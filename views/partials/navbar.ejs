<style>
    /* Style untuk Link Desktop */
    .nav-link {
        color: #A3C2B8; /* Text Muted */
        font-size: 0.875rem; /* text-sm */
        font-weight: 500;
        padding: 0.5rem 1rem;
        border-radius: 9999px;
        transition: all 0.2s;
    }
    .nav-link:hover {
        color: #F5FEF9; /* Text Pale */
        background-color: rgba(131, 197, 64, 0.1); /* Accent transparan */
    }

    /* Style untuk Link Mobile */
    .mobile-link {
        display: block;
        color: #F5FEF9;
        font-weight: 500;
        padding: 0.75rem;
        border-radius: 0.5rem;
    }
    .mobile-link:hover {
        background-color: rgba(255, 255, 255, 0.05);
        color: #83C540;
        padding-left: 1rem; /* Efek geser kanan dikit */
        transition: all 0.2s;
    }
</style>

<script>
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');

    btn.addEventListener('click', () => {
        menu.classList.toggle('hidden');
    });
</script>