<nav class="sticky top-0 z-50 w-full bg-[#003024]/90 backdrop-blur-md border-b border-white/10 transition-all duration-300">
    <div class="container mx-auto px-4 md:px-6">
        <div class="flex justify-between items-center h-20">

            <a href="/" class="flex items-center gap-2 group">
                <div class="w-8 h-8 rounded-lg bg-[#83C540] flex items-center justify-center text-[#003024]">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                    </svg>
                </div>
                <span class="text-xl md:text-2xl font-bold tracking-tight text-[#F5FEF9] group-hover:text-[#83C540] transition-colors">
                    Bausasran
                </span>
            </a>
            
            <div class="hidden lg:flex items-center gap-1 bg-[#004030]/50 px-4 py-2 rounded-full border border-white/5">
                <a href="/" class="nav-link">Home</a>
                <a href="/kegiatan" class="nav-link">Kegiatan</a>
                <a href="/produk" class="nav-link">Produk</a>
                <a href="/galeri" class="nav-link">Galeri</a>
                <a href="/anggota" class="nav-link">Anggota</a>
                <a href="/prestasi" class="nav-link">Prestasi</a>
                <a href="/testimoni" class="nav-link">Testimoni</a>
                <% if(currentUser && currentUser.Role === 'User') { %>
                    <a href="/user/testimoni" class="nav-link text-[#83C540]">Testimoni Saya</a>
                <% } %>
            </div>

            <div class="hidden lg:flex items-center gap-4">
                <% if(!currentUser) { %>
                    <a href="/login" class="bg-[#83C540] text-[#003024] px-5 py-2.5 rounded-lg font-bold hover:bg-[#6DA830] hover:shadow-[0_0_15px_rgba(131,197,64,0.4)] transition-all">
                        Login
                    </a>
                <% } else { %>
                    
                    <div class="flex flex-col text-right mr-2">
                        <span class="text-xs text-[#A3C2B8]">Halo,</span>
                        <span class="text-sm font-bold text-[#F5FEF9]"><%= currentUser.Nama.split(' ')[0] %></span>
                    </div>

                    <% if(currentUser.Role === 'Admin') { %>
                        <a href="/admin/dashboard" class="text-[#83C540] hover:text-[#F5FEF9] font-medium text-sm border border-[#83C540]/30 hover:border-[#83C540] px-4 py-2 rounded-lg transition-all">
                            Dashboard
                        </a>
                    <% } %>
                    
                    <a href="/logout" class="text-red-400 hover:text-red-300 hover:bg-red-500/10 p-2 rounded-lg transition-colors" title="Logout">
