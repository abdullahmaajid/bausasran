<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daftar Anggota - Bausasran</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        main: '#003024',    // Background Gelap
                        surface: '#004030', // Warna Kartu
                        accent: '#83C540',  // Hijau Neon
                        pale: '#F5FEF9',    // Teks Putih
                        muted: '#A3C2B8',   // Teks Pudar
                    },
                    fontFamily: { sans: ['Inter', 'sans-serif'] }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer base { 
            body { @apply bg-main text-pale font-sans antialiased; } 
            /* Custom Scrollbar */
            .custom-scroll::-webkit-scrollbar { width: 8px; }
            .custom-scroll::-webkit-scrollbar-track { @apply bg-main; }
            .custom-scroll::-webkit-scrollbar-thumb { @apply bg-surface border border-white/10 rounded-full; }
        }
    </style>
</head>
<body class="flex h-screen overflow-hidden">

    <%- include('../../partials/user_sidebar.ejs') %>

    <main class="flex-1 overflow-y-auto custom-scroll p-6 md:p-10 relative">
        
        <div class="fixed top-0 right-0 w-[500px] h-[500px] bg-accent/5 rounded-full blur-[100px] pointer-events-none -z-10"></div>

        <%- include('../../partials/flash.ejs') %>

        <div class="mb-10 border-b border-white/10 pb-6">
            <h1 class="text-3xl md:text-4xl font-bold text-pale mb-2">
                Daftar <span class="text-accent">Anggota</span>
            </h1>
            <p class="text-muted text-lg">Temui para penggerak dan anggota komunitas Kelompok Tani kami.</p>
        </div>

        <% if (anggotaList && anggotaList.length > 0) { %>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 pb-10">
                <% for(let anggota of anggotaList) { %>
                    <div class="group bg-surface border border-white/5 rounded-2xl overflow-hidden hover:border-accent/50 hover:shadow-[0_0_20px_rgba(131,197,64,0.15)] transition-all duration-300 flex flex-col relative">
                        
                        <div class="h-64 relative overflow-hidden bg-black/20">
                            <% if (anggota.dataValues && anggota.dataValues.fotoFile) { %>
                                <img src="/images/anggota/<%= anggota.dataValues.fotoFile %>" 
                                     alt="<%= anggota.Nama %>"
                                     class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700">
                                <div class="absolute inset-0 bg-gradient-to-t from-surface via-surface/20 to-transparent opacity-90"></div>
                            <% } else { %>
                                <div class="w-full h-full flex flex-col items-center justify-center bg-surface border-b border-white/5">
                                    <svg class="w-20 h-20 text-white/5 group-hover:text-accent/20 transition-colors duration-500" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"></path>
                                    </svg>
                                </div>
                            <% } %>
                        </div>

                        <div class="p-5 flex-1 flex flex-col relative -mt-12 z-10">
                            <h3 class="text-xl font-bold text-white mb-1 drop-shadow-md truncate"><%= anggota.Nama %></h3>
                            <div class="w-12 h-1 bg-accent rounded-full mb-4 shadow-[0_0_10px_rgba(131,197,64,0.5)]"></div>
                            
                            <div class="space-y-3 mb-6 flex-grow">
                                <% if (anggota.Username) { %>
                                    <div class="flex items-center text-sm text-muted group-hover:text-pale transition-colors">
                                        <div class="w-8 h-8 rounded-full bg-black/20 flex items-center justify-center mr-3 border border-white/5 group-hover:border-accent/30 transition-colors shrink-0">
                                            <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                                        </div>
                                        <span class="truncate font-medium">@<%= anggota.Username %></span>
                                    </div>
                                <% } %>
                                
                                <% if (anggota.Alamat) { %>
                                    <div class="flex items-start text-sm text-muted group-hover:text-pale transition-colors">
                                        <div class="w-8 h-8 rounded-full bg-black/20 flex items-center justify-center mr-3 border border-white/5 group-hover:border-accent/30 transition-colors shrink-0">
                                            <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                        </div>
                                        <span class="line-clamp-2 leading-relaxed text-xs opacity-80"><%= anggota.Alamat %></span>
                                    </div>
                                <% } %>
                            </div>

                            <a href="/user/anggota/<%= anggota.ID_Pengguna %>" 
                               class="block w-full text-center bg-white/5 hover:bg-accent border border-white/10 hover:border-transparent text-pale hover:text-main font-bold py-3 px-4 rounded-xl transition-all duration-300 transform group-hover:-translate-y-1 shadow-lg">
                                Lihat Profil
                            </a>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } else { %>
            <div class="flex flex-col items-center justify-center py-20 border-2 border-dashed border-white/5 rounded-3xl bg-surface/30">
                <div class="w-20 h-20 bg-white/5 rounded-full flex items-center justify-center mb-4 animate-pulse">
                    <svg class="w-10 h-10 text-muted/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-pale mb-2">Belum Ada Anggota</h3>
                <p class="text-muted text-sm">Data anggota belum tersedia saat ini.</p>
            </div>
        <% } %>

        <div class="mt-4 border-t border-white/5 pt-6 text-center text-xs text-muted/30">
            &copy; <%= new Date().getFullYear() %> Kampung Wisata Bausasran.
        </div>
    </main>

</body>
</html>