<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Produk: <%= product.Nama %> - Admin Bausasran</title>
    
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        main: '#003024',    // Background Gelap
                        surface: '#004030', // Warna Kartu
                        accent: '#83C540',  // Hijau Neon
                        pale: '#F5FEF9',    // Teks Putih
                        muted: '#A3C2B8',   // Teks Pudar
                        darker: '#00251a',  // Background Input
                        danger: '#ff4d4d',  // Merah Error
                        warning: '#FFC107', // Kuning Warning
                        info: '#3B82F6',    // Biru Info
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style type="text/tailwindcss">
        @layer base {
            body { @apply bg-main text-pale font-sans antialiased; }
        }
        
        /* Custom Scrollbar */
        .custom-scroll::-webkit-scrollbar { width: 6px; }
        .custom-scroll::-webkit-scrollbar-track { background: transparent; }
        .custom-scroll::-webkit-scrollbar-thumb { background: #004030; border-radius: 10px; border: 1px solid rgba(255,255,255,0.1); }
        .custom-scroll::-webkit-scrollbar-thumb:hover { background: #83C540; }

        /* Input Styles */
        .form-input {
            @apply w-full bg-darker border border-white/10 rounded-xl px-4 py-3 text-sm text-pale focus:border-accent focus:ring-1 focus:ring-accent outline-none transition-all placeholder-white/20 appearance-none;
        }
        .form-label {
            @apply block text-xs font-bold text-muted mb-2 uppercase tracking-wider;
        }

        /* Select Chevron */
        .select-wrapper { @apply relative; }
        .select-wrapper::after {
            content: '';
            @apply absolute right-4 top-1/2 -translate-y-1/2 w-2 h-2 border-r-2 border-b-2 border-muted pointer-events-none rotate-45;
        }

        /* Animation */
        @keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
        .animate-fade-in { animation: fadeIn 0.3s ease-out forwards; }
    </style>
</head>

<body class="flex h-screen overflow-hidden w-full">

    <%- include('../../partials/admin_sidebar.ejs') %>

    <main class="flex-1 h-full overflow-y-auto overflow-x-hidden custom-scroll relative">
        <%- include('../../partials/flash.ejs') %>

        <input type="file" id="edit-photo-input" accept="image/png, image/jpeg, image/jpg" class="hidden">

        <form id="edit-product-form" action="/admin/produk/<%= product.ID_Product %>/edit" method="POST" enctype="multipart/form-data" class="min-h-full p-6 md:p-8 flex flex-col">
            
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6 shrink-0">
                <div>
                    <h1 class="text-3xl font-bold text-pale tracking-tight flex items-center gap-2">
                        <span class="text-accent">Edit:</span> <%= product.Nama %>
                    </h1>
                    <p class="text-muted text-sm mt-1">Halaman manajemen detail produk.</p>
                </div>
                <div class="flex gap-2">
                    <button type="submit" class="bg-accent text-main font-bold py-2 px-6 rounded-lg text-sm shadow-lg hover:shadow-accent/20 transition-all">Simpan Perubahan</button>
                    <a href="/admin/produk" class="bg-surface text-pale py-2 px-6 rounded-lg text-sm border border-white/10 hover:bg-white/5 transition-all">Batal</a>
                </div>
            </div>

            <div class="flex flex-col lg:flex-row gap-6 items-start flex-1">
                
                <div class="w-full lg:flex-1 min-w-0 flex flex-col gap-6">
                    
                    <div class="bg-surface rounded-2xl p-6 md:p-8 shadow-xl border border-white/5">
                        <h3 class="text-lg font-bold text-pale mb-6 flex items-center gap-2 border-b border-white/5 pb-4">
                            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                            Informasi Produk
                        </h3>

                        <div class="space-y-6">
                            <div>
                                <label for="Nama" class="form-label">Nama Produk</label>
                                <input type="text" id="Nama" name="Nama" value="<%= product.Nama %>" 
                                    class="w-full bg-transparent border-b border-white/10 px-0 py-2 text-3xl font-bold text-pale focus:border-accent outline-none transition-colors placeholder-white/20" 
                                    required>
                            </div>

                            <div>
                                <label for="Kategori" class="form-label">Kategori</label>
                                <div class="select-wrapper">
                                    <select id="Kategori" name="Kategori" class="form-input cursor-pointer">
                                        <option value="Sayur" <%= product.Kategori === 'Sayur' ? 'selected' : '' %>>Sayur</option>
                                        <option value="Buah" <%= product.Kategori === 'Buah' ? 'selected' : '' %>>Buah</option>
                                        <option value="Herbal" <%= product.Kategori === 'Herbal' ? 'selected' : '' %>>Herbal</option>
                                        <option value="Lainnya" <%= (product.Kategori !== 'Sayur' && product.Kategori !== 'Buah' && product.Kategori !== 'Herbal') ? 'selected' : '' %>>Lainnya</option>
                                    </select>
                                </div>
                            </div>
                            
                            <div>
                                <label for="Deskripsi" class="form-label">Deskripsi Lengkap</label>
                                <textarea id="Deskripsi" name="Deskripsi" rows="5" class="form-input leading-relaxed resize-none"><%= product.Deskripsi || '' %></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="bg-surface rounded-2xl p-6 md:p-8 shadow-xl border border-white/5">
                        <h3 class="text-lg font-bold text-pale mb-4 flex items-center gap-2">
                            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            Harga & Diskon
                        </h3>
                        
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-end">
                            <div>
                                <label for="Harga" class="form-label">Harga Satuan (Rp)</label>
                                <input type="number" id="Harga" name="Harga" value="<%= product.Harga %>" class="form-input font-mono text-lg" placeholder="0" required>
                            </div>

                            <div>
                                <label for="Diskon" class="form-label text-warning">Diskon (%)</label>
                                <input type="number" id="Diskon" name="Diskon" value="<%= product.Diskon ? (product.Diskon * 100).toFixed(0) : 0 %>" class="form-input font-mono text-warning text-center" placeholder="0" min="0" max="100">
                            </div>

                            <div>
                                <label class="form-label text-accent">Harga Akhir</label>
                                <div id="final-price-preview" class="w-full h-[46px] flex items-center justify-center bg-accent/10 border border-accent/20 rounded-xl text-accent font-bold font-mono text-xl">
                                    Rp 0
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="bg-surface rounded-2xl p-6 md:p-8 shadow-xl border border-white/5">
                        <div class="flex justify-between items-center mb-4">
                            <h3 class="text-lg font-bold text-pale flex items-center gap-2">
                                <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                Galeri Produk
                            </h3>
                            <div class="flex gap-2">
                                <button type="button" id="edit-photo-btn" class="px-4 py-1.5 rounded-lg text-xs font-bold bg-info/20 text-info hover:bg-info hover:text-white transition disabled:opacity-30 disabled:cursor-not-allowed" disabled>
                                    Ganti Terpilih
                                </button>
                                <button type="button" id="delete-photos-btn" class="px-4 py-1.5 rounded-lg text-xs font-bold bg-danger/20 text-danger hover:bg-danger hover:text-white transition disabled:opacity-30 disabled:cursor-not-allowed" disabled>
                                    Hapus Terpilih
                                </button>
                            </div>
                        </div>

                        <div class="space-y-4">
                            <div id="photo-list-container" class="grid grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
                                <% if (existingPhotos && existingPhotos.length > 0) { %>
                                    <% existingPhotos.forEach(photo => { %>
                                        <div class="relative group photo-item aspect-square rounded-xl overflow-hidden border border-white/10 hover:border-accent/50 transition-colors bg-darker">
                                            <img id="img-<%= photo.ID_Foto %>" src="/images/produk/<%= photo.Foto %>" class="w-full h-full object-cover">
                                            <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col justify-between p-3">
                                                <div class="flex justify-between items-start w-full">
                                                     <label class="cursor-pointer bg-black/50 rounded-md p-1.5 hover:bg-info/80 text-white text-[10px]" title="Pilih untuk ganti">
                                                        <span class="block mb-1 text-center font-bold text-info">Ganti</span>
                                                        <input type="radio" name="selectPhotoToEdit" value="<%= photo.ID_Foto %>" class="edit-photo-radio accent-info w-4 h-4 cursor-pointer block mx-auto">
                                                    </label>
                                                    <label class="cursor-pointer bg-black/50 rounded-md p-1.5 hover:bg-danger/80 text-white text-[10px]" title="Pilih untuk hapus">
                                                        <span class="block mb-1 text-center font-bold text-danger">Hapus</span>
                                                        <input type="checkbox" name="deletePhotos" value="<%= photo.ID_Foto %>" class="delete-photo-checkbox accent-danger w-4 h-4 cursor-pointer block mx-auto">
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <p class="text-sm text-muted col-span-full text-center py-10 italic no-photos-msg border border-dashed border-white/10 rounded-xl">Belum ada foto yang diunggah.</p>
                                <% } %>
                                
                                <div class="relative group aspect-square bg-darker/50 border-2 border-dashed border-white/10 rounded-xl flex flex-col items-center justify-center hover:border-accent/50 transition-colors cursor-pointer hover:bg-darker">
                                    <input type="file" name="productImages" multiple accept="image/png, image/jpeg, image/jpg" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10">
                                    <svg class="w-8 h-8 text-muted mb-2 group-hover:text-accent transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                                    <span class="text-[10px] text-muted font-bold group-hover:text-white uppercase tracking-wider">Upload Baru</span>
                                </div>
                            </div>

                            <div class="h-5 flex items-center justify-center">
                                <p id="edit-status" class="text-xs"></p>
                                <p id="delete-status" class="text-xs"></p>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="w-full lg:w-[380px] shrink-0 flex flex-col gap-6">
                    
                    <div class="bg-surface rounded-2xl p-6 shadow-xl border border-white/5 sticky top-0">
                        <div class="flex justify-between items-center mb-6">
                            <h3 class="text-lg font-bold text-pale flex items-center gap-2">
                                <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.384-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
                                Parameter
                            </h3>
                            <button type="button" id="add-parameter-btn" class="text-xs bg-accent/10 hover:bg-accent hover:text-main text-accent border border-accent/20 py-1.5 px-3 rounded transition-all font-bold">
                                + Tambah
                            </button>
                        </div>
                        
                        <div id="parameter-container" class="space-y-3 min-h-[200px]">
                            <% if (existingParameters && existingParameters.length > 0) { %>
                                <% existingParameters.forEach(param => { %>
                                    <div class="parameter-row p-3 bg-darker/30 border border-white/10 rounded-xl relative group">
                                        <div class="mb-2">
                                            <div class="select-wrapper">
                                                <select name="paramNama[]" class="param-select w-full bg-darker border border-white/10 rounded-lg px-3 py-1.5 text-xs text-pale focus:border-accent outline-none appearance-none" data-selected-value="<%= param.Nama %>">
                                                    <option value="">-- Pilih --</option>
                                                </select>
                                            </div>
                                            <span class="param-unit text-[9px] text-accent mt-1 block font-mono pl-1">Unit: -</span>
                                        </div>
                                        <div class="grid grid-cols-2 gap-2">
                                            <div>
                                                <input type="number" step="any" name="paramMin[]" value="<%= param.Minimal %>" placeholder="Min" class="w-full bg-darker border border-white/10 rounded-lg px-2 py-1.5 text-xs text-pale text-center focus:border-accent outline-none">
                                            </div>
                                            <div>
                                                <input type="number" step="any" name="paramMax[]" value="<%= param.Maksimal %>" placeholder="Max" class="w-full bg-darker border border-white/10 rounded-lg px-2 py-1.5 text-xs text-pale text-center focus:border-accent outline-none">
                                            </div>
                                        </div>
                                        <button type="button" class="remove-parameter-btn absolute -top-1.5 -right-1.5 bg-danger text-white rounded-full p-1 opacity-0 group-hover:opacity-100 transition-opacity shadow-lg z-10">
                                            <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                                        </button>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <div class="text-center py-6 border-2 border-dashed border-white/5 rounded-xl placeholder-message flex flex-col items-center justify-center h-full">
                                    <p class="text-muted text-xs">Belum ada parameter.</p>
                                </div>
                            <% } %>
                        </div>
                    </div>

                </div> </div> </form>
    </main>

    <template id="parameter-row-template">
        <div class="parameter-row p-3 bg-darker/30 border border-white/10 rounded-xl relative group animate-fade-in">
            <div class="mb-2">
                <div class="select-wrapper">
                    <select name="paramNama[]" class="param-select w-full bg-darker border border-white/10 rounded-lg px-3 py-1.5 text-xs text-pale focus:border-accent outline-none appearance-none">
                        <option value="">-- Pilih --</option>
                    </select>
                </div>
                <span class="param-unit text-[9px] text-accent mt-1 block font-mono pl-1">Unit: -</span>
            </div>
            <div class="grid grid-cols-2 gap-2">
                <div>
                    <input type="number" step="any" name="paramMin[]" placeholder="Min" class="w-full bg-darker border border-white/10 rounded-lg px-2 py-1.5 text-xs text-pale text-center focus:border-accent outline-none">
                </div>
                <div>
                    <input type="number" step="any" name="paramMax[]" placeholder="Max" class="w-full bg-darker border border-white/10 rounded-lg px-2 py-1.5 text-xs text-pale text-center focus:border-accent outline-none">
                </div>
            </div>
            <button type="button" class="remove-parameter-btn absolute -top-1.5 -right-1.5 bg-danger text-white rounded-full p-1 opacity-0 group-hover:opacity-100 transition-opacity shadow-lg z-10">
                <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
    </template>

    <script>
        // --- 1. HARGA & DISKON ---
        const hargaInput = document.getElementById('Harga');
        const diskonInput = document.getElementById('Diskon');
        const pricePreview = document.getElementById('final-price-preview');
        const formatter = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 });

        function updatePricePreview() {
            const harga = parseFloat(hargaInput.value) || 0;
            let diskonPersen = parseFloat(diskonInput.value) || 0;
            if (diskonPersen < 0) diskonPersen = 0;
            if (diskonPersen > 100) diskonPersen = 100;
            const hargaAkhir = harga - (harga * (diskonPersen / 100));
            pricePreview.textContent = formatter.format(hargaAkhir);
        }
        hargaInput.addEventListener('input', updatePricePreview);
        diskonInput.addEventListener('input', updatePricePreview);
        updatePricePreview();

        // --- 2. PARAMETER ---
        const parameterDetails = { 
            'Suhu Rata-rata': { unit: '°C' }, 'Kelembaban Relatif': { unit: '%' }, 'Curah Hujan': { unit: 'mm' }, 
            'Kecepatan Angin': { unit: 'm/s' }, 'Radiasi Matahari': { unit: 'MJ/m²/day' }, 'Evapotranspirasi': { unit: 'mm/day' }, 
            'Suhu Tanah (0-7cm)': { unit: '°C' }, 'Kelembaban Tanah': { unit: 'm³/m³' }, 'pH Tanah': { unit: 'pH' }, 'Kandungan Organik': { unit: '%' } 
        };
        const predefinedParameters = Object.keys(parameterDetails);
        const container = document.getElementById('parameter-container');
        const addButton = document.getElementById('add-parameter-btn');
        const template = document.getElementById('parameter-row-template');

        function updateAllDropdowns() {
            const selects = container.querySelectorAll('.param-select');
            const selectedValues = new Set();
            selects.forEach(s => { if (s.value) selectedValues.add(s.value); });
            selects.forEach(currentSelect => {
                const currentVal = currentSelect.value;
                Array.from(currentSelect.options).forEach(opt => {
                    if (opt.value && opt.value !== currentVal && selectedValues.has(opt.value)) {
                        opt.disabled = true; opt.classList.add('text-muted');
                    } else {
                        opt.disabled = false; opt.classList.remove('text-muted');
                    }
                });
            });
            const placeholder = container.querySelector('.placeholder-message');
            if (placeholder) placeholder.style.display = container.querySelectorAll('.parameter-row').length > 0 ? 'none' : 'flex';
        }
        function updateUnit(row, val) {
            const unitEl = row.querySelector('.param-unit');
            if (unitEl) unitEl.textContent = parameterDetails[val] ? `Unit: ${parameterDetails[val].unit}` : 'Unit: -';
        }
        function populateSelect(select, selected = '') {
            select.innerHTML = '<option value="">-- Pilih --</option>';
            predefinedParameters.forEach(p => {
                const opt = document.createElement('option');
                opt.value = p; opt.textContent = p; if (p === selected) opt.selected = true;
                select.appendChild(opt);
            });
        }
        function initRow(row, selectedVal = '') {
            const select = row.querySelector('.param-select');
            populateSelect(select, selectedVal);
            updateUnit(row, selectedVal);
            select.addEventListener('change', (e) => { updateAllDropdowns(); updateUnit(row, e.target.value); });
            row.querySelector('.remove-parameter-btn').addEventListener('click', () => { row.remove(); updateAllDropdowns(); });
        }

        addButton.addEventListener('click', () => {
            const clone = template.content.cloneNode(true);
            initRow(clone.querySelector('.parameter-row'));
            container.appendChild(clone);
            updateAllDropdowns();
        });

        container.querySelectorAll('.parameter-row').forEach(row => {
            initRow(row, row.querySelector('.param-select').dataset.selectedValue);
        });
        updateAllDropdowns();

        // --- 3. FOTO (AJAX) ---
        const photoContainer = document.getElementById('photo-list-container');
        const deleteBtn = document.getElementById('delete-photos-btn');
        const editBtn = document.getElementById('edit-photo-btn');
        const editPhotoInput = document.getElementById('edit-photo-input');
        const deleteStatus = document.getElementById('delete-status');
        const editStatus = document.getElementById('edit-status');
        const productId = '<%= product.ID_Product %>';

        function updateControls() {
            deleteBtn.disabled = !photoContainer.querySelector('.delete-photo-checkbox:checked');
            editBtn.disabled = !photoContainer.querySelector('.edit-photo-radio:checked');
        }
        photoContainer.addEventListener('change', updateControls);

        deleteBtn.addEventListener('click', async () => {
            const ids = Array.from(photoContainer.querySelectorAll('.delete-photo-checkbox:checked')).map(cb => cb.value);
            if (!confirm(`Hapus ${ids.length} foto?`)) return;
            deleteBtn.disabled = true; deleteStatus.textContent = 'Menghapus...'; deleteStatus.className = 'text-xs text-center text-warning';
            try {
                const res = await fetch(`/admin/produk/${productId}/delete-photos`, { method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({ photoIds: ids }) });
                const data = await res.json();
                if (res.ok && data.success) {
                    deleteStatus.textContent = 'Terhapus!'; deleteStatus.className = 'text-xs text-center text-accent';
                    ids.forEach(id => document.querySelector(`.delete-photo-checkbox[value="${id}"]`).closest('.photo-item').remove());
                } else throw new Error(data.message);
            } catch (e) { deleteStatus.textContent = e.message; deleteStatus.className = 'text-xs text-center text-danger'; }
            finally { updateControls(); setTimeout(() => deleteStatus.textContent = '', 2000); }
        });

        editBtn.addEventListener('click', () => editPhotoInput.click());
        editPhotoInput.addEventListener('change', async (e) => {
            const file = e.target.files[0];
            const radio = photoContainer.querySelector('.edit-photo-radio:checked');
            if (!file || !radio) { editPhotoInput.value = ''; return; }
            editBtn.disabled = true; editStatus.textContent = 'Upload...'; editStatus.className = 'text-xs text-center text-info';
            const formData = new FormData(); formData.append('editedPhoto', file); formData.append('photoIdToReplace', radio.value);
            try {
                const res = await fetch(`/admin/produk/${productId}/edit-photo`, { method: 'POST', body: formData });
                const data = await res.json();
                if (res.ok && data.success) {
                    editStatus.textContent = 'Sukses!'; editStatus.className = 'text-xs text-center text-accent';
                    document.getElementById(`img-${data.photoId}`).src = `/images/produk/${data.newFilename}?t=${Date.now()}`;
                    radio.checked = false;
                } else throw new Error(data.message);
            } catch (e) { editStatus.textContent = e.message; editStatus.className = 'text-xs text-center text-danger'; }
            finally { editPhotoInput.value = ''; updateControls(); setTimeout(() => editStatus.textContent = '', 2000); }
        });
        updateControls();
    </script>
</body>
</html>