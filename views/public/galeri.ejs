<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Galeri - Bausasran</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-gray-100">

    <%- include('../partials/navbar.ejs') %>

    <main class="container mx-auto p-6 md:p-12">
        <%- include('../partials/flash.ejs') %>

        <!-- Header -->
        <div class="text-center mb-12">
            <h1 class="text-4xl font-bold text-gray-800 mb-4">Galeri Foto</h1>
            <p class="text-lg text-gray-600">Dokumentasi kegiatan dan momen berharga Bausasran</p>
        </div>

        <!-- Category Filter -->
        <% if(groupFotoList && groupFotoList.length > 0) { %>
            <div class="flex flex-wrap justify-center mb-8 gap-3">
                <button onclick="filterGaleri('all')" class="filter-btn px-6 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition">
                    Semua
                </button>
                <% groupFotoList.forEach(group => { %>
                    <button onclick="filterGaleri('<%= group.ID_GroupFoto %>')" class="filter-btn px-6 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition">
                        <%= group.Nama %>
                    </button>
                <% }) %>
            </div>
        <% } %>

        <!-- Gallery Grid -->
        <% if(fotoList && fotoList.length > 0) { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
                <% fotoList.forEach((foto, index) => { %>
                    <div class="galeri-item bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-all transform hover:-translate-y-2 cursor-pointer" 
                         data-category="<%= foto.ID_GroupFoto %>"
                         data-index="<%= index %>"
                         onclick="openLightbox(this.dataset.index)">
                        <!-- Photo -->
                        <div class="relative h-64 bg-gray-200">
                            <% 
                            // Determine folder based on category
                            let folder = 'anggota';
                            if (foto.dataValues.kategoriName) {
                                const kategori = foto.dataValues.kategoriName.toLowerCase();
                                if (kategori.includes('kegiatan')) folder = 'kegiatan';
                                else if (kategori.includes('produk')) folder = 'produk';
                                else if (kategori.includes('galeri')) folder = 'galeri';
                            }
                            %>
                            <img src="/images/<%= folder %>/<%= foto.Foto %>" 
                                 alt="<%= foto.dataValues.kategoriName || 'Foto' %>" 
                                 class="w-full h-full object-cover">
                            
                            <!-- Category Badge -->
                            <% if (foto.dataValues.kategoriName) { %>
                                <div class="absolute top-3 left-3">
                                    <span class="px-3 py-1 bg-blue-500 text-white text-xs font-bold rounded-full">
                                        <%= foto.dataValues.kategoriName %>
                                    </span>
                                </div>
                            <% } %>

                            <!-- Overlay -->
                            <div class="absolute inset-0 bg-black bg-opacity-0 hover:bg-opacity-30 transition-all flex items-center justify-center">
                                <svg class="w-12 h-12 text-white opacity-0 hover:opacity-100 transition-all" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/>
                                    <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/>
                                </svg>
                            </div>
                        </div>

                        <!-- Caption (if exists) -->
                        <% if (foto.Deskripsi || foto.Tanggal) { %>
                            <div class="p-4">
                                <% if (foto.Deskripsi) { %>
                                    <p class="text-gray-700 text-sm mb-2"><%= foto.Deskripsi %></p>
                                <% } %>
                                <% if (foto.Tanggal) { %>
                                    <p class="text-gray-500 text-xs">
                                        <%= new Date(foto.Tanggal).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                                    </p>
                                <% } %>
                            </div>
                        <% } %>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="text-center py-16">
                <svg class="w-24 h-24 mx-auto text-gray-400 mb-4" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"/>
                </svg>
                <h3 class="text-xl font-semibold text-gray-700 mb-2">Belum Ada Foto</h3>
                <p class="text-gray-500">Galeri foto akan segera hadir!</p>
            </div>
        <% } %>
    </main>

    <%- include('../partials/footer.ejs') %>

    <!-- Hidden data element for JavaScript -->
    <script type="application/json" id="foto-data">
        <%- JSON.stringify(fotoList || []) %>
    </script>

    <!-- Lightbox Modal -->
    <div id="lightbox" class="fixed inset-0 bg-black bg-opacity-90 z-50 hidden items-center justify-center" onclick="closeLightbox()">
        <div class="relative max-w-7xl mx-auto p-4" onclick="event.stopPropagation()">
            <!-- Close Button -->
            <button onclick="closeLightbox()" class="absolute top-4 right-4 text-white hover:text-gray-300 z-10">
                <svg class="w-10 h-10" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
                </svg>
            </button>

            <!-- Image Container -->
            <div class="bg-white rounded-lg overflow-hidden shadow-2xl">
                <img id="lightbox-img" src="" alt="" class="w-full max-h-[80vh] object-contain">
                <div id="lightbox-caption" class="p-4 bg-gray-100">
                    <p id="lightbox-desc" class="text-gray-800 font-semibold mb-1"></p>
                    <p id="lightbox-date" class="text-gray-600 text-sm"></p>
                </div>
            </div>

            <!-- Navigation -->
            <button onclick="navigateLightbox(-1); event.stopPropagation()" class="absolute left-4 top-1/2 transform -translate-y-1/2 text-white hover:text-gray-300">
                <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
            </button>
            <button onclick="navigateLightbox(1); event.stopPropagation()" class="absolute right-4 top-1/2 transform -translate-y-1/2 text-white hover:text-gray-300">
                <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                </svg>
            </button>
        </div>
    </div>

    <script>
        let currentImageIndex = 0;
        let fotoData = [];
        
        // Load foto data from server
        try {
            const dataElement = document.getElementById('foto-data');
            if (dataElement && dataElement.textContent) {
                fotoData = JSON.parse(dataElement.textContent);
            }
        } catch (e) {
            console.error('Error parsing foto data:', e);
        }

        function filterGaleri(category) {
            const items = document.querySelectorAll('.galeri-item');
            const buttons = document.querySelectorAll('.filter-btn');
            
            // Update button styles
            buttons.forEach(btn => {
                btn.classList.remove('bg-blue-500', 'text-white');
                btn.classList.add('bg-gray-200', 'text-gray-700');
            });
            event.target.classList.remove('bg-gray-200', 'text-gray-700');
            event.target.classList.add('bg-blue-500', 'text-white');
            
            // Filter items
            items.forEach(item => {
                if (category === 'all' || item.dataset.category === category) {
                    item.style.display = 'block';
                } else {
                    item.style.display = 'none';
                }
            });
        }

        function openLightbox(index) {
            currentImageIndex = index;
            updateLightboxContent();
            document.getElementById('lightbox').classList.remove('hidden');
            document.getElementById('lightbox').classList.add('flex');
            document.body.style.overflow = 'hidden';
        }

        function closeLightbox() {
            document.getElementById('lightbox').classList.add('hidden');
            document.getElementById('lightbox').classList.remove('flex');
            document.body.style.overflow = 'auto';
        }

        function navigateLightbox(direction) {
            currentImageIndex = (currentImageIndex + direction + fotoData.length) % fotoData.length;
            updateLightboxContent();
        }

        function updateLightboxContent() {
            if (!fotoData || fotoData.length === 0) return;
            
            const foto = fotoData[currentImageIndex];
            let folder = 'anggota';
            if (foto.dataValues && foto.dataValues.kategoriName) {
                const kategori = foto.dataValues.kategoriName.toLowerCase();
                if (kategori.includes('kegiatan')) folder = 'kegiatan';
                else if (kategori.includes('produk')) folder = 'produk';
                else if (kategori.includes('galeri')) folder = 'galeri';
            }
            
            document.getElementById('lightbox-img').src = `/images/${folder}/${foto.Foto}`;
            document.getElementById('lightbox-desc').textContent = foto.Deskripsi || foto.dataValues?.kategoriName || 'Foto';
            
            if (foto.Tanggal) {
                const date = new Date(foto.Tanggal).toLocaleDateString('id-ID', { 
                    year: 'numeric', 
                    month: 'long', 
                    day: 'numeric' 
                });
                document.getElementById('lightbox-date').textContent = date;
            } else {
                document.getElementById('lightbox-date').textContent = '';
            }
        }

        // Keyboard navigation
        document.addEventListener('keydown', function(e) {
            const lightbox = document.getElementById('lightbox');
            if (!lightbox.classList.contains('hidden')) {
                if (e.key === 'ArrowLeft') navigateLightbox(-1);
                if (e.key === 'ArrowRight') navigateLightbox(1);
                if (e.key === 'Escape') closeLightbox();
            }
        });
    </script>

</body>
</html>
