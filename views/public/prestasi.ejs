<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Prestasi - Bausasran</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-gray-100">

    <%- include('../partials/navbar.ejs') %>

    <main class="container mx-auto p-6 md:p-12">
        <%- include('../partials/flash.ejs') %>

        <!-- Header -->
        <div class="text-center mb-12">
            <h1 class="text-4xl font-bold text-gray-800 mb-4">Prestasi Kami</h1>
            <p class="text-lg text-gray-600">Berbagai pencapaian dan penghargaan yang telah diraih Bausasran</p>
        </div>

        <!-- Prestasi Timeline -->
        <% if(prestasiList && prestasiList.length > 0) { %>
            <div class="max-w-4xl mx-auto">
                <% prestasiList.forEach((prestasi, index) => { %>
                    <div class="relative mb-12 <%= index % 2 === 0 ? '' : 'md:ml-auto' %> md:w-1/2">
                        <!-- Timeline Dot -->
                        <div class="absolute top-0 <%= index % 2 === 0 ? 'md:right-0 md:-mr-6' : 'md:left-0 md:-ml-6' %> left-0 -ml-6 md:top-1/2 md:-mt-3">
                            <div class="w-12 h-12 bg-blue-500 rounded-full border-4 border-white shadow-lg flex items-center justify-center">
                                <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                </svg>
                            </div>
                        </div>

                        <!-- Content Card -->
                        <div class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow ml-8 md:ml-0 <%= index % 2 === 0 ? 'md:mr-12' : 'md:ml-12' %>">
                            <div class="p-6">
                                <div class="flex items-center justify-between mb-3">
                                    <span class="text-sm font-semibold text-blue-600">
                                        <%= new Date(prestasi.Tanggal).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                                    </span>
                                    <% if (prestasi.Kategori) { %>
                                        <span class="px-3 py-1 bg-yellow-100 text-yellow-800 text-xs font-bold rounded-full">
                                            <%= prestasi.Kategori %>
                                        </span>
                                    <% } %>
                                </div>
                                <h3 class="text-2xl font-bold text-gray-900 mb-3"><%= prestasi.Judul %></h3>
                                <a href="/prestasi/<%= prestasi.ID_Prestasi %>" class="inline-block text-blue-500 hover:text-blue-700 font-semibold">
                                    Lihat Detail →
                                </a>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="text-center py-16">
                <svg class="w-24 h-24 mx-auto text-gray-400 mb-4" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
                <h3 class="text-xl font-semibold text-gray-700 mb-2">Belum Ada Prestasi</h3>
                <p class="text-gray-500">Prestasi akan segera hadir di sini!</p>
            </div>
        <% } %>
    </main>

    <%- include('../partials/footer.ejs') %>

</body>
</html>
