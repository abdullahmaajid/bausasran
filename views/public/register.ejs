<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daftar Warga - Bausasran Heritage</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
    
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        paper: '#F9F7F2',       // Cream Background
                        deep: '#0F1F18',        // Dark Green (Primary)
                        gold: '#C5B388',        // Luxury Accent
                        charcoal: '#4A4A4A',    // Text
                        sand: '#E5E0D8',        // Border/Secondary
                        white: '#FFFFFF',
                        danger: '#EF4444',      // Error Red
                        success: '#10B981',     // Success Green
                    },
                    fontFamily: {
                        sans: ['Lato', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                        crest: ['Cinzel', 'serif'], 
                    },
                    boxShadow: {
                        'elegant': '0 20px 40px -10px rgba(15, 31, 24, 0.1)',
                        'sharp': '5px 5px 0px 0px rgba(197, 179, 136, 0.3)',
                    }
                }
            }
        }
    </script>

    <style type="text/tailwindcss">
        @layer base {
            body {
                @apply bg-paper text-deep font-sans antialiased;
            }
        }
        .noise-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none; z-index: 9999; mix-blend-mode: multiply;
        }
    </style>
</head>

<body class="flex flex-col min-h-screen relative justify-center py-12">

    <div class="noise-overlay"></div>
    
    <div class="fixed top-0 right-0 w-96 h-96 bg-gold/10 rounded-full blur-[100px] translate-x-1/3 -translate-y-1/3 pointer-events-none"></div>
    <div class="fixed bottom-0 left-0 w-64 h-64 bg-deep/5 rounded-full blur-[80px] -translate-x-1/3 translate-y-1/3 pointer-events-none"></div>

    <main class="container mx-auto px-4 relative z-10 flex items-center justify-center">
        
        <div class="w-full max-w-2xl">
            <%- include('../partials/flash.ejs') %>

            <div class="bg-white border border-deep/10 p-8 md:p-12 shadow-elegant relative overflow-hidden animate-[fadeIn_0.5s]">
                <div class="absolute top-0 left-0 w-full h-1 bg-gold"></div>

                <div class="text-center mb-10">
                    <span class="font-crest text-3xl text-deep mb-2 block">✦</span>
                    <h1 class="font-crest text-2xl md:text-3xl text-deep mb-2">Registrasi Warga</h1>
                    <p class="font-serif italic text-charcoal/60 text-sm">Bergabunglah menjaga warisan budaya Bausasran.</p>
                </div>
                
                <form action="/register" method="POST" id="registerForm" class="space-y-6">
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="group">
                            <label for="Nama" class="block text-[9px] uppercase tracking-widest text-deep/40 mb-2 font-bold group-focus-within:text-gold transition-colors">
                                Nama Lengkap <span class="text-gold">*</span>
                            </label>
                            <input type="text" id="Nama" name="Nama" 
                                class="block w-full px-4 py-3 bg-paper border border-deep/10 text-deep font-serif placeholder-deep/20 focus:outline-none focus:border-gold focus:bg-white transition-all duration-300" 
                                required placeholder="Cth: Budi Santoso">
                        </div>
                        
                        <div class="group">
                            <label for="Username" class="block text-[9px] uppercase tracking-widest text-deep/40 mb-2 font-bold group-focus-within:text-gold transition-colors">
                                Username <span class="text-gold">*</span>
                            </label>
                            <input type="text" id="Username" name="Username" 
                                class="block w-full px-4 py-3 bg-paper border border-deep/10 text-deep font-serif placeholder-deep/20 focus:outline-none focus:border-gold focus:bg-white transition-all duration-300" 
                                required placeholder="Cth: budi_san" pattern="[a-zA-Z0-9_]+" title="Hanya huruf, angka, dan underscore">
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="group">
                            <label for="Password" class="block text-[9px] uppercase tracking-widest text-deep/40 mb-2 font-bold group-focus-within:text-gold transition-colors">
                                Password <span class="text-gold">*</span>
                            </label>
                            <div class="relative">
                                <input type="password" id="Password" name="Password" 
                                    class="block w-full px-4 py-3 bg-paper border border-deep/10 text-deep font-serif placeholder-deep/20 focus:outline-none focus:border-gold focus:bg-white transition-all duration-300" 
                                    required minlength="6" placeholder="••••••••">
                                <button type="button" onclick="togglePassword('Password')" class="absolute right-3 top-1/2 -translate-y-1/2 text-deep/30 hover:text-gold transition-colors">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                                </button>
                            </div>
                        </div>
                        
                        <div class="group">
                            <label for="ConfirmPassword" class="block text-[9px] uppercase tracking-widest text-deep/40 mb-2 font-bold group-focus-within:text-gold transition-colors">
                                Konfirmasi Password <span class="text-gold">*</span>
                            </label>
                            <div class="relative">
                                <input type="password" id="ConfirmPassword" name="ConfirmPassword" 
                                    class="block w-full px-4 py-3 bg-paper border border-deep/10 text-deep font-serif placeholder-deep/20 focus:outline-none focus:border-gold focus:bg-white transition-all duration-300" 
                                    required minlength="6" placeholder="••••••••">
                                <button type="button" onclick="togglePassword('ConfirmPassword')" class="absolute right-3 top-1/2 -translate-y-1/2 text-deep/30 hover:text-gold transition-colors">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                                </button>
                            </div>
                            <p class="text-[10px] text-danger mt-1 hidden font-bold tracking-wider uppercase" id="passwordError">
                                ⚠ Password tidak cocok!
                            </p>
                        </div>
                    </div>

                    <div class="bg-deep/5 p-4 border border-deep/5">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-[9px] uppercase tracking-widest text-deep/50">Keamanan Password</span>
                            <span id="strengthText" class="text-[9px] uppercase tracking-widest font-bold text-deep/30">Belum diisi</span>
                        </div>
                        <div class="w-full bg-white h-1 overflow-hidden">
                            <div id="passwordStrength" class="h-full transition-all duration-500 ease-out w-0 bg-deep/20"></div>
                        </div>
                    </div>

                    <button type="submit" 
                        class="w-full py-4 bg-deep text-paper text-[10px] uppercase tracking-widest font-bold border border-deep hover:bg-gold hover:border-gold hover:text-deep transition-all duration-300 shadow-sharp mt-4">
                        Buat Akun Sekarang
                    </button>
                </form>
                
                <div class="mt-8 pt-6 border-t border-deep/5 text-center">
                    <p class="font-serif text-charcoal/60 text-sm">
                        Sudah menjadi warga? 
                        <a href="/login" class="text-deep font-bold hover:text-gold transition-colors decoration-gold/30 underline underline-offset-4">
                            Login Disini
                        </a>
                    </p>
                </div>
            </div>
            
            <div class="mt-8 text-center animate-[fadeIn_0.8s]">
                <a href="/" class="text-[9px] uppercase tracking-widest text-deep/40 hover:text-deep transition-colors flex items-center justify-center gap-2">
                    <span>←</span> Kembali ke Beranda
                </a>
            </div>
        </div>
    </main>

    <script>
        // Toggle password visibility
        function togglePassword(fieldId) {
            const field = document.getElementById(fieldId);
            field.type = field.type === 'password' ? 'text' : 'password';
        }

        // Password strength checker
        const passwordInput = document.getElementById('Password');
        const strengthBar = document.getElementById('passwordStrength');
        const strengthText = document.getElementById('strengthText');

        passwordInput.addEventListener('input', function() {
            const password = this.value;
            let strength = 0;
            
            if (password.length > 0) strength += 10;
            if (password.length >= 6) strength += 20;
            if (password.length >= 10) strength += 20;
            if (/[a-z]/.test(password) && /[A-Z]/.test(password)) strength += 20;
            if (/[0-9]/.test(password)) strength += 15;
            if (/[^a-zA-Z0-9]/.test(password)) strength += 15;
            
            if(strength > 100) strength = 100;

            strengthBar.style.width = strength + '%';
            
            // Mengubah warna bar & text berdasarkan kekuatan (Heritage Palette)
            if (strength === 0) {
                strengthBar.className = 'h-full transition-all duration-500 bg-deep/20';
                strengthText.textContent = 'Belum diisi';
                strengthText.className = 'text-[9px] uppercase tracking-widest font-bold text-deep/30';
            } else if (strength < 40) {
                strengthBar.className = 'h-full transition-all duration-500 bg-danger';
                strengthText.textContent = 'Lemah';
                strengthText.className = 'text-[9px] uppercase tracking-widest font-bold text-danger';
            } else if (strength < 70) {
                strengthBar.className = 'h-full transition-all duration-500 bg-gold';
                strengthText.textContent = 'Sedang';
                strengthText.className = 'text-[9px] uppercase tracking-widest font-bold text-gold';
            } else {
                strengthBar.className = 'h-full transition-all duration-500 bg-deep';
                strengthText.textContent = 'Kuat';
                strengthText.className = 'text-[9px] uppercase tracking-widest font-bold text-deep';
            }
        });

        // Validate password match
        const confirmPassword = document.getElementById('ConfirmPassword');
        const passwordError = document.getElementById('passwordError');
        const form = document.getElementById('registerForm');

        function checkMatch() {
            if (confirmPassword.value && confirmPassword.value !== passwordInput.value) {
                passwordError.classList.remove('hidden');
                confirmPassword.classList.add('border-danger', 'text-danger');
                confirmPassword.classList.remove('border-deep/10', 'focus:border-gold');
            } else {
                passwordError.classList.add('hidden');
                confirmPassword.classList.remove('border-danger', 'text-danger');
                confirmPassword.classList.add('border-deep/10', 'focus:border-gold');
            }
        }

        confirmPassword.addEventListener('input', checkMatch);
        passwordInput.addEventListener('input', checkMatch);

        form.addEventListener('submit', function(e) {
            if (passwordInput.value !== confirmPassword.value) {
                e.preventDefault();
                alert('Password dan Konfirmasi Password tidak cocok!');
                confirmPassword.focus();
            }
        });
    </script>
</body>
</html>