<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registrasi Produk - Executive Console</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        paper: '#F9F7F2',       /* Latar Belakang Kertas Tua */
                        deep: '#0F1F18',        /* Tinta Hijau Gelap */
                        gold: '#C5B388',        /* Emas Antik */
                        charcoal: '#4A4A4A',    /* Abu Arang */
                        linen: '#EBE9E4',       /* Abu Linen */
                        white: '#FFFFFF',
                        danger: '#8B3A3A',      /* Merah Bata Elegan */
                    },
                    fontFamily: {
                        sans: ['Lato', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                        crest: ['Cinzel', 'serif'], 
                    },
                    boxShadow: {
                        'elegant': '0 20px 50px -12px rgba(15, 31, 24, 0.08)',
                        'gold-glow': '0 0 15px rgba(197, 179, 136, 0.2)',
                    }
                }
            }
        }
    </script>

    <style type="text/tailwindcss">
        @layer base {
            body { @apply bg-paper text-deep font-sans antialiased; }
        }

        /* TEXTURE: Film Grain Overlay */
        .noise-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.03'/%3E%3C/svg%3E");
            pointer-events: none; z-index: 50; mix-blend-mode: multiply;
        }

        /* COMPONENTS */
        .input-label { 
            @apply block text-[10px] uppercase tracking-[0.15em] font-bold text-deep/60 mb-2 font-sans; 
        }
        
        .required-mark { 
            @apply text-danger ml-0.5 text-xs align-top; 
        }

        .input-luxury {
            @apply w-full bg-white border border-deep/10 px-4 py-3 text-sm text-deep placeholder-deep/20 focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold/50 transition-all duration-300 font-sans shadow-sm rounded-sm;
        }

        .input-headline {
            @apply w-full bg-transparent border-b-2 border-deep/10 px-2 py-2 -mx-2 text-3xl md:text-4xl font-serif font-bold text-deep placeholder-deep/15 focus:outline-none focus:border-gold focus:bg-white/40 transition-all duration-300;
        }

        /* Custom Scrollbar */
        .custom-scroll::-webkit-scrollbar { width: 6px; }
        .custom-scroll::-webkit-scrollbar-track { background: transparent; }
        .custom-scroll::-webkit-scrollbar-thumb { background: #C5B388; border-radius: 3px; }
        .custom-scroll::-webkit-scrollbar-thumb:hover { background: #0F1F18; }
    </style>
</head>

<body class="flex h-screen overflow-hidden relative">

    <div class="noise-overlay"></div>

    <%- include('../../partials/admin_sidebar.ejs') %>

    <main class="flex-1 h-full overflow-y-auto overflow-x-hidden custom-scroll relative z-10 p-6 md:p-12">
        <%- include('../../partials/flash.ejs') %>

        <form action="/admin/produk" method="POST" enctype="multipart/form-data" id="product-form" class="max-w-6xl mx-auto flex flex-col min-h-full">
            
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 border-b border-deep/10 pb-6 animate-enter">
                <div>
                    <span class="font-sans text-[10px] uppercase tracking-widest text-gold mb-2 block">Inventaris Komoditas</span>
                    <h1 class="font-crest text-3xl md:text-4xl text-deep leading-tight">Registrasi Produk Baru</h1>
                    <p class="font-serif italic text-charcoal/60 text-sm mt-2">Pencatatan detail komoditas, harga pasar, dan spesifikasi tumbuh.</p>
                </div>
                <div class="flex gap-4">
                    <a href="/admin/produk" class="px-6 py-3 border border-deep/10 text-deep/60 text-[10px] uppercase tracking-widest font-bold hover:bg-white hover:text-deep transition-all flex items-center justify-center">
                        Batal
                    </a>
                    <button type="submit" id="btn-submit" class="px-8 py-3 bg-deep text-gold text-[10px] uppercase tracking-[0.2em] font-bold border border-deep hover:bg-gold hover:text-deep hover:border-gold transition-all shadow-lg hover:shadow-gold-glow flex items-center gap-2 group">
                        <span>Simpan Katalog</span>
                        <svg class="w-3 h-3 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                    </button>
                </div>
            </div>

            <div class="flex flex-col xl:flex-row gap-8 xl:gap-12 items-start">
                
                <div class="w-full xl:flex-1 space-y-8">
                    
                    <div class="bg-white p-8 border border-deep/5 shadow-elegant relative group">
                        <div class="absolute top-0 left-0 w-1 h-full bg-gold/50 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                        
                        <div class="mb-8 relative">
                            <label for="Nama" class="input-label text-gold">Nama Produk <span class="required-mark">*</span></label>
                            <input type="text" id="Nama" name="Nama" class="input-headline" placeholder="Contoh: Bibit Cabai Rawit" required autocomplete="off">
                        </div>

                        <div class="mb-6">
                            <label for="Kategori" class="input-label">Kategori Komoditas</label>
                            <input type="text" id="Kategori" name="Kategori" class="input-luxury" placeholder="Contoh: Sayuran / Bibit / Pupuk">
                        </div>

                        <div class="flex flex-col">
                            <label for="Deskripsi" class="input-label">Deskripsi Lengkap</label>
                            <textarea id="Deskripsi" name="Deskripsi" rows="5"
                                class="w-full bg-paper/50 border border-deep/10 p-5 text-sm text-deep/80 leading-relaxed font-serif italic focus:outline-none focus:border-gold resize-none placeholder-deep/20 focus:bg-white transition-all rounded-sm" 
                                placeholder="Jelaskan detail produk, manfaat, dan cara perawatan singkat..."></textarea>
                        </div>
                    </div>

                    <div class="bg-deep/5 p-8 border border-deep/5 rounded-sm relative overflow-hidden">
                        <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: url('data:image/svg+xml,%3Csvg width=\'20\' height=\'20\' viewBox=\'0 0 20 20\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'%230F1F18\' fill-opacity=\'1\' fill-rule=\'evenodd\'%3E%3Ccircle cx=\'3\' cy=\'3\' r=\'3\'/%3E%3Ccircle cx=\'13\' cy=\'13\' r=\'3\'/%3E%3C/g%3E%3C/svg%3E');"></div>
                        
                        <h3 class="font-crest text-lg text-deep mb-6 flex items-center gap-3 relative z-10">
                            <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            Valuasi & Harga
                        </h3>

                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 relative z-10">
                            <div>
                                <label for="Harga" class="input-label">Harga Dasar (IDR) <span class="required-mark">*</span></label>
                                <input type="number" id="Harga" name="Harga" step="1" min="0" class="input-luxury font-mono" placeholder="0" required>
                            </div>
                            <div>
                                <label for="Diskon" class="input-label">Potongan (%)</label>
                                <input type="number" id="Diskon" name="Diskon" step="1" min="0" max="100" class="input-luxury text-center font-mono" placeholder="0">
                            </div>
                            <div>
                                <label class="input-label text-gold">Harga Final</label>
                                <div id="final-price-preview" class="w-full border-b-2 border-gold/30 py-3 text-lg md:text-xl font-serif font-bold text-deep text-right">
                                    Rp 0
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="w-full xl:w-[400px] shrink-0 flex flex-col gap-8">
                    
                    <div class="bg-white p-6 border border-deep/5 shadow-elegant">
                        <div class="mb-4 flex items-center justify-between">
                            <span class="input-label mb-0 text-deep">Dokumentasi Visual</span>
                            <div class="h-[1px] flex-1 bg-deep/10 ml-4"></div>
                        </div>

                        <label for="productImages" class="relative flex flex-col items-center justify-center w-full aspect-video bg-linen/20 border border-dashed border-deep/20 cursor-pointer group hover:border-gold transition-all duration-300 overflow-hidden mb-4">
                            <div class="flex flex-col items-center justify-center pt-5 pb-6 text-deep/30 group-hover:text-gold transition-colors">
                                <svg class="w-10 h-10 mb-3 stroke-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                <p class="text-[10px] uppercase tracking-widest font-bold">Pilih Foto</p>
                                <p class="text-[8px] mt-1 font-mono opacity-60">Max 10 files (JPG/PNG)</p>
                            </div>
                            <input type="file" id="productImages" name="productImages" multiple accept="image/png, image/jpeg, image/jpg" class="hidden" onchange="previewImages(this)">
                        </label>

                        <div id="image-preview-container" class="grid grid-cols-4 gap-2 hidden">
                            </div>
                    </div>

                    <div class="bg-white p-6 border border-deep/5 shadow-elegant flex-1">
                        <div class="flex justify-between items-center mb-6">
                            <div class="flex items-center gap-2">
                                <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                                <span class="input-label mb-0 text-deep">Spesifikasi Tumbuh</span>
                            </div>
                            <button type="button" id="add-parameter-btn" class="text-[10px] bg-linen hover:bg-gold hover:text-deep text-deep/60 py-1.5 px-3 uppercase tracking-wider font-bold transition-all flex items-center gap-1 border border-deep/5">
                                + Parameter
                            </button>
                        </div>

                        <div id="parameter-container" class="space-y-4 min-h-[150px]">
                            <div class="placeholder-message text-center py-8 flex flex-col items-center justify-center opacity-40 border border-dashed border-deep/10 bg-linen/10">
                                <p class="text-[10px] uppercase tracking-widest font-bold text-deep">Data Kosong</p>
                                <p class="font-serif italic text-xs mt-1">Belum ada parameter lingkungan.</p>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </form>
    </main>

    <template id="parameter-row-template">
        <div class="parameter-row bg-paper border-l-2 border-gold p-3 shadow-sm relative group animate-fade-in-down">
            <div class="flex justify-between items-start mb-2">
                <div class="w-full mr-2">
                    <select name="paramNama[]" class="param-select w-full bg-transparent border-b border-deep/10 py-1 text-xs font-bold text-deep uppercase tracking-wide focus:border-gold outline-none cursor-pointer">
                        <option value="">-- Pilih Parameter --</option>
                    </select>
                </div>
                <button type="button" class="remove-parameter-btn text-deep/20 hover:text-danger transition-colors" title="Hapus Baris">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>

            <div class="grid grid-cols-2 gap-3 mb-2">
                <div>
                    <span class="text-[9px] text-deep/40 uppercase block mb-1">Min</span>
                    <input type="number" step="any" name="paramMin[]" class="w-full bg-white border border-deep/5 px-2 py-1 text-xs font-mono focus:border-gold outline-none" placeholder="0.0">
                </div>
                <div>
                    <span class="text-[9px] text-deep/40 uppercase block mb-1">Max</span>
                    <input type="number" step="any" name="paramMax[]" class="w-full bg-white border border-deep/5 px-2 py-1 text-xs font-mono focus:border-gold outline-none" placeholder="0.0">
                </div>
            </div>

            <div class="flex justify-between items-center pt-2 border-t border-deep/5">
                <span class="param-unit text-[10px] font-mono text-gold font-bold">Unit: -</span>
                <span class="param-desc text-[9px] text-deep/50 italic truncate max-w-[120px]"></span>
            </div>
        </div>
    </template>

    <script>
        // --- 1. Price Calculator Logic ---
        (function () {
            const hargaInput = document.getElementById('Harga');
            const diskonInput = document.getElementById('Diskon');
            const pricePreview = document.getElementById('final-price-preview');
            const formatter = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 });

            function updatePricePreview() {
                const harga = parseFloat(hargaInput.value) || 0;
                let diskonPersen = parseFloat(diskonInput.value);
                
                if (isNaN(diskonPersen)) diskonPersen = 0;
                if (diskonPersen < 0) diskonPersen = 0;
                if (diskonPersen > 100) diskonPersen = 100;

                const diskonNilai = harga * (diskonPersen / 100);
                const hargaAkhir = Math.max(0, harga - diskonNilai);
                
                pricePreview.textContent = formatter.format(hargaAkhir);
            }

            hargaInput.addEventListener('input', updatePricePreview);
            diskonInput.addEventListener('input', updatePricePreview);
            updatePricePreview();
        })();

        // --- 2. Image Preview Logic (Grid) ---
        function previewImages(input) {
            const container = document.getElementById('image-preview-container');
            container.innerHTML = ''; // Clear previous
            
            if (input.files && input.files.length > 0) {
                container.classList.remove('hidden');
                
                Array.from(input.files).forEach(file => {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        const div = document.createElement('div');
                        div.className = 'relative aspect-square bg-deep/5 overflow-hidden border border-deep/10';
                        div.innerHTML = `<img src="${e.target.result}" class="w-full h-full object-cover">`;
                        container.appendChild(div);
                    }
                    reader.readAsDataURL(file);
                });
            } else {
                container.classList.add('hidden');
            }
        }

        // --- 3. Dynamic Parameters Logic ---
        (function() {
            const parameterDetails = {
                'Suhu Rata-rata': { unit: '°C', desc: 'Temperatur udara rata-rata.' },
                'Kelembaban Relatif': { unit: '%', desc: 'Persentase uap air di udara.' },
                'Curah Hujan': { unit: 'mm', desc: 'Jumlah hujan harian.' },
                'Kecepatan Angin': { unit: 'm/s', desc: 'Kecepatan angin permukaan.' },
                'Radiasi Matahari': { unit: 'MJ/m²/day', desc: 'Energi radiasi harian.' },
                'Evapotranspirasi': { unit: 'mm/day', desc: 'Penguapan tanah & tanaman.' },
                'Suhu Tanah (0-7cm)': { unit: '°C', desc: 'Temperatur tanah atas.' },
                'Kelembaban Tanah': { unit: 'm³/m³', desc: 'Air tanah lapisan atas.' },
                'pH Tanah': { unit: 'pH', desc: 'Tingkat keasaman tanah.' },
                'Kandungan Organik': { unit: '%', desc: 'Bahan organik tanah.' }
            };
            const predefinedParameters = Object.keys(parameterDetails);
            const container = document.getElementById('parameter-container');
            const addButton = document.getElementById('add-parameter-btn');
            const template = document.getElementById('parameter-row-template');
            const placeholder = container.querySelector('.placeholder-message');

            function getSelectedValues() {
                const selects = container.querySelectorAll('.param-select');
                const values = new Set();
                selects.forEach(s => { if (s.value) values.add(s.value); });
                return values;
            }

            function populateDropdown(selectElement, selectedValue = '') {
                selectElement.innerHTML = '<option value="">-- Pilih --</option>';
                const selectedValues = getSelectedValues();
                
                predefinedParameters.forEach(paramName => {
                    const option = document.createElement('option');
                    option.value = paramName;
                    option.textContent = paramName;
                    if (paramName === selectedValue) option.selected = true;
                    if (selectedValues.has(paramName) && paramName !== selectedValue) {
                        option.disabled = true;
                        option.innerText += ' (Dipilih)';
                    }
                    selectElement.appendChild(option);
                });
            }

            function updateAllDropdowns() {
                const selectedValues = getSelectedValues();
                const allSelects = container.querySelectorAll('.param-select');
                allSelects.forEach(select => {
                    const currentValue = select.value;
                    Array.from(select.options).forEach(option => {
                        if (!option.value) return;
                        if (option.value !== currentValue && selectedValues.has(option.value)) {
                            option.disabled = true;
                            if(!option.innerText.includes('(Dipilih)')) option.innerText += ' (Dipilih)';
                        } else {
                            option.disabled = false;
                            option.innerText = option.value;
                        }
                    });
                });
                
                if(getSelectedValues().size >= predefinedParameters.length) {
                    addButton.classList.add('opacity-50', 'cursor-not-allowed');
                    addButton.disabled = true;
                } else {
                    addButton.classList.remove('opacity-50', 'cursor-not-allowed');
                    addButton.disabled = false;
                }
            }

            function updateParameterInfo(rowElement, selectedValue) {
                const unitElement = rowElement.querySelector('.param-unit');
                const descElement = rowElement.querySelector('.param-desc');
                const details = parameterDetails[selectedValue];

                if (details) {
                    if (unitElement) unitElement.textContent = `Unit: ${details.unit}`;
                    if (descElement) descElement.textContent = details.desc;
                } else {
                    if (unitElement) unitElement.textContent = 'Unit: -';
                    if (descElement) descElement.textContent = '';
                }
            }

            function addParamRow(selectedValue = '') {
                if (placeholder) placeholder.style.display = 'none';
                
                const clone = template.content.cloneNode(true);
                const newRow = clone.querySelector('.parameter-row');
                const selectElement = newRow.querySelector('.param-select');
                const removeButton = newRow.querySelector('.remove-parameter-btn');

                populateDropdown(selectElement, selectedValue);
                updateParameterInfo(newRow, selectedValue);

                selectElement.addEventListener('change', (e) => {
                    updateAllDropdowns();
                    updateParameterInfo(newRow, e.target.value);
                });

                removeButton.addEventListener('click', (e) => {
                    newRow.remove();
                    updateAllDropdowns();
                    if (container.querySelectorAll('.parameter-row').length === 0 && placeholder) {
                        placeholder.style.display = 'flex';
                    }
                });

                container.appendChild(clone);
                updateAllDropdowns();
            }

            addButton.addEventListener('click', () => { addParamRow(); });
        })();

        // --- 4. Submit Loading State ---
        document.getElementById('product-form').addEventListener('submit', function(e) {
            const btn = document.getElementById('btn-submit');
            btn.style.width = `${btn.offsetWidth}px`;
            btn.disabled = true;
            btn.innerHTML = `<svg class="animate-spin h-4 w-4 text-deep mx-auto" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>`;
            btn.classList.add('opacity-75', 'cursor-not-allowed', 'bg-gold', 'text-deep', 'border-gold');
            btn.classList.remove('bg-deep', 'text-gold');
        });
    </script>
</body>
</html>