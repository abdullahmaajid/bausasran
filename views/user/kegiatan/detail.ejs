<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= kegiatan.Judul %> - Detail Kegiatan</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        main: '#003024',    // Background Gelap
                        surface: '#004030', // Warna Kartu
                        accent: '#83C540',  // Hijau Neon
                        pale: '#F5FEF9',    // Teks Putih
                        muted: '#A3C2B8',   // Teks Pudar
                    },
                    fontFamily: { sans: ['Inter', 'sans-serif'] }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer base { 
            body { @apply bg-main text-pale font-sans antialiased; } 
            /* Custom Scrollbar */
            .custom-scroll::-webkit-scrollbar { width: 8px; }
            .custom-scroll::-webkit-scrollbar-track { @apply bg-main; }
            .custom-scroll::-webkit-scrollbar-thumb { @apply bg-surface border border-white/10 rounded-full hover:bg-accent/50; }
        }
    </style>
</head>
<body class="flex h-screen overflow-hidden">

    <%- include('../../partials/user_sidebar.ejs') %>

    <main class="flex-1 overflow-y-auto custom-scroll p-6 md:p-10 relative">
        
        <div class="fixed top-0 right-0 w-[500px] h-[500px] bg-accent/5 rounded-full blur-[100px] pointer-events-none -z-10"></div>

        <%- include('../../partials/flash.ejs') %>

        <div class="mb-8">
            <a href="/user/kegiatan" class="inline-flex items-center text-muted hover:text-accent transition-colors duration-300 group">
                <div class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center mr-3 group-hover:bg-accent group-hover:text-main transition-all border border-white/5 group-hover:border-accent">
                    <svg class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                    </svg>
                </div>
                <span class="font-semibold text-sm">Kembali ke Daftar Kegiatan</span>
            </a>
        </div>

        <div class="max-w-5xl mx-auto shadow-2xl">
            
            <div class="bg-surface border border-white/5 rounded-t-3xl p-8 md:p-12 relative overflow-hidden">
                <div class="absolute top-0 right-0 p-10 opacity-10 pointer-events-none">
                    <svg class="w-64 h-64 text-accent" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"></path></svg>
                </div>

                <div class="relative z-10">
                    <div class="flex flex-wrap items-center gap-3 mb-6">
                        <% if (kegiatan.Status === 'Upcoming') { %>
                            <span class="inline-flex items-center px-4 py-1.5 rounded-full text-sm font-bold bg-accent text-main shadow-[0_0_15px_rgba(131,197,64,0.4)]">
                                <span class="w-2 h-2 rounded-full bg-main mr-2 animate-pulse"></span>
                                Akan Datang
                            </span>
                        <% } else { %>
                            <span class="inline-flex items-center px-4 py-1.5 rounded-full text-sm font-bold bg-white/10 text-muted border border-white/10">
                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                Selesai
                            </span>
                        <% } %>
                        
                        <% if (kegiatan.Kategori && kegiatan.Kategori.length < 20) { %> 
                            <span class="inline-flex items-center px-3 py-1.5 rounded-full text-xs font-semibold bg-white/5 text-pale border border-white/10 tracking-wide uppercase">
                                <%= kegiatan.Kategori %>
                            </span>
                        <% } %>
                    </div>

                    <h1 class="text-3xl md:text-5xl font-bold text-pale mb-8 leading-tight drop-shadow-sm">
                        <%= kegiatan.Judul %>
                    </h1>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 border-t border-white/10 pt-6">
                        <% if (kegiatan.Tanggal) { %>
                            <div class="flex items-start group">
                                <div class="bg-white/5 p-3 rounded-xl mr-4 group-hover:bg-white/10 transition-colors">
                                    <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                </div>
                                <div>
                                    <p class="text-xs text-muted font-bold uppercase tracking-wider mb-1">Tanggal & Waktu</p>
                                    <p class="text-pale text-lg font-medium">
                                        <%= new Date(kegiatan.Tanggal).toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
                                    </p>
                                </div>
                            </div>
                        <% } %>

                        <% if (kegiatan.Lokasi) { %>
                            <div class="flex items-start group">
                                <div class="bg-white/5 p-3 rounded-xl mr-4 group-hover:bg-white/10 transition-colors">
                                    <svg class="w-6 h-6 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                </div>
                                <div>
                                    <p class="text-xs text-muted font-bold uppercase tracking-wider mb-1">Lokasi</p>
                                    <p class="text-pale text-lg font-medium"><%= kegiatan.Lokasi %></p>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <div class="bg-black/20 border-x border-b border-white/5 rounded-b-3xl p-8 md:p-12">
                
                <% if (kegiatan.Kategori && kegiatan.Kategori.length >= 20) { %>
                    <div class="mb-12">
                        <h2 class="text-xl font-bold text-pale mb-6 flex items-center border-b border-white/5 pb-4">
                            <svg class="w-5 h-5 mr-3 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
                            Detail Kegiatan
                        </h2>
                        <div class="text-muted/90 leading-relaxed whitespace-pre-line bg-surface/50 p-6 rounded-2xl border border-white/5 text-base md:text-lg">
                            <%= kegiatan.Kategori %>
                        </div>
                    </div>
                <% } %>

                <% if (kegiatan.dataValues.fotoFiles && kegiatan.dataValues.fotoFiles.length > 0) { %>
                    <div>
                        <h2 class="text-xl font-bold text-pale mb-6 flex items-center border-b border-white/5 pb-4">
                            <svg class="w-5 h-5 mr-3 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                            Galeri Dokumentasi (<%= kegiatan.dataValues.fotoFiles.length %>)
                        </h2>
                        
                        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                            <% for(let foto of kegiatan.dataValues.fotoFiles) { %>
                                <div class="relative group cursor-pointer aspect-square rounded-xl overflow-hidden border border-white/5 bg-surface" onclick="openLightbox('<%= foto %>')">
                                    <img src="/images/kegiatan/<%= foto %>" 
                                         alt="Foto Kegiatan"
                                         class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700 ease-out">
                                    
                                    <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center backdrop-blur-[2px]">
                                        <div class="bg-accent/20 p-3 rounded-full border border-accent/50 transform scale-50 group-hover:scale-100 transition-transform duration-300">
                                            <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path>
                                            </svg>
                                        </div>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>

    </main>

    <div id="lightbox" class="fixed inset-0 bg-black/95 z-[9999] hidden flex items-center justify-center p-4 backdrop-blur-sm opacity-0 transition-opacity duration-300" onclick="closeLightbox()">
        <div class="relative max-w-5xl w-full flex flex-col items-center">
            
            <button onclick="closeLightbox()" class="absolute -top-12 right-0 md:right-0 text-white/70 hover:text-accent transition-colors p-2">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
            
            <img id="lightbox-img" src="" alt="Preview" class="max-w-full max-h-[85vh] rounded-lg shadow-2xl border border-white/10 transform scale-95 transition-transform duration-300" onclick="event.stopPropagation()">
        </div>
    </div>

    <script>
        const lightbox = document.getElementById('lightbox');
        const img = document.getElementById('lightbox-img');

        function openLightbox(foto) {
            img.src = '/images/kegiatan/' + foto;
            lightbox.classList.remove('hidden');
            // Timeout agar animasi CSS berjalan halus
            setTimeout(() => {
                lightbox.classList.remove('opacity-0');
                img.classList.remove('scale-95');
                img.classList.add('scale-100');
            }, 10);
        }

        function closeLightbox() {
            lightbox.classList.add('opacity-0');
            img.classList.remove('scale-100');
            img.classList.add('scale-95');
            
            setTimeout(() => {
                lightbox.classList.add('hidden');
                img.src = '';
            }, 300);
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeLightbox();
            }
        });
    </script>
</body>
</html>