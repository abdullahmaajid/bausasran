<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Analisis Lahan - Admin Bausasran</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        main: '#003024',    // Background Gelap
                        surface: '#004030', // Warna Kartu
                        accent: '#83C540',  // Hijau Neon
                        pale: '#F5FEF9',    // Teks Putih
                        muted: '#A3C2B8',   // Teks Pudar
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style type="text/tailwindcss">
        @layer base {
            body { @apply bg-main text-pale font-sans antialiased; }
        }
        
        /* Map Styles */
        #map { height: 100%; width: 100%; border-radius: 1rem; z-index: 1; }
        
        /* Range Slider Styling */
        input[type=range] { @apply h-1.5 bg-surface rounded-lg appearance-none cursor-pointer border border-white/10; }
        input[type=range]::-webkit-slider-thumb { @apply appearance-none w-4 h-4 bg-accent rounded-full shadow hover:scale-125 transition-transform; }

        /* Scrollbar */
        .custom-scroll::-webkit-scrollbar { width: 6px; }
        .custom-scroll::-webkit-scrollbar-track { background: transparent; }
        .custom-scroll::-webkit-scrollbar-thumb { background: #004030; border-radius: 10px; border: 1px solid rgba(255,255,255,0.1); }
        .custom-scroll::-webkit-scrollbar-thumb:hover { background: #83C540; }
    </style>
</head>

<body class="flex h-screen overflow-hidden">

    <%- include('../../partials/admin_sidebar.ejs') %>

    <main class="flex-1 flex flex-col h-screen overflow-hidden relative">
        <%- include('../../partials/flash.ejs') %>

        <div class="flex-1 overflow-y-auto custom-scroll p-6 md:p-8">
            
            <div class="flex justify-between items-end mb-6">
                <div>
                    <h1 class="text-2xl font-bold text-pale tracking-tight">Analisis Kecocokan Lahan</h1>
                    <p class="text-muted text-sm mt-1">Pilih lokasi di peta untuk melihat potensi produk.</p>
                </div>
                <a href="/admin/produk/new" class="hidden md:flex items-center gap-2 px-4 py-2 bg-surface hover:bg-white/5 border border-white/10 rounded-lg text-sm font-medium text-accent transition-all">
                    <span>+ Tambah Produk</span>
                </a>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8 h-[500px] lg:h-[450px]">
                
                <div class="lg:col-span-2 relative bg-surface rounded-2xl border border-white/10 shadow-xl overflow-hidden group">
                    <div id="map" class="h-full w-full"></div>
                    
                    <div id="map-loading" class="absolute inset-0 bg-main/80 backdrop-blur-sm z-[400] flex flex-col items-center justify-center hidden">
                        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-accent mb-3"></div>
                        <span class="text-accent text-sm font-medium animate-pulse">Sinkronisasi Satelit...</span>
                    </div>

                    <div class="absolute top-4 left-4 bg-main/90 backdrop-blur px-3 py-1.5 rounded-lg border border-white/10 text-xs font-mono text-accent z-[400] shadow-lg">
                        <span class="w-2 h-2 bg-red-500 rounded-full inline-block mr-2 animate-pulse"></span>Mode Interaktif
                    </div>
                </div>

                <div class="flex flex-col gap-4 h-full">
                    <div class="bg-surface rounded-2xl p-5 border border-white/10 flex-shrink-0">
                        <h3 class="text-sm font-bold text-muted uppercase tracking-wider mb-1">Kondisi Lahan</h3>
                        <p class="text-xs text-white/40" id="location-status">Menunggu pemilihan lokasi...</p>
                    </div>

                    <div id="live-weather-placeholder" class="flex-1 bg-surface rounded-2xl border border-white/10 p-6 flex flex-col items-center justify-center text-center space-y-4">
                        <div class="w-16 h-16 rounded-full bg-white/5 flex items-center justify-center animate-pulse">
                            <svg class="w-8 h-8 text-white/20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                        </div>
                        <p class="text-muted text-sm px-4">Silakan klik titik lokasi pada peta untuk memuat data cuaca real-time.</p>
                    </div>

                    <div id="live-weather-cards" class="flex-1 grid grid-cols-2 gap-3 hidden">
                        <div class="bg-surface rounded-xl p-4 border border-white/10 flex flex-col justify-center items-center relative overflow-hidden group">
                            <div class="absolute top-0 right-0 p-2 opacity-10 group-hover:opacity-20 transition-opacity">
                                <svg class="w-12 h-12 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                            </div>
                            <span class="text-xs text-muted uppercase tracking-wide mb-1">Suhu Rata-rata</span>
                            <span id="live-temp" class="text-2xl font-bold text-accent">-</span>
                        </div>
                        <div class="bg-surface rounded-xl p-4 border border-white/10 flex flex-col justify-center items-center relative overflow-hidden group">
                             <div class="absolute top-0 right-0 p-2 opacity-10 group-hover:opacity-20 transition-opacity">
                                <svg class="w-12 h-12 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
                            </div>
                            <span class="text-xs text-muted uppercase tracking-wide mb-1">Kelembapan</span>
                            <span id="live-humidity" class="text-2xl font-bold text-cyan-400">-</span>
                        </div>
                        <div class="bg-surface rounded-xl p-4 border border-white/10 flex flex-col justify-center items-center relative overflow-hidden group">
                            <span class="text-xs text-muted uppercase tracking-wide mb-1">Curah Hujan</span>
                            <span id="live-precip" class="text-2xl font-bold text-blue-400">-</span>
                        </div>
                         <div class="bg-surface rounded-xl p-4 border border-accent/30 flex flex-col justify-center items-center bg-accent/5">
                            <span class="text-xs text-accent uppercase tracking-wide mb-1 font-semibold">Produk Cocok</span>
                            <span id="live-cocok" class="text-2xl font-bold text-white">-</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="sticky top-0 z-30 bg-main/95 backdrop-blur-md py-4 border-b border-white/5 mb-6">
                <div class="flex flex-col md:flex-row gap-4 items-center justify-between">
                    
                    <div class="relative w-full md:w-64">
                        <input type="text" id="filter-search" placeholder="Cari produk..." 
                            class="w-full bg-surface border border-white/10 rounded-lg pl-9 pr-3 py-2 text-sm text-pale focus:border-accent focus:ring-1 focus:ring-accent outline-none placeholder-white/20 transition-all">
                        <svg class="w-4 h-4 text-white/30 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    </div>

                    <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
                        
                        <div class="bg-surface px-3 py-1.5 rounded-lg border border-white/10 flex items-center gap-3 flex-1 md:flex-none min-w-[200px]">
                            <label class="text-[10px] text-muted uppercase font-bold whitespace-nowrap">Min. Cocok:</label>
                            <input type="range" id="filter-grade" min="0" max="100" value="0" step="5" class="w-24">
                            <span id="filter-grade-value" class="text-xs font-bold text-accent w-8 text-right">0%</span>
                        </div>

                        <select id="filter-category" class="bg-surface border border-white/10 rounded-lg px-3 py-2 text-sm text-pale focus:border-accent outline-none cursor-pointer hover:bg-white/5 transition-colors">
                            <option value="Semua">Semua Kategori</option>
                            <% categories.forEach(cat => { %>
                                <option value="<%= cat %>"><%= cat %></option>
                            <% }) %>
                        </select>

                        <select id="filter-sort" class="bg-surface border border-white/10 rounded-lg px-3 py-2 text-sm text-pale focus:border-accent outline-none cursor-pointer hover:bg-white/5 transition-colors">
                            <option value="cocok">Kecocokan Tertinggi</option>
                            <option value="nama">Nama (A-Z)</option>
                        </select>
                    </div>
                </div>
            </div>

            <div id="results-list" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4 gap-5 pb-10">
                <div id="initial-message" class="col-span-full py-20 flex flex-col items-center justify-center text-muted opacity-50">
                    <div class="text-6xl mb-4">🌱</div>
                    <h3 class="text-xl font-medium text-pale">Siap Menganalisis</h3>
                    <p class="text-sm mt-2">Pilih lokasi pada peta untuk memulai.</p>
                </div>
            </div>

        </div>
    </main>

    <script>
        const allProductsData = JSON.parse(decodeURIComponent('<%- encodeURIComponent(JSON.stringify(productsWithParams)) %>'));
    </script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="/js/koncoTaniAdmin.js"></script>

    <script>
        // DOM Cache
        const els = {
            loading: document.getElementById('map-loading'),
            resultsList: document.getElementById('results-list'),
            locStatus: document.getElementById('location-status'),
            liveCards: document.getElementById('live-weather-cards'),
            livePlaceholder: document.getElementById('live-weather-placeholder'),
            liveTemp: document.getElementById('live-temp'),
            liveHumidity: document.getElementById('live-humidity'),
            livePrecip: document.getElementById('live-precip'),
            liveCocok: document.getElementById('live-cocok'),
            search: document.getElementById('filter-search'),
            grade: document.getElementById('filter-grade'),
            gradeVal: document.getElementById('filter-grade-value'),
            category: document.getElementById('filter-category'),
            sort: document.getElementById('filter-sort')
        };

        // UI Builder: Create Product Card
        function createCardHTML_UI(product) {
            const passingGrade = parseInt(els.grade.value, 10);
            let isCocok = false;
            let scoreColor = 'bg-red-500';
            
            if (product.paramCount > 0 && currentApiData) {
                isCocok = product.scorePercent >= passingGrade;
                scoreColor = product.scorePercent >= 80 ? 'bg-accent' : (product.scorePercent >= 50 ? 'bg-yellow-500' : 'bg-red-500');
            }

            // Status Badge
            const statusBadge = isCocok 
                ? `<span class="absolute top-3 right-3 bg-accent text-main px-2 py-1 rounded text-[10px] font-bold uppercase shadow-lg z-10">Cocok</span>` 
                : (currentApiData ? `<span class="absolute top-3 right-3 bg-black/50 text-white px-2 py-1 rounded text-[10px] font-bold uppercase backdrop-blur border border-white/10 z-10">Tidak Cocok</span>` : '');

            // Image
            const imgUrl = (product.photos && product.photos.length > 0) 
                ? `/images/produk/${product.photos[0].Foto}` 
                : null;
            
            const imgHTML = imgUrl 
                ? `<img src="${imgUrl}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">`
                : `<div class="w-full h-full bg-surface flex items-center justify-center text-white/20 text-xs">No Image</div>`;

            // Parameters List
            let paramsHTML = '';
            if (product.paramDetails && currentApiData) {
                paramsHTML = product.paramDetails.filter(p => parameterApiMapping && parameterApiMapping[p.Nama]).map(p => {
                    const icon = p.isCocok ? `<span class="text-accent">✓</span>` : `<span class="text-red-400">✕</span>`;
                    return `
                        <div class="flex justify-between items-center py-1.5 border-b border-white/5 last:border-0 text-xs">
                            <span class="text-muted">${p.Nama}</span>
                            <div class="flex items-center gap-2">
                                <span class="text-pale font-mono">${p.actualValue}</span>
                                ${icon}
                            </div>
                        </div>
                    `;
                }).join('');
            }

            // Price
            const price = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(product.Harga || 0);

            return `
                <div class="bg-surface rounded-xl border border-white/10 shadow hover:shadow-2xl hover:border-accent/30 transition-all duration-300 group flex flex-col overflow-hidden h-full">
                    
                    <div class="relative h-40 overflow-hidden border-b border-white/5">
                        ${statusBadge}
                        ${imgHTML}
                        <div class="absolute bottom-0 left-0 w-full bg-gradient-to-t from-surface to-transparent h-12"></div>
                    </div>

                    <div class="p-4 flex flex-col flex-grow">
                        <div class="mb-3">
                            <div class="flex justify-between items-start">
                                <h3 class="font-bold text-pale text-base leading-tight group-hover:text-accent transition-colors line-clamp-1" title="${product.Nama}">${product.Nama}</h3>
                            </div>
                            <span class="text-[10px] text-muted uppercase tracking-wider">${product.Kategori || 'Umum'}</span>
                        </div>

                        <div class="mb-4">
                            <div class="flex justify-between text-[10px] mb-1">
                                <span class="text-white/40">Tingkat Kecocokan</span>
                                <span class="font-bold text-pale">${product.scorePercent ? product.scorePercent.toFixed(0) : 0}%</span>
                            </div>
                            <div class="w-full bg-black/20 rounded-full h-1.5 overflow-hidden">
                                <div class="h-full rounded-full ${scoreColor} transition-all duration-1000" style="width: ${product.scorePercent || 0}%"></div>
                            </div>
                        </div>

                        <div class="flex-grow"></div>

                        <details class="group/details mt-2">
                            <summary class="list-none cursor-pointer flex items-center justify-between text-xs font-medium text-white/50 hover:text-white bg-white/5 rounded px-2 py-1.5 transition-colors">
                                <span>Detail Parameter</span>
                                <svg class="w-3 h-3 transition-transform group-open/details:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                            </summary>
                            <div class="mt-2 bg-black/20 rounded-lg p-2 max-h-32 overflow-y-auto custom-scroll">
                                ${paramsHTML || '<div class="text-[10px] text-center italic text-white/30">Menunggu data...</div>'}
                            </div>
                        </details>
                    </div>
                    
                    <div class="px-4 py-3 bg-black/20 border-t border-white/5 flex justify-between items-center">
                        <span class="text-sm font-bold text-accent">${price}</span>
                        <a href="/admin/produk/${product.ID_Product}" class="text-[10px] text-pale hover:underline opacity-60 hover:opacity-100">Lihat Full →</a>
                    </div>
                </div>
            `;
        }

        // --- Controller Interface ---
        const uiFunctions = {
            showLoadingState: () => {
                els.loading.classList.remove('hidden'); els.loading.classList.add('flex');
                els.liveCards.classList.add('hidden'); els.livePlaceholder.classList.remove('hidden');
                els.locStatus.textContent = "Mengambil data satelit...";
            },
            hideLoadingState: () => {
                els.loading.classList.add('hidden'); els.loading.classList.remove('flex');
            },
            updateLiveCards: (current, units) => {
                els.livePlaceholder.classList.add('hidden');
                els.liveCards.classList.remove('hidden'); els.liveCards.classList.add('grid');
                els.liveTemp.textContent = `${current.temperature_2m ?? '-'}${units?.temperature_2m || '°C'}`;
                els.liveHumidity.textContent = `${current.relative_humidity_2m ?? '-'}${units?.relative_humidity_2m || '%'}`;
                els.livePrecip.textContent = `${current.precipitation ?? '-'}${units?.precipitation || 'mm'}`;
                els.locStatus.textContent = "Data cuaca berhasil dimuat";
            },
            displayResults: (calculatedProducts, passingGrade, totalProducts) => {
                const visible = calculatedProducts.filter(p => p.isVisible);
                const cocokCount = visible.filter(p => p.paramCount > 0 && p.scorePercent >= passingGrade).length;
                els.liveCocok.textContent = cocokCount;
                
                els.resultsList.innerHTML = '';
                if(visible.length === 0) {
                    els.resultsList.innerHTML = `<div class="col-span-full py-10 text-center text-muted border border-white/5 rounded-xl bg-surface/50">Tidak ada produk ditemukan dengan filter ini.</div>`;
                } else {
                    visible.forEach(p => els.resultsList.innerHTML += createCardHTML_UI(p));
                }
            },
            displayInitialState: (msg) => {
                els.resultsList.innerHTML = '';
                const div = document.createElement('div');
                div.className = 'col-span-full py-20 flex flex-col items-center justify-center text-muted opacity-50';
                div.innerHTML = `<div class="text-6xl mb-4">📍</div><h3 class="text-xl text-pale">Lokasi Belum Dipilih</h3><p class="text-sm">${msg || 'Klik peta untuk mulai.'}</p>`;
                els.resultsList.appendChild(div);
            },
            displayError: (msg) => {
                els.resultsList.innerHTML = `<div class="col-span-full text-red-400 text-center py-4 bg-red-500/10 border border-red-500/20 rounded-xl">${msg}</div>`;
            },
            updateFilterGradeValue: (val) => { els.gradeVal.textContent = `${val}%`; },
            getFilterValues: () => ({
                search: els.search.value.toLowerCase(),
                category: els.category.value,
                sort: els.sort.value,
                grade: parseInt(els.grade.value, 10)
            }),
            addMapMarker: () => {}
        };

        document.addEventListener('DOMContentLoaded', () => {
            if (typeof initKoncoTani === 'function') initKoncoTani(uiFunctions);
        });
    </script>
</body>
</html>