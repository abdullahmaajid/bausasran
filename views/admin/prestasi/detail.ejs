<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detail Prestasi: <%= prestasi.Judul %> - Bausasran Heritage</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        paper: '#F9F7F2',       
                        deep: '#0F1F18',        
                        gold: '#C5B388',        
                        charcoal: '#4A4A4A',    
                        linen: '#EBE9E4', 
                        white: '#FFFFFF',
                        danger: '#9B1C1C',      
                    },
                    fontFamily: {
                        sans: ['Lato', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                        crest: ['Cinzel', 'serif'], 
                    },
                    boxShadow: {
                        'elegant': '0 10px 40px -10px rgba(15, 31, 24, 0.05)',
                        'gold-glow': '0 0 15px rgba(197, 179, 136, 0.2)',
                    }
                }
            }
        }
    </script>

    <style type="text/tailwindcss">
        @layer base {
            body { @apply bg-paper text-deep font-sans antialiased selection:bg-deep selection:text-paper; }
        }
        /* TEXTURE: Film Grain */
        .noise-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none; z-index: 50; mix-blend-mode: multiply;
        }

        /* Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #C5B388; border-radius: 3px; }

        /* Components */
        .heritage-card {
            @apply bg-white p-8 border border-deep/5 shadow-elegant relative overflow-hidden transition-all duration-500;
        }
        .btn-heritage {
            @apply px-6 py-3 border border-deep/10 bg-white text-deep text-[10px] font-bold uppercase tracking-widest hover:bg-linen transition-colors flex items-center justify-center gap-2;
        }
    </style>
</head>

<body class="flex h-screen overflow-hidden relative w-full">

    <div class="noise-overlay"></div>

    <%- include('../../partials/admin_sidebar.ejs') %>

    <main class="flex-1 h-full overflow-y-auto overflow-x-hidden p-8 md:p-12 relative z-10">
        <%- include('../../partials/flash.ejs') %>

        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 border-b border-deep/10 pb-8">
            <div class="max-w-3xl">
                <div class="flex items-center gap-3 mb-3">
                    <span class="font-sans text-[10px] uppercase tracking-widest text-gold block">
                        Pencapaian & Penghargaan
                    </span>
                    <span class="h-px w-8 bg-deep/10"></span>
                    <span class="text-[10px] font-bold text-deep/40 font-mono tracking-wider">ID: #<%= prestasi.ID_Prestasi %></span>
                </div>
                
                <h1 class="font-crest text-3xl md:text-4xl text-deep leading-tight flex items-center gap-4">
                    <%= prestasi.Judul %>
                </h1>
            </div>
            
            <div class="mt-6 md:mt-0 flex gap-3">
                <a href="/admin/prestasi" class="btn-heritage">
                    Kembali
                </a>
                
                <form action="/admin/prestasi/<%= prestasi.ID_Prestasi %>/delete" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus data prestasi ini?');">
                    <button type="submit" class="btn-heritage hover:!bg-danger hover:!text-white hover:!border-danger group">
                        <svg class="w-3 h-3 text-danger group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                        <span>Hapus</span>
                    </button>
                </form>

                <a href="/admin/prestasi/<%= prestasi.ID_Prestasi %>/edit" class="btn-heritage !bg-deep !text-white !border-deep hover:!bg-gold hover:!text-deep hover:!border-gold hover:shadow-gold-glow">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                    <span>Edit Data</span>
                </a>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
            
            <div class="lg:col-span-2 flex flex-col gap-8">
                
                <div class="heritage-card">
                    <div class="flex justify-between items-center mb-6 border-b border-deep/5 pb-4">
                        <h2 class="font-crest text-xl text-deep">Dokumentasi & Sertifikat</h2>
                        <span class="text-[10px] text-gold font-bold tracking-widest uppercase"><%= fotoList ? fotoList.length : 0 %> Item</span>
                    </div>

                    <% if (fotoList && fotoList.length > 0) { %>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                            <% fotoList.forEach((foto, index) => { %>
                                <div class="relative group">
                                    <div class="aspect-[4/3] overflow-hidden bg-linen/30 border border-deep/10 shadow-sm relative">
                                        <img src="/images/prestasi/<%= foto.Foto %>" 
                                             alt="Dokumentasi Prestasi" 
                                             class="w-full h-full object-cover  group-hover:-0 transition-all duration-700 ease-out">
                                        
                                        <div class="absolute inset-2 border border-white/20 pointer-events-none z-10"></div>
                                        
                                        <div class="absolute inset-0 bg-deep/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center z-20">
                                            <a href="/images/prestasi/<%= foto.Foto %>" target="_blank" class="px-5 py-2 bg-white text-deep text-[9px] font-bold uppercase tracking-widest hover:bg-gold transition-colors shadow-lg">
                                                Lihat Dokumen
                                            </a>
                                        </div>

                                        <% if (index === 0) { %>
                                            <div class="absolute top-0 left-0 bg-gold text-deep text-[9px] font-bold px-3 py-1.5 z-30 tracking-widest uppercase border-r border-b border-deep/10">
                                                Cover Utama
                                            </div>
                                        <% } %>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="flex flex-col items-center justify-center py-16 text-charcoal/40 bg-linen/10 border border-dashed border-deep/10">
                            <svg class="w-10 h-10 mb-3 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                            <span class="font-serif italic text-sm">Belum ada dokumentasi yang diunggah.</span>
                        </div>
                    <% } %>
                </div>
            </div>

            <div class="lg:col-span-1 space-y-6">
                
                <div class="heritage-card !p-0">
                    <div class="bg-deep p-8 text-paper relative overflow-hidden">
                        <div class="absolute -top-4 -right-4 opacity-10 rotate-12">
                            <svg class="w-32 h-32 text-gold" fill="currentColor" viewBox="0 0 24 24"><path d="M19 5h-2V3H7v2H5c-1.1 0-2 .9-2 2v1c0 2.55 1.92 4.63 4.39 4.94.63 1.5 1.98 2.63 3.61 2.96V19H7v2h10v-2h-4v-3.1c1.63-.33 2.98-1.46 3.61-2.96C19.08 12.63 21 10.55 21 8V7c0-1.1-.9-2-2-2zM7 8c0-1.66 1.34-3 3-3v5c-1.66 0-3-1.34-3-2zm10 0c0 1.66-1.34 3-3 3V5c1.66 0 3 1.34 3 3z"/></svg>
                        </div>
                        
                        <h3 class="font-sans text-[10px] text-gold uppercase tracking-[0.2em] mb-4 relative z-10">Tanggal Diraih</h3>
                        
                        <div class="relative z-10">
                            <p class="font-serif text-4xl italic leading-none mb-2 text-white">
                                <%= new Date(prestasi.Tanggal).getDate() %>
                            </p>
                            <div class="w-12 h-px bg-gold/50 mb-2"></div>
                            <p class="font-crest text-lg uppercase tracking-wide">
                                <%= new Date(prestasi.Tanggal).toLocaleDateString('id-ID', { month: 'long', year: 'numeric' }) %>
                            </p>
                            <p class="text-[10px] font-bold uppercase tracking-widest mt-1 opacity-60">
                                <%= new Date(prestasi.Tanggal).toLocaleDateString('id-ID', { weekday: 'long' }) %>
                            </p>
                        </div>
                    </div>

                    <div class="p-8 bg-white space-y-8">
                        <div>
                            <span class="text-[9px] text-charcoal/50 font-bold uppercase tracking-widest mb-3 block flex items-center gap-2">
                                <span class="w-1 h-1 bg-gold rounded-full"></span> Kategori / Tingkat
                            </span>
                            <p class="font-crest text-deep text-lg leading-relaxed border-l-2 border-gold/30 pl-4">
                                <%= prestasi.Kategori || 'Umum' %>
                            </p>
                        </div>

                        <div>
                            <span class="text-[9px] text-charcoal/50 font-bold uppercase tracking-widest mb-3 block flex items-center gap-2">
                                <span class="w-1 h-1 bg-gold rounded-full"></span> Judul Penghargaan
                            </span>
                            <p class="font-serif italic text-deep/80 text-sm leading-relaxed pl-4">
                                "<%= prestasi.Judul %>"
                            </p>
                        </div>

                        <div class="pt-6 border-t border-deep/5">
                            <div class="flex items-center gap-3 opacity-60">
                                <svg class="w-4 h-4 text-deep" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                <span class="text-[10px] font-bold uppercase tracking-widest text-deep">Terverifikasi Sistem</span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </main>
</body>
</html>