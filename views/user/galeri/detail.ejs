<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= groupFoto.Nama || 'Album' %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="flex bg-gray-100">

    <%- include('../../partials/user_sidebar.ejs') %>

    <main class="flex-1 p-10">
        <%- include('../../partials/flash.ejs') %>

        <div class="mb-6">
            <a href="/user/galeri" class="text-blue-500 hover:text-blue-700 font-semibold">
                ← Kembali ke Galeri
            </a>
        </div>

        <div class="bg-white rounded-lg shadow-lg p-8">
            <!-- Header -->
            <div class="border-b pb-6 mb-6">
                <h1 class="text-4xl font-bold text-gray-800 mb-2">
                    <%= groupFoto.Nama || 'Album Tanpa Nama' %>
                </h1>
                <p class="text-gray-600">
                    Total <%= groupFoto.dataValues.fotoFiles.length %> foto dalam album ini
                </p>
            </div>

            <!-- Grid Foto -->
            <% if (groupFoto.dataValues.fotoFiles && groupFoto.dataValues.fotoFiles.length > 0) { %>
                <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                    <% for(let foto of groupFoto.dataValues.fotoFiles) { %>
                        <div class="relative group cursor-pointer" onclick="openLightbox('<%= foto.Foto %>')">
                            <img src="/images/galeri/<%= foto.Foto %>" 
                                 alt="Foto Galeri"
                                 class="w-full h-48 object-cover rounded-lg border-2 border-gray-200 hover:border-purple-400 transition-all shadow-md hover:shadow-xl">
                            <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-40 transition-all rounded-lg flex items-center justify-center">
                                <svg class="w-10 h-10 text-white opacity-0 group-hover:opacity-100 transition-all transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path>
                                </svg>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } else { %>
                <div class="text-center py-12">
                    <svg class="mx-auto h-16 w-16 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"></path>
                    </svg>
                    <p class="mt-4 text-gray-500 text-lg">Album ini belum memiliki foto.</p>
                </div>
            <% } %>
        </div>
    </main>

    <!-- Lightbox Modal -->
    <div id="lightbox" class="fixed inset-0 bg-black bg-opacity-95 z-50 hidden items-center justify-center p-4" onclick="closeLightbox()">
        <div class="relative max-w-6xl w-full">
            <!-- Close Button -->
            <button onclick="closeLightbox()" class="absolute -top-12 right-0 text-white text-4xl font-bold hover:text-gray-300 transition-colors z-10">
                ×
            </button>
            
            <!-- Image Container -->
            <div class="flex items-center justify-center">
                <img id="lightbox-img" src="" alt="Preview" class="max-w-full max-h-screen rounded-lg shadow-2xl">
            </div>
            
            <!-- Navigation Arrows -->
            <button onclick="prevImage(event)" class="absolute left-4 top-1/2 transform -translate-y-1/2 text-white text-5xl font-bold hover:text-gray-300 transition-colors bg-black bg-opacity-50 rounded-full w-14 h-14 flex items-center justify-center">
                ‹
            </button>
            <button onclick="nextImage(event)" class="absolute right-4 top-1/2 transform -translate-y-1/2 text-white text-5xl font-bold hover:text-gray-300 transition-colors bg-black bg-opacity-50 rounded-full w-14 h-14 flex items-center justify-center">
                ›
            </button>
            
            <!-- Image Counter -->
            <div class="absolute bottom-4 left-1/2 transform -translate-x-1/2 text-white bg-black bg-opacity-75 px-4 py-2 rounded-full text-sm font-semibold">
                <span id="current-index">1</span> / <span id="total-images"><%= groupFoto.dataValues.fotoFiles.length %></span>
            </div>
        </div>
    </div>

    <script>
        const fotoList = [
            <% for(let foto of groupFoto.dataValues.fotoFiles) { %>
                '<%= foto.Foto %>',
            <% } %>
        ];
        
        let currentIndex = 0;

        function openLightbox(foto) {
            currentIndex = fotoList.indexOf(foto);
            updateLightboxImage();
            const lightbox = document.getElementById('lightbox');
            lightbox.classList.remove('hidden');
            lightbox.classList.add('flex');
        }

        function closeLightbox() {
            const lightbox = document.getElementById('lightbox');
            lightbox.classList.add('hidden');
            lightbox.classList.remove('flex');
        }

        function prevImage(event) {
            event.stopPropagation();
            currentIndex = (currentIndex - 1 + fotoList.length) % fotoList.length;
            updateLightboxImage();
        }

        function nextImage(event) {
            event.stopPropagation();
            currentIndex = (currentIndex + 1) % fotoList.length;
            updateLightboxImage();
        }

        function updateLightboxImage() {
            const img = document.getElementById('lightbox-img');
            img.src = '/images/galeri/' + fotoList[currentIndex];
            document.getElementById('current-index').textContent = currentIndex + 1;
        }

        // Keyboard navigation
        document.addEventListener('keydown', function(e) {
            const lightbox = document.getElementById('lightbox');
            if (!lightbox.classList.contains('hidden')) {
                if (e.key === 'Escape') {
                    closeLightbox();
                } else if (e.key === 'ArrowLeft') {
                    prevImage(e);
                } else if (e.key === 'ArrowRight') {
                    nextImage(e);
                }
            }
        });
    </script>
</body>
</html>
