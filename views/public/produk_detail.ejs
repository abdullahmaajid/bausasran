<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= produk.Nama %> - Bausasran Heritage</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

    <script src="https://cdn.jsdelivr.net/gh/studio-freight/lenis@1.0.29/bundled/lenis.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        paper: '#F9F7F2',       // Cream Background
                        deep: '#0F1F18',        // Dark Green (Primary)
                        gold: '#C5B388',        // Luxury Accent
                        charcoal: '#4A4A4A',    // Text
                        sand: '#E5E0D8',        // Border/Secondary
                        white: '#FFFFFF',
                        danger: '#8B0000',
                    },
                    fontFamily: {
                        sans: ['Lato', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                        crest: ['Cinzel', 'serif'], 
                    },
                    letterSpacing: {
                        'luxury': '0.2em',
                        'widest': '0.3em',
                    },
                    boxShadow: {
                        'elegant': '0 10px 40px -10px rgba(15, 31, 24, 0.05)',
                        'sharp': '5px 5px 0px 0px rgba(197, 179, 136, 0.3)',
                    }
                }
            }
        }
    </script>

    <style type="text/tailwindcss">
        @layer base {
            body {
                @apply bg-paper text-deep font-sans antialiased selection:bg-deep selection:text-paper;
                overscroll-behavior: none; 
            }
            h1, h2, h3, h4 {
                @apply font-crest text-deep;
            }
            p {
                @apply font-serif text-charcoal/80 leading-relaxed;
            }
        }
        
        /* TEXTURE OVERLAY */
        .noise-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none; z-index: 9999; mix-blend-mode: multiply;
        }

        /* MAP FIXES */
        #map { z-index: 1; background: #E5E0D8; }
        .leaflet-container { font-family: 'Lato', sans-serif !important; z-index: 10; }
        .custom-scroll::-webkit-scrollbar { width: 3px; }
        .custom-scroll::-webkit-scrollbar-track { background: transparent; }
        .custom-scroll::-webkit-scrollbar-thumb { background: #C5B388; }
    </style>
</head>

<body class="flex flex-col min-h-screen relative">

    <div class="noise-overlay"></div>

    <%- include('../partials/navbar.ejs') %>

    <main class="flex-grow pt-40 pb-24 px-6 relative z-10">
        <%- include('../partials/flash.ejs') %>

        <div class="max-w-7xl mx-auto">
            
            <nav class="flex mb-8 animate-[fadeIn_1s]" aria-label="Breadcrumb">
                <ol class="inline-flex items-center space-x-2 md:space-x-3 font-sans text-[10px] uppercase tracking-widest">
                    <li class="inline-flex items-center">
                        <a href="/" class="text-deep/40 hover:text-gold transition-colors">Home</a>
                    </li>
                    <li><span class="text-deep/20">/</span></li>
                    <li>
                        <a href="/produk" class="text-deep/40 hover:text-gold transition-colors">Produk</a>
                    </li>
                    <li><span class="text-deep/20">/</span></li>
                    <li aria-current="page">
                        <span class="text-deep font-bold truncate max-w-[200px]"><%= produk.Nama %></span>
                    </li>
                </ol>
            </nav>

            <header class="mb-12 animate-[fadeIn_1.2s]">
                <div class="flex flex-wrap items-center gap-4 mb-4">
                    <% if (produk.Kategori) { %>
                        <span class="inline-block px-3 py-1 text-[9px] font-bold uppercase tracking-widest border bg-gold text-paper border-gold">
                            <%= produk.Kategori %>
                        </span>
                    <% } %>
                    <span class="inline-block px-3 py-1 text-[9px] font-bold uppercase tracking-widest border border-deep/20 text-deep/60">
                        Stok Tersedia
                    </span>
                </div>
                <h1 class="text-4xl md:text-6xl text-deep leading-tight mb-2"><%= produk.Nama %></h1>
            </header>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
                
                <div class="lg:col-span-8 space-y-12 animate-[fadeIn_1.5s]">
                    
                    <div class="space-y-4">
                        <div class="relative w-full aspect-video bg-sand/20 p-2 border border-deep/5">
                            <div class="w-full h-full relative overflow-hidden group">
                                <% if (fotoFiles && fotoFiles.length > 0) { %>
                                    <img id="mainImage"
                                         src="/images/produk/<%= fotoFiles[0] %>" 
                                         alt="<%= produk.Nama %>" 
                                         class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
                                         onerror="this.onerror=null;this.src='https://via.placeholder.com/800x600?text=Bausasran+Heritage'">
                                <% } else { %>
                                    <div class="w-full h-full flex items-center justify-center bg-sand/10 text-deep/20">
                                        <span class="font-crest text-4xl">Image Not Available</span>
                                    </div>
                                <% } %>
                                <div class="absolute inset-0 bg-gradient-to-t from-deep/20 to-transparent opacity-60 pointer-events-none"></div>
                            </div>
                        </div>

                        <% if (fotoFiles && fotoFiles.length > 1) { %>
                            <div class="flex gap-3 overflow-x-auto pb-2 scrollbar-hide">
                                <% fotoFiles.forEach((foto, index) => { %>
                                    <div class="w-20 h-20 shrink-0 cursor-pointer border border-transparent hover:border-gold p-0.5 transition-all"
                                         onclick="document.getElementById('mainImage').src = '/images/produk/<%= foto %>'">
                                        <img src="/images/produk/<%= foto %>" class="w-full h-full object-cover opacity-80 hover:opacity-100">
                                    </div>
                                <% }) %>
                            </div>
                        <% } %>
                    </div>

                    <div class="prose prose-lg max-w-none text-charcoal/80">
                        <h3 class="text-2xl mb-4 pb-4 border-b border-deep/10 relative inline-block">
                            Tentang Produk
                            <span class="absolute bottom-0 left-0 w-1/3 h-[2px] bg-gold"></span>
                        </h3>
                        <div class="font-serif leading-loose whitespace-pre-line text-lg text-justify">
                            <%= produk.Deskripsi || 'Tidak ada deskripsi detail untuk produk ini.' %>
                        </div>
                    </div>

                    <div>
                        <h3 class="text-2xl mb-6 flex items-center gap-3">
                            <span class="text-gold">✦</span> Simulasi Lahan
                        </h3>
                        
                        <div class="bg-paper border border-deep/5 p-1 relative shadow-sm">
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-0 md:gap-4 bg-sand/10 p-4">
                                <div class="md:col-span-2 relative h-[400px] border border-deep/10 bg-white">
                                    <div id="map" class="h-full w-full"></div>
                                    <div id="map-loading" class="absolute inset-0 bg-paper/90 backdrop-blur-sm z-[1000] flex flex-col items-center justify-center hidden">
                                        <div class="w-8 h-8 border-2 border-deep border-t-gold rounded-full animate-spin mb-3"></div>
                                        <span class="text-[9px] font-bold uppercase tracking-widest text-deep animate-pulse">Analisis Satelit...</span>
                                    </div>
                                </div>

                                <div class="md:col-span-1 flex flex-col h-[400px] border-l border-deep/5 pl-0 md:pl-4 pt-4 md:pt-0">
                                    <div id="live-weather-container" class="hidden mb-4 pb-4 border-b border-deep/10">
                                        <div class="grid grid-cols-2 gap-2">
                                            <div class="text-center bg-white p-2 border border-deep/5">
                                                <div class="font-crest text-lg text-deep" id="val-temp">-</div>
                                                <div class="text-[8px] uppercase tracking-widest text-deep/40 mt-1">Suhu</div>
                                            </div>
                                            <div class="text-center bg-white p-2 border border-deep/5">
                                                <div class="font-crest text-lg text-deep" id="val-rain">-</div>
                                                <div class="text-[8px] uppercase tracking-widest text-deep/40 mt-1">Hujan</div>
                                            </div>
                                        </div>
                                    </div>

                                    <div id="analysis-result-container" class="flex-grow flex flex-col relative overflow-hidden bg-white p-3 border border-deep/5">
                                        <div id="initial-instruction" class="flex flex-col items-center justify-center h-full text-center opacity-40">
                                            <svg class="w-8 h-8 mb-2 text-deep/30" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                            <p class="text-[10px] font-serif italic uppercase tracking-wider">Pilih Lokasi</p>
                                        </div>
                                        
                                        <div id="result-content" class="hidden h-full flex flex-col">
                                            <div id="result-badge" class="mb-3 text-center p-2 border bg-paper">
                                                </div>
                                            <div class="flex-grow overflow-y-auto custom-scroll pr-1" id="parameter-detail-list">
                                                </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="reviews">
                        <div class="flex items-center justify-between mb-8 pb-4 border-b border-deep/10">
                            <h3 class="text-2xl">Ulasan Pembeli</h3>
                            <div class="flex items-center gap-2">
                                <span class="text-3xl font-serif text-deep"><%= avgRating %></span>
                                <div class="flex text-gold text-xs">
                                    <% for(let i=1; i<=5; i++) { %>
                                        <span class="<%= i <= Math.round(avgRating) ? 'opacity-100' : 'opacity-30' %>">★</span>
                                    <% } %>
                                </div>
                                <span class="text-[10px] uppercase tracking-widest text-deep/40 ml-2">Based on <%= totalReview %> reviews</span>
                            </div>
                        </div>

                        <% if (reviewList && reviewList.length > 0) { %>
                            <div class="grid gap-6">
                                <% reviewList.forEach(review => { %>
                                    <div class="bg-white border border-deep/5 p-6 shadow-sm hover:shadow-elegant transition-all duration-300 relative group">
                                        <div class="absolute top-4 right-6 text-6xl font-serif text-deep/5 select-none">”</div>
                                        
                                        <div class="flex items-center gap-4 mb-4 relative z-10">
                                            <div class="w-10 h-10 rounded-full bg-sand/30 flex items-center justify-center text-deep font-serif italic border border-deep/10">
                                                <%= review.dataValues.pengguna ? review.dataValues.pengguna.Nama.charAt(0) : '?' %>
                                            </div>
                                            <div>
                                                <h4 class="font-sans font-bold text-sm text-deep uppercase tracking-wide">
                                                    <%= review.dataValues.pengguna ? review.dataValues.pengguna.Nama : 'Anonymous' %>
                                                </h4>
                                                <div class="flex text-gold text-[10px] gap-0.5 mt-1">
                                                    <% for(let i=1; i<=5; i++) { %>
                                                        <span class="<%= i <= review.Rating ? 'opacity-100' : 'opacity-20' %>">★</span>
                                                    <% } %>
                                                </div>
                                            </div>
                                            <span class="ml-auto text-[10px] text-deep/30 font-serif italic relative z-10">
                                                <%= new Date(review.createdAt).toLocaleDateString() %>
                                            </span>
                                        </div>
                                        <p class="text-charcoal/70 italic text-sm relative z-10">"<%= review.Ulasan %>"</p>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="bg-sand/10 border border-dashed border-deep/10 p-8 text-center rounded-sm">
                                <p class="text-deep/40 font-serif italic text-sm">Belum ada ulasan tertulis. Jadilah yang pertama memberikan kesan.</p>
                            </div>
                        <% } %>
                    </div>

                </div>

                <div class="lg:col-span-4 animate-[fadeIn_1.8s]">
                    <div class="sticky top-32 space-y-6">
                        
                        <div class="bg-white border border-deep/10 p-8 shadow-elegant relative overflow-hidden">
                            <div class="absolute top-0 left-0 w-full h-1 bg-gold"></div>
                            
                            <h3 class="text-xl mb-6">Informasi Produk</h3>
                            
                            <ul class="space-y-6">
                                <li class="flex items-start gap-4">
                                    <div class="w-8 h-8 flex items-center justify-center text-deep/40 border border-deep/10 rounded-full shrink-0">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                    </div>
                                    <div>
                                        <span class="block text-[9px] uppercase tracking-widest text-deep/40 mb-1">Harga</span>
                                        <span class="font-crest text-deep text-2xl leading-tight block">
                                            Rp <%= new Intl.NumberFormat('id-ID').format(produk.Harga) %>
                                        </span>
                                    </div>
                                </li>

                                <li class="flex items-start gap-4">
                                    <div class="w-8 h-8 flex items-center justify-center text-deep/40 border border-deep/10 rounded-full shrink-0">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path></svg>
                                    </div>
                                    <div>
                                        <span class="block text-[9px] uppercase tracking-widest text-deep/40 mb-1">Kategori</span>
                                        <span class="font-serif text-deep text-lg leading-tight block">
                                            <%= produk.Kategori || '-' %>
                                        </span>
                                    </div>
                                </li>

                                <li class="flex items-start gap-4">
                                    <div class="w-8 h-8 flex items-center justify-center text-deep/40 border border-deep/10 rounded-full shrink-0">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path></svg>
                                    </div>
                                    <div>
                                        <span class="block text-[9px] uppercase tracking-widest text-deep/40 mb-1">Rating</span>
                                        <span class="font-serif text-deep text-lg leading-tight block">
                                            <%= avgRating %> <span class="text-sm text-deep/40 italic">/ 5.0</span>
                                        </span>
                                    </div>
                                </li>
                            </ul>
                        </div>

                        <div class="space-y-3">
                            <a href="https://wa.me/62812345678?text=Halo, saya tertarik dengan produk <%= encodeURIComponent(produk.Nama) %>" 
                               target="_blank"
                               class="block w-full py-4 bg-deep text-paper text-[10px] uppercase tracking-widest font-bold text-center border border-deep hover:bg-gold hover:border-gold hover:text-deep transition-all duration-300 shadow-sharp group">
                                <span class="group-hover:mr-2 transition-all duration-300">Hubungi Penjual</span>
                            </a>

                            <% if (currentUser && currentUser.Role === 'User') { %>
                                <a href="/user/testimoni/tambah" class="block w-full py-4 bg-white text-deep text-[10px] uppercase tracking-widest font-bold text-center border border-deep/20 hover:border-deep transition-all duration-300">
                                    Tulis Ulasan
                                </a>
                            <% } else if (!currentUser) { %>
                                <a href="/login?returnTo=/produk/<%= produk.ID_Product %>" class="block w-full py-4 bg-white text-deep text-[10px] uppercase tracking-widest font-bold text-center border border-deep/20 hover:border-deep transition-all duration-300">
                                    Login untuk Review
                                </a>
                            <% } %>
                            
                            <a href="/produk" class="block w-full py-3 text-center text-[10px] uppercase tracking-widest text-deep/40 hover:text-deep transition-colors">
                                ← Kembali ke Daftar
                            </a>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </main>

    <%- include('../partials/footer.ejs') %>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="/js/koncoTaniAdmin.js"></script>

    <script>
        // 1. SMOOTH SCROLL
        const lenis = new Lenis({ duration: 1.2, easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), direction: 'vertical', smooth: true });
        function raf(time) { lenis.raf(time); requestAnimationFrame(raf); }
        requestAnimationFrame(raf);

        // 2. KONCOTANI INTEGRATION (Map Logic)
        const productData = JSON.parse(decodeURIComponent('<%- encodeURIComponent(JSON.stringify(produk)) %>'));

        // Define UI handlers to bridge logic to this Heritage UI
        const detailUiFunctions = {
            showLoadingState: () => {
                document.getElementById('map-loading').classList.remove('hidden');
            },
            hideLoadingState: () => {
                document.getElementById('map-loading').classList.add('hidden');
            },
            updateLiveCards: (current, units) => {
                document.getElementById('live-weather-container').classList.remove('hidden');
                document.getElementById('val-temp').innerText = (current.temperature_2m || '-') + '°';
                document.getElementById('val-rain').innerText = (current.precipitation || '0') + 'mm';
            },
            displayResults: (products, grade, total) => {
                if(!products.length) return;
                const p = products[0];
                const instruction = document.getElementById('initial-instruction');
                const content = document.getElementById('result-content');
                const badge = document.getElementById('result-badge');
                const paramList = document.getElementById('parameter-detail-list');

                instruction.classList.add('hidden');
                content.classList.remove('hidden');

                const isCocok = p.scorePercent >= 50; 
                badge.className = `mb-3 text-center p-2 border ${isCocok ? 'border-deep/10 bg-deep/5' : 'border-danger/10 bg-red-50'}`;
                
                badge.innerHTML = `
                    <div class="font-crest text-sm ${isCocok ? 'text-deep' : 'text-danger'}">
                        ${isCocok ? 'Lahan Cocok' : 'Kurang Cocok'}
                    </div>
                    <div class="text-[8px] uppercase tracking-widest text-deep/50 mt-1">
                        Score: ${Math.round(p.scorePercent)}%
                    </div>
                `;

                if (p.paramDetails && p.paramDetails.length > 0) {
                    paramList.innerHTML = p.paramDetails.map(param => `
                        <div class="flex justify-between items-center py-2 border-b border-deep/5 last:border-0 hover:bg-black/5 transition-colors px-1">
                            <div>
                                <span class="block font-bold text-[10px] text-deep uppercase tracking-wider">${param.Nama}</span>
                                <span class="text-[9px] text-deep/40 font-serif italic">Range: ${param.Minimal}-${param.Maksimal}</span>
                            </div>
                            <div class="text-right">
                                <span class="text-[10px] font-mono text-charcoal mr-2 bg-sand/20 px-1 rounded">${param.actualValue}</span>
                                <span class="${param.isCocok ? 'text-deep' : 'text-danger'} text-[10px] font-bold">${param.isCocok ? '✓' : '!'}</span>
                            </div>
                        </div>`).join('');
                } else {
                    paramList.innerHTML = '<p class="text-[10px] text-deep/40 italic text-center py-2">Parameter tidak tersedia.</p>';
                }
            },
            displayError: (msg) => {
                alert("Info: " + msg);
            }
        };

        // Init Map Logic
        document.addEventListener('DOMContentLoaded', () => {
            window.allProductsData = [productData];
            if (typeof window.initKoncoTani === 'function') {
                window.initKoncoTani(detailUiFunctions);
            }
        });
    </script>
</body>
</html>