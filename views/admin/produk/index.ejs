<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Analisis Kecocokan Lahan & Produk</title>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>



        /* Map Height */
        #map { height: 350px; border-radius: 0.5rem; border: 1px solid #e5e7eb; }

        /* Scrollable parameter list inside cards */
        .parameter-list-scroll { max-height: 140px; /* Adjust height as needed */ overflow-y: auto; padding-right: 0.5rem; margin-top: 0.75rem; /* mt-3 */ border-top: 1px solid #f3f4f6; padding-top: 0.75rem; /* pt-3 */}
        .parameter-list-scroll::-webkit-scrollbar { width: 4px; }
        .parameter-list-scroll::-webkit-scrollbar-track { background: #f9fafb; border-radius: 10px;}
        .parameter-list-scroll::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 10px;}
        .parameter-list-scroll::-webkit-scrollbar-thumb:hover { background: #9ca3af; }

        /* Status Badges */
        .status-badge { padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; }
        .status-cocok { background-color: #d1fae5; color: #065f46; border: 1px solid #a7f3d0; }
        .status-tidak-cocok { background-color: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }
        .status-na { background-color: #f3f4f6; color: #4b5563; border: 1px solid #e5e7eb; }

        /* Parameter Comparison Visuals */
        .param-item { display: flex; justify-content: space-between; align-items: center; padding: 0.375rem 0; border-bottom: 1px solid #f3f4f6; font-size: 0.875rem; }
        .param-item:last-child { border-bottom: none; }
        .param-name { color: #4b5563; flex-basis: 45%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .param-optimal-range { color: #6b7280; font-size: 0.75rem; text-align: right; flex-basis: 30%;}
        .param-actual-value { font-weight: 600; text-align: right; flex-basis: 25%;}
        .param-cocok { color: #10b981; }
        .param-tidak-cocok { color: #ef4444; }
        .param-na { color: #9ca3af; }

        /* Input styling */
        .form-input, .form-select { border-color: #d1d5db; border-radius: 0.375rem; box-shadow: 0 1px 2px 0 rgb(0 0 0 / 0.05); font-size: 0.875rem; }
        .form-input:focus, .form-select:focus { border-color: #3b82f6; ring: 1px; ring-color: #3b82f6; }
        input[type=range]::-webkit-slider-thumb { appearance: none; width: 16px; height: 16px; background: #3b82f6; border-radius: 50%; cursor: pointer; }
        input[type=range]::-moz-range-thumb { width: 16px; height: 16px; background: #3b82f6; border-radius: 50%; cursor: pointer; border: none;}

        /* Image styles */
        .product-image-placeholder { height: 150px; /* Taller image */ background-color: #e5e7eb; display: flex; align-items: center; justify-content: center; color: #9ca3af; font-size: 0.875rem; border-bottom: 1px solid #e5e7eb; }
        .product-image { height: 150px; /* Taller image */ width: 100%; object-fit: cover; border-bottom: 1px solid #e5e7eb; }
    </style>
</head>
<body class="flex bg-gray-50 text-gray-800">

    <%- include('../../partials/admin_sidebar.ejs') %>

    <main class="flex-1 p-6 md:p-8 space-y-6 overflow-y-auto">
        <%- include('../../partials/flash.ejs') %>

        <!-- Header -->
        <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-4 mb-4">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">Analisis Kecocokan Lahan</h1>
                <p class="text-gray-600 text-sm mt-1">Pilih lokasi di peta untuk melihat produk pertanian yang cocok.</p>
            </div>
            <a href="/admin/produk/new" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-md text-sm whitespace-nowrap shadow-sm">
                + Tambah Produk Pertanian
            </a>
        </div>

        <!-- Section 1: Map, Filters, Live Data (Grid for medium screens and up) -->
        <section class="grid grid-cols-1 md:grid-cols-12 gap-6">
            <!-- Map (Takes more space) -->
            <div class="md:col-span-8 lg:col-span-9 bg-white p-4 sm:p-5 rounded-lg shadow border border-gray-200">
                 <div class="flex justify-between items-center mb-3">
                     <h2 class="text-lg font-semibold text-gray-800">Peta Lokasi</h2>
                     <p class="text-xs text-gray-500">Klik pada peta untuk memilih lokasi</p>
                 </div>
                 <div id="map"></div>
                 <div id="map-loading" class="text-center text-blue-600 mt-2 text-sm font-medium" style="display: none;"> <span class="animate-spin inline-block w-4 h-4 border-2 border-current border-t-transparent rounded-full mr-2" role="status" aria-hidden="true"></span> Mengambil data API... </div>
            </div>

            <!-- Filters & Live Data (Stacked on right) -->
            <div class="md:col-span-4 lg:col-span-3 space-y-6">
                 <!-- Live Data -->
                 <div>
                    <h2 class="text-base font-semibold text-gray-700 mb-2 px-1">Data Aktual Lokasi</h2>
                     <div id="live-weather-cards" class="grid grid-cols-2 gap-3" style="display: none;">
                         <div class="bg-white p-3 rounded-lg shadow border border-gray-200 text-center"> <div class="text-xs font-medium text-gray-500 mb-1">Suhu</div> <div id="live-temp" class="text-xl font-bold text-blue-600">-</div> </div>
                         <div class="bg-white p-3 rounded-lg shadow border border-gray-200 text-center"> <div class="text-xs font-medium text-gray-500 mb-1">Kelembapan</div> <div id="live-humidity" class="text-xl font-bold text-blue-600">-</div> </div>
                         <div class="bg-white p-3 rounded-lg shadow border border-gray-200 text-center"> <div class="text-xs font-medium text-gray-500 mb-1">Curah Hujan</div> <div id="live-precip" class="text-xl font-bold text-blue-600">-</div> </div>
                         <div class="bg-white p-3 rounded-lg shadow border border-gray-200 text-center"> <div class="text-xs font-medium text-gray-500 mb-1">Produk Cocok</div> <div id="live-cocok" class="text-xl font-bold text-green-600">-</div> </div>
                    </div>
                     <div id="live-weather-placeholder" class="grid grid-cols-2 gap-3">
                         <div class="bg-gray-200 rounded-lg shadow animate-pulse h-[76px]"></div> <div class="bg-gray-200 rounded-lg shadow animate-pulse h-[76px]"></div> <div class="bg-gray-200 rounded-lg shadow animate-pulse h-[76px]"></div> <div class="bg-gray-200 rounded-lg shadow animate-pulse h-[76px]"></div>
                     </div>
                 </div>
                 <!-- Filters -->
                 <div class="bg-white p-4 sm:p-5 rounded-lg shadow border border-gray-200 sticky top-4">
                    <h2 class="text-lg font-semibold mb-4 text-gray-800">Filter Hasil</h2>
                    <div class="space-y-4">
                        <div> <label for="filter-search" class="block text-xs font-medium text-gray-600 mb-1">Cari Produk</label> <input type="text" id="filter-search" placeholder="Contoh: Cabai" class="form-input block w-full"> </div>
                        <div> <label for="filter-grade" class="block text-xs font-medium text-gray-600 mb-1">Minimal Kecocokan</label> <div class="flex items-center space-x-3"> <input type="range" id="filter-grade" min="0" max="100" value="0" class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-blue-600"> <span id="filter-grade-value" class="font-semibold text-gray-700 w-12 text-right text-sm">0%</span> </div> </div>
                        <div> <label for="filter-category" class="block text-xs font-medium text-gray-600 mb-1">Kategori Produk</label> <select id="filter-category" class="form-select block w-full"> <option value="Semua">Semua Kategori</option> <% categories.forEach(cat => { %> <option value="<%= cat %>"><%= cat %></option> <% }) %> </select> </div>
                        <div> <label for="filter-sort" class="block text-xs font-medium text-gray-600 mb-1">Urutkan Berdasarkan</label> <select id="filter-sort" class="form-select block w-full"> <option value="nama">Nama (A-Z)</option> <option value="cocok">Kecocokan Tertinggi</option> </select> </div>
                    </div>
                 </div>
            </div>
        </section>

        <!-- Section 2: Hasil Pencocokan (Full Width, Wider Grid) -->
        <section class="bg-white rounded-lg shadow border border-gray-200">
            <div class="px-4 sm:px-5 py-3 border-b border-gray-200 flex justify-between items-center">
                <h2 class="text-lg font-semibold text-gray-800">Hasil Analisis Produk</h2>
                <p id="results-summary" class="text-xs text-gray-500 font-medium">Pilih lokasi di peta.</p>
            </div>
            <!-- Wadah untuk list hasil (cards) - Wider Grid -->
            <div id="results-list" class="p-4 sm:p-5 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5"> 
                <div id="initial-message" class="col-span-full text-center py-8 text-gray-500 text-sm">
                    <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"> <path vector-effect="non-scaling-stroke" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /> <path vector-effect="non-scaling-stroke" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /> </svg>
                    <span class="mt-2 block">Pilih lokasi di peta untuk melihat hasil kecocokan produk pertanian.</span>
                </div>
               
            </div>
        </section>
    </main>

    <!-- Data Produk & Scripts -->
    <script> const allProductsData = <%- JSON.stringify(productsWithParams) %>; </script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="/js/koncoTaniAdmin.js"></script>

    <!-- UI Functions Script (Needs Update for Wider Card Content) -->
    <script>
        // DOM Elements (same as before)
        const uiMapLoading = document.getElementById('map-loading'); /* ... etc ... */
        const uiResultsList = document.getElementById('results-list');
        const uiResultsSummary = document.getElementById('results-summary');
        const uiLiveWeatherCards = document.getElementById('live-weather-cards');
        const uiLiveTemp = document.getElementById('live-temp');
        const uiLiveHumidity = document.getElementById('live-humidity');
        const uiLivePrecip = document.getElementById('live-precip');
        const uiLiveCocok = document.getElementById('live-cocok');
        const uiLivePlaceholder = document.getElementById('live-weather-placeholder');
        const uiFilterGradeValue = document.getElementById('filter-grade-value');
        const uiFilterSearch = document.getElementById('filter-search');
        const uiFilterGrade = document.getElementById('filter-grade');
        const uiFilterCategory = document.getElementById('filter-category');
        const uiFilterSort = document.getElementById('filter-sort');


        // Helper: Create Card HTML (Updated for Wider Layout)
        function createCardHTML_UI(product, isVisible) {
            let isCocok = false; let statusText = 'N/A'; let statusClass = 'status-na';
            const passingGradeValue = parseInt(uiFilterGrade.value, 10);

            if (product.paramCount > 0 && currentApiData && currentApiData.current) {
                isCocok = product.scorePercent >= passingGradeValue;
                statusText = isCocok ? 'Cocok' : 'Tidak Cocok';
                statusClass = isCocok ? 'status-cocok' : 'status-tidak-cocok';
            } else if (!currentApiData || !currentApiData.current) { statusText = 'Pilih Lokasi'; statusClass = 'status-na'; }
            else { statusText = 'Parameter N/A'; statusClass = 'status-na'; }

            const formattedPrice = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(product.Harga || 0);
            const discountPercent = product.Diskon ? (product.Diskon * 100).toFixed(1) + '%' : null;
            const originalPrice = (product.Diskon && product.Harga > 0) ? new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(product.Harga / (1 - product.Diskon)) : null;

            const paramsHTML = product.paramDetails && product.paramDetails.length > 0 && currentApiData && currentApiData.current
                ? product.paramDetails
                    .filter(param => typeof parameterApiMapping !== 'undefined' && parameterApiMapping[param.Nama])
                    .map(param => {
                        const paramStatusClass = param.isCocok ? 'param-cocok' : 'param-tidak-cocok';
                        const actualText = param.actualValue;
                        return `
                        <li class="param-item">
                            <span class="param-name" title="${param.Nama}">${param.Nama} (${param.Unit || 'N/A'})</span>
                            <span class="param-optimal-range">Opt: ${param.Minimal}–${param.Maksimal}</span>
                            <span class="param-actual-value ${paramStatusClass}">${actualText}</span>
                        </li>`;
                    }).join('')
                : `<li class="text-xs text-gray-400 italic py-3 text-center">${currentApiData && currentApiData.current ? 'Parameter optimal tidak ditemukan/tercocokkan.' : 'Pilih lokasi di peta.'}</li>`;

            const scoreText = product.paramCount > 0 && currentApiData && currentApiData.current ? `Kecocokan: <strong>${product.score}/${product.paramCount}</strong> (${product.scorePercent.toFixed(1)}%)` : `Kecocokan: <strong>N/A</strong>`;

            const firstPhoto = product.photos && product.photos.length > 0 ? product.photos[0].Foto : null;
            const imageHTML = firstPhoto ? `<img src="/images/produk/${firstPhoto}" alt="${product.Nama}" class="product-image block">` : `<div class="product-image-placeholder">[ Tidak Ada Foto ]</div>`;

            // Added Description back, adjusted spacing
            return `
                <div class="product-card bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden flex flex-col h-full" data-product-id="${product.ID_Product}">
                    ${imageHTML}
                    <div class="p-4 flex flex-col flex-grow space-y-2">
                        <div class="flex justify-between items-start">
                            <div>
                                <h3 class="text-lg font-semibold text-gray-800 product-name leading-tight">${product.Nama}</h3>
                                <p class="text-xs text-gray-500 product-category">${product.Kategori || 'Tanpa Kategori'}</p>
                            </div>
                            <span class="status-badge ${statusClass} mt-1"> ${statusText} </span>
                        </div>
                         <div class="text-sm">
                            <span class="text-lg font-semibold text-blue-700">${formattedPrice}</span>
                            ${discountPercent ? `<span class="ml-2 text-xs bg-red-100 text-red-700 font-medium px-1.5 py-0.5 rounded">${discountPercent} OFF</span>` : ''}
                            ${originalPrice ? `<span class="ml-2 text-xs text-gray-400 line-through">${originalPrice}</span>` : ''}
                        </div>
             
                         <p class="text-xs text-gray-600 description-full flex-grow min-h-[30px]"> 
                            ${product.Deskripsi ? (product.Deskripsi.length > 120 ? product.Deskripsi.substring(0, 120) + '...' : product.Deskripsi) : 'Tidak ada deskripsi.'}
                         </p>
                        <p class="text-sm text-gray-600 product-score"> ${scoreText} </p>
                        <details class="product-details text-sm">
                            <summary class="cursor-pointer text-blue-600 hover:text-blue-800 font-medium text-xs">Detail Parameter</summary>
                            <div class="parameter-list-scroll"> <ul class="product-params">${paramsHTML}</ul> </div>
                        </details>
                        <div class="mt-auto pt-3 border-t border-gray-100 flex justify-end space-x-2">
                             <a href="/admin/produk/${product.ID_Product}/edit" class="bg-gray-100 hover:bg-yellow-100 text-gray-700 hover:text-yellow-800 text-xs font-medium py-1 px-2.5 rounded border border-gray-200 hover:border-yellow-200"> Edit </a>
                             <form action="/admin/produk/${product.ID_Product}/delete" method="POST" onsubmit="return confirm('Hapus produk ${product.Nama}?');"> <button type="submit" class="bg-gray-100 hover:bg-red-100 text-gray-700 hover:text-red-800 text-xs font-medium py-1 px-2.5 rounded border border-gray-200 hover:border-red-200"> Hapus </button> </form>
                        </div>
                    </div>
                </div>`;
        }

        // UI Functions Object (remains the same as previous)
        const uiFunctions = {
            showLoadingState: () => { /* ... */ },
            hideLoadingState: () => { /* ... */ },
            updateLiveCards: (current, units) => { /* ... */ },
            displayResults: (calculatedProducts, passingGrade, totalProducts) => {
                const visibleProducts = calculatedProducts.filter(p => p.isVisible); const cocokCount = visibleProducts.filter(p => p.paramCount > 0 && p.scorePercent >= passingGrade).length;
                if(uiLiveCocok) uiLiveCocok.textContent = `${cocokCount} Produk`; if(uiResultsSummary) uiResultsSummary.textContent = `Menampilkan ${visibleProducts.length} dari ${totalProducts} produk (Min. Kecocokan: ${passingGrade}%)`;
                if(uiResultsList) uiResultsList.innerHTML = '';
                if (visibleProducts.length === 0) { const initialMsg = document.getElementById('initial-message'); if (initialMsg) initialMsg.style.display = 'none'; if(uiResultsList) uiResultsList.innerHTML = `<div class="col-span-full text-center py-8 text-gray-500 text-sm"><svg class="mx-auto h-10 w-10 text-gray-400"...</svg><span class="mt-2 block">Tidak ada produk cocok...</span></div>`; }
                else { const initialMsg = document.getElementById('initial-message'); if (initialMsg) initialMsg.style.display = 'none'; visibleProducts.forEach(product => { if(uiResultsList) uiResultsList.innerHTML += createCardHTML_UI(product, true); }); } },
            displayInitialState: (message = 'Pilih lokasi...') => { /* ... */ },
            displayError: (errorMessage) => { /* ... */ },
            updateFilterGradeValue: (value) => { /* ... */ },
            getFilterValues: () => { /* ... */ },
            addMapMarker: (lat, lng) => { /* ... */ }
        };

        // Initialize (remains the same)
        document.addEventListener('DOMContentLoaded', () => {
            if (typeof initKoncoTani === 'function') {
                initKoncoTani(uiFunctions);
            } else { console.error("koncoTaniAdmin.js not loaded."); /* ... */ }
        });
    </script>

</body>
</html>