<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kegiatan - Bausasran</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-gray-100">

    <%- include('../partials/navbar.ejs') %>

    <main class="container mx-auto p-6 md:p-12">
        <%- include('../partials/flash.ejs') %>

        <!-- Header -->
        <div class="text-center mb-12">
            <h1 class="text-4xl font-bold text-gray-800 mb-4">Kegiatan Kami</h1>
            <p class="text-lg text-gray-600">Berbagai kegiatan yang telah dan akan dilaksanakan oleh Bausasran</p>
        </div>

        <!-- Filter Tabs -->
        <div class="flex justify-center mb-8">
            <div class="inline-flex rounded-lg border border-gray-300 bg-white p-1">
                <button onclick="filterKegiatan('all')" id="btnAll" class="px-6 py-2 rounded-md text-sm font-semibold bg-blue-500 text-white">
                    Semua
                </button>
                <button onclick="filterKegiatan('upcoming')" id="btnUpcoming" class="px-6 py-2 rounded-md text-sm font-semibold text-gray-700 hover:bg-gray-100">
                    Upcoming
                </button>
                <button onclick="filterKegiatan('past')" id="btnPast" class="px-6 py-2 rounded-md text-sm font-semibold text-gray-700 hover:bg-gray-100">
                    Past
                </button>
            </div>
        </div>

        <!-- Kegiatan List -->
        <% if(kegiatanList && kegiatanList.length > 0) { %>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="kegiatanGrid">
                <% kegiatanList.forEach(kegiatan => { %>
                    <div class="kegiatan-card bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow duration-300" data-status="<%= kegiatan.Status %>">
                        <div class="relative h-48 bg-gray-200">
                            <img 
                                src="https://via.placeholder.com/400x250?text=<%= encodeURIComponent(kegiatan.Judul) %>" 
                                alt="<%= kegiatan.Judul %>" 
                                class="w-full h-full object-cover">
                            <span class="absolute top-3 right-3 px-3 py-1 rounded-full text-xs font-semibold <%= kegiatan.Status === 'Upcoming' ? 'bg-green-500 text-white' : 'bg-gray-500 text-white' %>">
                                <%= kegiatan.Status %>
                            </span>
                        </div>
                        <div class="p-5">
                            <div class="flex items-center text-sm text-gray-500 mb-2">
                                <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/>
                                </svg>
                                <%= new Date(kegiatan.Tanggal).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                            </div>
                            <h3 class="text-xl font-bold text-gray-900 mb-2 line-clamp-2"><%= kegiatan.Judul %></h3>
                            <% if (kegiatan.Deskripsi) { %>
                                <p class="text-gray-600 text-sm mb-4 line-clamp-3"><%= kegiatan.Deskripsi %></p>
                            <% } %>
                            <% if (kegiatan.Lokasi) { %>
                                <div class="flex items-center text-sm text-gray-500 mb-4">
                                    <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
                                    </svg>
                                    <%= kegiatan.Lokasi %>
                                </div>
                            <% } %>
                            <a href="/kegiatan/<%= kegiatan.ID_Kegiatan %>" class="block w-full text-center bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 px-4 rounded-lg transition-colors">
                                Lihat Detail
                            </a>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="text-center py-16">
                <svg class="w-24 h-24 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                <h3 class="text-xl font-semibold text-gray-700 mb-2">Belum Ada Kegiatan</h3>
                <p class="text-gray-500">Kegiatan akan segera hadir. Pantau terus halaman ini!</p>
            </div>
        <% } %>
    </main>

    <%- include('../partials/footer.ejs') %>

    <script>
        function filterKegiatan(status) {
            const cards = document.querySelectorAll('.kegiatan-card');
            const buttons = {
                'all': document.getElementById('btnAll'),
                'upcoming': document.getElementById('btnUpcoming'),
                'past': document.getElementById('btnPast')
            };

            // Reset button styles
            Object.values(buttons).forEach(btn => {
                btn.classList.remove('bg-blue-500', 'text-white');
                btn.classList.add('text-gray-700', 'hover:bg-gray-100');
            });

            // Set active button
            buttons[status].classList.add('bg-blue-500', 'text-white');
            buttons[status].classList.remove('text-gray-700', 'hover:bg-gray-100');

            // Filter cards
            cards.forEach(card => {
                if (status === 'all') {
                    card.style.display = 'block';
                } else {
                    const cardStatus = card.getAttribute('data-status').toLowerCase();
                    card.style.display = cardStatus === status ? 'block' : 'none';
                }
            });
        }
    </script>

</body>
</html>
