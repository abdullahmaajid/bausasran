<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= kegiatan.Judul %> - Bausasran Heritage</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
    
    <script src="https://cdn.jsdelivr.net/gh/studio-freight/lenis@1.0.29/bundled/lenis.min.js"></script>

    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        paper: '#F9F7F2',       // Cream Background
                        deep: '#0F1F18',        // Dark Green (Primary)
                        gold: '#C5B388',        // Luxury Accent
                        charcoal: '#4A4A4A',    // Text
                        sand: '#E5E0D8',        // Border/Secondary
                        white: '#FFFFFF',
                    },
                    fontFamily: {
                        sans: ['Lato', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                        crest: ['Cinzel', 'serif'], 
                    },
                    letterSpacing: {
                        'luxury': '0.2em',
                        'widest': '0.3em',
                    },
                    boxShadow: {
                        'elegant': '0 10px 40px -10px rgba(15, 31, 24, 0.05)',
                        'sharp': '5px 5px 0px 0px rgba(197, 179, 136, 0.3)',
                    }
                }
            }
        }
    </script>

    <style type="text/tailwindcss">
        @layer base {
            body {
                @apply bg-paper text-deep font-sans antialiased selection:bg-deep selection:text-paper;
                overscroll-behavior: none; 
            }
            h1, h2, h3, h4 {
                @apply font-crest text-deep;
            }
            p {
                @apply font-serif text-charcoal/80 leading-relaxed;
            }
        }
        
        /* TEXTURE OVERLAY */
        .noise-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none; z-index: 9999; mix-blend-mode: multiply;
        }
    </style>
</head>

<body class="flex flex-col min-h-screen relative">

    <div class="noise-overlay"></div>

    <%- include('../partials/navbar.ejs') %>

    <main class="flex-grow pt-40 pb-24 px-6 relative z-10">
        <%- include('../partials/flash.ejs') %>

        <div class="max-w-7xl mx-auto">
            
            <nav class="flex mb-8 animate-[fadeIn_1s]" aria-label="Breadcrumb">
                <ol class="inline-flex items-center space-x-2 md:space-x-3 font-sans text-[10px] uppercase tracking-widest">
                    <li class="inline-flex items-center">
                        <a href="/" class="text-deep/40 hover:text-gold transition-colors">Home</a>
                    </li>
                    <li><span class="text-deep/20">/</span></li>
                    <li>
                        <a href="/kegiatan" class="text-deep/40 hover:text-gold transition-colors">Kegiatan</a>
                    </li>
                    <li><span class="text-deep/20">/</span></li>
                    <li aria-current="page">
                        <span class="text-deep font-bold truncate max-w-[200px]"><%= kegiatan.Judul %></span>
                    </li>
                </ol>
            </nav>

            <header class="mb-12 animate-[fadeIn_1.2s]">
                <div class="flex flex-wrap items-center gap-4 mb-4">
                    <span class="inline-block px-3 py-1 text-[9px] font-bold uppercase tracking-widest border <%= kegiatan.Status === 'Upcoming' ? 'bg-gold text-paper border-gold' : 'bg-deep/5 text-deep/40 border-deep/10' %>">
                        <%= kegiatan.Status === 'Upcoming' ? 'Akan Datang' : 'Selesai' %>
                    </span>
                    <% if (kegiatan.Kategori) { %>
                        <span class="inline-block px-3 py-1 text-[9px] font-bold uppercase tracking-widest border border-deep/20 text-deep/60">
                            <%= kegiatan.Kategori %>
                        </span>
                    <% } %>
                </div>
                <h1 class="text-4xl md:text-6xl text-deep leading-tight mb-2"><%= kegiatan.Judul %></h1>
            </header>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
                
                <div class="lg:col-span-8 space-y-12 animate-[fadeIn_1.5s]">
                    
                    <div class="relative w-full aspect-video bg-sand/20 p-2 border border-deep/5">
                        <div class="w-full h-full relative overflow-hidden group">
                            <% if (fotoFiles && fotoFiles.length > 0) { %>
                                <img src="/images/kegiatan/<%= fotoFiles[0] %>" 
                                     alt="<%= kegiatan.Judul %>" 
                                     class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
                                     onerror="this.onerror=null;this.src='https://via.placeholder.com/800x600?text=Bausasran+Heritage'">
                            <% } else { %>
                                <div class="w-full h-full flex items-center justify-center bg-sand/10 text-deep/20">
                                    <span class="font-crest text-4xl">✦</span>
                                </div>
                            <% } %>
                            <div class="absolute inset-0 bg-gradient-to-t from-deep/20 to-transparent opacity-60"></div>
                        </div>
                    </div>

                    <div class="prose prose-lg max-w-none text-charcoal/80">
                        <h3 class="text-2xl mb-4 pb-4 border-b border-deep/10 relative inline-block">
                            Tentang Kegiatan
                            <span class="absolute bottom-0 left-0 w-1/3 h-[2px] bg-gold"></span>
                        </h3>
                        <div class="font-serif leading-loose whitespace-pre-line text-lg">
                            <%= kegiatan.Deskripsi || 'Tidak ada deskripsi detail untuk kegiatan ini.' %>
                        </div>
                    </div>

                    <% if (fotoFiles && fotoFiles.length > 1) { %>
                        <div>
                            <h3 class="text-2xl mb-6 flex items-center gap-3">
                                <span class="text-gold">✦</span> Galeri Momen
                            </h3>
                            <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                                <% fotoFiles.forEach((foto, index) => { %>
                                    <% if (index > 0) { %> 
                                        <div class="relative aspect-square overflow-hidden cursor-pointer group border border-deep/5 bg-white p-1 shadow-sm hover:shadow-elegant transition-all">
                                            <div class="w-full h-full overflow-hidden relative">
                                                <img src="/images/kegiatan/<%= foto %>" 
                                                     alt="Galeri <%= index %>" 
                                                     class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">
                                                <div class="absolute inset-0 bg-deep/0 group-hover:bg-deep/10 transition-colors duration-500"></div>
                                            </div>
                                        </div>
                                    <% } %>
                                <% }) %>
                            </div>
                        </div>
                    <% } %>

                    <div id="reviews">
                        <div class="flex items-center justify-between mb-8 pb-4 border-b border-deep/10">
                            <h3 class="text-2xl">Ulasan Pengunjung</h3>
                            <div class="flex items-center gap-2">
                                <span class="text-3xl font-serif text-deep"><%= avgRating %></span>
                                <div class="flex text-gold text-xs">
                                    <% for(let i=1; i<=5; i++) { %>
                                        <span class="<%= i <= Math.round(avgRating) ? 'opacity-100' : 'opacity-30' %>">★</span>
                                    <% } %>
                                </div>
                                <span class="text-[10px] uppercase tracking-widest text-deep/40 ml-2">Based on <%= totalReview %> reviews</span>
                            </div>
                        </div>

                        <% if (reviewList && reviewList.length > 0) { %>
                            <div class="grid gap-6">
                                <% reviewList.forEach(review => { %>
                                    <div class="bg-white border border-deep/5 p-6 shadow-sm hover:shadow-elegant transition-all duration-300 relative group">
                                        <div class="absolute top-4 right-6 text-6xl font-serif text-deep/5 select-none">”</div>
                                        
                                        <div class="flex items-center gap-4 mb-4 relative z-10">
                                            <div class="w-10 h-10 rounded-full bg-sand/30 flex items-center justify-center text-deep font-serif italic border border-deep/10">
                                                <%= review.dataValues.pengguna ? review.dataValues.pengguna.Nama.charAt(0) : '?' %>
                                            </div>
                                            <div>
                                                <h4 class="font-sans font-bold text-sm text-deep uppercase tracking-wide">
                                                    <%= review.dataValues.pengguna ? review.dataValues.pengguna.Nama : 'Anonymous' %>
                                                </h4>
                                                <div class="flex text-gold text-[10px] gap-0.5">
                                                    <% for(let i=1; i<=5; i++) { %>
                                                        <span class="<%= i <= review.Rating ? 'opacity-100' : 'opacity-20' %>">★</span>
                                                    <% } %>
                                                </div>
                                            </div>
                                        </div>
                                        <p class="text-charcoal/70 italic text-sm relative z-10">"<%= review.Ulasan %>"</p>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="bg-sand/10 border border-dashed border-deep/10 p-8 text-center rounded-sm">
                                <p class="text-deep/40 font-serif italic text-sm">Belum ada ulasan tertulis. Jadilah yang pertama memberikan kesan.</p>
                            </div>
                        <% } %>
                    </div>

                </div>

                <div class="lg:col-span-4 animate-[fadeIn_1.8s]">
                    <div class="sticky top-32 space-y-6">
                        
                        <div class="bg-white border border-deep/10 p-8 shadow-elegant relative overflow-hidden">
                            <div class="absolute top-0 left-0 w-full h-1 bg-gold"></div>
                            
                            <h3 class="text-xl mb-6">Detail Informasi</h3>
                            
                            <ul class="space-y-6">
                                <li class="flex items-start gap-4">
                                    <div class="w-8 h-8 flex items-center justify-center text-deep/40 border border-deep/10 rounded-full shrink-0">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                    </div>
                                    <div>
                                        <span class="block text-[9px] uppercase tracking-widest text-deep/40 mb-1">Tanggal</span>
                                        <span class="font-serif text-deep text-lg leading-tight block">
                                            <%= new Date(kegiatan.Tanggal).toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %>
                                        </span>
                                    </div>
                                </li>

                                <% if (kegiatan.Lokasi) { %>
                                    <li class="flex items-start gap-4">
                                        <div class="w-8 h-8 flex items-center justify-center text-deep/40 border border-deep/10 rounded-full shrink-0">
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                        </div>
                                        <div>
                                            <span class="block text-[9px] uppercase tracking-widest text-deep/40 mb-1">Lokasi</span>
                                            <span class="font-serif text-deep text-lg leading-tight block">
                                                <%= kegiatan.Lokasi %>
                                            </span>
                                        </div>
                                    </li>
                                <% } %>

                                <li class="flex items-start gap-4">
                                    <div class="w-8 h-8 flex items-center justify-center text-deep/40 border border-deep/10 rounded-full shrink-0">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path></svg>
                                    </div>
                                    <div>
                                        <span class="block text-[9px] uppercase tracking-widest text-deep/40 mb-1">Rating</span>
                                        <span class="font-serif text-deep text-lg leading-tight block">
                                            <%= avgRating %> <span class="text-sm text-deep/40 italic">/ 5.0</span>
                                        </span>
                                    </div>
                                </li>
                            </ul>
                        </div>

                        <div class="space-y-3">
                            <% if (currentUser && currentUser.Role === 'User') { %>
                                <a href="/user/testimoni/tambah" class="block w-full py-4 bg-deep text-paper text-[10px] uppercase tracking-widest font-bold text-center border border-deep hover:bg-gold hover:border-gold hover:text-deep transition-all duration-300 shadow-sharp">
                                    Tulis Ulasan
                                </a>
                            <% } else if (!currentUser) { %>
                                <a href="/login?returnTo=/kegiatan/<%= kegiatan.ID_Kegiatan %>" class="block w-full py-4 bg-white text-deep text-[10px] uppercase tracking-widest font-bold text-center border border-deep/20 hover:border-deep transition-all duration-300">
                                    Login untuk Review
                                </a>
                            <% } %>
                            
                            <a href="/kegiatan" class="block w-full py-3 text-center text-[10px] uppercase tracking-widest text-deep/40 hover:text-deep transition-colors">
                                ← Kembali ke Daftar
                            </a>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </main>

    <%- include('../partials/footer.ejs') %>

    <script>
        // Init Smooth Scroll
        const lenis = new Lenis({ duration: 1.2, easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), direction: 'vertical', smooth: true });
        function raf(time) { lenis.raf(time); requestAnimationFrame(raf); }
        requestAnimationFrame(raf);
    </script>
</body>
</html>