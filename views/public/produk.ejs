<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simulasi & Katalog Tani - Bausasran Heritage</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
    
    <script src="https://cdn.jsdelivr.net/gh/studio-freight/lenis@1.0.29/bundled/lenis.min.js"></script>

    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        paper: '#F9F7F2',       // Cream Background
                        deep: '#0F1F18',        // Dark Green Text/Bg
                        gold: '#C5B388',        // Luxury Accent
                        charcoal: '#4A4A4A',    // Body Text
                        linen: '#EBE9E4',       // Secondary bg
                        white: '#FFFFFF',
                    },
                    fontFamily: {
                        sans: ['Lato', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                        crest: ['Cinzel', 'serif'], 
                    },
                    letterSpacing: {
                        'luxury': '0.2em',
                        'widest': '0.3em',
                    },
                    transitionDuration: {
                        '1500': '1500ms',       // Efek Slow Burn
                    },
                    boxShadow: {
                        'elegant': '0 10px 40px -10px rgba(15, 31, 24, 0.10)',
                    }
                }
            }
        }
    </script>

    <style type="text/tailwindcss">
        @layer base {
            body {
                @apply bg-paper text-deep font-sans antialiased selection:bg-deep selection:text-paper;
                overscroll-behavior: none; 
            }
        }

        /* TEXTURE OVERLAY */
        .noise-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none; z-index: 9999; mix-blend-mode: multiply;
        }

        /* CUSTOM RANGE SLIDER */
        input[type="range"] {
            -webkit-appearance: none;
            @apply bg-deep/10 h-[1px] w-full cursor-pointer;
        }
        input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            @apply w-3 h-3 bg-deep border border-gold rounded-full shadow-sm transition-transform hover:scale-150;
        }

        /* LEAFLET CUSTOMIZATION */
        .leaflet-container {
            font-family: 'Lato', sans-serif !important;
            z-index: 0;
        }
    </style>
</head>

<body class="flex flex-col min-h-screen relative">

    <div class="noise-overlay"></div>

    <%- include('../partials/navbar.ejs') %>

    <main class="flex-grow pt-40 pb-24 relative z-10">
        
        <%- include('../partials/flash.ejs') %>

        <div class="max-w-7xl mx-auto text-center mb-16 px-6 animate-[fadeIn_1.5s]">
            <span class="font-sans text-[10px] uppercase tracking-widest text-gold mb-4 block">Precision Agriculture</span>
            <h1 class="font-crest text-4xl md:text-6xl text-deep mb-6 leading-none">Simulasi Lahan</h1>
            <p class="font-serif italic text-lg md:text-xl text-charcoal/70 max-w-2xl mx-auto leading-relaxed">
                "Analisis kesesuaian lahan secara real-time untuk menentukan varietas unggul bagi ekosistem Anda."
            </p>
            <div class="w-[1px] h-16 bg-deep/10 mx-auto mt-10"></div>
        </div>

        <section class="max-w-7xl mx-auto px-4 md:px-6 mb-24">
            <div class="flex flex-col lg:flex-row shadow-elegant border border-deep/5 bg-white">
                
                <div class="w-full lg:w-3/4 h-[500px] lg:h-[600px] relative group overflow-hidden">
                    <div id="map" class="h-full w-full grayscale-[50%] group-hover:grayscale-0 transition-all duration-1500"></div>
                    
                    <div id="map-loading" class="absolute inset-0 bg-paper/90 backdrop-blur-sm z-[400] hidden flex flex-col items-center justify-center">
                        <div class="w-12 h-12 border border-deep border-t-transparent rounded-full animate-spin mb-4"></div>
                        <span class="font-crest text-sm text-deep tracking-widest">Menganalisis Parameter...</span>
                    </div>

                    <div class="absolute bottom-6 left-6 z-[400] bg-paper/90 backdrop-blur px-4 py-2 border border-deep/10 shadow-sm opacity-80 group-hover:opacity-0 transition-opacity pointer-events-none">
                        <span class="text-[9px] uppercase tracking-widest text-deep font-bold">Klik Lokasi Peta</span>
                    </div>
                </div>

                <div class="w-full lg:w-1/4 bg-deep text-paper flex flex-col justify-between p-8 relative overflow-hidden">
                    <div class="absolute -top-10 -right-10 w-48 h-48 border border-gold/10 rounded-full"></div>
                    <div class="absolute top-20 -left-10 w-24 h-24 border border-gold/5 rounded-full"></div>

                    <div id="live-weather-placeholder" class="h-full flex flex-col items-center justify-center text-center opacity-60">
                        <div class="mb-6 animate-pulse">
                            <svg class="w-10 h-10 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                        </div>
                        <p class="font-crest text-lg tracking-widest mb-2">Menunggu Input</p>
                        <p class="font-serif italic text-sm text-paper/50 max-w-[200px]">
                            Pilih titik pada peta untuk mengambil data iklim mikro.
                        </p>
                    </div>

                    <div id="live-weather-cards" class="hidden h-full flex flex-col relative z-10">
                        <div class="mb-8 border-b border-gold/20 pb-6">
                            <span class="block text-[9px] uppercase tracking-widest text-gold mb-2">Temperatur Udara</span>
                            <div class="flex items-start">
                                <span id="live-temp" class="font-crest text-6xl text-paper leading-none">0</span>
                                <span class="text-xl font-serif italic text-gold ml-2 mt-2">°C</span>
                            </div>
                        </div>

                        <div class="space-y-6 flex-grow">
                            <div>
                                <span class="block text-[9px] uppercase tracking-widest text-paper/40 mb-1">Curah Hujan</span>
                                <span id="live-precip" class="font-serif text-2xl text-paper">0 mm</span>
                            </div>
                            <div>
                                <span class="block text-[9px] uppercase tracking-widest text-paper/40 mb-1">Kelembaban</span>
                                <span id="live-humidity" class="font-serif text-2xl text-paper">0%</span>
                            </div>
                        </div>

                        <div class="mt-auto pt-6 border-t border-white/10">
                            <span class="block text-[9px] uppercase tracking-widest text-gold mb-2">Rekomendasi</span>
                            <div class="flex items-center gap-3">
                                <span id="live-cocok" class="font-crest text-4xl text-paper">0</span>
                                <span class="text-xs text-paper/60 font-serif italic">Produk Cocok</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="max-w-7xl mx-auto px-4 md:px-6" id="katalog">
            
            <div class="sticky top-20 z-40 bg-paper/95 backdrop-blur-md border-y border-deep/5 py-6 mb-16 shadow-sm transition-all duration-300" id="filter-bar">
                <div class="flex flex-col md:flex-row justify-between items-center gap-8">
                    
                    <div class="w-full md:w-1/3 relative group">
                        <input type="text" id="filter-search" placeholder="Pencarian spesimen..." 
                            class="w-full bg-transparent border-b border-deep/20 py-2 pl-0 pr-8 text-deep placeholder:text-deep/30 focus:outline-none focus:border-gold transition-colors font-serif italic text-lg">
                        <div class="absolute right-0 top-3 text-deep/30 group-hover:text-gold transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                        </div>
                    </div>

                    <div class="flex flex-col sm:flex-row items-center gap-8 w-full md:w-auto">
                        
                        <div class="flex items-center gap-4 w-full sm:w-auto">
                            <label for="filter-grade" class="text-[9px] uppercase tracking-widest text-deep whitespace-nowrap font-bold">Min. Match</label>
                            <input type="range" id="filter-grade" min="0" max="100" value="50" step="10" class="w-24">
                            <span id="filter-grade-value" class="font-serif text-deep text-lg w-12 text-right">50%</span>
                        </div>

                        <div class="flex gap-4 w-full sm:w-auto">
                            <div class="relative">
                                <select id="filter-category" class="appearance-none bg-transparent text-[10px] uppercase tracking-widest text-deep border border-deep/20 px-6 py-2 pr-8 hover:border-gold hover:text-gold focus:outline-none cursor-pointer transition-colors">
                                    <option value="Semua">Semua Kategori</option>
                                    <% const categories = [...new Set(produkList.map(p => p.Kategori).filter(Boolean))]; %>
                                    <% categories.forEach(cat => { %>
                                        <option value="<%= cat %>"><%= cat %></option>
                                    <% }) %>
                                </select>
                                <div class="absolute right-2 top-2.5 pointer-events-none text-deep/50">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex justify-between items-end mb-12 border-b border-deep/5 pb-4">
                <h2 class="font-crest text-3xl text-deep">Katalog Produk</h2>
                <span id="results-summary" class="font-serif italic text-sm text-charcoal/50">Memuat koleksi...</span>
            </div>

            <div id="results-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-16 min-h-[400px]">
                <div class="col-span-full flex flex-col items-center justify-center py-20 opacity-40">
                    <div class="w-8 h-8 border border-deep border-t-transparent rounded-full animate-spin mb-4"></div>
                    <p class="font-serif italic text-sm">Menata katalog...</p>
                </div>
            </div>

        </section>
    </main>

    <%- include('../partials/footer.ejs') %>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

    <script> 
        const allProductsData = JSON.parse(decodeURIComponent('<%- encodeURIComponent(JSON.stringify(produkList)) %>')); 
    </script>
    
    <script src="/js/koncoTaniAdmin.js"></script>

    <script>
        // 1. Initialize Smooth Scroll
        const lenis = new Lenis({ duration: 1.2, easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), direction: 'vertical', smooth: true });
        function raf(time) { lenis.raf(time); requestAnimationFrame(raf); }
        requestAnimationFrame(raf);

        // 2. UI Functions Implementation
        const uiFunctions = {
            
            showLoadingState: () => {
                document.getElementById('map-loading').classList.remove('hidden');
                document.getElementById('results-summary').textContent = 'Menganalisis parameter lahan...';
                document.getElementById('live-weather-cards').classList.add('hidden');
                document.getElementById('live-weather-placeholder').classList.remove('hidden');
            },

            hideLoadingState: () => {
                document.getElementById('map-loading').classList.add('hidden');
            },

            updateLiveCards: (current, units) => {
                const placeholder = document.getElementById('live-weather-placeholder');
                const content = document.getElementById('live-weather-cards');
                
                placeholder.classList.add('hidden');
                content.classList.remove('hidden');
                
                // Animation: Slide Up Fade
                content.style.opacity = '0';
                content.style.transform = 'translateY(10px)';
                requestAnimationFrame(() => {
                    content.style.transition = 'all 0.6s ease-out';
                    content.style.opacity = '1';
                    content.style.transform = 'translateY(0)';
                });

                document.getElementById('live-temp').textContent = Math.round(current.temperature_2m);
                document.getElementById('live-humidity').textContent = (current.relative_humidity_2m || '-') + '%';
                document.getElementById('live-precip').textContent = (current.precipitation || '0') + ' mm';
            },

            displayResults: (calculatedProducts, passingGrade, totalProducts) => {
                const visibleProducts = calculatedProducts.filter(p => p.isVisible);
                const cocokCount = visibleProducts.filter(p => p.paramCount > 0 && p.scorePercent >= passingGrade).length;
                
                // Update Sidebar Count
                const liveCocokEl = document.getElementById('live-cocok');
                if(liveCocokEl) liveCocokEl.textContent = cocokCount;

                document.getElementById('results-summary').textContent = `Menampilkan ${visibleProducts.length} dari ${totalProducts} spesimen`;
                
                const container = document.getElementById('results-list');
                container.innerHTML = ''; 
                
                // Empty State
                if (visibleProducts.length === 0) {
                     container.innerHTML = `
                        <div class="col-span-full text-center py-24 border border-dashed border-deep/10 bg-linen/30 rounded-sm">
                            <span class="font-crest text-4xl text-deep/20 mb-4 block">∅</span>
                            <p class="font-crest text-xl text-deep mb-2">Tidak Ditemukan</p>
                            <p class="font-serif italic text-charcoal/50 text-sm">Sesuaikan filter atau pilih lokasi berbeda.</p>
                        </div>`;
                     return;
                }

                // Render Grid
                visibleProducts.forEach(product => {
                    container.innerHTML += createHeritageCard(product, passingGrade);
                });
            },

            displayInitialState: (msg) => {
                 if(typeof runComparison === 'function') runComparison(null); 
            },
            
            displayError: (msg) => { alert("System Error: " + msg); },
            
            updateFilterGradeValue: (val) => {}, // Handled by inline listener
            
            getFilterValues: () => {
                return {
                    search: document.getElementById('filter-search').value.toLowerCase(),
                    category: document.getElementById('filter-category').value,
                    sort: 'nama', // Default sort, can add dropdown later if needed
                    grade: parseInt(document.getElementById('filter-grade').value, 10)
                };
            }
        };

        // 3. Card Generator (Heritage Style)
        function createHeritageCard(product, passingGrade) {
            let badge = '';
            
            // Logic Badge Kecocokan
            if (product.paramCount > 0) {
                const isCocok = product.scorePercent >= passingGrade;
                if (isCocok) {
                    badge = `<div class="absolute top-4 right-4 bg-deep text-gold text-[9px] font-bold uppercase tracking-widest px-3 py-1 shadow-sm z-20 border border-gold">
                                ${Math.round(product.scorePercent)}% Match
                             </div>`;
                } else {
                    badge = `<div class="absolute top-4 right-4 bg-paper/90 text-charcoal/40 text-[9px] uppercase tracking-widest px-3 py-1 z-20 border border-deep/10">
                                ${Math.round(product.scorePercent)}% Match
                             </div>`;
                }
            }

            // Image Logic
            const imgUrl = (product.photos && product.photos.length > 0) 
                 ? `/images/produk/${product.photos[0].Foto}` 
                 : `https://via.placeholder.com/400x500?text=${encodeURIComponent(product.Nama)}`;
            
            const price = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(product.Harga);

            // Params List
            let paramsList = '';
            const details = product.paramDetails || [];
            if(details.length > 0) {
                paramsList = details.map(p => {
                    const statusColor = p.isCocok ? 'text-deep font-bold' : 'text-deep/40';
                    return `<div class="flex justify-between text-[9px] py-1 border-b border-deep/5 last:border-0">
                                <span class="text-charcoal/60 uppercase tracking-widest">${p.Nama}</span>
                                <span class="${statusColor}">${p.actualValue}</span>
                            </div>`;
                }).join('');
            } else {
                paramsList = `<p class="text-[9px] text-charcoal/30 italic text-center py-2">Parameter standar</p>`;
            }

            return `
                <article class="group flex flex-col bg-white border border-deep/5 shadow-sm hover:shadow-elegant transition-all duration-700 hover:-translate-y-1" data-product-id="${product.ID_Product}">
                    
                    ${badge}
                    
                    <div class="aspect-[4/5] overflow-hidden relative bg-linen">
                        <img src="${imgUrl}" alt="${product.Nama}" 
                             class="w-full h-full object-cover grayscale transition-transform duration-1500 ease-out group-hover:grayscale-0 group-hover:scale-105">
                        
                        <a href="/produk/${product.ID_Product}" class="absolute inset-0 bg-deep/20 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-center justify-center">
                            <span class="bg-paper text-deep border border-deep px-6 py-2 text-[9px] uppercase tracking-widest hover:bg-deep hover:text-gold hover:border-gold transition-colors shadow-lg">
                                Lihat Detail
                            </span>
                        </a>
                    </div>
                    
                    <div class="p-6 flex flex-col flex-grow text-center">
                        <span class="text-[8px] uppercase tracking-widest text-gold mb-3 block">
                            ${product.Kategori || 'Koleksi'}
                        </span>
                        
                        <h3 class="font-serif text-xl text-deep mb-2 line-clamp-1 group-hover:text-gold transition-colors duration-300">
                            <a href="/produk/${product.ID_Product}">${product.Nama}</a>
                        </h3>
                        
                        <div class="w-8 h-[1px] bg-deep/10 mx-auto mb-3"></div>
                        
                        <p class="font-sans text-xs font-bold text-deep tracking-widest mb-4">
                            ${price}
                        </p>

                        <div class="mt-auto pt-4 border-t border-deep/5 text-left w-full">
                            <details class="group/acc">
                                <summary class="cursor-pointer list-none flex justify-between items-center outline-none">
                                    <span class="text-[9px] uppercase tracking-widest text-charcoal/40 group-hover/acc:text-deep transition-colors">Spesifikasi</span>
                                    <span class="text-[10px] text-deep/30 group-open/acc:rotate-180 transition-transform">+</span>
                                </summary>
                                <div class="mt-2 bg-paper/50 p-2 border border-deep/5">
                                    ${paramsList}
                                </div>
                            </details>
                        </div>
                    </div>
                </article>`;
        }

        // 4. Event Listeners
        document.getElementById('filter-grade').addEventListener('input', function(e) {
            document.getElementById('filter-grade-value').textContent = e.target.value + '%';
        });

        // 5. Init
        document.addEventListener('DOMContentLoaded', () => {
             if (window.initKoncoTani) {
                 window.initKoncoTani(uiFunctions);
             } else {
                 // Fallback display if script fails
                 uiFunctions.displayResults(allProductsData.map(p => ({...p, isVisible: true})), 50, allProductsData.length);
             }
        });
    </script>

</body>
</html>