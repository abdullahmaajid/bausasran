<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registrasi Anggota - Executive Console</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        paper: '#F9F7F2',       /* Latar Belakang Kertas Tua */
                        deep: '#0F1F18',        /* Tinta Hijau Gelap */
                        gold: '#C5B388',        /* Emas Antik */
                        charcoal: '#4A4A4A',    /* Abu Arang */
                        linen: '#EBE9E4',       /* Abu Linen */
                        white: '#FFFFFF',
                        danger: '#8B3A3A',      /* Merah Bata Elegan */
                    },
                    fontFamily: {
                        sans: ['Lato', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                        crest: ['Cinzel', 'serif'], 
                    },
                    boxShadow: {
                        'elegant': '0 20px 50px -12px rgba(15, 31, 24, 0.08)',
                        'gold-glow': '0 0 15px rgba(197, 179, 136, 0.2)',
                    }
                }
            }
        }
    </script>

    <style type="text/tailwindcss">
        @layer base {
            body { @apply bg-paper text-deep font-sans antialiased; }
        }

        /* TEXTURE: Film Grain Overlay (Kesan Arsip Tua) */
        .noise-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.03'/%3E%3C/svg%3E");
            pointer-events: none; z-index: 50; mix-blend-mode: multiply;
        }

        /* COMPONENTS */
        .input-label { 
            @apply block text-[10px] uppercase tracking-[0.15em] font-bold text-deep/60 mb-2 font-sans; 
        }
        
        .required-mark { 
            @apply text-danger ml-0.5 text-xs align-top; 
        }

        /* Input Standard Luxury */
        .input-luxury {
            @apply w-full bg-white border border-deep/10 px-4 py-3 text-sm text-deep placeholder-deep/20 focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold/50 transition-all duration-300 font-sans shadow-sm rounded-sm;
        }

        /* Input Headline (Untuk Nama) */
        .input-headline {
            @apply w-full bg-transparent border-b-2 border-deep/10 px-2 py-2 -mx-2 text-3xl md:text-4xl font-serif font-bold text-deep placeholder-deep/15 focus:outline-none focus:border-gold focus:bg-white/40 transition-all duration-300;
        }

        /* Custom Scrollbar */
        .custom-scroll::-webkit-scrollbar { width: 6px; }
        .custom-scroll::-webkit-scrollbar-track { background: transparent; }
        .custom-scroll::-webkit-scrollbar-thumb { background: #C5B388; border-radius: 3px; }
        .custom-scroll::-webkit-scrollbar-thumb:hover { background: #0F1F18; }
    </style>
</head>

<body class="flex h-screen overflow-hidden relative">

    <div class="noise-overlay"></div>

    <%- include('../../partials/admin_sidebar.ejs') %>

    <main class="flex-1 h-full overflow-y-auto overflow-x-hidden custom-scroll relative z-10 p-6 md:p-12">
        <%- include('../../partials/flash.ejs') %>

        <form action="/admin/anggota" method="POST" enctype="multipart/form-data" class="max-w-6xl mx-auto flex flex-col min-h-full">
            
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 border-b border-deep/10 pb-6 animate-enter">
                <div>
                    <span class="font-sans text-[10px] uppercase tracking-widest text-gold mb-2 block">Administrasi Keanggotaan</span>
                    <h1 class="font-crest text-3xl md:text-4xl text-deep leading-tight">Registrasi Anggota Baru</h1>
                    <p class="font-serif italic text-charcoal/60 text-sm mt-2">Formulir resmi pendataan dan pembuatan kredensial akses.</p>
                </div>
                
                <div class="flex gap-4">
                    <a href="/admin/anggota" class="px-6 py-3 border border-deep/10 text-deep/60 text-[10px] uppercase tracking-widest font-bold hover:bg-white hover:text-deep transition-all flex items-center justify-center">
                        Batal
                    </a>
                    <button type="submit" id="btn-submit" class="px-8 py-3 bg-deep text-gold text-[10px] uppercase tracking-[0.2em] font-bold border border-deep hover:bg-gold hover:text-deep hover:border-gold transition-all shadow-lg hover:shadow-gold-glow flex items-center gap-2 group">
                        <span>Simpan Arsip</span>
                        <svg class="w-3 h-3 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                    </button>
                </div>
            </div>

            <div class="flex flex-col lg:flex-row gap-8 lg:gap-12 items-start">
                
                <div class="w-full lg:flex-1 space-y-8 order-2 lg:order-1">
                    
                    <div class="bg-white p-8 border border-deep/5 shadow-elegant relative group">
                        <div class="absolute top-0 left-0 w-1 h-full bg-gold/50 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                        
                        <div class="mb-8 relative">
                            <label for="nama" class="input-label text-gold">Nama Lengkap & Gelar <span class="required-mark">*</span></label>
                            <input type="text" id="nama" name="nama" 
                                class="input-headline" 
                                placeholder="Ketikan nama lengkap..." required autocomplete="off">
                            <p class="text-[10px] text-deep/40 mt-2 font-mono ml-1">Sertakan gelar akademik/adat jika diperlukan.</p>
                        </div>

                        <div class="mb-6">
                            <label for="jabatan" class="input-label">Jabatan / Posisi</label>
                            <input type="text" id="jabatan" name="jabatan" class="input-luxury" placeholder="Contoh: Ketua Karang Taruna, Bendahara, dll.">
                        </div>

                        <div class="h-[1px] w-full bg-deep/5 mb-6"></div>

                        <div class="flex flex-col">
                            <label for="deskripsi" class="input-label">Biografi Singkat</label>
                            <textarea id="deskripsi" name="deskripsi" rows="5"
                                class="w-full bg-paper/50 border border-deep/10 p-5 text-sm text-deep/80 leading-relaxed font-serif italic focus:outline-none focus:border-gold resize-none placeholder-deep/20 focus:bg-white transition-all rounded-sm" 
                                placeholder="Tuliskan latar belakang singkat atau catatan penting mengenai anggota ini..."></textarea>
                        </div>
                    </div>

                    <div class="bg-deep/5 p-8 border border-deep/5 relative overflow-hidden rounded-sm">
                        <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: url('data:image/svg+xml,%3Csvg width=\'20\' height=\'20\' viewBox=\'0 0 20 20\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'%230F1F18\' fill-opacity=\'1\' fill-rule=\'evenodd\'%3E%3Ccircle cx=\'3\' cy=\'3\' r=\'3\'/%3E%3Ccircle cx=\'13\' cy=\'13\' r=\'3\'/%3E%3C/g%3E%3C/svg%3E');"></div>
                        
                        <h3 class="font-crest text-lg text-deep mb-6 flex items-center gap-3 relative z-10">
                            <svg class="w-5 h-5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                            Kredensial Akses
                        </h3>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 relative z-10">
                            <div>
                                <label for="username" class="input-label">Username <span class="required-mark">*</span></label>
                                <div class="relative">
                                    <span class="absolute left-4 top-3 text-deep/40 font-serif italic">@</span>
                                    <input type="text" id="username" name="username" class="input-luxury pl-8" required autocomplete="off" placeholder="username">
                                </div>
                            </div>

                            <div>
                                <label for="password" class="input-label">Kata Sandi <span class="required-mark">*</span></label>
                                <div class="relative group/pass">
                                    <input type="password" id="password" name="password" class="input-luxury pr-10" required autocomplete="new-password" placeholder="••••••••">
                                    <button type="button" onclick="togglePassword()" class="absolute right-3 top-3 text-deep/30 hover:text-gold transition-colors focus:outline-none p-1">
                                        <svg id="eye-open" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                                        <svg id="eye-closed" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.542-7a10.05 10.05 0 011.578-2.926"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6.42 6.42a3 3 0 014.242 0m2.828 2.828a3 3 0 014.242 4.242"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.94 17.94l-1.636-1.636"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2 2l20 20"></path></svg>
                                    </button>
                                </div>
                            </div>

                            <div class="md:col-span-2">
                                <label for="role" class="input-label">Tingkat Otoritas</label>
                                <div class="relative">
                                    <select id="role" name="role" class="input-luxury appearance-none cursor-pointer">
                                        <option value="User">Warga (Akses Standar)</option>
                                        <option value="Admin">Administrator (Akses Penuh)</option>
                                    </select>
                                    <div class="absolute inset-y-0 right-4 flex items-center pointer-events-none text-deep/40">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                                    </div>
                                </div>
                                <p class="mt-2 text-[10px] text-deep/40 italic font-serif">*Administrator memiliki wewenang mengubah data sistem.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="w-full lg:w-[320px] shrink-0 order-1 lg:order-2">
                    
                    <div class="bg-white p-6 border border-deep/5 shadow-elegant sticky top-6">
                        <div class="mb-4 flex items-center justify-between">
                            <span class="input-label mb-0 text-deep">Pas Foto</span>
                            <div class="h-[1px] flex-1 bg-deep/10 ml-4"></div>
                        </div>

                        <div class="relative w-full aspect-[3/4] bg-linen/20 border border-dashed border-deep/20 mb-4 group hover:border-gold transition-all duration-300 overflow-hidden cursor-pointer">
                            
                            <input type="file" id="fotoAnggota" name="fotoAnggota" 
                                accept="image/png, image/jpeg, image/jpg" 
                                class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-20" 
                                onchange="previewProfile(this)">
                            
                            <div id="placeholder-ui" class="absolute inset-0 flex flex-col items-center justify-center text-deep/30 transition-all duration-300 group-hover:text-gold group-hover:bg-deep/5">
                                <div class="w-14 h-14 rounded-full border border-current flex items-center justify-center mb-3">
                                    <svg class="w-6 h-6 stroke-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                                </div>
                                <span class="text-[9px] uppercase tracking-widest font-bold">Unggah Foto</span>
                                <span class="text-[8px] mt-1 font-mono opacity-60">Format: JPG/PNG</span>
                            </div>

                            <img id="preview-img" class="absolute inset-0 w-full h-full object-cover z-10 hidden transition-transform duration-700 group-hover:scale-105 filter sepia-[0.1]" />
                            
                            <div id="change-overlay" class="absolute inset-0 bg-deep/80 z-30 hidden flex-col items-center justify-center text-gold opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none">
                                <svg class="w-8 h-8 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
                                <span class="text-[10px] tracking-widest font-bold uppercase">Ganti Foto</span>
                            </div>
                        </div>

                        <p class="text-[10px] text-center text-charcoal/40 font-serif italic leading-relaxed border-t border-deep/5 pt-4">
                            "Mohon gunakan foto formal dengan wajah menghadap depan. Rasio 3:4 disarankan."
                        </p>
                    </div>

                </div>
            </div>
        </form>
    </main>

    <script>
        // --- LOGIC: Preview Foto Realtime ---
        function previewProfile(input) {
            const preview = document.getElementById('preview-img');
            const placeholder = document.getElementById('placeholder-ui');
            const overlay = document.getElementById('change-overlay');
            
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                    preview.classList.remove('hidden');
                    placeholder.classList.add('opacity-0'); 
                    overlay.classList.remove('hidden');
                    overlay.classList.add('flex');
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        // --- LOGIC: Toggle Password Visibility ---
        function togglePassword() {
            const input = document.getElementById('password');
            const eyeOpen = document.getElementById('eye-open');
            const eyeClosed = document.getElementById('eye-closed');
            
            if (input.type === "password") {
                input.type = "text";
                eyeOpen.classList.add('hidden');
                eyeClosed.classList.remove('hidden');
            } else {
                input.type = "password";
                eyeOpen.classList.remove('hidden');
                eyeClosed.classList.add('hidden');
            }
        }

        // --- LOGIC: Submit Loading State ---
        document.querySelector('form').addEventListener('submit', function(e) {
            const btn = document.getElementById('btn-submit');
            
            // Kunci ukuran tombol biar tidak 'jumping'
            btn.style.width = `${btn.offsetWidth}px`;
            btn.disabled = true;
            
            // Ubah tampilan jadi spinner
            btn.innerHTML = `<svg class="animate-spin h-4 w-4 text-deep mx-auto" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>`;
            
            // Ubah style tombol jadi 'state loading'
            btn.classList.add('opacity-75', 'cursor-not-allowed', 'bg-gold', 'text-deep', 'border-gold');
            btn.classList.remove('bg-deep', 'text-gold');
        });
    </script>
</body>
</html>