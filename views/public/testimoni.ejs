<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Testimoni - Bausasran</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-gray-100">

    <%- include('../partials/navbar.ejs') %>

    <main class="container mx-auto p-6 md:p-12">
        <%- include('../partials/flash.ejs') %>

        <!-- Header -->
        <div class="text-center mb-12">
            <h1 class="text-4xl font-bold text-gray-800 mb-4">Testimoni</h1>
            <p class="text-lg text-gray-600">Apa kata mereka tentang produk dan kegiatan kami</p>
        </div>

        <!-- CTA: Login to add testimonial -->
        <% if (!currentUser) { %>
            <div class="max-w-2xl mx-auto mb-8 bg-blue-50 border-2 border-blue-200 rounded-lg p-6 text-center">
                <p class="text-blue-900 mb-4">Ingin berbagi pengalaman Anda dengan kami?</p>
                <a href="/login" class="inline-block px-6 py-3 bg-blue-500 text-white font-semibold rounded-lg hover:bg-blue-600 transition">
                    Login untuk Memberi Testimoni
                </a>
            </div>
        <% } else if (currentUser.Role === 'User') { %>
            <div class="max-w-2xl mx-auto mb-8 bg-green-50 border-2 border-green-200 rounded-lg p-6 text-center">
                <p class="text-green-900 mb-4">Bagikan pengalaman Anda tentang produk atau kegiatan kami!</p>
                <a href="/user/testimoni/tambah" class="inline-block px-6 py-3 bg-green-500 text-white font-semibold rounded-lg hover:bg-green-600 transition">
                    Tulis Testimoni
                </a>
            </div>
        <% } %>

        <!-- Filter -->
        <div class="flex justify-center mb-8 space-x-4">
            <button onclick="filterTestimoni('all')" class="filter-btn px-6 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition">
                Semua
            </button>
            <button onclick="filterTestimoni('Product')" class="filter-btn px-6 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition">
                Produk
            </button>
            <button onclick="filterTestimoni('Kegiatan')" class="filter-btn px-6 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition">
                Kegiatan
            </button>
        </div>

        <!-- Testimonials Grid -->
        <% if(testimoniList && testimoniList.length > 0) { %>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <% testimoniList.forEach(testimoni => { %>
                    <div class="testimoni-card bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-all transform hover:-translate-y-2" data-kategori="<%= testimoni.Kategori %>">
                        <!-- Header -->
                        <div class="flex items-center mb-4">
                            <!-- User Photo -->
                            <% if (testimoni.dataValues.penggunaFoto) { %>
                                <img src="/images/anggota/<%= testimoni.dataValues.penggunaFoto %>" 
                                     alt="<%= testimoni.dataValues.penggunaName || 'User' %>" 
                                     class="w-12 h-12 rounded-full object-cover mr-4">
                            <% } else { %>
                                <div class="w-12 h-12 bg-blue-500 rounded-full flex items-center justify-center mr-4">
                                    <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
                                    </svg>
                                </div>
                            <% } %>
                            <div class="flex-1">
                                <h3 class="font-bold text-gray-900"><%= testimoni.dataValues.penggunaName || 'Anonymous' %></h3>
                                <p class="text-gray-500 text-sm">
                                    Review #<%= testimoni.ID_Review %>
                                </p>
                            </div>
                        </div>

                        <!-- Rating -->
                        <div class="flex items-center mb-3">
                            <% for(let i = 1; i <= 5; i++) { %>
                                <% if(i <= testimoni.Rating) { %>
                                    ⭐
                                <% } else { %>
                                    <span class="text-gray-300">⭐</span>
                                <% } %>
                            <% } %>
                            <span class="ml-2 text-gray-600 font-semibold"><%= testimoni.Rating %>/5</span>
                        </div>

                        <!-- Category Badge -->
                        <div class="mb-3">
                            <span class="px-3 py-1 <%= testimoni.Kategori === 'Product' ? 'bg-purple-100 text-purple-800' : 'bg-green-100 text-green-800' %> text-xs font-bold rounded-full">
                                <%= testimoni.Kategori === 'Product' ? '🛍️ Produk' : '🎉 Kegiatan' %>
                            </span>
                            <% if (testimoni.dataValues.entityName) { %>
                                <span class="ml-2 text-gray-600 text-sm">
                                    "<%= testimoni.dataValues.entityName %>"
                                </span>
                            <% } %>
                        </div>

                        <!-- Review Text -->
                        <p class="text-gray-700 leading-relaxed">
                            "<%= testimoni.Testimoni %>"
                        </p>

                        <!-- Link to entity -->
                        <% if (testimoni.ID_Product && testimoni.Kategori === 'Product') { %>
                            <a href="/produk/<%= testimoni.ID_Product %>" class="block mt-4 text-blue-500 hover:text-blue-700 font-semibold text-sm">
                                Lihat Produk →
                            </a>
                        <% } else if (testimoni.ID_Kegiatan && testimoni.Kategori === 'Kegiatan') { %>
                            <a href="/kegiatan/<%= testimoni.ID_Kegiatan %>" class="block mt-4 text-blue-500 hover:text-blue-700 font-semibold text-sm">
                                Lihat Kegiatan →
                            </a>
                        <% } %>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="text-center py-16">
                <svg class="w-24 h-24 mx-auto text-gray-400 mb-4" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M2 5a2 2 0 012-2h7a2 2 0 012 2v4a2 2 0 01-2 2H9l-3 3v-3H4a2 2 0 01-2-2V5z"/>
                    <path d="M15 7v2a4 4 0 01-4 4H9.828l-1.766 1.767c.28.149.599.233.938.233h2l3 3v-3h2a2 2 0 002-2V9a2 2 0 00-2-2h-1z"/>
                </svg>
                <h3 class="text-xl font-semibold text-gray-700 mb-2">Belum Ada Testimoni</h3>
                <p class="text-gray-500">Jadilah yang pertama memberikan testimoni!</p>
            </div>
        <% } %>

        <!-- Pagination (if needed) -->
        <% if(testimoniList && testimoniList.length > 12) { %>
            <div class="mt-12 flex justify-center">
                <nav class="inline-flex rounded-md shadow">
                    <a href="#" class="px-3 py-2 rounded-l-md border border-gray-300 bg-white text-gray-500 hover:bg-gray-50">
                        Previous
                    </a>
                    <a href="#" class="px-3 py-2 border-t border-b border-gray-300 bg-blue-500 text-white">
                        1
                    </a>
                    <a href="#" class="px-3 py-2 border border-gray-300 bg-white text-gray-700 hover:bg-gray-50">
                        2
                    </a>
                    <a href="#" class="px-3 py-2 rounded-r-md border border-gray-300 bg-white text-gray-500 hover:bg-gray-50">
                        Next
                    </a>
                </nav>
            </div>
        <% } %>
    </main>

    <%- include('../partials/footer.ejs') %>

    <script>
        function filterTestimoni(kategori) {
            const cards = document.querySelectorAll('.testimoni-card');
            const buttons = document.querySelectorAll('.filter-btn');
            
            // Update button styles
            buttons.forEach(btn => {
                btn.classList.remove('bg-blue-500', 'text-white');
                btn.classList.add('bg-gray-200', 'text-gray-700');
            });
            event.target.classList.remove('bg-gray-200', 'text-gray-700');
            event.target.classList.add('bg-blue-500', 'text-white');
            
            // Filter cards
            cards.forEach(card => {
                if (kategori === 'all' || card.dataset.kategori === kategori) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }
    </script>

</body>
</html>
