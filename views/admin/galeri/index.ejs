<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kelola Galeri - Admin Bausasran</title>
    
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        main: '#003024',    // Background Gelap
                        surface: '#004030', // Warna Kartu
                        accent: '#83C540',  // Hijau Neon
                        pale: '#F5FEF9',    // Teks Putih
                        muted: '#A3C2B8',   // Teks Pudar
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style type="text/tailwindcss">
        @layer base {
            body { @apply bg-main text-pale font-sans antialiased; }
        }
        
        /* Custom Checkbox */
        .custom-checkbox {
            @apply appearance-none h-5 w-5 border border-white/20 rounded bg-main checked:bg-accent checked:border-accent cursor-pointer transition-all relative;
        }
        .custom-checkbox:checked::after {
            content: '✓';
            @apply absolute inset-0 flex items-center justify-center text-main font-bold text-xs;
        }

        /* Scrollbar Halus */
        .custom-scroll::-webkit-scrollbar { width: 6px; }
        .custom-scroll::-webkit-scrollbar-track { background: transparent; }
        .custom-scroll::-webkit-scrollbar-thumb { background: #004030; border-radius: 10px; border: 1px solid rgba(255,255,255,0.1); }
        .custom-scroll::-webkit-scrollbar-thumb:hover { background: #83C540; }
    </style>
</head>

<body class="flex h-screen overflow-hidden">

    <%- include('../../partials/admin_sidebar.ejs') %>

    <main class="flex-1 overflow-y-auto relative p-6 md:p-10 custom-scroll">
        <%- include('../../partials/flash.ejs') %>

        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
            <div>
                <h1 class="text-3xl font-bold text-pale">Kelola Galeri</h1>
                <p class="text-muted text-sm mt-1">Kumpulan album foto kegiatan dan dokumentasi desa.</p>
            </div>
            <a href="/admin/galeri/new" class="inline-flex items-center justify-center px-5 py-2.5 bg-accent hover:bg-white text-main font-bold rounded-xl transition-all shadow-lg hover:shadow-green-500/20 group">
                <span class="mr-2 text-lg">+</span> Buat Album Baru
            </a>
        </div>

        <div class="bg-surface p-4 rounded-2xl border border-white/10 mb-6 flex flex-col md:flex-row gap-4 items-center justify-between sticky top-0 z-20 shadow-md">
            
            <div class="relative w-full md:w-96">
                <input type="text" id="searchInput" placeholder="Cari nama album..." 
                    class="w-full bg-main border border-white/10 rounded-xl px-4 py-2.5 text-sm text-pale focus:border-accent focus:ring-1 focus:ring-accent outline-none transition-all placeholder-white/20">
                <svg class="w-5 h-5 text-white/30 absolute right-4 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>

            <div class="flex items-center gap-3 w-full md:w-auto">
                <div class="flex items-center gap-2">
                     <label class="text-xs text-muted font-bold uppercase hidden sm:block">Urutkan:</label>
                     <select id="sortFilter" class="bg-main border border-white/10 rounded-xl px-3 py-2.5 text-sm text-pale focus:border-accent outline-none cursor-pointer">
                        <option value="newest">Terbaru</option>
                        <option value="name_asc">Nama (A-Z)</option>
                        <option value="count_desc">Foto Terbanyak</option>
                    </select>
                </div>
                
                <button type="button" id="toggleSelectAll" class="px-4 py-2.5 bg-white/5 hover:bg-white/10 border border-white/10 rounded-xl text-sm text-muted hover:text-white transition-all whitespace-nowrap">
                    Pilih Semua
                </button>
            </div>
        </div>

        <form action="/admin/galeri/bulk-action" method="POST" id="bulk-form">
            <input type="hidden" name="action" value="delete">

            <div id="bulk-action-bar" class="hidden fixed bottom-6 left-1/2 transform -translate-x-1/2 bg-surface border border-white/10 shadow-2xl rounded-full px-6 py-3 z-50 flex items-center gap-6 animate-bounce-in">
                <span class="text-pale text-sm font-medium"><span id="selected-count" class="text-accent font-bold">0</span> album dipilih</span>
                <button type="submit" class="text-xs bg-red-500 hover:bg-red-600 text-white font-bold py-2 px-5 rounded-full transition-colors shadow-lg shadow-red-500/20 flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                    Hapus Terpilih
                </button>
            </div>
            
            <div id="galleryGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 pb-20">
                <% if(groupFotoList && groupFotoList.length > 0) { %>
                    <% for(let group of groupFotoList) { %>
                        <div class="group relative bg-surface rounded-2xl border border-white/5 overflow-hidden hover:border-accent/50 hover:shadow-xl hover:shadow-accent/5 transition-all duration-300 gallery-card"
                             data-name="<%= group.Nama.toLowerCase() %>"
                             data-count="<%= group.dataValues.photoCount %>"
                             data-id="<%= group.ID_GroupFoto %>">
                            
                            <div class="absolute top-3 left-3 z-20">
                                <input type="checkbox" name="selectedIds" value="<%= group.ID_GroupFoto %>" class="row-checkbox custom-checkbox shadow-lg">
                            </div>

                            <div class="aspect-[4/3] w-full overflow-hidden bg-main relative">
                                <% if (group.dataValues.thumbnail) { %>
                                    <img src="/images/galeri/<%= group.dataValues.thumbnail %>" 
                                         alt="<%= group.Nama %>" 
                                         class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700">
                                    <div class="absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent opacity-80"></div>
                                <% } else { %>
                                    <div class="w-full h-full flex flex-col items-center justify-center text-white/20">
                                        
                                        <svg class="w-12 h-12 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                        <span class="text-xs">Kosong</span>
                                    </div>
                                <% } %>

                                <div class="absolute bottom-3 right-3 bg-black/60 backdrop-blur-sm border border-white/10 text-white px-2.5 py-1 rounded-lg text-xs font-bold flex items-center gap-1.5">
                                    <svg class="w-3.5 h-3.5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                    <%= group.dataValues.photoCount %> Foto
                                </div>
                            </div>

                            <div class="p-5">
                                <h3 class="text-lg font-bold text-pale group-hover:text-accent transition-colors truncate mb-1" title="<%= group.Nama %>">
                                    <%= group.Nama %>
                                </h3>
                                <p class="text-xs text-muted font-mono opacity-60 mb-4">ID: <%= group.ID_GroupFoto %></p>

                                <div class="grid grid-cols-3 gap-2">
                                    <a href="/admin/galeri/<%= group.ID_GroupFoto %>" class="flex items-center justify-center py-2 rounded-lg bg-white/5 hover:bg-blue-500/20 text-blue-400 hover:text-blue-300 border border-white/10 hover:border-blue-500/30 transition-all text-sm font-medium" title="Lihat Foto">
                                        Lihat
                                    </a>
                                    <a href="/admin/galeri/<%= group.ID_GroupFoto %>/edit" class="flex items-center justify-center py-2 rounded-lg bg-white/5 hover:bg-yellow-500/20 text-yellow-400 hover:text-yellow-300 border border-white/10 hover:border-yellow-500/30 transition-all text-sm font-medium" title="Edit Album">
                                        Edit
                                    </a>
                                    <button type="button" onclick="deleteItem('<%= group.ID_GroupFoto %>', '<%= group.Nama.replace(/'/g, "\\'") %>')" class="flex items-center justify-center py-2 rounded-lg bg-white/5 hover:bg-red-500/20 text-red-400 hover:text-red-300 border border-white/10 hover:border-red-500/30 transition-all text-sm font-medium" title="Hapus">
                                        Hapus
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% } %>
                <% } else { %>
                    <div class="col-span-full py-20 text-center flex flex-col items-center justify-center opacity-60">
                        <svg class="w-20 h-20 text-muted mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                        <h3 class="text-xl font-bold text-pale">Belum ada Album Galeri</h3>
                        <p class="text-muted mt-2">Silakan buat album baru untuk mulai mengunggah foto.</p>
                    </div>
                <% } %>
            </div>
            
            <div id="noResultsMsg" class="hidden py-20 text-center text-muted">
                <p>Tidak ditemukan album dengan nama tersebut.</p>
            </div>
        </form>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('searchInput');
            const sortFilter = document.getElementById('sortFilter');
            const galleryGrid = document.getElementById('galleryGrid');
            const noResultsMsg = document.getElementById('noResultsMsg');
            let cards = Array.from(document.querySelectorAll('.gallery-card'));

            // --- 1. FILTER & SEARCH LOGIC ---
            function filterAndSort() {
                const searchTerm = searchInput.value.toLowerCase();
                const sortValue = sortFilter.value;

                // Filter Visual
                let visibleCount = 0;
                cards.forEach(card => {
                    const name = card.getAttribute('data-name');
                    if (name.includes(searchTerm)) {
                        card.style.display = '';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                // Show/Hide No Results
                if(visibleCount === 0 && cards.length > 0) {
                    noResultsMsg.classList.remove('hidden');
                } else {
                    noResultsMsg.classList.add('hidden');
                }

                // Sorting Logic
                // Note: Since cards are DOM elements, we re-append them in new order
                const visibleCards = cards.filter(c => c.style.display !== 'none');
                
                visibleCards.sort((a, b) => {
                    const nameA = a.getAttribute('data-name');
                    const nameB = b.getAttribute('data-name');
                    const countA = parseInt(a.getAttribute('data-count'));
                    const countB = parseInt(b.getAttribute('data-count'));
                    const idA = parseInt(a.getAttribute('data-id')); // Assuming higher ID = newer
                    const idB = parseInt(b.getAttribute('data-id'));

                    if (sortValue === 'name_asc') return nameA.localeCompare(nameB);
                    if (sortValue === 'count_desc') return countB - countA;
                    if (sortValue === 'newest') return idB - idA; // Simple ID based sort for "Newest"
                    return 0;
                });

                visibleCards.forEach(card => galleryGrid.appendChild(card));
            }

            searchInput.addEventListener('input', filterAndSort);
            sortFilter.addEventListener('change', filterAndSort);


            // --- 2. BULK ACTION LOGIC ---
            const toggleSelectAllBtn = document.getElementById('toggleSelectAll');
            const checkboxes = document.querySelectorAll('.row-checkbox');
            const bulkActionBar = document.getElementById('bulk-action-bar');
            const selectedCountSpan = document.getElementById('selected-count');

            function updateBulkState() {
                const checked = document.querySelectorAll('.row-checkbox:checked');
                selectedCountSpan.innerText = checked.length;
                
                if (checked.length > 0) {
                    bulkActionBar.classList.remove('hidden');
                    bulkActionBar.classList.add('flex');
                } else {
                    bulkActionBar.classList.add('hidden');
                    bulkActionBar.classList.remove('flex');
                }
            }

            toggleSelectAllBtn.addEventListener('click', function() {
                // Check current state of first visible checkbox to toggle
                const visibleCheckboxes = Array.from(checkboxes).filter(cb => cb.closest('.gallery-card').style.display !== 'none');
                if(visibleCheckboxes.length === 0) return;

                const allChecked = visibleCheckboxes.every(cb => cb.checked);
                
                visibleCheckboxes.forEach(cb => {
                    cb.checked = !allChecked;
                });
                
                updateBulkState();
                this.innerText = !allChecked ? 'Batal Pilih' : 'Pilih Semua';
            });

            checkboxes.forEach(cb => {
                cb.addEventListener('change', updateBulkState);
            });

            // Prevent card click from triggering checkbox if clicking other elements
            checkboxes.forEach(cb => {
                cb.addEventListener('click', (e) => e.stopPropagation());
            });

            // --- 3. DELETE ACTIONS ---
            const bulkForm = document.getElementById('bulk-form');
            if(bulkForm) {
                bulkForm.addEventListener('submit', function(e) {
                    const count = document.querySelectorAll('.row-checkbox:checked').length;
                    if(count === 0) {
                        e.preventDefault(); 
                        return;
                    }
                    if(!confirm(`Yakin ingin menghapus ${count} album? Semua foto di dalamnya akan ikut terhapus permanen.`)) {
                        e.preventDefault();
                    }
                });
            }
        });

        function deleteItem(id, name) {
            if (confirm(`PERINGATAN: Menghapus album "${name}" akan menghapus SEMUA FOTO di dalamnya.\n\nApakah Anda yakin ingin melanjutkan?`)) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = `/admin/galeri/${id}/delete`;
                form.style.display = 'none';
                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
</body>
</html>