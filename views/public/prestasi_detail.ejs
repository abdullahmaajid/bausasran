<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= prestasi.Judul %> - Prestasi Bausasran</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
    
    <script src="https://cdn.jsdelivr.net/gh/studio-freight/lenis@1.0.29/bundled/lenis.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        paper: '#F9F7F2',       // Cream Background
                        deep: '#0F1F18',        // Dark Green (Primary)
                        gold: '#C5B388',        // Luxury Accent
                        charcoal: '#4A4A4A',    // Text
                        sand: '#E5E0D8',        // Border/Secondary
                        white: '#FFFFFF',
                    },
                    fontFamily: {
                        sans: ['Lato', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                        crest: ['Cinzel', 'serif'], 
                    },
                    letterSpacing: {
                        'luxury': '0.2em',
                        'widest': '0.3em',
                    },
                    boxShadow: {
                        'elegant': '0 10px 40px -10px rgba(15, 31, 24, 0.05)',
                        'sharp': '5px 5px 0px 0px rgba(197, 179, 136, 0.3)',
                    }
                }
            }
        }
    </script>

    <style type="text/tailwindcss">
        @layer base {
            body {
                @apply bg-paper text-deep font-sans antialiased selection:bg-deep selection:text-paper;
                overscroll-behavior: none; 
            }
            h1, h2, h3, h4 {
                @apply font-crest text-deep;
            }
            p {
                @apply font-serif text-charcoal/80 leading-relaxed;
            }
        }
        
        /* TEXTURE OVERLAY */
        .noise-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none; z-index: 9999; mix-blend-mode: multiply;
        }
    </style>
</head>

<body class="flex flex-col min-h-screen relative">

    <div class="noise-overlay"></div>

    <%- include('../partials/navbar.ejs') %>

    <main class="flex-grow pt-40 pb-24 px-4 md:px-8 relative z-10">
        <%- include('../partials/flash.ejs') %>

        <div class="max-w-7xl mx-auto">
            
            <nav class="flex mb-8 animate-[fadeIn_1s]" aria-label="Breadcrumb">
                <ol class="inline-flex items-center space-x-2 md:space-x-3 font-sans text-[10px] uppercase tracking-widest">
                    <li class="inline-flex items-center">
                        <a href="/" class="text-deep/40 hover:text-gold transition-colors">Home</a>
                    </li>
                    <li><span class="text-deep/20">/</span></li>
                    <li>
                        <a href="/prestasi" class="text-deep/40 hover:text-gold transition-colors">Prestasi</a>
                    </li>
                    <li><span class="text-deep/20">/</span></li>
                    <li aria-current="page">
                        <span class="text-deep font-bold truncate max-w-[200px]"><%= prestasi.Judul %></span>
                    </li>
                </ol>
            </nav>

            <header class="mb-12 animate-[fadeIn_1.2s]">
                <div class="flex flex-wrap items-center gap-4 mb-4">
                    <span class="inline-block px-3 py-1 text-[9px] font-bold uppercase tracking-widest border bg-gold text-paper border-gold">
                        Penghargaan
                    </span>
                    <% if (prestasi.Kategori) { %>
                        <span class="inline-block px-3 py-1 text-[9px] font-bold uppercase tracking-widest border border-deep/20 text-deep/60">
                            <%= prestasi.Kategori %>
                        </span>
                    <% } %>
                </div>
                <h1 class="text-4xl md:text-6xl text-deep leading-tight mb-2"><%= prestasi.Judul %></h1>
            </header>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
                
                <div class="lg:col-span-8 space-y-12 animate-[fadeIn_1.5s]">
                    
                    <div class="relative w-full aspect-video bg-sand/20 p-2 border border-deep/5">
                        <div class="w-full h-full relative overflow-hidden group">
                            <% if (fotoFiles && fotoFiles.length > 0) { %>
                                <img src="/images/<%= folder || 'prestasi' %>/<%= fotoFiles[0] %>" 
                                     alt="<%= prestasi.Judul %>" 
                                     class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105 filter grayscale contrast-[1.1] group-hover:grayscale-0 transition-all"
                                     onerror="this.onerror=null;this.src='https://via.placeholder.com/800x600?text=Bausasran+Heritage'">
                            <% } else { %>
                                <div class="w-full h-full flex items-center justify-center bg-sand/10 text-deep/20">
                                    <span class="font-crest text-4xl">✦</span>
                                </div>
                            <% } %>
                            <div class="absolute inset-0 bg-gradient-to-t from-deep/20 to-transparent opacity-60"></div>
                        </div>
                    </div>

                    <div class="prose prose-lg max-w-none text-charcoal/80">
                        <h3 class="text-2xl mb-4 pb-4 border-b border-deep/10 relative inline-block">
                            Tentang Pencapaian
                            <span class="absolute bottom-0 left-0 w-1/3 h-[2px] bg-gold"></span>
                        </h3>
                        <div class="font-serif leading-loose whitespace-pre-line text-lg">
                            <%= prestasi.Deskripsi || 'Pencapaian ini merupakan bukti dedikasi warga Bausasran dalam menjaga dan mengembangkan potensi wilayah.' %>
                        </div>
                    </div>

                    <% if (fotoFiles && fotoFiles.length > 1) { %>
                        <div>
                            <h3 class="text-2xl mb-6 flex items-center gap-3">
                                <span class="text-gold">✦</span> Dokumentasi Lainnya
                            </h3>
                            <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                                <% fotoFiles.forEach((foto, index) => { %>
                                    <% if (index > 0) { %> 
                                        <div class="relative aspect-square overflow-hidden cursor-pointer group border border-deep/5 bg-white p-1 shadow-sm hover:shadow-elegant transition-all">
                                            <div class="w-full h-full overflow-hidden relative">
                                                <img src="/images/<%= folder || 'prestasi' %>/<%= foto %>" 
                                                     alt="Galeri <%= index %>" 
                                                     class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 filter grayscale group-hover:grayscale-0 transition-all">
                                                <div class="absolute inset-0 bg-deep/0 group-hover:bg-deep/10 transition-colors duration-500"></div>
                                            </div>
                                        </div>
                                    <% } %>
                                <% }) %>
                            </div>
                        </div>
                    <% } %>

                </div>

                <div class="lg:col-span-4 animate-[fadeIn_1.8s]">
                    <div class="sticky top-32 space-y-6">
                        
                        <div class="bg-white border border-deep/10 p-8 shadow-elegant relative overflow-hidden">
                            <div class="absolute top-0 left-0 w-full h-1 bg-gold"></div>
                            
                            <h3 class="text-xl mb-6">Detail Informasi</h3>
                            
                            <ul class="space-y-6">
                                <li class="flex items-start gap-4">
                                    <div class="w-8 h-8 flex items-center justify-center text-deep/40 border border-deep/10 rounded-full shrink-0">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                    </div>
                                    <div>
                                        <span class="block text-[9px] uppercase tracking-widest text-deep/40 mb-1">Tanggal Raihan</span>
                                        <span class="font-serif text-deep text-lg leading-tight block">
                                            <%= new Date(prestasi.Tanggal).toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %>
                                        </span>
                                    </div>
                                </li>

                                <% if (prestasi.Kategori) { %>
                                    <li class="flex items-start gap-4">
                                        <div class="w-8 h-8 flex items-center justify-center text-deep/40 border border-deep/10 rounded-full shrink-0">
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>
                                        </div>
                                        <div>
                                            <span class="block text-[9px] uppercase tracking-widest text-deep/40 mb-1">Tingkat / Kategori</span>
                                            <span class="font-serif text-deep text-lg leading-tight block">
                                                <%= prestasi.Kategori %>
                                            </span>
                                        </div>
                                    </li>
                                <% } %>

                                <% if (groupFoto) { %>
                                    <li class="flex items-start gap-4">
                                        <div class="w-8 h-8 flex items-center justify-center text-deep/40 border border-deep/10 rounded-full shrink-0">
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                        </div>
                                        <div>
                                            <span class="block text-[9px] uppercase tracking-widest text-deep/40 mb-1">Album Terkait</span>
                                            <a href="/galeri" class="font-serif text-deep hover:text-gold transition-colors text-lg leading-tight block underline decoration-deep/30 underline-offset-4">
                                                <%= groupFoto.Nama %>
                                            </a>
                                        </div>
                                    </li>
                                <% } %>
                            </ul>
                        </div>

                        <a href="/prestasi" class="block w-full py-4 text-center text-[10px] uppercase tracking-widest text-deep/40 border border-deep/10 hover:border-deep hover:text-deep transition-all duration-300 bg-white shadow-sm hover:shadow-sharp">
                            ← Kembali ke Daftar Prestasi
                        </a>

                    </div>
                </div>

            </div>
        </div>
    </main>

    <%- include('../partials/footer.ejs') %>

    <script>
        const lenis = new Lenis({ duration: 1.2, easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), direction: 'vertical', smooth: true });
        function raf(time) { lenis.raf(time); requestAnimationFrame(raf); }
        requestAnimationFrame(raf);
    </script>
</body>
</html>