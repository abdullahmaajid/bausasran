<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kelola Testimoni - Executive Console</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        paper: '#F9F7F2',       /* Cream Background */
                        deep: '#0F1F18',        /* Dark Emerald Green */
                        gold: '#C5B388',        /* Antique Gold */
                        charcoal: '#4A4A4A',    /* Soft Black */
                        linen: '#EBE9E4',       /* Light Gray/Beige */
                        white: '#FFFFFF',
                        danger: '#8B3A3A',      /* Elegant Red */
                    },
                    fontFamily: {
                        sans: ['Lato', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                        crest: ['Cinzel', 'serif'], 
                    },
                    boxShadow: {
                        'elegant': '0 20px 50px -12px rgba(15, 31, 24, 0.08)',
                        'gold-glow': '0 0 15px rgba(197, 179, 136, 0.2)',
                    }
                }
            }
        }
    </script>

    <style type="text/tailwindcss">
        @layer base {
            body { @apply bg-paper text-deep font-sans antialiased; }
        }

        /* TEXTURE: Film Grain Overlay */
        .noise-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.03'/%3E%3C/svg%3E");
            pointer-events: none; z-index: 50; mix-blend-mode: multiply;
        }

        /* Custom Checkbox Heritage Style */
        .custom-checkbox {
            @apply appearance-none h-4 w-4 border border-deep/20 rounded-none bg-white checked:bg-deep checked:border-deep cursor-pointer transition-all relative;
        }
        .custom-checkbox:checked::after {
            content: '✓';
            @apply absolute inset-0 flex items-center justify-center text-gold font-bold text-[10px];
        }

        /* Input Luxury */
        .input-luxury {
            @apply bg-white border border-deep/10 px-4 py-2 text-sm text-deep placeholder-charcoal/30 focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold/50 transition-all duration-300 font-sans shadow-sm rounded-none;
        }

        /* Scrollbar */
        .custom-scroll::-webkit-scrollbar { width: 6px; }
        .custom-scroll::-webkit-scrollbar-track { background: transparent; }
        .custom-scroll::-webkit-scrollbar-thumb { background: #C5B388; border-radius: 3px; }
        .custom-scroll::-webkit-scrollbar-thumb:hover { background: #0F1F18; }
    </style>
</head>

<body class="flex h-screen overflow-hidden relative">

    <div class="noise-overlay"></div>

    <%- include('../../partials/admin_sidebar.ejs') %>

    <main class="flex-1 overflow-y-auto relative z-10 custom-scroll p-6 md:p-12">
        <%- include('../../partials/flash.ejs') %>

        <div class="flex flex-col md:flex-row justify-between items-end md:items-end mb-10 border-b border-deep/10 pb-6 gap-6">
            <div>
                <span class="font-sans text-[10px] uppercase tracking-widest text-gold mb-2 block">Suara Warga</span>
                <h1 class="font-crest text-3xl md:text-4xl text-deep leading-tight">Testimoni & Review</h1>
                <p class="font-serif italic text-charcoal/60 text-sm mt-2">Arsip ulasan pengguna terhadap produk dan kegiatan wilayah.</p>
            </div>
            
            <a href="/admin/testimoni/new" class="group flex items-center gap-3 px-6 py-3 bg-deep text-gold text-[10px] font-bold uppercase tracking-[0.2em] border border-deep hover:bg-gold hover:text-deep hover:border-gold transition-all duration-500 shadow-lg hover:shadow-gold-glow">
                <span class="text-lg leading-none mb-0.5">+</span>
                <span>Review Manual</span>
            </a>
        </div>

        <div class="bg-white p-6 border border-deep/5 shadow-elegant mb-8 relative overflow-hidden group">
            <div class="absolute top-0 right-0 w-16 h-16 bg-gold/5 rounded-bl-full -mr-8 -mt-8"></div>
            
            <div class="flex flex-col xl:flex-row gap-6 justify-between items-end xl:items-center">
                
                <div class="w-full xl:w-1/3 relative group/search">
                    <input type="text" id="searchInput" placeholder="Cari ulasan atau nama..." 
                        class="w-full bg-transparent border-b border-deep/20 py-3 pl-8 pr-4 text-deep font-serif italic placeholder-deep/30 focus:border-gold focus:outline-none transition-all">
                    <svg class="w-4 h-4 text-deep/30 absolute left-0 top-3.5 group-focus-within/search:text-gold transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                </div>

                <div class="flex flex-col sm:flex-row gap-4 w-full xl:w-auto">
                    <select id="categoryFilter" class="input-luxury cursor-pointer w-full sm:w-48">
                        <option value="">Semua Kategori</option>
                        <option value="Product">📦 Produk UMKM</option>
                        <option value="Kegiatan">📅 Kegiatan Desa</option>
                    </select>

                    <select id="ratingFilter" class="input-luxury cursor-pointer w-full sm:w-48">
                        <option value="">Semua Penilaian</option>
                        <option value="5">★★★★★ (Sempurna)</option>
                        <option value="4">★★★★ (Sangat Baik)</option>
                        <option value="3">★★★ (Cukup)</option>
                        <option value="2">★★ (Kurang)</option>
                        <option value="1">★ (Buruk)</option>
                    </select>
                </div>
            </div>
        </div>

        <form action="/admin/testimoni/bulk-action" method="POST" id="bulk-form">
            <input type="hidden" name="action" value="delete">
            
            <div class="bg-white border border-deep/5 shadow-sm overflow-hidden relative min-h-[400px]">
                
                <div id="bulk-action-bar" class="hidden bg-danger text-white border-b border-danger p-3 flex justify-between items-center px-6 animate-pulse absolute top-0 left-0 w-full z-20 shadow-lg">
                    <span class="font-crest text-xs tracking-widest"><span id="selected-count" class="font-bold">0</span> ITEM DIPILIH</span>
                    <button type="submit" class="text-[10px] bg-white text-danger font-bold uppercase tracking-widest py-1.5 px-4 hover:bg-paper transition-colors shadow-sm">
                        Hapus Permanen
                    </button>
                </div>

                <div class="overflow-x-auto custom-scroll">
                    <table class="min-w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-paper border-b border-deep/10 text-[9px] uppercase tracking-[0.15em] text-deep/60 font-bold font-sans">
                                <th class="py-5 px-6 text-center w-14">
                                    <input type="checkbox" id="select-all" class="custom-checkbox">
                                </th>
                                <th class="py-5 px-6">Identitas & Objek</th>
                                <th class="py-5 px-6 w-1/2">Penilaian & Opini</th>
                                <th class="py-5 px-6 text-center">Tindakan</th>
                            </tr>
                        </thead>
                        <tbody id="reviewTableBody" class="divide-y divide-deep/5 bg-white">
                            <% if(reviewList && reviewList.length > 0) { %>
                                <% for(let review of reviewList) { %>
                                    <tr class="hover:bg-paper transition-colors duration-300 group review-row"
                                        data-user="<%= (review.dataValues.pengguna ? review.dataValues.pengguna.Nama : '').toLowerCase() %>"
                                        data-content="<%= (review.Ulasan || '').toLowerCase() %>"
                                        data-category="<%= review.Kategori %>"
                                        data-rating="<%= review.Rating %>">
                                        
                                        <td class="py-6 px-6 text-center align-top pt-8">
                                            <input type="checkbox" name="selectedIds" value="<%= review.ID_Review %>" class="row-checkbox custom-checkbox">
                                        </td>

                                        <td class="py-6 px-6 align-top">
                                            <div class="flex flex-col gap-3">
                                                <div class="flex items-center gap-3">
                                                    <div class="w-8 h-8 bg-gold/20 flex items-center justify-center text-xs font-crest font-bold text-deep border border-gold/30">
                                                        <%= review.dataValues.pengguna ? review.dataValues.pengguna.Nama.charAt(0).toUpperCase() : '?' %>
                                                    </div>
                                                    <span class="font-serif font-bold text-deep text-sm tracking-wide">
                                                        <%= review.dataValues.pengguna ? review.dataValues.pengguna.Nama : 'Anonim' %>
                                                    </span>
                                                </div>
                                                
                                                <div class="pl-11">
                                                    <span class="inline-block text-[9px] uppercase font-bold tracking-widest text-charcoal/50 border border-deep/10 px-2 py-0.5 mb-1 bg-paper">
                                                        <%= review.Kategori %>
                                                    </span>
                                                    <div class="text-xs text-deep/60 font-mono truncate max-w-[180px]" title="<%= review.Kategori === 'Product' ? (review.dataValues.produk ? review.dataValues.produk.Nama : '-') : (review.dataValues.kegiatan ? review.dataValues.kegiatan.Judul : '-') %>">
                                                        <% if (review.Kategori === 'Product' && review.dataValues.produk) { %>
                                                            <%= review.dataValues.produk.Nama %>
                                                        <% } else if (review.Kategori === 'Kegiatan' && review.dataValues.kegiatan) { %>
                                                            <%= review.dataValues.kegiatan.Judul %>
                                                        <% } else { %>
                                                            - Item Dihapus -
                                                        <% } %>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>

                                        <td class="py-6 px-6 align-top">
                                            <div class="flex items-center mb-3 space-x-1">
                                                <% for(let i=0; i<5; i++) { %>
                                                    <svg class="w-3.5 h-3.5 <%= i < review.Rating ? 'text-gold fill-gold' : 'text-linen fill-linen' %>" viewBox="0 0 20 20">
                                                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                                                    </svg>
                                                <% } %>
                                            </div>
                                            <div class="relative pl-4 border-l-2 border-gold/30">
                                                <p class="text-sm text-deep/80 leading-relaxed font-serif italic">
                                                    "<%= review.Ulasan %>"
                                                </p>
                                            </div>
                                        </td>

                                        <td class="py-6 px-6 text-center align-top pt-8">
                                            <div class="flex items-center justify-center gap-2">
                                                <a href="/admin/testimoni/<%= review.ID_Review %>/edit" class="p-2 text-deep/40 hover:text-gold hover:bg-deep transition-all border border-transparent" title="Edit">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                                                </a>
                                                
                                                <button type="button" 
                                                    onclick="deleteItem('<%= review.ID_Review %>', '<%= (review.dataValues.pengguna ? review.dataValues.pengguna.Nama : 'User').replace(/'/g, "\\'") %>')"
                                                    class="p-2 text-deep/40 hover:text-white hover:bg-danger transition-all border border-transparent" title="Hapus">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% } %>
                            <% } else { %>
                                <tr>
                                    <td colspan="4" class="py-24 text-center text-deep/30">
                                        <div class="flex flex-col items-center justify-center">
                                            <svg class="w-12 h-12 mb-4 stroke-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
                                            <p class="font-serif italic">Belum ada arsip ulasan.</p>
                                        </div>
                                    </td>
                                </tr>
                            <% } %>
                            
                            <tr id="noSearchResultsRow" class="hidden">
                                <td colspan="4" class="py-16 text-center text-deep/40 font-serif italic bg-paper/30">
                                    <p>Tidak ditemukan ulasan yang cocok dengan kriteria.</p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </form>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // --- 1. FILTER LOGIC ---
            const searchInput = document.getElementById('searchInput');
            const categoryFilter = document.getElementById('categoryFilter');
            const ratingFilter = document.getElementById('ratingFilter');
            const rows = document.querySelectorAll('.review-row');
            const noResultsRow = document.getElementById('noSearchResultsRow');

            function filterTable() {
                const searchTerm = searchInput.value.toLowerCase();
                const selectedCategory = categoryFilter.value;
                const selectedRating = ratingFilter.value;
                
                let visibleCount = 0;

                rows.forEach(row => {
                    const user = row.getAttribute('data-user');
                    const content = row.getAttribute('data-content');
                    const category = row.getAttribute('data-category');
                    const rating = row.getAttribute('data-rating');

                    const matchesSearch = user.includes(searchTerm) || content.includes(searchTerm);
                    const matchesCategory = selectedCategory === '' || category === selectedCategory;
                    const matchesRating = selectedRating === '' || rating === selectedRating;

                    if (matchesSearch && matchesCategory && matchesRating) {
                        row.style.display = '';
                        visibleCount++;
                    } else {
                        row.style.display = 'none';
                    }
                });

                // Show/Hide "No Results" Message
                if (rows.length > 0) {
                    if (visibleCount === 0) {
                        noResultsRow.classList.remove('hidden');
                    } else {
                        noResultsRow.classList.add('hidden');
                    }
                }
            }

            // Event Listeners for Filters
            if(searchInput) searchInput.addEventListener('input', filterTable);
            if(categoryFilter) categoryFilter.addEventListener('change', filterTable);
            if(ratingFilter) ratingFilter.addEventListener('change', filterTable);

            // --- 2. BULK ACTION LOGIC ---
            const selectAll = document.getElementById('select-all');
            const checkboxes = document.querySelectorAll('.row-checkbox');
            const bulkActionBar = document.getElementById('bulk-action-bar');
            const selectedCountSpan = document.getElementById('selected-count');

            function updateBulkActionState() {
                // Count visible checked boxes
                const visibleChecked = Array.from(document.querySelectorAll('.row-checkbox:checked')).filter(cb => {
                    return cb.closest('tr').style.display !== 'none';
                });

                selectedCountSpan.innerText = visibleChecked.length;

                if (visibleChecked.length > 0) {
                    bulkActionBar.classList.remove('hidden');
                    bulkActionBar.classList.add('flex');
                } else {
                    bulkActionBar.classList.add('hidden');
                    bulkActionBar.classList.remove('flex');
                }
            }

            if(selectAll) {
                selectAll.addEventListener('change', function(e) {
                    checkboxes.forEach(cb => {
                        // Only check visible rows
                        if(cb.closest('tr').style.display !== 'none') {
                            cb.checked = e.target.checked;
                        }
                    });
                    updateBulkActionState();
                });
            }

            checkboxes.forEach(cb => {
                cb.addEventListener('change', updateBulkActionState);
            });

            // Prevent form submit if nothing selected
            document.getElementById('bulk-form').addEventListener('submit', function(e) {
                const checkedCount = document.querySelectorAll('.row-checkbox:checked').length;
                if (checkedCount === 0) {
                    e.preventDefault();
                    return;
                }
                if (!confirm(`Tindakan ini akan menghapus ${checkedCount} ulasan terpilih secara permanen. Lanjutkan?`)) {
                    e.preventDefault();
                }
            });
        });

        // --- 3. SINGLE DELETE LOGIC ---
        function deleteItem(id, userName) {
            if (confirm(`Hapus permanen ulasan dari "${userName}"?`)) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = `/admin/testimoni/${id}/delete`;
                form.style.display = 'none';
                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
</body>
</html>