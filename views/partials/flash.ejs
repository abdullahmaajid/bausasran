<% if(success_flash && success_flash.length > 0) { %>
    <div class="max-w-6xl mx-auto mb-8 animate-fade-in-down" id="flash-success">
        <div class="bg-white border-l-4 border-deep shadow-elegant p-6 relative flex items-start group">
            <div class="flex-shrink-0 mr-4 mt-0.5">
                <div class="w-8 h-8 rounded-full bg-deep/5 flex items-center justify-center border border-deep/10">
                    <svg class="w-4 h-4 text-deep" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                </div>
            </div>
            
            <div class="flex-1">
                <h3 class="text-[10px] font-bold uppercase tracking-luxury text-gold mb-1">Berhasil</h3>
                <p class="font-serif text-deep text-lg italic leading-relaxed">
                    <%= success_flash %>
                </p>
            </div>

            <button onclick="document.getElementById('flash-success').remove()" class="text-charcoal/30 hover:text-deep transition-colors ml-4">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
            
            <div class="absolute top-0 right-0 w-16 h-16 bg-gradient-to-bl from-gold/10 to-transparent pointer-events-none"></div>
        </div>
    </div>
<% } %>

<% if(error_flash && error_flash.length > 0) { %>
    <div class="max-w-6xl mx-auto mb-8 animate-fade-in-down" id="flash-error">
        <div class="bg-white border-l-4 border-red-800 shadow-elegant p-6 relative flex items-start group">
            <div class="flex-shrink-0 mr-4 mt-0.5">
                <div class="w-8 h-8 rounded-full bg-red-50 flex items-center justify-center border border-red-100">
                    <svg class="w-4 h-4 text-red-800" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                    </svg>
                </div>
            </div>

            <div class="flex-1">
                <h3 class="text-[10px] font-bold uppercase tracking-luxury text-red-800/60 mb-1">Perhatian</h3>
                <p class="font-serif text-red-900 text-lg italic leading-relaxed">
                    <%= error_flash %>
                </p>
            </div>

            <button onclick="document.getElementById('flash-error').remove()" class="text-red-800/30 hover:text-red-800 transition-colors ml-4">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>
    </div>
<% } %>

<style>
    @keyframes fadeInDownFlash {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in-down {
        animation: fadeInDownFlash 0.5s ease-out forwards;
    }
</style>