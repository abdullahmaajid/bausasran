<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Struktur Organisasi - Bausasran Heritage</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
    
    <script src="https://cdn.jsdelivr.net/gh/studio-freight/lenis@1.0.29/bundled/lenis.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        paper: '#F9F7F2', deep: '#0F1F18', gold: '#C5B388', 
                        charcoal: '#4A4A4A', sand: '#E5E0D8', white: '#FFFFFF',
                    },
                    fontFamily: {
                        sans: ['Lato', 'sans-serif'], serif: ['Playfair Display', 'serif'], crest: ['Cinzel', 'serif'], 
                    },
                    boxShadow: {
                        'pop': '0 20px 40px -5px rgba(0, 0, 0, 0.4)', // Shadow lebih soft
                    },
                    transitionTimingFunction: {
                        'elastic': 'cubic-bezier(0.22, 1, 0.36, 1)', // Kunci smooth animation
                    }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer base { body { @apply bg-paper text-deep font-sans antialiased; overscroll-behavior: none; } }
        .noise-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 9999; opacity: 0.04; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E"); }
    </style>
</head>

<body class="flex flex-col min-h-screen relative">
    <div class="noise-overlay"></div>
    <%- include('../partials/navbar.ejs') %>

    <main class="flex-grow pt-32 pb-20 px-4 relative z-10">
        <%- include('../partials/flash.ejs') %>

        <div class="max-w-4xl mx-auto text-center mb-10 animate-[fadeIn_1s]">
            <span class="font-sans text-[10px] uppercase tracking-widest text-gold mb-2 block">The People Behind</span>
            <h1 class="font-crest text-4xl md:text-5xl text-deep mb-4">Struktur Organisasi</h1>
            <p class="font-serif italic text-sm md:text-base text-charcoal/70 max-w-2xl mx-auto">
                "Mengenal para penggerak yang mendedikasikan waktu dan tenaga untuk menjaga warisan serta memajukan Kampung Wisata."
            </p>
        </div>

        <div class="flex justify-center mb-8 sticky top-20 z-40 pointer-events-none">
            <div class="inline-flex bg-white/90 backdrop-blur border border-deep/10 shadow-sm p-1 rounded-sm gap-1 pointer-events-auto">
                <button onclick="filterAnggota('all')" id="btn-all" class="filter-btn px-4 py-1.5 text-[9px] uppercase tracking-widest font-bold bg-deep text-paper border border-deep transition-all">Semua</button>
                <button onclick="filterAnggota('Admin')" id="btn-Admin" class="filter-btn px-4 py-1.5 text-[9px] uppercase tracking-widest font-bold text-deep/50 hover:text-deep transition-all">Pengurus Inti</button>
                <button onclick="filterAnggota('User')" id="btn-User" class="filter-btn px-4 py-1.5 text-[9px] uppercase tracking-widest font-bold text-deep/50 hover:text-deep transition-all">Anggota</button>
            </div>
        </div>

        <% if(anggotaList && anggotaList.length > 0) { %>
            <div class="max-w-7xl mx-auto">
                <div class="grid grid-cols-4 md:grid-cols-8 lg:grid-cols-12 gap-0.5" id="mosaic-grid">
                    <% anggotaList.forEach(anggota => { 
                        const vals = anggota.dataValues || anggota;
                        const foto = vals.Foto || vals.fotoFile;
                        const nama = vals.Nama;
                        const jabatan = vals.Jabatan || 'Warga';
                        const role = vals.Role;
                        const id = vals.ID_Pengguna;
                    %>
                        <div class="mosaic-item relative aspect-square group z-0 hover:z-50" data-role="<%= role === 'Admin' ? 'Admin' : 'User' %>">
                            
                            <div class="absolute inset-0 w-full h-full bg-deep/5 overflow-hidden cursor-pointer 
                                        transition-all duration-500 ease-elastic origin-center
                                        group-hover:scale-[1.75] group-hover:shadow-pop group-hover:rounded-sm border border-transparent group-hover:border-gold/50">
                                
                                <% if (foto) { %>
                                    <img src="/images/anggota/<%= foto %>" loading="lazy" class="w-full h-full object-cover filter grayscale sepia-[0.3] group-hover:grayscale-0 group-hover:sepia-0 transition-all duration-500">
                                <% } else { %>
                                    <div class="w-full h-full flex items-center justify-center bg-sand/20 text-deep/30 group-hover:bg-deep group-hover:text-gold transition-colors duration-500">
                                        <span class="font-crest text-[10px]"><%= nama.charAt(0) %></span>
                                    </div>
                                <% } %>

                                <div class="absolute inset-0 bg-gradient-to-t from-deep/90 via-deep/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 delay-75 flex flex-col justify-end p-3">
                                    <span class="text-[6px] uppercase tracking-widest text-gold mb-1 truncate"><%= role === 'Admin' ? '★ ' + jabatan : jabatan %></span>
                                    <h3 class="font-serif text-[10px] text-paper leading-tight truncate"><%= nama %></h3>
                                </div>
                                
                                <a href="/anggota/<%= id %>" class="absolute inset-0"></a>
                            </div>
                        </div>
                    <% }) %>
                </div>
                <div class="text-center mt-6 opacity-30 text-[9px] uppercase tracking-widest">Total: <%= anggotaList.length %> Warga</div>
            </div>
        <% } else { %>
            <div class="max-w-lg mx-auto text-center py-20 border border-dashed border-deep/10"><p class="text-deep/40 text-sm italic">Data belum tersedia.</p></div>
        <% } %>
    </main>
    <%- include('../partials/footer.ejs') %>
    
    <script>
        const lenis = new Lenis({smooth: true});
        function raf(time) { lenis.raf(time); requestAnimationFrame(raf); }
        requestAnimationFrame(raf);

        function filterAnggota(role) {
            const items = document.querySelectorAll('.mosaic-item');
            document.querySelectorAll('.filter-btn').forEach(b => b.className = 'filter-btn px-4 py-1.5 text-[9px] uppercase tracking-widest font-bold text-deep/50 hover:text-deep transition-all');
            document.getElementById(`btn-${role}`).className = 'filter-btn px-4 py-1.5 text-[9px] uppercase tracking-widest font-bold bg-deep text-paper border border-deep transition-all';
            
            items.forEach(item => {
                if(role === 'all' || item.dataset.role === role) {
                    item.style.display = 'block';
                } else {
                    item.style.display = 'none';
                }
            });
        }
    </script>
</body>
</html>