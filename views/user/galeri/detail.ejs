<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= groupFoto.Nama || 'Album' %> - Galeri Foto</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        main: '#003024',    // Background Gelap
                        surface: '#004030', // Warna Kartu
                        accent: '#83C540',  // Hijau Neon
                        pale: '#F5FEF9',    // Teks Putih
                        muted: '#A3C2B8',   // Teks Pudar
                    },
                    fontFamily: { sans: ['Inter', 'sans-serif'] }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer base { 
            body { @apply bg-main text-pale font-sans antialiased; } 
            .custom-scroll::-webkit-scrollbar { width: 8px; }
            .custom-scroll::-webkit-scrollbar-track { @apply bg-main; }
            .custom-scroll::-webkit-scrollbar-thumb { @apply bg-surface border border-white/10 rounded-full hover:bg-accent/50; }
        }
    </style>
</head>
<body class="flex h-screen overflow-hidden">

    <%- include('../../partials/user_sidebar.ejs') %>

    <main class="flex-1 overflow-y-auto custom-scroll p-6 md:p-10 relative">
        
        <div class="fixed top-0 right-0 w-[500px] h-[500px] bg-accent/5 rounded-full blur-[100px] pointer-events-none -z-10"></div>

        <%- include('../../partials/flash.ejs') %>

        <div class="mb-8">
            <a href="/user/galeri" class="inline-flex items-center text-muted hover:text-accent transition-colors duration-300 group">
                <div class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center mr-3 group-hover:bg-accent group-hover:text-main transition-all border border-white/5 group-hover:border-accent">
                    <svg class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                    </svg>
                </div>
                <span class="font-semibold text-sm">Kembali ke Galeri</span>
            </a>
        </div>

        <div class="max-w-7xl mx-auto">
            <div class="bg-surface border border-white/5 rounded-3xl p-8 mb-8 relative overflow-hidden flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
                <div class="absolute top-0 right-0 p-10 opacity-5 pointer-events-none">
                    <svg class="w-40 h-40 text-accent" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"></path></svg>
                </div>

                <div class="relative z-10">
                    <div class="flex items-center gap-4 mb-2">
                        <div class="p-2 bg-accent/10 rounded-lg text-accent">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                        </div>
                        <h1 class="text-3xl md:text-4xl font-bold text-pale">
                            <%= groupFoto.Nama || 'Album Tanpa Nama' %>
                        </h1>
                    </div>
                    <p class="text-muted ml-12">
                        Menampilkan <%= groupFoto.dataValues.fotoFiles.length %> foto dalam album ini
                    </p>
                </div>
            </div>

            <% if (groupFoto.dataValues.fotoFiles && groupFoto.dataValues.fotoFiles.length > 0) { %>
                <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
                    <% for(let foto of groupFoto.dataValues.fotoFiles) { %>
                        <div class="relative group cursor-pointer rounded-2xl overflow-hidden border border-white/5 bg-surface aspect-square shadow-lg" onclick="openLightbox('<%= foto.Foto %>')">
                            <img src="/images/galeri/<%= foto.Foto %>" 
                                 alt="Foto Galeri"
                                 class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700 ease-out">
                            
                            <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center backdrop-blur-[2px]">
                                <div class="transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
                                    <div class="w-12 h-12 rounded-full bg-accent/20 border border-accent/50 flex items-center justify-center text-accent">
                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path>
                                        </svg>
                                    </div>
                                    <p class="text-xs text-center text-white mt-2 font-medium tracking-wide">Lihat</p>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } else { %>
                <div class="flex flex-col items-center justify-center py-20 bg-surface/30 rounded-3xl border border-white/5 border-dashed">
                    <div class="bg-white/5 p-6 rounded-full mb-4">
                        <svg class="w-12 h-12 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                    </div>
                    <p class="text-muted text-lg">Album ini belum memiliki foto.</p>
                </div>
            <% } %>
        </div>
    </main>

    <div id="lightbox" class="fixed inset-0 bg-black/95 z-[9999] hidden items-center justify-center p-4 backdrop-blur-sm opacity-0 transition-opacity duration-300">
        <div class="relative w-full max-w-6xl h-full flex flex-col items-center justify-center">
            
            <button onclick="closeLightbox()" class="absolute top-4 right-4 md:right-0 md:-top-8 text-white/70 hover:text-accent transition-colors z-50 p-2 bg-black/50 rounded-full md:bg-transparent">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
            
            <div class="relative w-full h-full flex items-center justify-center group/lightbox" onclick="event.stopPropagation()">
                <img id="lightbox-img" src="" alt="Preview" class="max-w-full max-h-[80vh] md:max-h-[90vh] rounded-lg shadow-2xl border border-white/10 transform scale-95 transition-transform duration-300">
                
                <button onclick="prevImage(event)" class="absolute left-0 md:-left-12 text-white/50 hover:text-white hover:bg-white/10 p-2 rounded-full transition-all focus:outline-none bg-black/20 md:bg-transparent">
                    <svg class="w-10 h-10 md:w-16 md:h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                </button>
                
                <button onclick="nextImage(event)" class="absolute right-0 md:-right-12 text-white/50 hover:text-white hover:bg-white/10 p-2 rounded-full transition-all focus:outline-none bg-black/20 md:bg-transparent">
                    <svg class="w-10 h-10 md:w-16 md:h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </button>
            </div>

            <div class="absolute bottom-4 left-1/2 transform -translate-x-1/2 bg-surface/80 backdrop-blur-md px-4 py-2 rounded-full border border-white/10 text-sm font-semibold text-pale shadow-xl z-50">
                <span id="current-index" class="text-accent">1</span> <span class="text-muted mx-1">/</span> <span id="total-images"><%= groupFoto.dataValues.fotoFiles.length %></span>
            </div>
        </div>
    </div>

    <script>
        // Data Foto dari Server
        const fotoList = [
            <% for(let foto of groupFoto.dataValues.fotoFiles) { %>
                '<%= foto.Foto %>',
            <% } %>
        ];
        
        let currentIndex = 0;
        const lightbox = document.getElementById('lightbox');
        const img = document.getElementById('lightbox-img');

        function openLightbox(foto) {
            currentIndex = fotoList.indexOf(foto);
            updateLightboxImage();
            
            lightbox.classList.remove('hidden');
            lightbox.classList.add('flex');
            
            // Animasi Fade In
            setTimeout(() => {
                lightbox.classList.remove('opacity-0');
                img.classList.remove('scale-95');
                img.classList.add('scale-100');
            }, 10);
        }

        function closeLightbox() {
            lightbox.classList.add('opacity-0');
            img.classList.remove('scale-100');
            img.classList.add('scale-95');
            
            setTimeout(() => {
                lightbox.classList.add('hidden');
                lightbox.classList.remove('flex');
            }, 300);
        }

        function prevImage(event) {
            event.stopPropagation();
            currentIndex = (currentIndex - 1 + fotoList.length) % fotoList.length;
            animateSwap();
        }

        function nextImage(event) {
            event.stopPropagation();
            currentIndex = (currentIndex + 1) % fotoList.length;
            animateSwap();
        }

        function updateLightboxImage() {
            img.src = '/images/galeri/' + fotoList[currentIndex];
            document.getElementById('current-index').textContent = currentIndex + 1;
        }

        function animateSwap() {
            // Efek transisi sederhana saat ganti gambar
            img.classList.add('opacity-50');
            setTimeout(() => {
                updateLightboxImage();
                img.classList.remove('opacity-50');
            }, 150);
        }

        // Keyboard Navigation
        document.addEventListener('keydown', function(e) {
            if (!lightbox.classList.contains('hidden')) {
                if (e.key === 'Escape') closeLightbox();
                if (e.key === 'ArrowLeft') prevImage(e);
                if (e.key === 'ArrowRight') nextImage(e);
            }
        });
        
        // Klik background untuk menutup
        lightbox.addEventListener('click', function(e) {
            if (e.target === lightbox || e.target.classList.contains('w-full')) {
                closeLightbox();
            }
        });
    </script>
</body>
</html>