<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tim Kami - Bausasran</title>
    
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        main: '#003024',    // Background Gelap
                        surface: '#004030', // Warna Kartu
                        accent: '#83C540',  // Hijau Neon
                        pale: '#F5FEF9',    // Teks Putih
                        muted: '#A3C2B8',   // Teks Pudar
                        admin: '#C084FC',   // Ungu untuk Badge Admin
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style type="text/tailwindcss">
        @layer base {
            body {
                @apply bg-main text-pale font-sans antialiased;
            }
        }
    </style>
</head>

<body class="flex flex-col min-h-screen">

    <%- include('../partials/navbar.ejs') %>

    <main class="container mx-auto px-4 py-12 flex-grow">
        <%- include('../partials/flash.ejs') %>

        <div class="text-center mb-12">
            <h1 class="text-4xl md:text-5xl font-bold text-pale mb-4">
                Tim <span class="text-accent">Kami</span>
            </h1>
            <p class="text-lg text-muted max-w-2xl mx-auto">
                Kenali para penggerak yang berdedikasi membangun kemajuan Kampung Wisata Bausasran.
            </p>
        </div>

        <div class="flex flex-wrap justify-center mb-10 gap-3">
            <button onclick="filterAnggota('all')" id="btn-all" 
                class="filter-btn active px-6 py-2.5 rounded-full text-sm font-bold border border-accent bg-accent text-main transition-all duration-300 shadow-[0_0_15px_rgba(131,197,64,0.3)]">
                Semua
            </button>
            <button onclick="filterAnggota('Admin')" id="btn-Admin" 
                class="filter-btn px-6 py-2.5 rounded-full text-sm font-bold border border-white/10 text-muted hover:border-admin hover:text-white bg-surface transition-all duration-300">
                Admin
            </button>
            <button onclick="filterAnggota('User')" id="btn-User" 
                class="filter-btn px-6 py-2.5 rounded-full text-sm font-bold border border-white/10 text-muted hover:border-accent hover:text-white bg-surface transition-all duration-300">
                Anggota
            </button>
        </div>

        <% if(anggotaList && anggotaList.length > 0) { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                <% anggotaList.forEach(anggota => { %>
                    <div class="anggota-card group bg-surface border border-white/5 rounded-2xl overflow-hidden shadow-lg hover:shadow-accent/10 hover:border-accent/30 transition-all duration-300 transform hover:-translate-y-1" data-role="<%= anggota.Role %>">
                        
                        <div class="relative h-72 w-full overflow-hidden bg-main">
                            <% if (anggota.dataValues.fotoFile) { %>
                                <img src="/images/anggota/<%= anggota.dataValues.fotoFile %>" 
                                     alt="<%= anggota.Nama %>" 
                                     class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 filter grayscale group-hover:grayscale-0">
                            <% } else { %>
                                <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-surface to-main">
                                    <svg class="w-24 h-24 text-muted/20" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
                                    </svg>
                                </div>
                            <% } %>
                            
                            <div class="absolute top-4 right-4">
                                <% if (anggota.Role === 'Admin') { %>
                                    <span class="px-3 py-1 bg-admin/20 text-admin border border-admin/50 backdrop-blur-md text-xs font-bold rounded-lg shadow-sm">
                                        ADMIN
                                    </span>
                                <% } else { %>
                                    <span class="px-3 py-1 bg-accent/20 text-accent border border-accent/50 backdrop-blur-md text-xs font-bold rounded-lg shadow-sm">
                                        ANGGOTA
                                    </span>
                                <% } %>
                            </div>
                            
                            <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-surface to-transparent"></div>
                        </div>

                        <div class="relative p-6 pt-2">
                            <h3 class="text-xl font-bold text-pale mb-1 group-hover:text-accent transition-colors"><%= anggota.Nama %></h3>
                            
                            <% if (anggota.Jabatan) { %>
                                <p class="text-accent text-sm font-semibold tracking-wide uppercase mb-4"><%= anggota.Jabatan %></p>
                            <% } else { %>
                                <p class="text-muted text-sm font-medium mb-4 italic">Anggota Bausasran</p>
                            <% } %>

                            <div class="space-y-2 mb-6">
                                <% if (anggota.No_Telepon) { %>
                                    <div class="flex items-center text-muted text-sm">
                                        <svg class="w-4 h-4 mr-2 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                                        <%= anggota.No_Telepon %>
                                    </div>
                                <% } %>
                                <% if (anggota.Alamat) { %>
                                    <div class="flex items-start text-muted text-sm">
                                        <svg class="w-4 h-4 mr-2 mt-0.5 text-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                                        <span class="line-clamp-2"><%= anggota.Alamat %></span>
                                    </div>
                                <% } %>
                            </div>

                            <a href="/anggota/<%= anggota.ID_Pengguna %>" 
                               class="block w-full text-center py-2.5 rounded-lg border border-white/10 bg-white/5 text-pale hover:bg-accent hover:text-main hover:border-accent font-semibold text-sm transition-all duration-300">
                                Lihat Profil
                            </a>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="text-center py-20 border-2 border-dashed border-white/10 rounded-2xl bg-surface/30">
                <svg class="w-20 h-20 mx-auto text-muted mb-4 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                </svg>
                <h3 class="text-xl font-bold text-pale mb-2">Belum Ada Anggota</h3>
                <p class="text-muted">Data anggota akan segera diperbarui.</p>
            </div>
        <% } %>
    </main>

    <%- include('../partials/footer.ejs') %>

    <script>
        function filterAnggota(role) {
            const cards = document.querySelectorAll('.anggota-card');
            const buttons = document.querySelectorAll('.filter-btn');
            
            // 1. Reset Styles for All Buttons
            buttons.forEach(btn => {
                // Remove Active Classes
                btn.classList.remove('bg-accent', 'text-main', 'border-accent', 'shadow-[0_0_15px_rgba(131,197,64,0.3)]');
                // Add Inactive Classes
                btn.classList.add('bg-surface', 'text-muted', 'border-white/10');
            });

            // 2. Set Active Style for Clicked Button
            const activeBtn = document.getElementById(`btn-${role}`);
            if(activeBtn) {
                activeBtn.classList.remove('bg-surface', 'text-muted', 'border-white/10');
                activeBtn.classList.add('bg-accent', 'text-main', 'border-accent', 'shadow-[0_0_15px_rgba(131,197,64,0.3)]');
            }
            
            // 3. Filter Cards with Animation
            cards.forEach(card => {
                if (role === 'all' || card.dataset.role === role) {
                    card.style.display = 'block';
                    // Simple fade in animation
                    card.animate([
                        { opacity: 0, transform: 'translateY(10px)' },
                        { opacity: 1, transform: 'translateY(0)' }
                    ], { duration: 300, fill: 'forwards' });
                } else {
                    card.style.display = 'none';
                }
            });
        }
    </script>

</body>
</html>