<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Review #<%= review.ID_Review %></title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        main: '#003024',    // Background Gelap
                        surface: '#004030', // Warna Kartu
                        accent: '#83C540',  // Hijau Neon
                        pale: '#F5FEF9',    // Teks Putih
                        muted: '#A3C2B8',   // Teks Pudar
                        darker: '#00251a',  // Background Input
                        danger: '#ff4d4d',  // Merah Error
                        warning: '#FFC107', // Kuning Warning
                    },
                    fontFamily: { sans: ['Inter', 'sans-serif'] }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer base { body { @apply bg-main text-pale font-sans antialiased; } }
        
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #004030; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #83C540; }

        /* Input Styling */
        .form-input {
            @apply w-full bg-darker border border-white/10 rounded-xl px-4 py-3 text-sm text-pale focus:border-accent focus:ring-1 focus:ring-accent outline-none transition-all placeholder-white/20;
        }
        .form-select {
            @apply w-full bg-darker border border-white/10 rounded-xl px-4 py-3 text-sm text-pale focus:border-accent focus:ring-1 focus:ring-accent outline-none transition-all appearance-none cursor-pointer;
        }
        .form-label {
            @apply block text-xs font-bold text-muted mb-2 uppercase tracking-wider;
        }
    </style>
</head>

<body class="flex h-screen overflow-hidden w-full">

    <%- include('../../partials/admin_sidebar.ejs') %>

    <main class="flex-1 h-full overflow-y-auto overflow-x-hidden p-6 md:p-8 relative">
        <%- include('../../partials/flash.ejs') %>

        <form action="/admin/testimoni/<%= review.ID_Review %>/edit" method="POST">
            
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
                
                <div class="flex-1">
                    <h1 class="text-3xl font-bold text-pale tracking-tight flex items-center gap-2">
                        <span class="text-accent">Edit Review</span> #<%= review.ID_Review %>
                    </h1>
                    <p class="text-muted text-sm mt-1">Kelola ulasan dan feedback dari pengguna.</p>
                </div>

                <div class="flex items-center gap-3 shrink-0">
                    <a href="/admin/testimoni" class="bg-surface hover:bg-white/10 text-pale font-bold py-2.5 px-6 rounded-xl border border-white/10 transition-all text-sm shadow-lg text-center">
                        Kembali
                    </a>
                    <button type="submit" class="bg-accent hover:bg-accent/90 text-main font-bold py-2.5 px-6 rounded-xl shadow-lg shadow-accent/20 transition-all flex items-center gap-2 text-sm">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        Simpan Perubahan
                    </button>
                </div>
            </div>

            <div class="bg-surface rounded-2xl p-6 md:p-8 shadow-xl border border-white/5">
                
                <h3 class="text-lg font-bold text-pale mb-6 border-b border-white/5 pb-4 flex items-center gap-2">
                    <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                    Detail Ulasan
                </h3>

                <div class="space-y-6">
                    
                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                        <div>
                            <label for="ID_Pengguna" class="form-label">Pengguna (Pemberi Review)</label>
                            <div class="relative">
                                <select id="ID_Pengguna" name="ID_Pengguna" class="form-select" required>
                                    <option value="" class="bg-main">-- Pilih Pengguna --</option>
                                    <% if(penggunaList && penggunaList.length > 0) { %>
                                        <% for(let pengguna of penggunaList) { %>
                                            <option value="<%= pengguna.ID_Pengguna %>" <%= review.ID_Pengguna === pengguna.ID_Pengguna ? 'selected' : '' %> class="bg-main">
                                                <%= pengguna.Nama %> (<%= pengguna.Role %>)
                                            </option>
                                        <% } %>
                                    <% } %>
                                </select>
                                <div class="absolute inset-y-0 right-0 flex items-center px-4 pointer-events-none text-muted">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                                </div>
                            </div>
                        </div>

                        <div>
                            <label for="Kategori" class="form-label">Kategori Review</label>
                            <div class="relative">
                                <select id="Kategori" name="Kategori" class="form-select" required onchange="toggleKategori(this.value)">
                                    <option value="" class="bg-main">-- Pilih Kategori --</option>
                                    <option value="Product" <%= review.Kategori === 'Product' ? 'selected' : '' %> class="bg-main">Product (Produk)</option>
                                    <option value="Kegiatan" <%= review.Kategori === 'Kegiatan' ? 'selected' : '' %> class="bg-main">Kegiatan</option>
                                </select>
                                <div class="absolute inset-y-0 right-0 flex items-center px-4 pointer-events-none text-muted">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
                        
                        <div id="dynamic-selection-area" class="bg-darker/30 p-4 rounded-xl border border-white/5 transition-all min-h-[86px] flex flex-col justify-center">
                            
                            <div id="produk-section" style="display: <%= review.Kategori === 'Product' ? 'block' : 'none' %>;">
                                <label for="ID_Product" class="form-label text-accent">Pilih Produk yang Direview</label>
                                <div class="relative">
                                    <select id="ID_Product" name="ID_Product" class="form-select">
                                        <option value="" class="bg-main">-- Pilih Produk --</option>
                                        <% if(produkList && produkList.length > 0) { %>
                                            <% for(let produk of produkList) { %>
                                                <option value="<%= produk.ID_Product %>" <%= review.ID_Product === produk.ID_Product ? 'selected' : '' %> class="bg-main">
                                                    <%= produk.Nama %>
                                                </option>
                                            <% } %>
                                        <% } %>
                                    </select>
                                    <div class="absolute inset-y-0 right-0 flex items-center px-4 pointer-events-none text-muted">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                                    </div>
                                </div>
                            </div>

                            <div id="kegiatan-section" style="display: <%= review.Kategori === 'Kegiatan' ? 'block' : 'none' %>;">
                                <label for="ID_Kegiatan" class="form-label text-accent">Pilih Kegiatan yang Direview</label>
                                <div class="relative">
                                    <select id="ID_Kegiatan" name="ID_Kegiatan" class="form-select">
                                        <option value="" class="bg-main">-- Pilih Kegiatan --</option>
                                        <% if(kegiatanList && kegiatanList.length > 0) { %>
                                            <% for(let kegiatan of kegiatanList) { %>
                                                <option value="<%= kegiatan.ID_Kegiatan %>" <%= review.ID_Kegiatan === kegiatan.ID_Kegiatan ? 'selected' : '' %> class="bg-main">
                                                    <%= kegiatan.Judul %>
                                                </option>
                                            <% } %>
                                        <% } %>
                                    </select>
                                    <div class="absolute inset-y-0 right-0 flex items-center px-4 pointer-events-none text-muted">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                                    </div>
                                </div>
                            </div>

                            <div id="no-kategori-msg" class="text-center text-muted text-sm py-2 italic" style="display: <%= !review.Kategori ? 'block' : 'none' %>;">
                                Pilih kategori di atas untuk menampilkan opsi terkait.
                            </div>
                        </div>

                        <div>
                            <div class="p-4 rounded-xl border border-white/5 bg-darker/30 min-h-[86px] flex flex-col justify-center">
                                <label for="Rating" class="form-label">Rating</label>
                                <div class="relative">
                                    <select id="Rating" name="Rating" class="form-select font-bold text-warning border-none bg-transparent focus:ring-0 p-0 h-auto text-lg" required>
                                        <option value="" class="bg-main text-muted">-- Pilih Rating --</option>
                                        <option value="1" <%= review.Rating === 1 ? 'selected' : '' %> class="bg-main">⭐ 1 - Sangat Buruk</option>
                                        <option value="2" <%= review.Rating === 2 ? 'selected' : '' %> class="bg-main">⭐⭐ 2 - Buruk</option>
                                        <option value="3" <%= review.Rating === 3 ? 'selected' : '' %> class="bg-main">⭐⭐⭐ 3 - Cukup</option>
                                        <option value="4" <%= review.Rating === 4 ? 'selected' : '' %> class="bg-main">⭐⭐⭐⭐ 4 - Baik</option>
                                        <option value="5" <%= review.Rating === 5 ? 'selected' : '' %> class="bg-main">⭐⭐⭐⭐⭐ 5 - Sangat Baik</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div>
                        <label for="Ulasan" class="form-label">Isi Ulasan / Komentar</label>
                        <textarea id="Ulasan" name="Ulasan" rows="6" class="form-input resize-y text-lg leading-relaxed" placeholder="Tuliskan pendapat pengguna di sini..."><%= review.Ulasan || '' %></textarea>
                        <p class="text-xs text-muted mt-2 opacity-60">Ulasan ini akan ditampilkan di halaman detail produk atau kegiatan terkait.</p>
                    </div>

                </div>
            </div>
        </form>
    </main>

    <script>
        function toggleKategori(kategori) {
            const produkSection = document.getElementById('produk-section');
            const kegiatanSection = document.getElementById('kegiatan-section');
            const noKategoriMsg = document.getElementById('no-kategori-msg');
            
            const produkSelect = document.getElementById('ID_Product');
            const kegiatanSelect = document.getElementById('ID_Kegiatan');

            // Reset tampilan
            produkSection.style.display = 'none';
            kegiatanSection.style.display = 'none';
            noKategoriMsg.style.display = 'none';

            // Reset required
            produkSelect.required = false;
            kegiatanSelect.required = false;

            if (kategori === 'Product') {
                produkSection.style.display = 'block';
                produkSelect.required = true;
                // Opsional: Reset value kegiatan jika pindah ke produk
                kegiatanSelect.value = ''; 
            } else if (kategori === 'Kegiatan') {
                kegiatanSection.style.display = 'block';
                kegiatanSelect.required = true;
                // Opsional: Reset value produk jika pindah ke kegiatan
                produkSelect.value = '';
            } else {
                noKategoriMsg.style.display = 'block';
            }
        }
    </script>
</body>
</html>