<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detail Anggota</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="flex bg-gray-100">
    <%- include('../../partials/admin_sidebar.ejs') %>

    <main class="flex-1 p-10">
        <%- include('../../partials/flash.ejs') %>

        <div class="flex justify-between items-center mb-6">
            <div>
                <h1 class="text-3xl font-bold text-gray-800"><%= anggota.Nama %></h1>
                <p class="text-gray-600">Detail data anggota</p>
            </div>
            <div class="flex space-x-2">
                <a href="/admin/anggota" class="bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold py-2 px-4 rounded-lg">
                    &larr; Kembali
                </a>
                <a href="/admin/anggota/<%= anggota.ID_Pengguna %>/edit" class="bg-yellow-500 hover:bg-yellow-600 text-white font-bold py-2 px-4 rounded-lg">
                    Edit Data Ini
                </a>
            </div>
        </div>

        <div class="bg-white p-8 rounded-lg shadow-lg max-w-4xl mx-auto">
            <div class="flex flex-col md:flex-row md:space-x-8">
                
                <div class="md:w-1/3 text-center mb-6 md:mb-0 flex-shrink-0">
                    <h3 class="text-sm font-semibold text-gray-500 uppercase mb-3">Foto Profil</h3>
                    <% if (anggota.dataValues.fotoFile) { %>
                        <img src="/images/anggota/<%= anggota.dataValues.fotoFile %>" alt="<%= anggota.Nama %>" class="w-48 h-48 rounded-full object-cover mx-auto shadow-md border-4 border-white">
                    <% } else { %>
                        <div class="w-48 h-48 rounded-full bg-gray-300 flex items-center justify-center text-gray-600 mx-auto shadow-md border-4 border-white">
                            <span class="text-sm">Tidak Ada Foto</span>
                        </div>
                    <% } %>
                </div>

                <div class="md:w-2/3">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                        <div>
                            <h3 class="text-sm font-semibold text-gray-500 uppercase">Nama Lengkap</h3>
                            <p class="text-lg text-gray-800"><%= anggota.Nama %></p>
                        </div>
                        <div>
                            <h3 class="text-sm font-semibold text-gray-500 uppercase">Jabatan</h3>
                            <p class="text-lg text-gray-800"><%= anggota.Jabatan || '-' %></p>
                        </div>
                        <div>
                            <h3 class="text-sm font-semibold text-gray-500 uppercase">Username</h3>
                            <p class="text-lg text-gray-800 font-mono"><%= anggota.username %></p>
                        </div>
                        <div>
                            <h3 class="text-sm font-semibold text-gray-500 uppercase">Role</h3>
                            <p class="text-lg font-medium <%= anggota.Role === 'Admin' ? 'text-red-600' : 'text-green-600' %>">
                                <%= anggota.Role %>
                            </p>
                        </div>
                    </div>
                    
                    <hr class="my-6">

                    <div>
    <h3 class="text-sm font-semibold text-gray-500 uppercase">Deskripsi (Bio)</h3>
    <div class="prose max-w-none text-gray-700 mt-2">
        <% if (anggota.Deskripsi) { %>
            <p><%- anggota.Deskripsi.replace(/\n/g, '<br>') %></p>
        <% } else { %>
            <p class="italic text-gray-500">Tidak ada deskripsi.</p>
        <% } %>
    </div>
</div>
                </div>
            </div>
        </div>
    </main>
</body>
</html>