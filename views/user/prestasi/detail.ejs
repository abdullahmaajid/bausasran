<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= prestasi.Judul %> - Arsip Prestasi</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        paper: '#F9F7F2',       // Background Utama
                        deep: '#0F1F18',        // Teks Utama / Aksen Gelap
                        gold: '#C5B388',        // Aksen Emas
                        charcoal: '#4A4A4A',    // Teks Sekunder
                        linen: '#EBE9E4',       // Background Kartu
                    },
                    fontFamily: {
                        sans: ['Lato', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                        crest: ['Cinzel', 'serif'],
                    },
                    letterSpacing: {
                        'luxury': '0.2em',
                    },
                    boxShadow: {
                        'elegant': '0 20px 50px -12px rgba(15, 31, 24, 0.1)',
                    }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer base { 
            body { 
                @apply bg-paper text-deep font-sans antialiased; 
            } 
            .custom-scroll::-webkit-scrollbar { width: 6px; }
            .custom-scroll::-webkit-scrollbar-track { @apply bg-paper; }
            .custom-scroll::-webkit-scrollbar-thumb { @apply bg-deep/20 hover:bg-gold rounded-full transition-colors; }
        }

        /* Texture Grain Overlay */
        .noise-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none; z-index: 0; mix-blend-mode: multiply;
        }
    </style>
</head>
<body class="flex h-screen overflow-hidden relative">

    <div class="noise-overlay"></div>

    <%- include('../../partials/user_sidebar.ejs') %>

    <main class="flex-1 overflow-y-auto custom-scroll p-8 md:p-12 relative z-10">
        
        <%- include('../../partials/flash.ejs') %>

        <div class="mb-8 border-b border-deep/10 pb-4">
            <a href="/user/prestasi" class="inline-flex items-center text-[10px] uppercase tracking-luxury font-bold text-deep/60 hover:text-gold transition-colors duration-300 group">
                <svg class="w-3 h-3 mr-2 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
                Kembali ke Daftar Prestasi
            </a>
        </div>

        <div class="max-w-6xl mx-auto">
            
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
                
                <div class="lg:col-span-2 space-y-10">
                    
                    <div>
                        <div class="flex items-center gap-4 mb-4">
                            <span class="text-[10px] uppercase tracking-luxury text-gold font-bold border-b border-gold pb-1">
                                Pencapaian & Penghargaan
                            </span>
                        </div>

                        <h1 class="text-3xl md:text-5xl font-crest text-deep mb-6 leading-tight flex items-start gap-4">
                            <svg class="w-12 h-12 text-gold opacity-80 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1.323l3.954 1.582 1.599-.8a1 1 0 01.894 1.79l-1.233.616 1.738 5.42a1 1 0 01-.285 1.05A3.989 3.989 0 0115 15a3.989 3.989 0 01-2.667-1.019 1 1 0 01-.285-1.05l1.715-5.349L11 6.477V16h2a1 1 0 110 2H7a1 1 0 110-2h2V6.477L6.237 7.582l1.715 5.349a1 1 0 01-.285 1.05A3.989 3.989 0 015 15a3.989 3.989 0 01-2.667-1.019 1 1 0 01-.285-1.05l1.738-5.42-1.233-.616a1 1 0 01.894-1.79l1.599.8L9 4.323V3a1 1 0 011-1z" clip-rule="evenodd"></path>
                            </svg>
                            <%= prestasi.Judul %>
                        </h1>

                        <div class="w-full h-px bg-deep/10 mb-1"></div>
                        <div class="w-full h-px bg-deep/5 mb-8"></div>

                        <% if (prestasi.Deskripsi) { %>
                            <div class="font-serif text-lg text-charcoal leading-loose text-justify bg-white/50 p-6 border border-deep/5 rounded-sm">
                                <p class="first-letter:text-5xl first-letter:font-crest first-letter:text-deep first-letter:mr-3 first-letter:float-left first-letter:leading-none">
                                    <%= prestasi.Deskripsi %>
                                </p>
                            </div>
                        <% } %>
                    </div>

                    <% if (prestasi.dataValues.fotoFiles && prestasi.dataValues.fotoFiles.length > 0) { %>
                        <div class="pt-8">
                            <h3 class="font-crest text-lg text-deep mb-6 flex items-center uppercase tracking-widest">
                                <span class="mr-4">Dokumentasi</span>
                                <span class="h-px flex-1 bg-deep/10"></span>
                            </h3>

                            <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                                <% for(let foto of prestasi.dataValues.fotoFiles) { %>
                                    <div class="group cursor-pointer relative bg-white p-3 shadow-sm hover:shadow-elegant border border-deep/5 transition-all duration-500 rotate-0 hover:rotate-2 hover:scale-105" onclick="openLightbox('<%= foto %>')">
                                        <div class="aspect-square relative overflow-hidden bg-linen border border-deep/10">
                                            <img src="/images/prestasi/<%= foto %>" 
                                                 alt="Dokumentasi"
                                                 class="w-full h-full object-cover filter sepia-[20%] group-hover:sepia-0 transition-all duration-700">
                                            
                                            <div class="absolute inset-0 bg-deep/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                                                <div class="bg-paper p-2 rounded-full shadow-lg">
                                                    <svg class="w-4 h-4 text-deep" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path></svg>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    <% } %>
                </div>

                <div class="lg:col-span-1">
                    <div class="sticky top-8">
                        <div class="bg-white border-2 border-double border-gold/50 p-8 shadow-elegant relative overflow-hidden group">
                            
                            <div class="absolute -bottom-10 -right-10 opacity-[0.05] pointer-events-none">
                                <svg class="w-40 h-40 text-deep" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"></path></svg>
                            </div>

                            <h3 class="font-crest text-lg text-deep mb-6 uppercase tracking-widest text-center border-b border-deep/10 pb-4">
                                Detail Sertifikat
                            </h3>

                            <div class="space-y-8 relative z-10">
                                <% if (prestasi.Tanggal) { %>
                                    <div class="text-center">
                                        <p class="text-[9px] uppercase tracking-luxury text-charcoal/50 mb-2">Tanggal Perolehan</p>
                                        <p class="font-serif text-xl text-deep font-bold italic">
                                            <%= new Date(prestasi.Tanggal).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                                        </p>
                                    </div>
                                <% } %>

                                <% if (prestasi.Penyelenggara) { %>
                                    <div class="text-center border-t border-deep/5 pt-6">
                                        <p class="text-[9px] uppercase tracking-luxury text-charcoal/50 mb-2">Penyelenggara</p>
                                        <p class="font-crest text-lg text-deep leading-relaxed font-bold">
                                            <%= prestasi.Penyelenggara %>
                                        </p>
                                    </div>
                                <% } %>
                            </div>

                            <div class="mt-10 pt-6 border-t border-deep/10 text-center">
                                <div class="inline-block p-1 border border-deep/20 rounded-full">
                                    <div class="w-16 h-16 bg-gold/20 rounded-full flex items-center justify-center mx-auto text-gold border border-gold/50">
                                        <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
                                    </div>
                                </div>
                                <p class="mt-3 font-serif text-xs italic text-charcoal/60">Terverifikasi</p>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </main>

    <div id="lightbox" class="fixed inset-0 bg-deep/95 z-[9999] hidden flex items-center justify-center p-4 backdrop-blur-md opacity-0 transition-opacity duration-300" onclick="closeLightbox()">
        <div class="relative max-w-5xl w-full flex flex-col items-center">
            
            <button onclick="closeLightbox()" class="absolute -top-12 right-0 md:right-0 text-white/50 hover:text-gold transition-colors">
                <span class="text-xs uppercase tracking-widest mr-2 font-crest">Tutup</span>
                <svg class="w-6 h-6 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
            
            <div class="bg-white p-2 shadow-2xl transform scale-95 transition-transform duration-500" id="lightbox-container">
                <img id="lightbox-img" src="" alt="Preview" class="max-w-full max-h-[85vh] border border-deep/10" onclick="event.stopPropagation()">
            </div>
        </div>
    </div>

    <script>
        const lightbox = document.getElementById('lightbox');
        const img = document.getElementById('lightbox-img');
        const container = document.getElementById('lightbox-container');

        function openLightbox(foto) {
            img.src = '/images/prestasi/' + foto;
            lightbox.classList.remove('hidden');
            setTimeout(() => {
                lightbox.classList.remove('opacity-0');
                container.classList.remove('scale-95');
                container.classList.add('scale-100');
            }, 10);
        }

        function closeLightbox() {
            lightbox.classList.add('opacity-0');
            container.classList.remove('scale-100');
            container.classList.add('scale-95');
            setTimeout(() => {
                lightbox.classList.add('hidden');
                img.src = '';
            }, 300);
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeLightbox();
            }
        });
    </script>
</body>
</html>