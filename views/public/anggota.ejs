<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Anggota - Bausasran</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-gray-100">

    <%- include('../partials/navbar.ejs') %>

    <main class="container mx-auto p-6 md:p-12">
        <%- include('../partials/flash.ejs') %>

        <!-- Header -->
        <div class="text-center mb-12">
            <h1 class="text-4xl font-bold text-gray-800 mb-4">Tim Kami</h1>
            <p class="text-lg text-gray-600">Kenali para anggota yang berdedikasi untuk kemajuan Bausasran</p>
        </div>

        <!-- Filter by Role -->
        <div class="flex justify-center mb-8 space-x-4">
            <button onclick="filterAnggota('all')" class="filter-btn px-6 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition">
                Semua
            </button>
            <button onclick="filterAnggota('Admin')" class="filter-btn px-6 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition">
                Admin
            </button>
            <button onclick="filterAnggota('User')" class="filter-btn px-6 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition">
                Anggota
            </button>
        </div>

        <!-- Anggota Grid -->
        <% if(anggotaList && anggotaList.length > 0) { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
                <% anggotaList.forEach(anggota => { %>
                    <div class="anggota-card bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-all transform hover:-translate-y-2" data-role="<%= anggota.Role %>">
                        <!-- Photo -->
                        <div class="relative h-64 bg-gray-200">
                            <% if (anggota.dataValues.fotoFile) { %>
                                <img src="/images/anggota/<%= anggota.dataValues.fotoFile %>" 
                                     alt="<%= anggota.Nama %>" 
                                     class="w-full h-full object-cover">
                            <% } else { %>
                                <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-blue-400 to-blue-600">
                                    <svg class="w-32 h-32 text-white" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
                                    </svg>
                                </div>
                            <% } %>
                            <!-- Role Badge -->
                            <div class="absolute top-4 right-4">
                                <span class="px-3 py-1 <%= anggota.Role === 'Admin' ? 'bg-purple-500' : 'bg-green-500' %> text-white text-xs font-bold rounded-full">
                                    <%= anggota.Role %>
                                </span>
                            </div>
                        </div>

                        <!-- Info -->
                        <div class="p-6">
                            <h3 class="text-xl font-bold text-gray-900 mb-2"><%= anggota.Nama %></h3>
                            <% if (anggota.Jabatan) { %>
                                <p class="text-blue-600 font-semibold mb-3"><%= anggota.Jabatan %></p>
                            <% } %>
                            <% if (anggota.No_Telepon) { %>
                                <p class="text-gray-600 text-sm mb-2">
                                    📞 <%= anggota.No_Telepon %>
                                </p>
                            <% } %>
                            <% if (anggota.Alamat) { %>
                                <p class="text-gray-600 text-sm mb-4">
                                    📍 <%= anggota.Alamat.substring(0, 50) %><%= anggota.Alamat.length > 50 ? '...' : '' %>
                                </p>
                            <% } %>
                            <a href="/anggota/<%= anggota.ID_Pengguna %>" 
                               class="block w-full text-center px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition">
                                Lihat Profil
                            </a>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="text-center py-16">
                <svg class="w-24 h-24 mx-auto text-gray-400 mb-4" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/>
                </svg>
                <h3 class="text-xl font-semibold text-gray-700 mb-2">Belum Ada Anggota</h3>
                <p class="text-gray-500">Data anggota akan segera hadir!</p>
            </div>
        <% } %>
    </main>

    <%- include('../partials/footer.ejs') %>

    <script>
        function filterAnggota(role) {
            const cards = document.querySelectorAll('.anggota-card');
            const buttons = document.querySelectorAll('.filter-btn');
            
            // Update button styles
            buttons.forEach(btn => {
                btn.classList.remove('bg-blue-500', 'text-white');
                btn.classList.add('bg-gray-200', 'text-gray-700');
            });
            event.target.classList.remove('bg-gray-200', 'text-gray-700');
            event.target.classList.add('bg-blue-500', 'text-white');
            
            // Filter cards
            cards.forEach(card => {
                if (role === 'all' || card.dataset.role === role) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }
    </script>

</body>
</html>
