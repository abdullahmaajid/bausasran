<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profil <%= anggota.Nama %> - Bausasran</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        main: '#003024',    // Background Gelap
                        surface: '#004030', // Warna Kartu
                        accent: '#83C540',  // Hijau Neon
                        pale: '#F5FEF9',    // Teks Putih
                        muted: '#A3C2B8',   // Teks Pudar
                    },
                    fontFamily: { sans: ['Inter', 'sans-serif'] }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer base { 
            body { @apply bg-main text-pale font-sans antialiased; } 
            .custom-scroll::-webkit-scrollbar { width: 8px; }
            .custom-scroll::-webkit-scrollbar-track { @apply bg-main; }
            .custom-scroll::-webkit-scrollbar-thumb { @apply bg-surface border border-white/10 rounded-full; }
        }
    </style>
</head>
<body class="flex h-screen overflow-hidden">

    <%- include('../../partials/user_sidebar.ejs') %>

    <main class="flex-1 overflow-y-auto custom-scroll p-6 md:p-10 relative">
        
        <div class="fixed top-0 right-0 w-[500px] h-[500px] bg-accent/5 rounded-full blur-[100px] pointer-events-none -z-10"></div>

        <%- include('../../partials/flash.ejs') %>

        <div class="mb-8">
            <a href="/user/anggota" class="inline-flex items-center text-muted hover:text-accent transition-colors duration-300 group">
                <div class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center mr-3 group-hover:bg-accent group-hover:text-main transition-all">
                    <svg class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                    </svg>
                </div>
                <span class="font-semibold text-sm">Kembali ke Daftar Anggota</span>
            </a>
        </div>

        <div class="bg-surface border border-white/5 rounded-3xl overflow-hidden shadow-2xl flex flex-col md:flex-row min-h-[500px]">
            
            <div class="md:w-5/12 lg:w-4/12 relative bg-black/20 group">
                <% if (anggota.dataValues.fotoFile) { %>
                    <img src="/images/anggota/<%= anggota.dataValues.fotoFile %>" 
                         alt="<%= anggota.Nama %>"
                         class="w-full h-full object-cover object-center absolute inset-0 transition-transform duration-700 group-hover:scale-105">
                    
                    <div class="absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent md:bg-gradient-to-r md:from-transparent md:to-surface opacity-90 md:opacity-100"></div>
                <% } else { %>
                    <div class="w-full h-full min-h-[300px] flex items-center justify-center bg-gradient-to-br from-surface to-main relative overflow-hidden">
                        <div class="absolute top-0 right-0 w-32 h-32 bg-accent/10 rounded-full blur-2xl"></div>
                        
                        <div class="text-center z-10">
                            <div class="w-24 h-24 mx-auto bg-white/5 rounded-full flex items-center justify-center mb-4 border border-white/10">
                                <span class="text-4xl font-bold text-accent">
                                    <%= anggota.Nama.charAt(0).toUpperCase() %>
                                </span>
                            </div>
                            <p class="text-muted text-sm">Tidak ada foto</p>
                        </div>
                    </div>
                <% } %>
            </div>

            <div class="md:w-7/12 lg:w-8/12 p-8 md:p-12 flex flex-col justify-center relative">
                
                <svg class="absolute top-8 right-8 w-20 h-20 text-white/5 rotate-12" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"></path>
                </svg>

                <div class="mb-2">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold tracking-wider uppercase 
                        <%= anggota.Role === 'Admin' ? 'bg-red-500/20 text-red-400 border border-red-500/20' : 'bg-accent/20 text-accent border border-accent/20' %>">
                        <%= anggota.Role || 'Anggota' %>
                    </span>
                </div>

                <h1 class="text-4xl md:text-5xl font-bold text-pale mb-1"><%= anggota.Nama %></h1>
                
                <% if (anggota.Jabatan) { %>
                    <p class="text-xl text-accent font-medium mb-8 flex items-center">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                        <%= anggota.Jabatan %>
                    </p>
                <% } else { %>
                    <div class="mb-8"></div>
                <% } %>

                <div class="grid grid-cols-1 gap-6 border-t border-white/10 pt-8">
                    
                    <div class="flex items-start">
                        <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-white/5 flex items-center justify-center mr-4">
                            <svg class="w-5 h-5 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                        </div>
                        <div>
                            <p class="text-sm text-muted font-medium">Username</p>
                            <p class="text-lg text-pale mt-0.5"><%= anggota.username || '-' %></p>
                        </div>
                    </div>

                    <% if (anggota.Deskripsi) { %>
                        <div class="flex items-start">
                            <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-white/5 flex items-center justify-center mr-4">
                                <svg class="w-5 h-5 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            </div>
                            <div>
                                <p class="text-sm text-muted font-medium">Tentang Anggota</p>
                                <p class="text-base text-pale/80 mt-1 leading-relaxed italic">
                                    "<%= anggota.Deskripsi %>"
                                </p>
                            </div>
                        </div>
                    <% } %>

                    </div>

                <div class="mt-auto pt-8">
                    <p class="text-xs text-muted/30">
                        Terdaftar di sistem Kampung Wisata Bausasran.
                    </p>
                </div>

            </div>
        </div>

    </main>

</body>
</html>