<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= prestasi.Judul %> - Detail Prestasi</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        main: '#003024',    // Background Gelap
                        surface: '#004030', // Warna Kartu
                        accent: '#83C540',  // Hijau Neon
                        pale: '#F5FEF9',    // Teks Putih
                        muted: '#A3C2B8',   // Teks Pudar
                        gold: '#FFD700',    // Aksen Emas untuk Piala
                    },
                    fontFamily: { sans: ['Inter', 'sans-serif'] }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer base { 
            body { @apply bg-main text-pale font-sans antialiased; } 
            .custom-scroll::-webkit-scrollbar { width: 8px; }
            .custom-scroll::-webkit-scrollbar-track { @apply bg-main; }
            .custom-scroll::-webkit-scrollbar-thumb { @apply bg-surface border border-white/10 rounded-full hover:bg-accent/50; }
        }
    </style>
</head>
<body class="flex h-screen overflow-hidden">

    <%- include('../../partials/user_sidebar.ejs') %>

    <main class="flex-1 overflow-y-auto custom-scroll p-6 md:p-10 relative">
        
        <div class="fixed top-0 right-0 w-[500px] h-[500px] bg-accent/5 rounded-full blur-[100px] pointer-events-none -z-10"></div>

        <%- include('../../partials/flash.ejs') %>

        <div class="mb-8">
            <a href="/user/prestasi" class="inline-flex items-center text-muted hover:text-accent transition-colors duration-300 group">
                <div class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center mr-3 group-hover:bg-accent group-hover:text-main transition-all border border-white/5 group-hover:border-accent">
                    <svg class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                    </svg>
                </div>
                <span class="font-semibold text-sm">Kembali ke Daftar Prestasi</span>
            </a>
        </div>

        <div class="max-w-5xl mx-auto shadow-2xl">
            
            <div class="bg-surface border border-white/5 rounded-t-3xl p-8 md:p-12 relative overflow-hidden">
                
                <div class="absolute -top-6 -right-6 p-0 opacity-5 rotate-12 pointer-events-none">
                    <svg class="w-80 h-80 text-gold" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" style="display:none;"></path>
                        <path d="M5 4a2 2 0 012-2h6a2 2 0 012 2v14l-5-2.5L5 18V4z" opacity="0"></path> <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1.323l3.954 1.582 1.599-.8a1 1 0 01.894 1.79l-1.233.616 1.738 5.42a1 1 0 01-.285 1.05A3.989 3.989 0 0115 15a3.989 3.989 0 01-2.667-1.019 1 1 0 01-.285-1.05l1.715-5.349L11 6.477V16h2a1 1 0 110 2H7a1 1 0 110-2h2V6.477L6.237 7.582l1.715 5.349a1 1 0 01-.285 1.05A3.989 3.989 0 015 15a3.989 3.989 0 01-2.667-1.019 1 1 0 01-.285-1.05l1.738-5.42-1.233-.616a1 1 0 01.894-1.79l1.599.8L9 4.323V3a1 1 0 011-1z" clip-rule="evenodd"></path>
                    </svg>
                </div>

                <div class="relative z-10">
                    <div class="flex items-start mb-6">
                        <div class="p-3 bg-gold/10 rounded-2xl mr-4 border border-gold/20 backdrop-blur-sm">
                            <svg class="w-8 h-8 text-gold" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1.323l3.954 1.582 1.599-.8a1 1 0 01.894 1.79l-1.233.616 1.738 5.42a1 1 0 01-.285 1.05A3.989 3.989 0 0115 15a3.989 3.989 0 01-2.667-1.019 1 1 0 01-.285-1.05l1.715-5.349L11 6.477V16h2a1 1 0 110 2H7a1 1 0 110-2h2V6.477L6.237 7.582l1.715 5.349a1 1 0 01-.285 1.05A3.989 3.989 0 015 15a3.989 3.989 0 01-2.667-1.019 1 1 0 01-.285-1.05l1.738-5.42-1.233-.616a1 1 0 01.894-1.79l1.599.8L9 4.323V3a1 1 0 011-1z" clip-rule="evenodd"></path>
                            </svg>
                        </div>
                        <h1 class="text-3xl md:text-5xl font-bold text-pale leading-tight drop-shadow-sm flex-1">
                            <%= prestasi.Judul %>
                        </h1>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 border-t border-white/10 pt-6">
                        <% if (prestasi.Tanggal) { %>
                            <div class="flex items-center group p-3 bg-white/5 rounded-xl border border-white/5 hover:border-accent/30 transition-all">
                                <div class="bg-main p-2 rounded-lg mr-3 text-accent">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                </div>
                                <div>
                                    <p class="text-[10px] text-muted font-bold uppercase tracking-wider">Tanggal Perolehan</p>
                                    <p class="text-pale font-semibold">
                                        <%= new Date(prestasi.Tanggal).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                                    </p>
                                </div>
                            </div>
                        <% } %>

                        <% if (prestasi.Penyelenggara) { %>
                            <div class="flex items-center group p-3 bg-white/5 rounded-xl border border-white/5 hover:border-accent/30 transition-all">
                                <div class="bg-main p-2 rounded-lg mr-3 text-accent">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                                </div>
                                <div>
                                    <p class="text-[10px] text-muted font-bold uppercase tracking-wider">Penyelenggara</p>
                                    <p class="text-pale font-semibold"><%= prestasi.Penyelenggara %></p>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <div class="bg-black/20 border-x border-b border-white/5 rounded-b-3xl p-8 md:p-12">
                
                <% if (prestasi.Deskripsi) { %>
                    <div class="mb-12">
                        <h2 class="text-xl font-bold text-pale mb-6 flex items-center border-b border-white/5 pb-4">
                            <svg class="w-5 h-5 mr-3 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                            Deskripsi Pencapaian
                        </h2>
                        <div class="bg-surface/50 p-6 rounded-2xl border border-white/5">
                            <p class="text-muted/90 leading-relaxed whitespace-pre-line text-base md:text-lg">
                                <%= prestasi.Deskripsi %>
                            </p>
                        </div>
                    </div>
                <% } %>

                <% if (prestasi.dataValues.fotoFiles && prestasi.dataValues.fotoFiles.length > 0) { %>
                    <div>
                        <h2 class="text-xl font-bold text-pale mb-6 flex items-center border-b border-white/5 pb-4">
                            <svg class="w-5 h-5 mr-3 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            Dokumentasi (<%= prestasi.dataValues.fotoFiles.length %>)
                        </h2>
                        
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                            <% for(let foto of prestasi.dataValues.fotoFiles) { %>
                                <div class="relative group cursor-pointer aspect-square rounded-xl overflow-hidden border border-white/5 bg-surface" onclick="openLightbox('<%= foto %>')">
                                    <img src="/images/prestasi/<%= foto %>" 
                                         alt="Foto Prestasi"
                                         class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700 ease-out">
                                    
                                    <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center backdrop-blur-[2px]">
                                        <div class="bg-accent/20 p-3 rounded-full border border-accent/50 transform scale-50 group-hover:scale-100 transition-transform duration-300">
                                            <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path>
                                            </svg>
                                        </div>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>

    </main>

    <div id="lightbox" class="fixed inset-0 bg-black/95 z-[9999] hidden flex items-center justify-center p-4 backdrop-blur-sm opacity-0 transition-opacity duration-300" onclick="closeLightbox()">
        <div class="relative max-w-5xl w-full flex flex-col items-center">
            
            <button onclick="closeLightbox()" class="absolute -top-12 right-0 md:right-0 text-white/70 hover:text-accent transition-colors p-2">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
            
            <img id="lightbox-img" src="" alt="Preview" class="max-w-full max-h-[85vh] rounded-lg shadow-2xl border border-white/10 transform scale-95 transition-transform duration-300" onclick="event.stopPropagation()">
        </div>
    </div>

    <script>
        const lightbox = document.getElementById('lightbox');
        const img = document.getElementById('lightbox-img');

        function openLightbox(foto) {
            img.src = '/images/prestasi/' + foto;
            lightbox.classList.remove('hidden');
            setTimeout(() => {
                lightbox.classList.remove('opacity-0');
                img.classList.remove('scale-95');
                img.classList.add('scale-100');
            }, 10);
        }

        function closeLightbox() {
            lightbox.classList.add('opacity-0');
            img.classList.remove('scale-100');
            img.classList.add('scale-95');
            
            setTimeout(() => {
                lightbox.classList.add('hidden');
                img.src = '';
            }, 300);
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeLightbox();
            }
        });
    </script>
</body>
</html>