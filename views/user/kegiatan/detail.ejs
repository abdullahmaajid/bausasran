<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= kegiatan.Judul %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="flex bg-gray-100">

    <%- include('../../partials/user_sidebar.ejs') %>

    <main class="flex-1 p-10">
        <%- include('../../partials/flash.ejs') %>

        <div class="mb-6">
            <a href="/user/kegiatan" class="text-blue-500 hover:text-blue-700 font-semibold">
                ← Kembali ke Daftar Kegiatan
            </a>
        </div>

        <div class="bg-white rounded-lg shadow-lg p-8">
            <!-- Header -->
            <div class="border-b pb-6 mb-6">
                <div class="flex justify-between items-start mb-4">
                    <h1 class="text-4xl font-bold text-gray-800"><%= kegiatan.Judul %></h1>
                    
                    <!-- Badge Status -->
                    <% if (kegiatan.Status === 'Upcoming') { %>
                        <span class="bg-blue-500 text-black px-4 py-2 rounded-full text-sm font-semibold">
                            🔄 Akan Datang
                        </span>
                    <% } else if (kegiatan.Status === 'Past') { %>
                        <span class="bg-green-500 text-black px-4 py-2 rounded-full text-sm font-semibold">
                            📅 Selesai
                        </span>
                    <% } else { %>
                        <span class="bg-gray-500 text-white px-4 py-2 rounded-full text-sm font-semibold">
                            ✓ Selesai
                        </span>
                    <% } %>
                </div>
                
                <div class="flex flex-wrap gap-4 text-sm text-gray-600">
                    <% if (kegiatan.Tanggal) { %>
                        <div class="flex items-center">
                            <svg class="w-5 h-5 mr-2 text-blue-500" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"></path>
                            </svg>
                            <span class="font-semibold"><%= new Date(kegiatan.Tanggal).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
                        </div>
                    <% } %>

                    <% if (kegiatan.Lokasi) { %>
                        <div class="flex items-center">
                            <svg class="w-5 h-5 mr-2 text-red-500" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                            </svg>
                            <span class="font-semibold"><%= kegiatan.Lokasi %></span>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Deskripsi -->
            <% if (kegiatan.Kategori) { %>
                <div class="mb-8">
                    <h2 class="text-2xl font-bold text-gray-800 mb-4">Kategori Kegiatan</h2>
                    <div class="bg-gray-50 p-6 rounded-lg">
                        <p class="text-gray-700 leading-relaxed whitespace-pre-line"><%= kegiatan.Kategori %></p>
                    </div>
                </div>
            <% } %>

            <!-- Galeri Foto -->
            <% if (kegiatan.dataValues.fotoFiles && kegiatan.dataValues.fotoFiles.length > 0) { %>
                <div class="mb-8">
                    <h2 class="text-2xl font-bold text-gray-800 mb-4">Galeri Foto (<%= kegiatan.dataValues.fotoFiles.length %>)</h2>
                    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                        <% for(let foto of kegiatan.dataValues.fotoFiles) { %>
                            <div class="relative group cursor-pointer" onclick="openLightbox('<%= foto %>')">
                                <img src="/images/kegiatan/<%= foto %>" 
                                     alt="Foto Kegiatan"
                                     class="w-full h-48 object-cover rounded-lg border-2 border-gray-200 hover:border-green-400 transition-all">
                                <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-30 transition-all rounded-lg flex items-center justify-center">
                                    <svg class="w-8 h-8 text-white opacity-0 group-hover:opacity-100 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path>
                                    </svg>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
            <% } %>
        </div>
    </main>

    <%- include('../../partials/footer.ejs') %>

    <!-- Lightbox Modal -->
    <div id="lightbox" class="fixed inset-0 bg-black bg-opacity-90 z-50 hidden flex items-center justify-center p-4" onclick="closeLightbox()">
        <div class="relative max-w-5xl max-h-full">
            <button onclick="closeLightbox()" class="absolute -top-10 right-0 text-white text-3xl font-bold hover:text-gray-300">
                ×
            </button>
            <img id="lightbox-img" src="" alt="Preview" class="max-w-full max-h-screen rounded-lg">
        </div>
    </div>

    <script>
        function openLightbox(foto) {
            const lightbox = document.getElementById('lightbox');
            const img = document.getElementById('lightbox-img');
            img.src = '/images/kegiatan/' + foto;
            lightbox.classList.remove('hidden');
            lightbox.classList.add('flex');
        }

        function closeLightbox() {
            const lightbox = document.getElementById('lightbox');
            lightbox.classList.add('hidden');
            lightbox.classList.remove('flex');
        }

        // Close on ESC key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeLightbox();
            }
        });
    </script>
</body>
</html>
