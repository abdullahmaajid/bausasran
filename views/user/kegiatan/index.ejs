<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Agenda Kegiatan - Bausasran Heritage</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        paper: '#F9F7F2',       // Background Utama
                        deep: '#0F1F18',        // Teks Utama / Aksen Gelap
                        gold: '#C5B388',        // Aksen Emas
                        charcoal: '#4A4A4A',    // Teks Sekunder
                        linen: '#EBE9E4',       // Background Kartu
                    },
                    fontFamily: {
                        sans: ['Lato', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                        crest: ['Cinzel', 'serif'],
                    },
                    letterSpacing: {
                        'luxury': '0.2em',
                    }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer base { 
            body { 
                @apply bg-paper text-deep font-sans antialiased; 
            } 
            .custom-scroll::-webkit-scrollbar { width: 6px; }
            .custom-scroll::-webkit-scrollbar-track { @apply bg-paper; }
            .custom-scroll::-webkit-scrollbar-thumb { @apply bg-deep/20 hover:bg-gold rounded-full transition-colors; }
        }

        /* Texture Grain Overlay */
        .noise-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none;
            z-index: 0;
            mix-blend-mode: multiply;
        }
    </style>
</head>
<body class="flex h-screen overflow-hidden relative">

    <div class="noise-overlay"></div>

    <%- include('../../partials/user_sidebar.ejs') %>

    <main class="flex-1 overflow-y-auto custom-scroll p-8 md:p-12 relative z-10">
        
        <%- include('../../partials/flash.ejs') %>

        <div class="mb-12 border-b border-deep/10 pb-8">
            <span class="text-[10px] uppercase tracking-luxury text-gold font-bold mb-2 block">Jurnal Desa</span>
            <h1 class="text-3xl md:text-5xl font-crest text-deep mb-3">
                Agenda & <span class="font-serif italic text-gold">Kegiatan</span>
            </h1>
            <p class="text-charcoal font-serif italic text-lg max-w-2xl">
                Catatan aktivitas, pelatihan, dan program kebersamaan warga.
            </p>
        </div>

        <div class="pb-10">
            <% if (kegiatanList && kegiatanList.length > 0) { %>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <% for(let kegiatan of kegiatanList) { %>
                        <div class="group bg-white border border-deep/5 hover:border-gold/50 transition-all duration-500 flex flex-col h-full shadow-sm hover:shadow-xl hover:-translate-y-1 relative overflow-hidden">
                            
                            <div class="h-56 relative overflow-hidden bg-linen">
                                <% if (kegiatan.dataValues.thumbnailFile) { %>
                                    <img src="/images/kegiatan/<%= kegiatan.dataValues.thumbnailFile %>" 
                                         alt="<%= kegiatan.Judul %>"
                                         class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-1000">
                                    <div class="absolute inset-0 bg-gradient-to-t from-deep/60 via-transparent to-transparent opacity-80"></div>
                                <% } else { %>
                                    <div class="w-full h-full flex items-center justify-center bg-linen text-deep/10">
                                        <svg class="w-20 h-20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                        </svg>
                                    </div>
                                <% } %>
                                
                                <div class="absolute top-4 right-4">
                                    <% if (kegiatan.Status === 'Ongoing') { %>
                                        <span class="px-3 py-1 text-[9px] font-bold uppercase tracking-widest bg-gold text-deep shadow-md border border-deep/10">
                                            Sedang Berlangsung
                                        </span>
                                    <% } else if (kegiatan.Status === 'Upcoming') { %>
                                        <span class="px-3 py-1 text-[9px] font-bold uppercase tracking-widest bg-paper text-deep shadow-md border border-deep/10">
                                            Akan Datang
                                        </span>
                                    <% } else { %>
                                        <span class="px-3 py-1 text-[9px] font-bold uppercase tracking-widest bg-deep/80 backdrop-blur-sm text-paper shadow-md">
                                            Selesai
                                        </span>
                                    <% } %>
                                </div>

                                <% if (kegiatan.Tanggal) { %>
                                    <div class="absolute bottom-0 left-4 bg-paper px-4 py-3 text-center border-t border-l border-r border-deep/10 shadow-lg translate-y-2 group-hover:translate-y-0 transition-transform duration-300">
                                        <div class="text-2xl font-serif text-deep leading-none">
                                            <%= new Date(kegiatan.Tanggal).getDate() %>
                                        </div>
                                        <div class="text-[9px] font-bold uppercase tracking-luxury text-gold mt-1">
                                            <%= new Date(kegiatan.Tanggal).toLocaleDateString('id-ID', { month: 'short' }) %>
                                        </div>
                                    </div>
                                <% } %>
                            </div>

                            <div class="p-6 pt-8 flex-1 flex flex-col">
                                <h3 class="text-xl font-crest text-deep mb-3 leading-snug group-hover:text-gold transition-colors duration-300">
                                    <%= kegiatan.Judul %>
                                </h3>
                                
                                <div class="space-y-3 mb-6 border-b border-deep/5 pb-4">
                                    <% if (kegiatan.Tanggal) { %>
                                        <div class="flex items-center gap-2 text-xs text-charcoal/70">
                                            <svg class="w-3.5 h-3.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                            <span class="font-serif italic">
                                                <%= new Date(kegiatan.Tanggal).toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric' }) %>
                                            </span>
                                        </div>
                                    <% } %>

                                    <% if (kegiatan.Lokasi) { %>
                                        <div class="flex items-start gap-2 text-xs text-charcoal/70">
                                            <svg class="w-3.5 h-3.5 text-gold shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                            <span class="line-clamp-1 font-sans"><%= kegiatan.Lokasi %></span>
                                        </div>
                                    <% } %>
                                </div>

                                <% if (kegiatan.Deskripsi) { %>
                                    <p class="text-sm text-charcoal/60 mb-6 line-clamp-3 leading-relaxed flex-grow font-sans">
                                        <%= kegiatan.Deskripsi %>
                                    </p>
                                <% } %>

                                <div class="mt-auto">
                                    <a href="/user/kegiatan/<%= kegiatan.ID_Kegiatan %>" 
                                       class="inline-flex items-center text-[10px] font-bold uppercase tracking-widest text-deep border-b border-gold pb-1 hover:text-gold hover:border-deep transition-all duration-300">
                                        Baca Selengkapnya
                                        <svg class="w-3 h-3 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } else { %>
                <div class="flex flex-col items-center justify-center py-24 border border-dashed border-deep/10 bg-linen/20">
                    <div class="w-16 h-16 rounded-full bg-paper border border-deep/10 flex items-center justify-center mb-6 shadow-sm">
                        <svg class="w-8 h-8 text-deep/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-crest text-deep mb-2">Agenda Kosong</h3>
                    <p class="font-serif italic text-charcoal/60 max-w-md text-center">
                        Saat ini belum ada agenda kegiatan yang dijadwalkan.
                    </p>
                </div>
            <% } %>
        </div>

        <div class="mt-8 pt-6 border-t border-deep/5 text-center">
            <p class="text-[9px] uppercase tracking-luxury text-charcoal/40">
                &copy; <%= new Date().getFullYear() %> Bausasran Heritage Estate.
            </p>
        </div>
    </main>

</body>
</html>