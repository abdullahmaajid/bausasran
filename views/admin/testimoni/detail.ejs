<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detail Ulasan #<%= review.ID_Review %> - Bausasran Heritage</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        paper: '#F9F7F2',       
                        deep: '#0F1F18',        
                        gold: '#C5B388',        
                        charcoal: '#4A4A4A',    
                        linen: '#EBE9E4', 
                        white: '#FFFFFF',
                        danger: '#9B1C1C',      
                    },
                    fontFamily: {
                        sans: ['Lato', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                        crest: ['Cinzel', 'serif'], 
                    },
                    boxShadow: {
                        'elegant': '0 10px 40px -10px rgba(15, 31, 24, 0.05)',
                        'gold-glow': '0 0 15px rgba(197, 179, 136, 0.2)',
                    }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer base {
            body { @apply bg-paper text-deep font-sans antialiased selection:bg-deep selection:text-paper; }
        }
        /* TEXTURE */
        .noise-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none; z-index: 50; mix-blend-mode: multiply;
        }

        /* Components */
        .heritage-card {
            @apply bg-white p-8 border border-deep/5 shadow-elegant relative overflow-hidden transition-all duration-500;
        }
        .btn-heritage {
            @apply px-6 py-3 border border-deep/10 bg-white text-deep text-[10px] font-bold uppercase tracking-widest hover:bg-linen transition-colors flex items-center justify-center gap-2;
        }
    </style>
</head>

<body class="flex h-screen overflow-hidden relative w-full">

    <div class="noise-overlay"></div>

    <%- include('../../partials/admin_sidebar.ejs') %>

    <main class="flex-1 h-full overflow-y-auto overflow-x-hidden p-8 md:p-12 relative z-10">
        <%- include('../../partials/flash.ejs') %>

        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 border-b border-deep/10 pb-8">
            <div class="max-w-3xl">
                <div class="flex items-center gap-3 mb-3">
                    <span class="font-sans text-[10px] uppercase tracking-widest text-gold block">
                        Testimoni & Masukan
                    </span>
                    <span class="h-px w-8 bg-deep/10"></span>
                    <span class="text-[10px] font-bold text-deep/40 font-mono tracking-wider">ID: #<%= review.ID_Review %></span>
                </div>
                
                <h1 class="font-crest text-3xl md:text-4xl text-deep leading-tight">
                    Detail Ulasan
                </h1>
            </div>
            
            <div class="mt-6 md:mt-0 flex gap-3">
                <a href="/admin/testimoni" class="btn-heritage">
                    Kembali
                </a>
                
                <a href="/admin/testimoni/<%= review.ID_Review %>/edit" class="btn-heritage !bg-deep !text-white !border-deep hover:!bg-gold hover:!text-deep hover:!border-gold hover:shadow-gold-glow">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                    <span>Edit Review</span>
                </a>
            </div>
        </div>
        
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
            
            <div class="lg:col-span-1 space-y-6">
                
                <div class="heritage-card !p-0">
                    <div class="bg-linen/30 p-6 border-b border-deep/5">
                        <span class="text-[9px] text-charcoal/50 font-bold uppercase tracking-widest mb-4 block">Profil Pengulas</span>
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 rounded-full bg-deep text-gold flex items-center justify-center font-crest text-xl border border-gold/30">
                                <%= pengguna ? pengguna.Nama.charAt(0).toUpperCase() : '?' %>
                            </div>
                            <div>
                                <h3 class="font-crest text-lg text-deep"><%= pengguna ? pengguna.Nama : 'Anonim' %></h3>
                                <p class="text-[10px] font-bold uppercase tracking-widest text-gold"><%= pengguna ? pengguna.Role : 'Tamu' %></p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="heritage-card">
                    <span class="text-[9px] text-charcoal/50 font-bold uppercase tracking-widest mb-4 block flex items-center gap-2">
                        <svg class="w-3 h-3 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path></svg>
                        Konteks Review
                    </span>
                    
                    <div class="space-y-4">
                        <div>
                            <p class="text-xs text-deep/60 mb-1">Kategori</p>
                            <span class="inline-block px-3 py-1 bg-deep/5 border border-deep/10 text-deep text-[10px] font-bold uppercase tracking-widest">
                                <%= review.Kategori %>
                            </span>
                        </div>
                        <div>
                            <p class="text-xs text-deep/60 mb-1">Item Terkait</p>
                            <p class="font-serif text-lg italic text-deep">
                                <% if (review.Kategori === 'Product' && relatedItem) { %>
                                    "<%= relatedItem.Nama %>"
                                <% } else if (review.Kategori === 'Kegiatan' && relatedItem) { %>
                                    "<%= relatedItem.Judul %>"
                                <% } else { %>
                                    <span class="opacity-50">- Tidak Diketahui -</span>
                                <% } %>
                            </p>
                        </div>
                    </div>
                </div>

                <div class="heritage-card text-center">
                     <span class="text-[9px] text-charcoal/50 font-bold uppercase tracking-widest mb-4 block">Penilaian</span>
                     
                     <div class="flex justify-center items-center gap-2 mb-2">
                        <% for(let i = 1; i <= 5; i++) { %>
                            <svg class="w-6 h-6 <%= i <= review.Rating ? 'text-gold fill-current' : 'text-gray-300' %>" viewBox="0 0 24 24" stroke="currentColor" stroke-width="<%= i <= review.Rating ? '0' : '1.5' %>">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                            </svg>
                        <% } %>
                     </div>
                     
                     <p class="font-crest text-2xl text-deep mb-1"><%= review.Rating %>/5</p>
                     
                     <p class="text-[10px] font-bold uppercase tracking-widest text-deep/60">
                        <% if (review.Rating === 5) { %>
                            Sempurna
                        <% } else if (review.Rating === 4) { %>
                            Sangat Baik
                        <% } else if (review.Rating === 3) { %>
                            Cukup
                        <% } else if (review.Rating === 2) { %>
                            Kurang
                        <% } else { %>
                            Buruk
                        <% } %>
                    </p>
                </div>
            </div>

            <div class="lg:col-span-2 space-y-8">
                
                <div class="heritage-card min-h-[400px] flex flex-col">
                    <svg class="w-12 h-12 text-gold/20 absolute top-8 left-8" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21L14.017 18C14.017 16.8954 14.9124 16 16.017 16H19.017C19.5693 16 20.017 15.5523 20.017 15V9C20.017 8.44772 19.5693 8 19.017 8H15.017C14.4647 8 14.017 8.44772 14.017 9V11C14.017 11.5523 13.5693 12 13.017 12H12.017V5H22.017V15C22.017 18.3137 19.3307 21 16.017 21H14.017ZM5.0166 21L5.0166 18C5.0166 16.8954 5.91203 16 7.0166 16H10.0166C10.5689 16 11.0166 15.5523 11.0166 15V9C11.0166 8.44772 10.5689 8 10.0166 8H6.0166C5.46432 8 5.0166 8.44772 5.0166 9V11C5.0166 11.5523 4.56889 12 4.0166 12H3.0166V5H13.0166V15C13.0166 18.3137 10.3303 21 7.0166 21H5.0166Z"></path></svg>
                    
                    <div class="relative z-10 pl-8 pt-4">
                        <h2 class="font-crest text-xl text-deep mb-6 border-b border-deep/5 pb-4">Isi Ulasan</h2>
                        
                        <div class="prose prose-lg max-w-none">
                            <% if (review.Ulasan && review.Ulasan.trim() !== '') { %>
                                <p class="font-serif italic text-deep/80 leading-loose text-lg whitespace-pre-wrap">
                                    "<%= review.Ulasan %>"
                                </p>
                            <% } else { %>
                                <p class="font-serif italic text-deep/40 text-center py-12">
                                    ~ Tidak ada deskripsi tertulis yang diberikan ~
                                </p>
                            <% } %>
                        </div>
                    </div>

                    <div class="mt-auto pt-8 flex justify-end">
                        <button onclick="deleteReview()" 
                                class="group flex items-center gap-2 px-4 py-2 text-[10px] font-bold uppercase tracking-widest text-danger border border-danger/20 hover:bg-danger hover:text-white transition-all rounded-sm">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                            Hapus Ulasan Ini
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </main>

    <script>
        function deleteReview() {
            if (confirm('PERINGATAN SISTEM:\n\nApakah Anda yakin ingin menghapus data ulasan ini secara permanen? Tindakan ini tidak dapat dibatalkan.')) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/admin/testimoni/<%= review.ID_Review %>/delete';
                form.style.display = 'none';
                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
</body>
</html>