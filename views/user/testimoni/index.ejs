<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ulasan Saya - Bausasran Heritage</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        paper: '#F9F7F2',       // Background Utama
                        deep: '#0F1F18',        // Teks Utama / Aksen Gelap
                        gold: '#C5B388',        // Aksen Emas
                        charcoal: '#4A4A4A',    // Teks Sekunder
                        linen: '#EBE9E4',       // Background Kartu
                        burgundy: '#5D1818',    // Merah Klasik untuk Hapus
                    },
                    fontFamily: {
                        sans: ['Lato', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                        crest: ['Cinzel', 'serif'],
                    },
                    letterSpacing: {
                        'luxury': '0.2em',
                    }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer base { 
            body { 
                @apply bg-paper text-deep font-sans antialiased; 
            } 
            .custom-scroll::-webkit-scrollbar { width: 6px; }
            .custom-scroll::-webkit-scrollbar-track { @apply bg-paper; }
            .custom-scroll::-webkit-scrollbar-thumb { @apply bg-deep/20 hover:bg-gold rounded-full transition-colors; }
        }

        /* Texture Grain Overlay */
        .noise-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none;
            z-index: 0;
            mix-blend-mode: multiply;
        }
    </style>
</head>
<body class="flex h-screen overflow-hidden relative">

    <div class="noise-overlay"></div>

    <%- include('../../partials/user_sidebar.ejs') %>

    <main class="flex-1 overflow-y-auto custom-scroll p-8 md:p-12 relative z-10">
        
        <%- include('../../partials/flash.ejs') %>

        <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6 mb-12 border-b border-deep/10 pb-8">
            <div>
                <span class="text-[10px] uppercase tracking-luxury text-gold font-bold mb-2 block">Suara Pelanggan</span>
                <h1 class="text-3xl md:text-5xl font-crest text-deep mb-2">
                    Testimoni <span class="font-serif italic text-gold">Saya</span>
                </h1>
                <p class="text-charcoal font-serif italic text-lg mt-2">
                    Halo <span class="text-deep font-semibold"><%= currentUser.Nama %></span>, ini adalah arsip pendapat Anda.
                </p>
            </div>
            
            <a href="/user/testimoni/tambah" class="group relative inline-flex items-center justify-center px-8 py-3 bg-deep text-paper font-crest text-xs uppercase tracking-widest hover:bg-gold hover:text-deep transition-all duration-300 shadow-md">
                <span class="absolute w-0 h-full bg-white/10 left-0 top-0 transition-all duration-300 group-hover:w-full"></span>
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                Tulis Ulasan Baru
            </a>
        </div>

        <div class="pb-10">
            <% if(myReviewList && myReviewList.length > 0) { %>
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                    <% for(let review of myReviewList) { %>
                        <div class="bg-white p-1 border border-deep/5 shadow-sm hover:shadow-lg transition-all duration-300 group">
                            <div class="border border-deep/10 p-6 h-full flex flex-col relative bg-paper/50">
                                
                                <div class="flex justify-between items-start mb-6">
                                    <div>
                                        <% if (review.Kategori === 'Product') { %>
                                            <span class="inline-flex items-center px-3 py-1 text-[9px] uppercase tracking-widest font-bold border border-deep/20 text-deep/70">
                                                Produk & Olahan
                                            </span>
                                        <% } else { %>
                                            <span class="inline-flex items-center px-3 py-1 text-[9px] uppercase tracking-widest font-bold border border-gold text-gold bg-deep/5">
                                                Agenda Kegiatan
                                            </span>
                                        <% } %>
                                    </div>

                                    <div class="flex items-center space-x-1">
                                        <% for(let i = 1; i <= 5; i++) { %>
                                            <svg class="w-3.5 h-3.5 <%= i <= review.Rating ? 'text-gold fill-current' : 'text-gray-300' %>" viewBox="0 0 20 20">
                                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                                            </svg>
                                        <% } %>
                                    </div>
                                </div>

                                <h3 class="text-xl font-crest text-deep mb-4 line-clamp-1 border-b border-deep/5 pb-2">
                                    <% if (review.Kategori === 'Product' && review.dataValues.produk) { %>
                                        <%= review.dataValues.produk.Nama %>
                                    <% } else if (review.Kategori === 'Kegiatan' && review.dataValues.kegiatan) { %>
                                        <%= review.dataValues.kegiatan.Judul %>
                                    <% } else { %>
                                        <span class="italic text-charcoal/50">Item Tidak Ditemukan</span>
                                    <% } %>
                                </h3>

                                <div class="bg-linen/30 p-5 flex-grow relative mb-6">
                                    <span class="absolute top-2 left-2 text-4xl text-gold/30 font-serif leading-none">“</span>
                                    <% if (review.Ulasan && review.Ulasan.trim() !== '') { %>
                                        <p class="text-charcoal text-sm font-serif italic relative z-10 pl-4 leading-relaxed">
                                            <%= review.Ulasan %>
                                        </p>
                                    <% } else { %>
                                        <p class="text-charcoal/40 text-sm italic relative z-10 pl-4">
                                            (Tidak ada ulasan tertulis)
                                        </p>
                                    <% } %>
                                    <span class="absolute bottom-0 right-4 text-4xl text-gold/30 font-serif leading-none rotate-180">“</span>
                                </div>

                                <div class="flex space-x-4 mt-auto pt-4 border-t border-deep/5">
                                    <a href="/user/testimoni/<%= review.ID_Review %>/edit" 
                                       class="flex-1 flex items-center justify-center py-2 text-[10px] font-bold uppercase tracking-widest text-deep hover:text-gold transition-colors group-hover:bg-deep/5 border border-transparent hover:border-deep/10">
                                        <svg class="w-3 h-3 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                        Sunting
                                    </a>
                                    <button type="button" onclick="deleteTestimoni('<%= review.ID_Review %>')"
                                            class="flex-1 flex items-center justify-center py-2 text-[10px] font-bold uppercase tracking-widest text-burgundy/70 hover:text-burgundy transition-colors hover:bg-burgundy/5 border border-transparent hover:border-burgundy/10">
                                        <svg class="w-3 h-3 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                        Hapus
                                    </button>
                                </div>

                            </div>
                        </div>
                    <% } %>
                </div>
            <% } else { %>
                <div class="flex flex-col items-center justify-center py-24 border border-dashed border-deep/10 bg-linen/20">
                    <div class="w-16 h-16 rounded-full bg-paper border border-deep/10 flex items-center justify-center mb-6 shadow-sm">
                        <svg class="w-8 h-8 text-deep/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-crest text-deep mb-2">Belum Ada Catatan</h3>
                    <p class="font-serif italic text-charcoal/60 max-w-md text-center mb-6">
                        Bagikan pengalaman berharga Anda agar bermanfaat bagi warga lainnya.
                    </p>
                    <a href="/user/testimoni/tambah" class="text-xs font-bold uppercase tracking-luxury text-gold border-b border-gold hover:text-deep hover:border-deep transition-colors">
                        Mulai Menulis
                    </a>
                </div>
            <% } %>
        </div>

        <div class="mt-8 pt-6 border-t border-deep/5 text-center">
            <p class="text-[9px] uppercase tracking-luxury text-charcoal/40">
                &copy; <%= new Date().getFullYear() %> Bausasran Heritage Estate.
            </p>
        </div>
    </main>

    <script>
        function deleteTestimoni(id) {
            if (confirm('Apakah Anda yakin ingin menghapus catatan ulasan ini dari arsip?')) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = `/user/testimoni/${id}/delete`;
                form.style.display = 'none';
                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
</body>
</html>