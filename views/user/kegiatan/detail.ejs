<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= kegiatan.Judul %> - Agenda Heritage</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        paper: '#F9F7F2',       // Background Utama
                        deep: '#0F1F18',        // Teks Utama / Aksen Gelap
                        gold: '#C5B388',        // Aksen Emas
                        charcoal: '#4A4A4A',    // Teks Sekunder
                        linen: '#EBE9E4',       // Background Kartu
                    },
                    fontFamily: {
                        sans: ['Lato', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                        crest: ['Cinzel', 'serif'],
                    },
                    letterSpacing: {
                        'luxury': '0.2em',
                    },
                    boxShadow: {
                        'elegant': '0 20px 50px -12px rgba(15, 31, 24, 0.1)',
                    }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer base { 
            body { 
                @apply bg-paper text-deep font-sans antialiased; 
            } 
            .custom-scroll::-webkit-scrollbar { width: 6px; }
            .custom-scroll::-webkit-scrollbar-track { @apply bg-paper; }
            .custom-scroll::-webkit-scrollbar-thumb { @apply bg-deep/20 hover:bg-gold rounded-full transition-colors; }
        }

        /* Texture Grain Overlay */
        .noise-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none;
            z-index: 0;
            mix-blend-mode: multiply;
        }
    </style>
</head>
<body class="flex h-screen overflow-hidden relative">

    <div class="noise-overlay"></div>

    <%- include('../../partials/user_sidebar.ejs') %>

    <main class="flex-1 overflow-y-auto custom-scroll p-8 md:p-12 relative z-10">
        
        <%- include('../../partials/flash.ejs') %>

        <div class="mb-8 border-b border-deep/10 pb-4">
            <a href="/user/kegiatan" class="inline-flex items-center text-[10px] uppercase tracking-luxury font-bold text-deep/60 hover:text-gold transition-colors duration-300 group">
                <svg class="w-3 h-3 mr-2 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
                Kembali ke Daftar Kegiatan
            </a>
        </div>

        <div class="max-w-6xl mx-auto">
            
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
                
                <div class="lg:col-span-2 space-y-10">
                    
                    <div>
                        <div class="flex items-center gap-4 mb-4">
                            <% if (kegiatan.Kategori) { %>
                                <span class="text-[10px] uppercase tracking-luxury text-gold font-bold border-b border-gold pb-1">
                                    <%= kegiatan.Kategori %>
                                </span>
                            <% } %>
                            
                            <% if (kegiatan.Status === 'Upcoming') { %>
                                <span class="px-3 py-1 bg-deep text-paper text-[9px] uppercase tracking-widest font-bold">
                                    Akan Datang
                                </span>
                            <% } else { %>
                                <span class="px-3 py-1 bg-linen text-charcoal/60 text-[9px] uppercase tracking-widest font-bold">
                                    Selesai
                                </span>
                            <% } %>
                        </div>

                        <h1 class="text-3xl md:text-5xl font-crest text-deep mb-6 leading-tight">
                            <%= kegiatan.Judul %>
                        </h1>

                        <div class="w-24 h-1 bg-deep mb-8"></div>

                        <% if (kegiatan.Kategori && kegiatan.Kategori.length >= 20) { %>
                            <div class="font-serif text-lg text-charcoal leading-loose text-justify">
                                <p class="first-letter:text-5xl first-letter:font-crest first-letter:text-deep first-letter:mr-3 first-letter:float-left first-letter:leading-none">
                                    <%= kegiatan.Kategori %>
                                </p>
                            </div>
                        <% } %>
                    </div>

                    <% if (kegiatan.dataValues.fotoFiles && kegiatan.dataValues.fotoFiles.length > 0) { %>
                        <div class="pt-10 border-t border-deep/10">
                            <h3 class="font-crest text-xl text-deep mb-6 flex items-center">
                                <span class="mr-4">Dokumentasi</span>
                                <span class="h-px flex-1 bg-deep/10"></span>
                            </h3>

                            <div class="grid grid-cols-2 gap-4">
                                <% for(let foto of kegiatan.dataValues.fotoFiles) { %>
                                    <div class="group cursor-pointer relative bg-white p-2 shadow-sm hover:shadow-elegant border border-deep/5 transition-all duration-500" onclick="openLightbox('<%= foto %>')">
                                        <div class="aspect-video relative overflow-hidden bg-linen">
                                            <img src="/images/kegiatan/<%= foto %>" 
                                                 alt="Dokumentasi"
                                                 class="w-full h-full object-cover filter grayscale-[20%] group-hover:grayscale-0 transition-all duration-700 transform group-hover:scale-105">
                                            
                                            <div class="absolute inset-0 bg-deep/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                                                <div class="bg-paper p-2 rounded-full">
                                                    <svg class="w-4 h-4 text-deep" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path></svg>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    <% } %>
                </div>

                <div class="lg:col-span-1">
                    <div class="sticky top-8">
                        <div class="bg-white border border-deep/10 p-8 shadow-elegant relative overflow-hidden group">
                            <div class="absolute top-0 right-0 w-32 h-32 bg-linen/30 rounded-full blur-3xl -mr-10 -mt-10 pointer-events-none"></div>

                            <h3 class="font-crest text-lg text-deep mb-6 uppercase tracking-widest border-b border-deep/10 pb-4">
                                Informasi Agenda
                            </h3>

                            <div class="space-y-6">
                                <% if (kegiatan.Tanggal) { %>
                                    <div class="flex items-start">
                                        <div class="mt-1 mr-4 text-gold">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                        </div>
                                        <div>
                                            <p class="text-[9px] uppercase tracking-luxury text-charcoal/50 mb-1">Waktu</p>
                                            <p class="font-serif text-lg text-deep font-bold">
                                                <%= new Date(kegiatan.Tanggal).toLocaleDateString('id-ID', { weekday: 'long' }) %>
                                            </p>
                                            <p class="font-serif text-deep italic">
                                                <%= new Date(kegiatan.Tanggal).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                                            </p>
                                        </div>
                                    </div>
                                <% } %>

                                <% if (kegiatan.Lokasi) { %>
                                    <div class="flex items-start border-t border-deep/5 pt-6">
                                        <div class="mt-1 mr-4 text-gold">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                        </div>
                                        <div>
                                            <p class="text-[9px] uppercase tracking-luxury text-charcoal/50 mb-1">Lokasi</p>
                                            <p class="font-serif text-lg text-deep leading-relaxed">
                                                <%= kegiatan.Lokasi %>
                                            </p>
                                        </div>
                                    </div>
                                <% } %>
                            </div>

                            <div class="mt-8 pt-6 border-t border-deep/10 text-center">
                                <div class="inline-block p-1 border border-deep/20">
                                    <div class="bg-paper px-4 py-2">
                                        <span class="font-crest text-[10px] font-bold text-deep uppercase tracking-widest">Bausasran Estate</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </main>

    <div id="lightbox" class="fixed inset-0 bg-deep/95 z-[9999] hidden flex items-center justify-center p-4 backdrop-blur-md opacity-0 transition-opacity duration-300" onclick="closeLightbox()">
        <div class="relative max-w-5xl w-full flex flex-col items-center">
            
            <button onclick="closeLightbox()" class="absolute -top-12 right-0 md:right-0 text-white/50 hover:text-gold transition-colors">
                <span class="text-xs uppercase tracking-widest mr-2 font-crest">Tutup</span>
                <svg class="w-6 h-6 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
            
            <div class="bg-white p-2 shadow-2xl transform scale-95 transition-transform duration-500" id="lightbox-container">
                <img id="lightbox-img" src="" alt="Preview" class="max-w-full max-h-[85vh] border border-deep/10" onclick="event.stopPropagation()">
            </div>
        </div>
    </div>

    <script>
        const lightbox = document.getElementById('lightbox');
        const img = document.getElementById('lightbox-img');
        const container = document.getElementById('lightbox-container');

        function openLightbox(foto) {
            img.src = '/images/kegiatan/' + foto;
            lightbox.classList.remove('hidden');
            setTimeout(() => {
                lightbox.classList.remove('opacity-0');
                container.classList.remove('scale-95');
                container.classList.add('scale-100');
            }, 10);
        }

        function closeLightbox() {
            lightbox.classList.add('opacity-0');
            container.classList.remove('scale-100');
            container.classList.add('scale-95');
            setTimeout(() => {
                lightbox.classList.add('hidden');
                img.src = '';
            }, 300);
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeLightbox();
            }
        });
    </script>
</body>
</html>