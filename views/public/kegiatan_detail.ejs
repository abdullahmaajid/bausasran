<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= kegiatan.Judul %> - Bausasran</title>
    
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        main: '#003024',    // Background Gelap
                        surface: '#004030', // Warna Kartu
                        accent: '#83C540',  // Hijau Neon
                        pale: '#F5FEF9',    // Teks Putih
                        muted: '#A3C2B8',   // Teks Pudar
                        gold: '#FACC15',    // Warna Bintang
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    boxShadow: {
                        'neon': '0 0 15px rgba(131, 197, 64, 0.3)',
                    }
                }
            }
        }
    </script>

    <style type="text/tailwindcss">
        @layer base {
            body {
                @apply bg-main text-pale font-sans antialiased;
            }
        }
    </style>
</head>

<body class="flex flex-col min-h-screen">

    <%- include('../partials/navbar.ejs') %>

    <main class="container mx-auto px-4 py-8 flex-grow">
        <%- include('../partials/flash.ejs') %>

        <nav class="flex mb-8 text-sm font-medium" aria-label="Breadcrumb">
            <ol class="inline-flex items-center space-x-1 md:space-x-3">
                <li class="inline-flex items-center">
                    <a href="/" class="text-muted hover:text-accent transition-colors">Home</a>
                </li>
                <li>
                    <div class="flex items-center">
                        <svg class="w-3 h-3 text-muted mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
                        </svg>
                        <a href="/kegiatan" class="text-muted hover:text-accent transition-colors">Kegiatan</a>
                    </div>
                </li>
                <li aria-current="page">
                    <div class="flex items-center">
                        <svg class="w-3 h-3 text-muted mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
                        </svg>
                        <span class="text-accent truncate max-w-[200px] md:max-w-xs"><%= kegiatan.Judul %></span>
                    </div>
                </li>
            </ol>
        </nav>

        <div class="mb-8">
            <div class="flex flex-wrap items-center gap-3 mb-4">
                <span class="px-3 py-1 rounded-full text-xs font-bold border <%= kegiatan.Status === 'Upcoming' ? 'bg-accent/20 text-accent border-accent/50' : 'bg-gray-500/20 text-gray-400 border-gray-500/50' %>">
                    <%= kegiatan.Status === 'Upcoming' ? 'AKAN DATANG' : 'SELESAI' %>
                </span>
                <% if (kegiatan.Kategori) { %>
                    <span class="px-3 py-1 rounded-full text-xs font-bold bg-white/10 text-muted border border-white/10">
                        <%= kegiatan.Kategori %>
                    </span>
                <% } %>
            </div>
            <h1 class="text-3xl md:text-5xl font-bold text-pale leading-tight"><%= kegiatan.Judul %></h1>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            <div class="lg:col-span-2 space-y-8">
                
                <div class="relative w-full h-[300px] md:h-[450px] rounded-2xl overflow-hidden shadow-neon bg-surface group">
                    <% if (fotoFiles && fotoFiles.length > 0) { %>
                        <img src="/images/kegiatan/<%= fotoFiles[0] %>" 
                             alt="<%= kegiatan.Judul %>" 
                             class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105">
                        <div class="absolute inset-0 bg-gradient-to-t from-main/80 via-transparent to-transparent"></div>
                    <% } else { %>
                        <div class="w-full h-full flex flex-col items-center justify-center bg-surface border border-white/5">
                            <svg class="w-20 h-20 text-muted/30 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                            </svg>
                            <span class="text-muted text-sm">Tidak ada foto utama</span>
                        </div>
                    <% } %>
                </div>

                <div class="bg-surface border border-white/5 rounded-2xl p-6 md:p-8">
                    <h2 class="text-2xl font-bold text-white mb-4 flex items-center">
                        <svg class="w-6 h-6 mr-2 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
                        Tentang Kegiatan
                    </h2>
                    <div class="prose prose-invert max-w-none text-muted leading-relaxed whitespace-pre-line">
                        <% if (kegiatan.Deskripsi) { %>
                            <%= kegiatan.Deskripsi %>
                        <% } else { %>
                            <span class="italic opacity-50">Tidak ada deskripsi tersedia untuk kegiatan ini.</span>
                        <% } %>
                    </div>
                </div>

                <% if (fotoFiles && fotoFiles.length > 1) { %>
                    <div>
                        <h2 class="text-2xl font-bold text-white mb-6 flex items-center">
                            <svg class="w-6 h-6 mr-2 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            Galeri Momen
                        </h2>
                        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                            <% fotoFiles.forEach((foto, index) => { %>
                                <% if (index > 0) { %> 
                                    <div class="relative aspect-square rounded-xl overflow-hidden bg-surface group cursor-pointer shadow-lg hover:shadow-accent/20 transition-all">
                                        <img src="/images/kegiatan/<%= foto %>" 
                                             alt="Galeri <%= index %>" 
                                             class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110">
                                        <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors"></div>
                                    </div>
                                <% } %>
                            <% }) %>
                        </div>
                    </div>
                <% } %>

                <div>
                    <h2 class="text-2xl font-bold text-white mb-6 flex items-center">
                        <svg class="w-6 h-6 mr-2 text-gold" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                        Ulasan Pengunjung
                    </h2>

                    <% if (reviewList && reviewList.length > 0) { %>
                        <div class="space-y-4">
                            <% reviewList.forEach(review => { %>
                                <div class="bg-surface border border-white/5 p-5 rounded-xl flex gap-4">
                                    <div class="flex-shrink-0">
                                        <div class="w-10 h-10 rounded-full bg-accent/20 border border-accent/30 flex items-center justify-center text-accent font-bold text-lg">
                                            <%= review.dataValues.pengguna ? review.dataValues.pengguna.Nama.charAt(0).toUpperCase() : '?' %>
                                        </div>
                                    </div>
                                    <div class="flex-grow">
                                        <div class="flex justify-between items-start mb-1">
                                            <h4 class="font-bold text-white text-sm">
                                                <%= review.dataValues.pengguna ? review.dataValues.pengguna.Nama : 'Anonymous' %>
                                            </h4>
                                            <div class="flex text-gold text-xs">
                                                <% for(let i=1; i<=5; i++) { %>
                                                    <% if(i <= review.Rating) { %> ★ <% } else { %> <span class="text-gray-600">★</span> <% } %>
                                                <% } %>
                                            </div>
                                        </div>
                                        <p class="text-muted text-sm leading-relaxed"><%= review.Ulasan || 'Tidak ada ulasan tertulis.' %></p>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="bg-surface/50 border border-dashed border-white/10 rounded-xl p-8 text-center">
                            <p class="text-muted">Belum ada ulasan untuk kegiatan ini.</p>
                        </div>
                    <% } %>
                </div>

            </div>

            <div class="space-y-6">
                
                <div class="bg-surface border border-white/10 rounded-2xl p-6 shadow-lg sticky top-24">
                    <h3 class="text-lg font-bold text-white mb-6 border-b border-white/10 pb-2">Informasi Detail</h3>
                    
                    <div class="space-y-5">
                        <div class="flex items-start">
                            <div class="w-8 h-8 rounded-full bg-blue-500/10 flex items-center justify-center mr-3 mt-1 text-blue-400">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            </div>
                            <div>
                                <p class="text-xs text-muted font-bold uppercase tracking-wider">Tanggal</p>
                                <p class="text-white font-medium">
                                    <%= new Date(kegiatan.Tanggal).toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
                                </p>
                            </div>
                        </div>

                        <% if (kegiatan.Lokasi) { %>
                            <div class="flex items-start">
                                <div class="w-8 h-8 rounded-full bg-red-500/10 flex items-center justify-center mr-3 mt-1 text-red-400">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                </div>
                                <div>
                                    <p class="text-xs text-muted font-bold uppercase tracking-wider">Lokasi</p>
                                    <p class="text-white font-medium"><%= kegiatan.Lokasi %></p>
                                </div>
                            </div>
                        <% } %>

                        <div class="flex items-start">
                            <div class="w-8 h-8 rounded-full bg-yellow-500/10 flex items-center justify-center mr-3 mt-1 text-gold">
                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                            </div>
                            <div>
                                <p class="text-xs text-muted font-bold uppercase tracking-wider">Rating</p>
                                <div class="flex items-center text-white font-medium">
                                    <span class="text-2xl font-bold mr-2"><%= avgRating %></span>
                                    <span class="text-sm text-muted">/ 5.0 (<%= totalReview %> ulasan)</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-8 pt-6 border-t border-white/10 space-y-3">
                        <% if (currentUser && currentUser.Role === 'User') { %>
                            <a href="/user/testimoni/tambah" class="block w-full py-3 bg-accent hover:bg-white text-main font-bold rounded-lg text-center transition-colors shadow-lg shadow-accent/20">
                                ✍️ Tulis Testimoni
                            </a>
                        <% } else if (!currentUser) { %>
                            <a href="/login?returnTo=/kegiatan/<%= kegiatan.ID_Kegiatan %>" class="block w-full py-3 bg-white/10 hover:bg-white/20 text-white font-bold rounded-lg text-center transition-colors border border-white/10">
                                🔐 Login untuk Review
                            </a>
                        <% } %>
                        
                        <a href="/kegiatan" class="block w-full py-3 bg-transparent hover:bg-white/5 text-muted hover:text-white font-semibold rounded-lg text-center transition-colors">
                            ← Kembali ke Daftar
                        </a>
                    </div>
                </div>

            </div>
        </div>

    </main>

    <%- include('../partials/footer.ejs') %>

</body>
</html>