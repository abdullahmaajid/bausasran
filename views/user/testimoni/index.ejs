<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Testimoni Saya - Bausasran</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        main: '#003024',    // Background Gelap
                        surface: '#004030', // Warna Kartu
                        accent: '#83C540',  // Hijau Neon
                        pale: '#F5FEF9',    // Teks Putih
                        muted: '#A3C2B8',   // Teks Pudar
                        gold: '#FACC15',    // Warna Bintang
                    },
                    fontFamily: { sans: ['Inter', 'sans-serif'] }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer base { 
            body { @apply bg-main text-pale font-sans antialiased; } 
            .custom-scroll::-webkit-scrollbar { width: 8px; }
            .custom-scroll::-webkit-scrollbar-track { @apply bg-main; }
            .custom-scroll::-webkit-scrollbar-thumb { @apply bg-surface border border-white/10 rounded-full; }
        }
    </style>
</head>
<body class="flex h-screen overflow-hidden">

    <%- include('../../partials/user_sidebar.ejs') %>

    <main class="flex-1 overflow-y-auto custom-scroll p-6 md:p-10 relative">
        
        <div class="fixed top-0 right-0 w-[500px] h-[500px] bg-accent/5 rounded-full blur-[100px] pointer-events-none -z-10"></div>

        <%- include('../../partials/flash.ejs') %>

        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-10 border-b border-white/10 pb-6">
            <div>
                <h1 class="text-3xl font-bold text-pale">
                    Testimoni <span class="text-accent">Saya</span>
                </h1>
                <p class="text-muted mt-1">Halo <span class="text-white font-semibold"><%= currentUser.Nama %></span>, kelola ulasan yang Anda berikan.</p>
            </div>
            
            <a href="/user/testimoni/tambah" class="group relative inline-flex items-center justify-center px-6 py-2.5 font-bold text-main transition-all duration-200 bg-accent font-pj rounded-xl focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent hover:bg-white hover:shadow-[0_0_15px_rgba(131,197,64,0.4)]">
                <svg class="w-5 h-5 mr-2 -ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                Tulis Testimoni
            </a>
        </div>

        <div class="pb-10">
            <% if(myReviewList && myReviewList.length > 0) { %>
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <% for(let review of myReviewList) { %>
                        <div class="bg-surface border border-white/5 rounded-2xl p-6 hover:border-accent/30 hover:shadow-lg transition-all duration-300 flex flex-col h-full">
                            
                            <div class="flex justify-between items-start mb-4">
                                <div>
                                    <% if (review.Kategori === 'Product') { %>
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-bold bg-accent/20 text-accent border border-accent/20">
                                            🛒 Produk
                                        </span>
                                    <% } else { %>
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-bold bg-blue-500/20 text-blue-400 border border-blue-500/20">
                                            📅 Kegiatan
                                        </span>
                                    <% } %>
                                </div>

                                <div class="flex items-center space-x-1 bg-black/20 px-2 py-1 rounded-lg">
                                    <% for(let i = 1; i <= 5; i++) { %>
                                        <svg class="w-4 h-4 <%= i <= review.Rating ? 'text-gold fill-current' : 'text-gray-600' %>" viewBox="0 0 20 20">
                                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                                        </svg>
                                    <% } %>
                                    <span class="ml-2 text-xs font-bold text-pale"><%= review.Rating %>/5</span>
                                </div>
                            </div>

                            <h3 class="text-xl font-bold text-pale mb-3 line-clamp-1">
                                <% if (review.Kategori === 'Product' && review.dataValues.produk) { %>
                                    <%= review.dataValues.produk.Nama %>
                                <% } else if (review.Kategori === 'Kegiatan' && review.dataValues.kegiatan) { %>
                                    <%= review.dataValues.kegiatan.Judul %>
                                <% } else { %>
                                    <span class="text-muted italic">Item Tidak Ditemukan</span>
                                <% } %>
                            </h3>

                            <div class="bg-black/20 rounded-xl p-4 mb-6 flex-grow border border-white/5 relative">
                                <svg class="absolute top-2 left-2 w-4 h-4 text-white/10 transform -scale-x-100" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21L14.017 18C14.017 16.8954 13.1216 16 12.017 16H9L9.91998 10.32C10.15 8.94002 11.33 7.99999 12.72 7.99999H14V2.99999C7.40998 2.99999 3.00998 9.32999 5.21998 15.33C5.64998 16.5 6.76998 17.27 7.99998 17.27H8.01698L8.01698 21H14.017ZM21.017 21L21.017 18C21.017 16.8954 20.1216 16 19.017 16H16L16.92 10.32C17.15 8.94002 18.33 8 19.72 8H21V3C14.41 3 10.01 9.33 12.22 15.33C12.65 16.5 13.77 17.27 15 17.27H15.017L15.017 21H21.017Z"></path></svg>
                                <% if (review.Ulasan && review.Ulasan.trim() !== '') { %>
                                    <p class="text-muted text-sm italic relative z-10 pl-2">"<%= review.Ulasan %>"</p>
                                <% } else { %>
                                    <p class="text-muted/50 text-sm italic relative z-10 pl-2">Tidak ada ulasan tertulis.</p>
                                <% } %>
                            </div>

                            <div class="flex space-x-3 mt-auto pt-4 border-t border-white/5">
                                <a href="/user/testimoni/<%= review.ID_Review %>/edit" 
                                   class="flex-1 flex items-center justify-center py-2 px-4 rounded-lg text-sm font-semibold bg-white/5 hover:bg-white/10 text-pale border border-white/10 transition-colors group">
                                    <svg class="w-4 h-4 mr-2 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                    Edit
                                </a>
                                <button type="button" onclick="deleteTestimoni('<%= review.ID_Review %>')"
                                        class="flex-1 flex items-center justify-center py-2 px-4 rounded-lg text-sm font-semibold bg-red-500/10 hover:bg-red-500 text-red-400 hover:text-white border border-red-500/20 hover:border-red-500 transition-all">
                                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                    Hapus
                                </button>
                            </div>

                        </div>
                    <% } %>
                </div>
            <% } else { %>
                <div class="flex flex-col items-center justify-center py-20 border-2 border-dashed border-white/5 rounded-3xl bg-surface/30">
                    <div class="w-20 h-20 bg-white/5 rounded-full flex items-center justify-center mb-4">
                        <svg class="w-10 h-10 text-muted/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-pale mb-2">Belum Ada Ulasan</h3>
                    <p class="text-muted text-sm text-center max-w-md mb-6">Bagikan pengalaman Anda tentang produk atau kegiatan kami agar bermanfaat bagi orang lain.</p>
                    <a href="/user/testimoni/tambah" class="px-6 py-2 rounded-lg bg-accent text-main font-bold hover:bg-white transition-colors">
                        Mulai Menulis
                    </a>
                </div>
            <% } %>
        </div>

        <div class="mt-4 border-t border-white/5 pt-6 text-center text-xs text-muted/30">
            &copy; <%= new Date().getFullYear() %> Kampung Wisata Bausasran.
        </div>
    </main>

    <script>
        function deleteTestimoni(id) {
            // Menggunakan styling confirm bawaan browser (simple), tapi formnya aman
            if (confirm('Apakah Anda yakin ingin menghapus ulasan ini?')) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = `/user/testimoni/${id}/delete`;
                form.style.display = 'none';
                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
</body>
</html>