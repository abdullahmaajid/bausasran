<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Prestasi - Bausasran</title>
    
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        main: '#003024',    // Background Gelap
                        surface: '#004030', // Warna Kartu
                        accent: '#83C540',  // Hijau Neon
                        pale: '#F5FEF9',    // Teks Putih
                        muted: '#A3C2B8',   // Teks Pudar
                        gold: '#FACC15',    // Warna Emas untuk Ikon
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    boxShadow: {
                        'neon': '0 0 15px rgba(131, 197, 64, 0.3)',
                    }
                }
            }
        }
    </script>

    <style type="text/tailwindcss">
        @layer base {
            body {
                @apply bg-main text-pale font-sans antialiased;
            }
        }
    </style>
</head>

<body class="flex flex-col min-h-screen">

    <%- include('../partials/navbar.ejs') %>

    <main class="container mx-auto px-4 py-12 flex-grow overflow-hidden">
        <%- include('../partials/flash.ejs') %>

        <div class="text-center mb-16 relative z-10">
            <h1 class="text-4xl md:text-5xl font-bold text-pale mb-4">
                Prestasi <span class="text-accent">Kami</span>
            </h1>
            <p class="text-lg text-muted max-w-2xl mx-auto">
                Rekam jejak perjuangan dan apresiasi yang telah diraih oleh Kampung Wisata Bausasran.
            </p>
            
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-32 h-32 bg-accent/20 rounded-full blur-[80px] -z-10"></div>
        </div>

        <% if(prestasiList && prestasiList.length > 0) { %>
            <div class="relative max-w-5xl mx-auto">
                
                <div class="absolute left-8 md:left-1/2 top-0 bottom-0 w-0.5 bg-gradient-to-b from-transparent via-white/20 to-transparent transform md:-translate-x-1/2 z-0"></div>

                <% prestasiList.forEach((prestasi, index) => { %>
                    <div class="relative z-10 mb-12 flex flex-col md:flex-row items-center w-full group">
                        
                        <div class="w-full md:w-1/2 pl-20 md:pl-0 md:pr-12 md:text-right order-1 md:order-1 <%= index % 2 !== 0 ? 'hidden md:block' : '' %>">
                            <% if(index % 2 === 0) { %>
                                <a href="/prestasi/<%= prestasi.ID_Prestasi %>" class="block bg-surface border border-white/5 p-6 rounded-2xl shadow-lg hover:shadow-neon hover:border-accent/50 transition-all duration-300 transform hover:-translate-y-1 relative overflow-hidden">
                                    <div class="absolute top-0 right-0 w-16 h-16 bg-gradient-to-br from-white/5 to-transparent rounded-bl-full -mr-4 -mt-4"></div>
                                    
                                    <div class="flex flex-col md:items-end mb-2">
                                        <span class="text-accent text-sm font-bold tracking-wider mb-1">
                                            <%= new Date(prestasi.Tanggal).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                                        </span>
                                        <% if (prestasi.Kategori) { %>
                                            <span class="inline-block px-3 py-1 bg-accent/10 border border-accent/20 text-accent text-xs font-bold rounded-full mb-3">
                                                <%= prestasi.Kategori %>
                                            </span>
                                        <% } %>
                                    </div>
                                    <h3 class="text-xl font-bold text-pale mb-2 group-hover:text-accent transition-colors"><%= prestasi.Judul %></h3>
                                    <div class="text-muted text-sm flex md:justify-end items-center mt-2 font-medium">
                                        Lihat Detail 
                                        <svg class="w-4 h-4 ml-1 transform rotate-180 md:rotate-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                                    </div>
                                </a>
                            <% } %>
                        </div>

                        <div class="absolute left-8 md:left-1/2 transform -translate-x-1/2 flex items-center justify-center order-1 z-20">
                            <div class="w-12 h-12 rounded-full bg-main border-2 border-accent shadow-[0_0_15px_rgba(131,197,64,0.4)] flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                                <svg class="w-6 h-6 text-gold drop-shadow-md" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                </svg>
                            </div>
                        </div>

                        <div class="w-full md:w-1/2 pl-20 md:pl-12 order-1 md:order-1 <%= index % 2 === 0 ? 'hidden md:block' : '' %>">
                            <% if(index % 2 !== 0) { %>
                                <a href="/prestasi/<%= prestasi.ID_Prestasi %>" class="block bg-surface border border-white/5 p-6 rounded-2xl shadow-lg hover:shadow-neon hover:border-accent/50 transition-all duration-300 transform hover:-translate-y-1 relative overflow-hidden">
                                    <div class="absolute top-0 left-0 w-16 h-16 bg-gradient-to-br from-white/5 to-transparent rounded-br-full -ml-4 -mt-4"></div>
                                    
                                    <div class="flex flex-col items-start mb-2">
                                        <span class="text-accent text-sm font-bold tracking-wider mb-1">
                                            <%= new Date(prestasi.Tanggal).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                                        </span>
                                        <% if (prestasi.Kategori) { %>
                                            <span class="inline-block px-3 py-1 bg-accent/10 border border-accent/20 text-accent text-xs font-bold rounded-full mb-3">
                                                <%= prestasi.Kategori %>
                                            </span>
                                        <% } %>
                                    </div>
                                    <h3 class="text-xl font-bold text-pale mb-2 group-hover:text-accent transition-colors"><%= prestasi.Judul %></h3>
                                    <div class="text-muted text-sm flex items-center mt-2 font-medium">
                                        Lihat Detail 
                                        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                                    </div>
                                </a>
                            <% } %>
                            
                            <div class="md:hidden">
                                <% if(index % 2 === 0) { %>
                                    <a href="/prestasi/<%= prestasi.ID_Prestasi %>" class="block bg-surface border border-white/5 p-6 rounded-2xl shadow-lg hover:shadow-neon hover:border-accent/50 transition-all duration-300 active:scale-95">
                                        <div class="mb-2">
                                            <span class="text-accent text-sm font-bold block mb-1">
                                                <%= new Date(prestasi.Tanggal).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                                            </span>
                                            <% if (prestasi.Kategori) { %>
                                                <span class="inline-block px-3 py-1 bg-accent/10 border border-accent/20 text-accent text-xs font-bold rounded-full">
                                                    <%= prestasi.Kategori %>
                                                </span>
                                            <% } %>
                                        </div>
                                        <h3 class="text-lg font-bold text-pale mb-2"><%= prestasi.Judul %></h3>
                                        <div class="text-muted text-sm flex items-center mt-2">
                                            Lihat Detail <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                                        </div>
                                    </a>
                                <% } %>
                            </div>
                        </div>

                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="text-center py-20 border-2 border-dashed border-white/10 rounded-2xl bg-surface/30 max-w-2xl mx-auto">
                <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-white/5 mb-6 text-muted">
                    <svg class="w-10 h-10 text-gold opacity-50" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-pale mb-2">Belum Ada Prestasi</h3>
                <p class="text-muted">Data prestasi akan segera diperbarui.</p>
            </div>
        <% } %>
    </main>

    <%- include('../partials/footer.ejs') %>

</body>
</html>