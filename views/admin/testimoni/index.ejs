<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kelola Testimoni - Admin Bausasran</title>
    
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        main: '#003024',    // Background Gelap
                        surface: '#004030', // Warna Kartu
                        accent: '#83C540',  // Hijau Neon
                        pale: '#F5FEF9',    // Teks Putih
                        muted: '#A3C2B8',   // Teks Pudar
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style type="text/tailwindcss">
        @layer base {
            body { @apply bg-main text-pale font-sans antialiased; }
        }
        
        /* Custom Checkbox */
        .custom-checkbox {
            @apply appearance-none h-5 w-5 border border-white/20 rounded bg-main checked:bg-accent checked:border-accent cursor-pointer transition-all relative;
        }
        .custom-checkbox:checked::after {
            content: '✓';
            @apply absolute inset-0 flex items-center justify-center text-main font-bold text-xs;
        }

        /* Scrollbar Halus */
        .custom-scroll::-webkit-scrollbar { width: 6px; }
        .custom-scroll::-webkit-scrollbar-track { background: transparent; }
        .custom-scroll::-webkit-scrollbar-thumb { background: #004030; border-radius: 10px; border: 1px solid rgba(255,255,255,0.1); }
        .custom-scroll::-webkit-scrollbar-thumb:hover { background: #83C540; }
    </style>
</head>

<body class="flex h-screen overflow-hidden">

    <%- include('../../partials/admin_sidebar.ejs') %>

    <main class="flex-1 overflow-y-auto relative p-6 md:p-10 custom-scroll">
        <%- include('../../partials/flash.ejs') %>

        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
            <div>
                <h1 class="text-3xl font-bold text-pale">Testimoni & Review</h1>
                <p class="text-muted text-sm mt-1">Kelola ulasan pengguna terhadap produk dan kegiatan.</p>
            </div>
            <a href="/admin/testimoni/new" class="inline-flex items-center justify-center px-5 py-2.5 bg-accent hover:bg-white text-main font-bold rounded-xl transition-all shadow-lg hover:shadow-green-500/20 group">
                <span class="mr-2 text-lg">+</span> Buat Review Manual
            </a>
        </div>

        <div class="bg-surface p-5 rounded-2xl border border-white/10 mb-6 space-y-4 shadow-lg">
            <div class="flex flex-col xl:flex-row gap-4 justify-between items-center">
                
                <div class="w-full xl:w-96 relative">
                    <input type="text" id="searchInput" placeholder="Cari nama pengguna atau isi ulasan..." 
                        class="w-full bg-main border border-white/10 rounded-xl px-4 py-3 text-sm text-pale focus:border-accent focus:ring-1 focus:ring-accent outline-none transition-all placeholder-white/20">
                    <svg class="w-5 h-5 text-white/30 absolute right-4 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                </div>

                <div class="flex flex-col sm:flex-row gap-3 w-full xl:w-auto">
                    <select id="categoryFilter" class="bg-main border border-white/10 rounded-xl px-4 py-2.5 text-sm text-pale focus:border-accent outline-none cursor-pointer">
                        <option value="">Semua Kategori</option>
                        <option value="Product">Produk</option>
                        <option value="Kegiatan">Kegiatan</option>
                    </select>

                    <select id="ratingFilter" class="bg-main border border-white/10 rounded-xl px-4 py-2.5 text-sm text-pale focus:border-accent outline-none cursor-pointer">
                        <option value="">Semua Rating</option>
                        <option value="5">⭐⭐⭐⭐⭐ (5)</option>
                        <option value="4">⭐⭐⭐⭐ (4)</option>
                        <option value="3">⭐⭐⭐ (3)</option>
                        <option value="2">⭐⭐ (2)</option>
                        <option value="1">⭐ (1)</option>
                    </select>
                </div>
            </div>
        </div>

        <form action="/admin/testimoni/bulk-action" method="POST" id="bulk-form">
            <input type="hidden" name="action" value="delete">
            
            <div class="bg-surface rounded-2xl shadow-xl border border-white/5 overflow-hidden">
                
                <div id="bulk-action-bar" class="hidden bg-red-500/10 border-b border-red-500/20 p-3 flex justify-between items-center px-6 animate-pulse">
                    <span class="text-red-400 text-sm font-medium"><span id="selected-count">0</span> review terpilih</span>
                    <button type="submit" class="text-xs bg-red-500 hover:bg-red-600 text-white font-bold py-1.5 px-4 rounded-lg transition-colors shadow-lg shadow-red-500/20">
                        Hapus Terpilih
                    </button>
                </div>

                <div class="overflow-x-auto">
                    <table class="min-w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-main/50 border-b border-white/10 text-xs uppercase tracking-wider text-muted font-semibold">
                                <th class="py-4 px-6 text-center w-12">
                                    <input type="checkbox" id="select-all" class="custom-checkbox">
                                </th>
                                <th class="py-4 px-6">Pengguna & Item</th>
                                <th class="py-4 px-6">Rating & Ulasan</th>
                                <th class="py-4 px-6 text-center w-32">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="reviewTableBody" class="divide-y divide-white/5">
                            <% if(reviewList && reviewList.length > 0) { %>
                                <% for(let review of reviewList) { %>
                                    <tr class="hover:bg-white/5 transition-colors group review-row"
                                        data-user="<%= (review.dataValues.pengguna ? review.dataValues.pengguna.Nama : '').toLowerCase() %>"
                                        data-content="<%= (review.Ulasan || '').toLowerCase() %>"
                                        data-category="<%= review.Kategori %>"
                                        data-rating="<%= review.Rating %>">
                                        
                                        <td class="py-4 px-6 text-center align-top">
                                            <input type="checkbox" name="selectedIds" value="<%= review.ID_Review %>" class="row-checkbox custom-checkbox mt-1">
                                        </td>

                                        <td class="py-4 px-6 align-top">
                                            <div class="flex flex-col gap-1">
                                                <div class="flex items-center gap-2">
                                                    <div class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center text-xs font-bold text-accent">
                                                        <%= review.dataValues.pengguna ? review.dataValues.pengguna.Nama.charAt(0).toUpperCase() : '?' %>
                                                    </div>
                                                    <span class="font-bold text-pale text-sm">
                                                        <%= review.dataValues.pengguna ? review.dataValues.pengguna.Nama : 'Anonim' %>
                                                    </span>
                                                </div>
                                                
                                                <div class="mt-2 pl-10">
                                                    <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded border 
                                                        <%= review.Kategori === 'Product' ? 'bg-blue-500/10 text-blue-400 border-blue-500/20' : 'bg-purple-500/10 text-purple-400 border-purple-500/20' %>">
                                                        <%= review.Kategori %>
                                                    </span>
                                                    <div class="text-xs text-muted mt-1 truncate max-w-[200px]" title="<%= review.Kategori === 'Product' ? (review.dataValues.produk ? review.dataValues.produk.Nama : '-') : (review.dataValues.kegiatan ? review.dataValues.kegiatan.Judul : '-') %>">
                                                        <% if (review.Kategori === 'Product' && review.dataValues.produk) { %>
                                                            📦 <%= review.dataValues.produk.Nama %>
                                                        <% } else if (review.Kategori === 'Kegiatan' && review.dataValues.kegiatan) { %>
                                                            📅 <%= review.dataValues.kegiatan.Judul %>
                                                        <% } else { %>
                                                            - Item Dihapus -
                                                        <% } %>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>

                                        <td class="py-4 px-6 align-top">
                                            <div class="flex items-center mb-1 space-x-0.5">
                                                <% for(let i=0; i<5; i++) { %>
                                                    <svg class="w-4 h-4 <%= i < review.Rating ? 'text-yellow-400' : 'text-gray-600' %>" fill="currentColor" viewBox="0 0 20 20">
                                                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                                                    </svg>
                                                <% } %>
                                                <span class="text-xs text-muted ml-2">(<%= review.Rating %>/5)</span>
                                            </div>
                                            <p class="text-sm text-pale/80 leading-relaxed italic">
                                                "<%= review.Ulasan %>"
                                            </p>
                                        </td>

                                        <td class="py-4 px-6 text-center align-top">
                                            <div class="flex items-center justify-center space-x-2">
                                                <a href="/admin/testimoni/<%= review.ID_Review %>/edit" class="p-2 bg-yellow-500/10 text-yellow-400 rounded-lg hover:bg-yellow-500 hover:text-white transition-all border border-yellow-500/20 group/btn" title="Edit">
                                                    <svg class="w-4 h-4 transform group-hover/btn:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                                                </a>
                                                
                                                <button type="button" 
                                                    onclick="deleteItem('<%= review.ID_Review %>', '<%= (review.dataValues.pengguna ? review.dataValues.pengguna.Nama : 'User').replace(/'/g, "\\'") %>')"
                                                    class="p-2 bg-red-500/10 text-red-400 rounded-lg hover:bg-red-500 hover:text-white transition-all border border-red-500/20 group/btn" title="Hapus">
                                                    <svg class="w-4 h-4 transform group-hover/btn:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% } %>
                            <% } else { %>
                                <tr>
                                    <td colspan="4" class="py-12 px-6 text-center text-muted">
                                        <div class="flex flex-col items-center justify-center">
                                            <svg class="w-12 h-12 mb-3 text-white/20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
                                            <p>Belum ada testimoni atau review.</p>
                                        </div>
                                    </td>
                                </tr>
                            <% } %>
                            
                            <tr id="noSearchResultsRow" class="hidden">
                                <td colspan="4" class="py-12 px-6 text-center text-muted">
                                    <p>Tidak ditemukan review yang cocok dengan filter Anda.</p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </form>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // --- 1. FILTER LOGIC ---
            const searchInput = document.getElementById('searchInput');
            const categoryFilter = document.getElementById('categoryFilter');
            const ratingFilter = document.getElementById('ratingFilter');
            const rows = document.querySelectorAll('.review-row');
            const noResultsRow = document.getElementById('noSearchResultsRow');

            function filterTable() {
                const searchTerm = searchInput.value.toLowerCase();
                const selectedCategory = categoryFilter.value;
                const selectedRating = ratingFilter.value;
                
                let visibleCount = 0;

                rows.forEach(row => {
                    const user = row.getAttribute('data-user');
                    const content = row.getAttribute('data-content');
                    const category = row.getAttribute('data-category');
                    const rating = row.getAttribute('data-rating');

                    const matchesSearch = user.includes(searchTerm) || content.includes(searchTerm);
                    const matchesCategory = selectedCategory === '' || category === selectedCategory;
                    const matchesRating = selectedRating === '' || rating === selectedRating;

                    if (matchesSearch && matchesCategory && matchesRating) {
                        row.style.display = '';
                        visibleCount++;
                    } else {
                        row.style.display = 'none';
                    }
                });

                // Show/Hide "No Results" Message
                if (rows.length > 0) {
                    if (visibleCount === 0) {
                        noResultsRow.classList.remove('hidden');
                    } else {
                        noResultsRow.classList.add('hidden');
                    }
                }
            }

            // Event Listeners for Filters
            searchInput.addEventListener('input', filterTable);
            categoryFilter.addEventListener('change', filterTable);
            ratingFilter.addEventListener('change', filterTable);

            // --- 2. BULK ACTION LOGIC ---
            const selectAll = document.getElementById('select-all');
            const checkboxes = document.querySelectorAll('.row-checkbox');
            const bulkActionBar = document.getElementById('bulk-action-bar');
            const selectedCountSpan = document.getElementById('selected-count');

            function updateBulkActionState() {
                // Count visible checked boxes
                const visibleChecked = Array.from(document.querySelectorAll('.row-checkbox:checked')).filter(cb => {
                    return cb.closest('tr').style.display !== 'none';
                });

                selectedCountSpan.innerText = visibleChecked.length;

                if (visibleChecked.length > 0) {
                    bulkActionBar.classList.remove('hidden');
                    bulkActionBar.classList.add('flex');
                } else {
                    bulkActionBar.classList.add('hidden');
                    bulkActionBar.classList.remove('flex');
                }
            }

            if(selectAll) {
                selectAll.addEventListener('change', function(e) {
                    checkboxes.forEach(cb => {
                        // Only check visible rows
                        if(cb.closest('tr').style.display !== 'none') {
                            cb.checked = e.target.checked;
                        }
                    });
                    updateBulkActionState();
                });
            }

            checkboxes.forEach(cb => {
                cb.addEventListener('change', updateBulkActionState);
            });

            // Prevent form submit if nothing selected
            document.getElementById('bulk-form').addEventListener('submit', function(e) {
                const checkedCount = document.querySelectorAll('.row-checkbox:checked').length;
                if (checkedCount === 0) {
                    e.preventDefault();
                    return;
                }
                if (!confirm(`Apakah Anda yakin ingin menghapus ${checkedCount} review terpilih?`)) {
                    e.preventDefault();
                }
            });
        });

        // --- 3. SINGLE DELETE LOGIC ---
        function deleteItem(id, userName) {
            if (confirm(`Apakah Anda yakin ingin menghapus review dari pengguna "${userName}"?`)) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = `/admin/testimoni/${id}/delete`;
                form.style.display = 'none';
                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
</body>
</html>