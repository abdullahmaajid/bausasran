<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detail Anggota: <%= anggota.Nama %></title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        main: '#003024',    // Background Gelap
                        surface: '#004030', // Warna Kartu
                        accent: '#83C540',  // Hijau Neon
                        pale: '#F5FEF9',    // Teks Putih
                        muted: '#A3C2B8',   // Teks Pudar
                        darker: '#00251a',  // Background Input
                        danger: '#ff4d4d',  // Merah Error
                        warning: '#FFC107', // Kuning Warning
                    },
                    fontFamily: { sans: ['Inter', 'sans-serif'] }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer base { body { @apply bg-main text-pale font-sans antialiased; } }
        
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #004030; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #83C540; }

        .label-text {
            @apply flex items-center gap-2 text-xs font-bold text-muted uppercase tracking-wider mb-1;
        }
        .value-text {
            @apply text-lg font-medium text-pale;
        }
    </style>
</head>

<body class="flex h-screen overflow-hidden w-full">

    <%- include('../../partials/admin_sidebar.ejs') %>

    <main class="flex-1 h-full overflow-y-auto overflow-x-hidden p-6 md:p-8 relative">
        <%- include('../../partials/flash.ejs') %>

        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
            
            <div class="flex-1">
                <div class="flex items-center gap-3">
                    <h1 class="text-3xl font-bold text-pale tracking-tight">
                        <%= anggota.Nama %>
                    </h1>
                    <span class="px-3 py-1 rounded-full text-xs font-bold border 
                        <%= anggota.Role === 'Admin' 
                            ? 'bg-danger/10 text-danger border-danger/20' 
                            : 'bg-accent/10 text-accent border-accent/20' %>">
                        <%= anggota.Role %>
                    </span>
                </div>
                <p class="text-muted text-sm mt-1">Detail profil dan informasi akun anggota.</p>
            </div>

            <div class="flex items-center gap-3 shrink-0">
                <a href="/admin/anggota" class="bg-surface hover:bg-white/10 text-pale font-bold py-2.5 px-6 rounded-xl border border-white/10 transition-all text-sm shadow-lg flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                    Kembali
                </a>
                <a href="/admin/anggota/<%= anggota.ID_Pengguna %>/edit" class="bg-warning hover:bg-warning/90 text-main font-bold py-2.5 px-6 rounded-xl shadow-lg shadow-warning/20 transition-all flex items-center gap-2 text-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                    Edit Data
                </a>
            </div>
        </div>

        <div class="bg-surface rounded-2xl p-6 md:p-8 shadow-xl border border-white/5">
            <div class="flex flex-col md:flex-row gap-8 md:gap-12">
                
                <div class="md:w-1/3 flex flex-col items-center text-center shrink-0">
                    <div class="relative group">
                        <div class="absolute -inset-1 bg-gradient-to-br from-accent to-surface rounded-full opacity-30 blur-sm group-hover:opacity-50 transition-opacity"></div>
                        
                        <% if (anggota.dataValues.fotoFile) { %>
                            <img src="/images/anggota/<%= anggota.dataValues.fotoFile %>" 
                                 alt="<%= anggota.Nama %>" 
                                 class="relative w-56 h-56 rounded-full object-cover border-4 border-surface shadow-2xl">
                        <% } else { %>
                            <div class="relative w-56 h-56 rounded-full bg-darker flex flex-col items-center justify-center border-4 border-surface shadow-2xl text-muted group-hover:text-accent transition-colors">
                                <svg class="w-20 h-20 mb-2 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                                <span class="text-xs font-bold uppercase tracking-widest opacity-70">No Photo</span>
                            </div>
                        <% } %>
                    </div>

                    <div class="mt-6">
                        <h2 class="text-xl font-bold text-pale"><%= anggota.Nama %></h2>
                        <p class="text-accent text-sm font-medium mt-1"><%= anggota.Jabatan || 'Anggota' %></p>
                    </div>
                </div>

                <div class="flex-1 flex flex-col">
                    <h3 class="text-lg font-bold text-pale mb-6 border-b border-white/5 pb-4 flex items-center gap-2">
                        <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2"></path></svg>
                        Informasi Pribadi
                    </h3>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-6 mb-8">
                        <div>
                            <div class="label-text">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                                Nama Lengkap
                            </div>
                            <div class="value-text"><%= anggota.Nama %></div>
                        </div>

                        <div>
                            <div class="label-text">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                                Jabatan
                            </div>
                            <div class="value-text"><%= anggota.Jabatan || '-' %></div>
                        </div>

                        <div>
                            <div class="label-text">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11.536 19.464a3 3 0 01-4.242-4.242l4.664-4.664A6 6 0 0121 9z"></path></svg>
                                Username
                            </div>
                            <div class="value-text font-mono text-accent"><%= anggota.username %></div>
                        </div>

                        <div>
                            <div class="label-text">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                                Role Akun
                            </div>
                            <div class="value-text"><%= anggota.Role %></div>
                        </div>
                    </div>

                    <div class="bg-darker/50 rounded-xl p-5 border border-white/5 flex-1">
                        <div class="label-text mb-3">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
                            Deskripsi / Bio
                        </div>
                        <div class="text-pale/90 leading-relaxed text-sm whitespace-pre-line">
                            <% if (anggota.Deskripsi) { %>
                                <%- anggota.Deskripsi %>
                            <% } else { %>
                                <span class="text-muted italic opacity-50">Belum ada deskripsi yang ditambahkan untuk anggota ini.</span>
                            <% } %>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </main>
</body>
</html>