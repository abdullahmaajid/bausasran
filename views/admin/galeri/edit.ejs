<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Galeri: <%= groupFoto.Nama %> - Bausasran Heritage</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        paper: '#F9F7F2',       
                        deep: '#0F1F18',        
                        gold: '#C5B388',        
                        charcoal: '#4A4A4A',    
                        linen: '#EBE9E4', 
                        white: '#FFFFFF',
                        danger: '#9B1C1C',      
                    },
                    fontFamily: {
                        sans: ['Lato', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                        crest: ['Cinzel', 'serif'], 
                    },
                    boxShadow: {
                        'elegant': '0 10px 40px -10px rgba(15, 31, 24, 0.05)',
                    }
                }
            }
        }
    </script>

    <style type="text/tailwindcss">
        @layer base {
            body {
                @apply bg-paper text-deep font-sans antialiased selection:bg-deep selection:text-paper;
            }
        }
        /* TEXTURE: FILM GRAIN */
        .noise-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none; z-index: 50; mix-blend-mode: multiply;
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #C5B388; border-radius: 3px; }

        /* Form Styling */
        .heritage-input {
            @apply w-full bg-white border border-deep/10 px-4 py-3 text-deep text-sm focus:border-gold focus:outline-none focus:ring-1 focus:ring-gold transition-all placeholder:text-charcoal/30;
        }
        .heritage-label {
            @apply block text-[10px] font-bold text-gold uppercase tracking-widest mb-2;
        }
        .heritage-card {
            @apply bg-white p-8 border border-deep/5 shadow-elegant relative overflow-hidden;
        }
    </style>
</head>

<body class="flex h-screen overflow-hidden relative">

    <div class="noise-overlay"></div>

    <%- include('../../partials/admin_sidebar.ejs') %>

    <main class="flex-1 h-full overflow-y-auto relative z-10 p-8 md:p-12">
        <%- include('../../partials/flash.ejs') %>

        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 border-b border-deep/10 pb-8">
            <div>
                <span class="font-sans text-[10px] uppercase tracking-widest text-gold mb-2 block">
                    Manajemen Galeri
                </span>
                <h1 class="font-crest text-3xl md:text-4xl text-deep leading-none">
                    Edit Album
                </h1>
                <p class="font-serif italic text-charcoal/60 mt-2 text-sm">
                    Perbarui informasi album "<span class="text-deep font-semibold"><%= groupFoto.Nama %></span>"
                </p>
            </div>
            <div class="mt-6 md:mt-0 flex gap-3">
                <a href="/admin/galeri" class="px-6 py-3 border border-deep/10 bg-white text-deep text-[10px] font-bold uppercase tracking-widest hover:bg-linen transition-colors">
                    Kembali
                </a>
            </div>
        </div>

        <form action="/admin/galeri/<%= groupFoto.ID_GroupFoto %>/edit" method="POST" enctype="multipart/form-data">
            
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch pb-12">
                
                <div class="lg:col-span-2 flex flex-col gap-8 h-full">
                    
                    <div class="heritage-card">
                        <h3 class="font-crest text-xl text-deep mb-6 border-b border-deep/5 pb-4">Informasi Dasar</h3>
                        <div class="space-y-6">
                            <div>
                                <label for="Nama" class="heritage-label">Nama Galeri / Album</label>
                                <input type="text" id="Nama" name="Nama" value="<%= groupFoto.Nama %>" class="heritage-input font-serif text-lg" placeholder="Contoh: Kegiatan Maulid Nabi 2024" required>
                            </div>
                        </div>
                    </div>

                    <div class="heritage-card flex-1">
                        <div class="flex justify-between items-center mb-6 border-b border-deep/5 pb-4">
                            <h3 class="font-crest text-xl text-deep">Koleksi Foto (<%= fotoList ? fotoList.length : 0 %>)</h3>
                        </div>

                        <% if (fotoList && fotoList.length > 0) { %>
                            <div class="mb-6">
                                <div class="flex items-center gap-4 bg-linen/30 p-3 border border-deep/5">
                                    <label class="flex items-center gap-2 cursor-pointer select-none text-xs text-deep hover:text-gold transition-colors">
                                        <input type="checkbox" id="select-all-fotos" class="accent-gold w-4 h-4 cursor-pointer">
                                        <span class="tracking-widest uppercase text-[10px] font-bold">Pilih Semua</span>
                                    </label>
                                    <div class="h-4 w-px bg-deep/10"></div>
                                    <button type="button" id="trigger-bulk-delete" disabled class="text-[10px] font-bold uppercase tracking-widest text-danger disabled:opacity-30 disabled:cursor-not-allowed hover:text-red-700 transition-colors flex items-center gap-1">
                                        Hapus Terpilih
                                    </button>
                                </div>
                            </div>

                            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
                                <% fotoList.forEach(foto => { %>
                                    <div class="relative group aspect-square bg-linen/20 border border-deep/5 overflow-hidden transition-all hover:shadow-lg">
                                        <img src="/images/<%= folder || 'galeri' %>/<%= foto.Foto %>" alt="Dokumentasi" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500">
                                        
                                        <div class="absolute top-2 left-2 z-20">
                                            <input type="checkbox" form="bulk-foto-form" name="selectedFotoIds" value="<%= foto.ID_Foto %>" class="row-foto-checkbox accent-danger w-5 h-5 cursor-pointer shadow-sm">
                                        </div>

                                        <div class="absolute inset-0 bg-deep/80 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col justify-center items-center gap-2 p-4">
                                            <button type="button" 
                                                onclick="deleteSingleFoto('<%= foto.ID_Foto %>')"
                                                class="px-3 py-2 bg-white text-danger text-[9px] font-bold uppercase tracking-widest hover:bg-danger hover:text-white transition-colors border border-white">
                                                Hapus Foto
                                            </button>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="text-center py-12 border border-dashed border-deep/10 bg-linen/10">
                                <p class="font-serif italic text-charcoal/40">Album ini belum memiliki foto.</p>
                            </div>
                        <% } %>
                    </div>
                </div>

                <div class="lg:col-span-1 flex flex-col h-full">
                    
                    <div class="heritage-card h-full flex flex-col justify-between">
                        
                        <div>
                            <h3 class="font-crest text-xl text-deep mb-6 border-b border-deep/5 pb-4">Upload Baru</h3>
                            
                            <div class="relative group w-full min-h-[200px] bg-linen/20 border border-dashed border-deep/20 flex flex-col items-center justify-center hover:border-gold transition-colors cursor-pointer mb-6 p-4">
                                <input type="file" id="fotoGaleri" name="fotoGaleri" multiple accept="image/png, image/jpeg, image/jpg" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10">
                                <div class="flex flex-col items-center pointer-events-none text-center">
                                    <span class="font-sans text-[9px] font-bold uppercase tracking-widest text-gold mb-2 group-hover:text-deep transition-colors">
                                        Klik atau Drag Foto
                                    </span>
                                    <p class="font-serif italic text-xs text-charcoal/50">Maksimal 5MB per file</p>
                                </div>
                            </div>

                            <div id="foto-preview-container" class="grid grid-cols-3 gap-2 mb-8 empty:hidden"></div>
                        </div>

                        <div class="mt-auto pt-6 border-t border-deep/5">
                            <button type="submit" class="w-full py-4 bg-deep text-white font-sans text-[10px] font-bold uppercase tracking-widest hover:bg-gold hover:text-deep transition-all border border-deep shadow-lg">
                                Simpan Perubahan
                            </button>
                        </div>

                    </div>
                </div>

            </div>
        </form>

        <% if (fotoList && fotoList.length > 0) { %>
            <form action="/admin/galeri/<%= groupFoto.ID_GroupFoto %>/bulk-delete-fotos" method="POST" id="bulk-foto-form" class="hidden"></form>
        <% } %>

    </main>

    <script>
        // --- 1. LOGIKA BULK DELETE ---
        const checkAll = document.getElementById('select-all-fotos');
        const triggerBtn = document.getElementById('trigger-bulk-delete');
        const bulkForm = document.getElementById('bulk-foto-form');
        
        if (checkAll && bulkForm) {
            checkAll.addEventListener('change', function(e) {
                const checkboxes = document.querySelectorAll('.row-foto-checkbox');
                checkboxes.forEach(cb => cb.checked = e.target.checked);
                toggleBulkButton();
            });

            document.querySelectorAll('.row-foto-checkbox').forEach(cb => {
                cb.addEventListener('change', toggleBulkButton);
            });

            function toggleBulkButton() {
                const count = document.querySelectorAll('.row-foto-checkbox:checked').length;
                triggerBtn.disabled = count === 0;
                if (count > 0) {
                    triggerBtn.innerText = `HAPUS (${count}) FOTO`;
                } else {
                    triggerBtn.innerText = `HAPUS TERPILIH`;
                }
            }

            triggerBtn.addEventListener('click', function() {
                const checkedBoxes = document.querySelectorAll('.row-foto-checkbox:checked').length;
                if (checkedBoxes > 0) {
                    if (confirm(`Apakah Anda yakin ingin menghapus ${checkedBoxes} foto terpilih dari album ini?`)) {
                        bulkForm.submit();
                    }
                }
            });
        }

        // --- 2. LOGIKA HAPUS SATU FOTO ---
        function deleteSingleFoto(fotoId) {
            if (confirm('Apakah Anda yakin ingin menghapus foto ini secara permanen?')) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = `/admin/galeri/<%= groupFoto.ID_GroupFoto %>/foto/${fotoId}/delete`;
                form.style.display = 'none';
                document.body.appendChild(form);
                form.submit();
            }
        }

        // --- 3. PREVIEW GAMBAR ---
        const inputUpload = document.getElementById('fotoGaleri');
        const previewContainer = document.getElementById('foto-preview-container');

        if (inputUpload && previewContainer) {
            inputUpload.addEventListener('change', function(event) {
                previewContainer.innerHTML = '';
                const files = Array.from(this.files);
                if (files.length > 20) {
                    alert('Maksimal upload 20 foto sekaligus!');
                    this.value = ''; 
                    return;
                }
                files.forEach(file => {
                    if (file.type.startsWith('image/')) {
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            const img = document.createElement('img');
                            img.src = e.target.result;
                            img.className = 'w-full h-16 object-cover border border-deep/10 filter grayscale hover:grayscale-0 transition-all rounded-sm';
                            previewContainer.appendChild(img);
                        }
                        reader.readAsDataURL(file);
                    }
                });
            });
        }
    </script>
</body>
</html>