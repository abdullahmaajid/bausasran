<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detail Kegiatan: <%= kegiatan.Judul %> - Bausasran Heritage</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        paper: '#F9F7F2',       
                        deep: '#0F1F18',        
                        gold: '#C5B388',        
                        charcoal: '#4A4A4A',    
                        linen: '#EBE9E4', 
                        white: '#FFFFFF',
                        danger: '#9B1C1C',      
                    },
                    fontFamily: {
                        sans: ['Lato', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                        crest: ['Cinzel', 'serif'], 
                    },
                    boxShadow: {
                        'elegant': '0 10px 40px -10px rgba(15, 31, 24, 0.05)',
                        'gold-glow': '0 0 15px rgba(197, 179, 136, 0.2)',
                    }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer base {
            body { @apply bg-paper text-deep font-sans antialiased selection:bg-deep selection:text-paper; }
        }
        /* TEXTURE: Film Grain */
        .noise-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none; z-index: 50; mix-blend-mode: multiply;
        }

        /* Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #C5B388; border-radius: 3px; }

        /* Components */
        .heritage-card {
            @apply bg-white p-8 border border-deep/5 shadow-elegant relative overflow-hidden transition-all duration-500;
        }
        .btn-heritage {
            @apply px-6 py-3 border border-deep/10 bg-white text-deep text-[10px] font-bold uppercase tracking-widest hover:bg-linen transition-colors flex items-center justify-center gap-2;
        }
    </style>
</head>

<body class="flex h-screen overflow-hidden relative w-full">

    <div class="noise-overlay"></div>

    <%- include('../../partials/admin_sidebar.ejs') %>

    <main class="flex-1 h-full overflow-y-auto overflow-x-hidden p-8 md:p-12 relative z-10">
        <%- include('../../partials/flash.ejs') %>

        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 border-b border-deep/10 pb-8">
            <div class="max-w-3xl">
                <div class="flex items-center gap-3 mb-3">
                    <span class="font-sans text-[10px] uppercase tracking-widest text-gold block">
                        Agenda & Kegiatan
                    </span>
                    <span class="h-px w-8 bg-deep/10"></span>
                    <span class="text-[10px] font-bold text-deep/40 font-mono tracking-wider">ID: #<%= kegiatan.ID_Kegiatan %></span>
                </div>
                
                <h1 class="font-crest text-3xl md:text-4xl text-deep leading-tight">
                    <%= kegiatan.Judul %>
                </h1>
            </div>
            
            <div class="mt-6 md:mt-0 flex gap-3">
                <a href="/admin/kegiatan" class="btn-heritage">
                    Kembali
                </a>
                <a href="/admin/kegiatan/<%= kegiatan.ID_Kegiatan %>/edit" class="btn-heritage !bg-deep !text-white !border-deep hover:!bg-gold hover:!text-deep hover:!border-gold hover:shadow-gold-glow">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                    <span>Edit Data</span>
                </a>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
            
            <div class="lg:col-span-2 space-y-8">
                
                <div class="heritage-card">
                    <h2 class="font-crest text-xl text-deep mb-6 flex items-center gap-3">
                        <span class="w-8 h-px bg-gold"></span>
                        Deskripsi Kegiatan
                    </h2>
                    
                    <div class="prose max-w-none">
                        <% if (sections && sections.length > 0) { %>
                            <% sections.forEach((section, index) => { %>
                                <div class="mb-6 last:mb-0">
                                    <% if (index === 0) { %>
                                        <p class="font-serif text-lg leading-relaxed text-deep/90 first-letter:text-5xl first-letter:font-crest first-letter:text-gold first-letter:float-left first-letter:mr-3 first-letter:mt-[-10px]">
                                            <%- section.Deskripsi.replace(/\n/g, '<br>') %>
                                        </p>
                                    <% } else { %>
                                        <p class="font-sans text-deep/70 leading-relaxed text-sm whitespace-pre-line text-justify">
                                            <%- section.Deskripsi %>
                                        </p>
                                    <% } %>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="flex flex-col items-center justify-center py-12 bg-linen/20 border border-dashed border-deep/10">
                                <span class="font-serif italic text-deep/40">Belum ada deskripsi konten untuk kegiatan ini.</span>
                            </div>
                        <% } %>
                    </div>
                </div>

                <div class="heritage-card">
                    <div class="flex justify-between items-center mb-6 border-b border-deep/5 pb-4">
                        <h2 class="font-crest text-xl text-deep">Dokumentasi Visual</h2>
                        <span class="text-[10px] text-gold font-bold tracking-widest uppercase"><%= fotoList ? fotoList.length : 0 %> Foto</span>
                    </div>

                    <% if (fotoList && fotoList.length > 0) { %>
                        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                            <% fotoList.forEach((foto) => { %>
                                <div class="group relative bg-white p-2 shadow-sm border border-deep/5 hover:shadow-xl hover:-translate-y-1 transition-all duration-500">
                                    <div class="aspect-square relative overflow-hidden bg-linen">
                                        <img src="/images/kegiatan/<%= foto.Foto %>" 
                                             alt="Dokumentasi" 
                                             class="w-full h-full object-cover  group-hover:-0 transition-all duration-700 ease-in-out">
                                        
                                        <a href="/images/kegiatan/<%= foto.Foto %>" target="_blank" class="absolute inset-0 bg-deep/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                                            <span class="bg-white text-deep px-3 py-1 text-[9px] font-bold uppercase tracking-widest">Lihat</span>
                                        </a>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="flex flex-col items-center justify-center py-12 text-charcoal/40 bg-linen/10 border border-dashed border-deep/10">
                            <svg class="w-10 h-10 mb-3 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            <span class="font-serif italic text-sm">Arsip foto belum tersedia.</span>
                        </div>
                    <% } %>
                </div>

            </div>

            <div class="lg:col-span-1 space-y-6">
                
                <div class="heritage-card !p-0">
                    <div class="bg-deep p-8 text-paper relative overflow-hidden">
                        <div class="absolute top-0 right-0 p-4 opacity-10">
                            <svg class="w-24 h-24" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z"/></svg>
                        </div>
                        
                        <h3 class="font-sans text-[10px] text-gold uppercase tracking-[0.2em] mb-4 relative z-10">Waktu Pelaksanaan</h3>
                        
                        <div class="relative z-10 flex items-baseline gap-2">
                            <span class="font-serif text-5xl text-white italic"><%= new Date(kegiatan.Tanggal).getDate() %></span>
                            <div class="flex flex-col">
                                <span class="font-crest text-lg uppercase leading-none"><%= new Date(kegiatan.Tanggal).toLocaleDateString('id-ID', { month: 'long' }) %></span>
                                <span class="text-xs font-mono opacity-60"><%= new Date(kegiatan.Tanggal).getFullYear() %></span>
                            </div>
                        </div>
                        <p class="mt-2 text-xs font-bold uppercase tracking-widest text-gold/80 relative z-10">
                            <%= new Date(kegiatan.Tanggal).toLocaleDateString('id-ID', { weekday: 'long' }) %>
                        </p>
                    </div>

                    <div class="p-8 space-y-6">
                        <div>
                            <span class="text-[9px] text-charcoal/50 font-bold uppercase tracking-widest mb-1 block">Kategori</span>
                            <p class="font-crest text-deep text-lg border-l-2 border-gold/30 pl-3">
                                <%= kegiatan.Kategori || 'Umum' %>
                            </p>
                        </div>

                        <div>
                            <span class="text-[9px] text-charcoal/50 font-bold uppercase tracking-widest mb-2 block">Status Arsip</span>
                            <div class="flex items-center gap-3">
                                <div class="px-4 py-2 border <%= kegiatan.Status === 'Upcoming' ? 'border-deep/80 text-deep bg-gold/20' : 'border-deep/10 text-deep/40 bg-linen/20' %> inline-flex items-center gap-2">
                                    <span class="w-2 h-2 rounded-full <%= kegiatan.Status === 'Upcoming' ? 'bg-gold animate-pulse' : 'bg-charcoal' %>"></span>
                                    <span class="text-[10px] font-bold uppercase tracking-widest"><%= kegiatan.Status %></span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="px-8 pb-8 pt-0">
                        <div class="w-full h-px bg-deep/5"></div>
                        <div class="mt-4 flex justify-between items-center text-[10px] text-deep/30 font-mono">
                            <span>CREATED: <%= new Date().getFullYear() %></span>
                            <span>BAUSASRAN</span>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </main>
</body>
</html>a