<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Testimoni Saya</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="flex bg-gray-100">

    <%- include('../../partials/user_sidebar.ejs') %>

    <main class="flex-1 p-10">
        <%- include('../../partials/flash.ejs') %>

        <div class="flex justify-between items-center mb-6">
            <h1 class="text-3xl font-bold text-gray-800">Testimoni Saya</h1>
            <a href="/user/testimoni/tambah" class="bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded-lg">
                + Tambah Testimoni
            </a>
        </div>
        
        <div class="bg-white p-6 rounded-lg shadow-lg mb-8">
            <h2 class="text-xl font-semibold mb-2">Selamat Datang, <%= currentUser.Nama %>!</h2>
            <p class="text-gray-700">
                Di sini Anda dapat melihat dan mengelola testimoni yang pernah Anda berikan untuk produk atau kegiatan kami.
            </p>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-lg">
            <h2 class="text-xl font-semibold mb-4">Riwayat Testimoni (<%= myReviewList.length %>)</h2>
            
            <% if(myReviewList && myReviewList.length > 0) { %>
                <div class="space-y-4">
                    <% for(let review of myReviewList) { %>
                        <div class="border-2 border-gray-200 p-5 rounded-lg hover:shadow-md transition-shadow">
                            <!-- Header -->
                            <div class="flex justify-between items-start mb-3">
                                <div>
                                    <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold <%= review.Kategori === 'Product' ? 'bg-blue-100 text-blue-800' : 'bg-green-100 text-green-800' %>">
                                        <%= review.Kategori %>
                                    </span>
                                    <h3 class="text-lg font-bold text-gray-800 mt-2">
                                        <% if (review.Kategori === 'Product' && review.dataValues.produk) { %>
                                            <%= review.dataValues.produk.Nama %>
                                        <% } else if (review.Kategori === 'Kegiatan' && review.dataValues.kegiatan) { %>
                                            <%= review.dataValues.kegiatan.Judul %>
                                        <% } else { %>
                                            <span class="text-gray-400">Item Tidak Ditemukan</span>
                                        <% } %>
                                    </h3>
                                </div>
                                <div class="text-right">
                                    <div class="flex items-center justify-end">
                                        <% for(let i = 1; i <= 5; i++) { %>
                                            <% if (i <= review.Rating) { %>
                                                <span class="text-yellow-400 text-xl">★</span>
                                            <% } else { %>
                                                <span class="text-gray-300 text-xl">★</span>
                                            <% } %>
                                        <% } %>
                                    </div>
                                    <p class="text-sm font-semibold text-gray-700 mt-1"><%= review.Rating %>/5</p>
                                </div>
                            </div>

                            <!-- Ulasan -->
                            <div class="bg-gray-50 p-4 rounded-lg mb-4">
                                <% if (review.Ulasan && review.Ulasan.trim() !== '') { %>
                                    <p class="text-gray-700 italic">"<%= review.Ulasan %>"</p>
                                <% } else { %>
                                    <p class="text-gray-400 italic">Tidak ada ulasan tertulis</p>
                                <% } %>
                            </div>

                            <!-- Actions -->
                            <div class="flex space-x-2">
                                <a href="/user/testimoni/<%= review.ID_Review %>/edit" 
                                   class="flex-1 text-center bg-yellow-500 hover:bg-yellow-600 text-white font-semibold py-2 px-4 rounded-lg text-sm">
                                    Edit
                                </a>
                                <button 
                                    type="button" 
                                    onclick="deleteTestimoni('<%= review.ID_Review %>')"
                                    class="flex-1 bg-red-500 hover:bg-red-600 text-white font-semibold py-2 px-4 rounded-lg text-sm">
                                    Hapus
                                </button>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } else { %>
                <div class="text-center py-12">
                    <svg class="mx-auto h-16 w-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                    </svg>
                    <p class="mt-4 text-gray-500 text-lg">Anda belum pernah memberikan testimoni.</p>
                    <a href="/user/testimoni/tambah" class="mt-4 inline-block bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-6 rounded-lg">
                        Tambah Testimoni Pertama
                    </a>
                </div>
            <% } %>
        </div>
    </main>

    <%- include('../../partials/footer.ejs') %>

    <script>
        function deleteTestimoni(id) {
            if (confirm('Apakah Anda yakin ingin menghapus testimoni ini?')) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = `/user/testimoni/${id}/delete`;
                form.style.display = 'none';
                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
</body>
</html>