<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Produk & Simulasi Tani - Bausasran</title>
    
    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        main: '#003024',    // Background Gelap
                        surface: '#004030', // Warna Card
                        accent: '#83C540',  // Hijau Neon
                        pale: '#F5FEF9',    // Teks Putih Gading
                        muted: '#A3C2B8',   // Teks Pudar
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style type="text/tailwindcss">
        @layer base {
            body {
                @apply bg-main text-pale font-sans antialiased;
            }
        }
        /* Custom Scrollbar untuk list parameter */
        .parameter-list-scroll::-webkit-scrollbar {
            width: 4px;
        }
        .parameter-list-scroll::-webkit-scrollbar-track {
            background: #003024; 
        }
        .parameter-list-scroll::-webkit-scrollbar-thumb {
            background: #004030; 
            border-radius: 2px;
        }
        .parameter-list-scroll::-webkit-scrollbar-thumb:hover {
            background: #83C540; 
        }
    </style>
</head>

<body class="flex flex-col min-h-screen">

    <%- include('../partials/navbar.ejs') %>

    <div class="relative bg-gradient-to-b from-surface to-main border-b border-white/5 py-10 px-4 md:px-8">
        <div class="container mx-auto">
            
            <div class="text-center mb-8">
                <h1 class="text-3xl md:text-4xl font-bold text-pale mb-2">
                    Simulasi <span class="text-accent">Kecocokan Lahan</span>
                </h1>
                <p class="text-muted max-w-2xl mx-auto">
                    Klik lokasi Anda di peta. Sistem kami akan menganalisis cuaca dan tanah secara <em>real-time</em> untuk merekomendasikan tanaman terbaik.
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <div class="lg:col-span-2 bg-surface border border-white/10 p-2 rounded-2xl shadow-lg">
                    <div class="relative rounded-xl overflow-hidden h-96 w-full group">
                        <div id="map" class="h-full w-full z-0 font-sans text-gray-800"></div>
                        
                        <div id="map-loading" class="absolute inset-0 bg-main/80 backdrop-blur-sm z-10 hidden flex flex-col items-center justify-center transition-all">
                            <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-accent"></div>
                            <span class="mt-3 text-accent font-bold tracking-wide">Menganalisis Lahan...</span>
                        </div>
                        
                        <div class="absolute bottom-4 left-4 bg-main/90 border border-white/10 px-4 py-2 rounded-lg pointer-events-none opacity-80 group-hover:opacity-0 transition-opacity duration-500">
                            <p class="text-xs text-accent">Klik di mana saja pada peta</p>
                        </div>
                    </div>
                </div>

                <div class="lg:col-span-1 flex flex-col gap-4">
                    
                    <div id="live-weather-placeholder" class="h-full flex flex-col items-center justify-center text-center p-8 border-2 border-dashed border-white/10 rounded-2xl bg-white/5">
                        <div class="w-16 h-16 rounded-full bg-accent/10 flex items-center justify-center mb-4 text-accent">
                            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                        </div>
                        <p class="text-pale font-semibold">Tentukan Lokasi</p>
                        <p class="text-sm text-muted mt-1">Pilih titik di peta untuk melihat data cuaca & rekomendasi.</p>
                    </div>

                    <div id="live-weather-cards" class="hidden h-full flex flex-col justify-between gap-4">
                         <div class="grid grid-cols-2 gap-3">
                            <div class="bg-surface border border-white/10 p-4 rounded-xl text-center shadow-lg">
                                <span class="block text-xs text-muted uppercase font-bold tracking-wider mb-1">Suhu</span>
                                <span id="live-temp" class="text-2xl font-bold text-pale">-</span>
                            </div>
                            <div class="bg-surface border border-white/10 p-4 rounded-xl text-center shadow-lg">
                                <span class="block text-xs text-muted uppercase font-bold tracking-wider mb-1">Hujan</span>
                                <span id="live-precip" class="text-2xl font-bold text-pale">-</span>
                            </div>
                            <div class="bg-surface border border-white/10 p-4 rounded-xl text-center shadow-lg col-span-2">
                                <span class="block text-xs text-muted uppercase font-bold tracking-wider mb-1">Kelembaban Udara</span>
                                <span id="live-humidity" class="text-2xl font-bold text-pale">-</span>
                            </div>
                         </div>

                         <div class="bg-gradient-to-r from-accent/20 to-surface border border-accent/30 p-5 rounded-xl flex items-center justify-between shadow-[0_0_15px_rgba(131,197,64,0.1)]">
                             <div>
                                <span class="block text-xs text-accent uppercase font-bold">Produk Cocok</span>
                                <span class="text-xs text-muted">Berdasarkan parameter</span>
                             </div>
                             <span id="live-cocok" class="text-3xl font-extrabold text-accent">-</span>
                         </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <main class="container mx-auto px-4 py-12 flex-grow">
        <%- include('../partials/flash.ejs') %>

        <div class="bg-surface border border-white/10 p-5 rounded-2xl shadow-lg mb-10 sticky top-24 z-30 backdrop-blur-md bg-opacity-90">
            <div class="flex flex-col md:flex-row gap-4 items-center justify-between">
                
                <div class="w-full md:w-1/3 relative">
                     <input type="text" id="filter-search" placeholder="Cari tanaman atau pupuk..." 
                        class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-main border border-white/10 text-pale focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-all placeholder-muted/50">
                     <svg class="w-5 h-5 text-muted absolute left-3 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                </div>

                <div class="flex flex-col sm:flex-row gap-4 w-full md:w-2/3 justify-end items-center">
                    
                    <select id="filter-category" class="w-full sm:w-auto px-4 py-2.5 rounded-xl bg-main border border-white/10 text-pale focus:border-accent focus:outline-none cursor-pointer">
                        <option value="Semua">Semua Kategori</option>
                        <% const categories = [...new Set(produkList.map(p => p.Kategori).filter(Boolean))]; %>
                        <% categories.forEach(cat => { %>
                            <option value="<%= cat %>"><%= cat %></option>
                        <% }) %>
                    </select>
                    
                    <div class="flex items-center gap-3 bg-main px-4 py-2 rounded-xl border border-white/10 w-full sm:w-auto">
                        <label for="filter-grade" class="text-xs font-bold text-muted uppercase whitespace-nowrap">Min. Cocok</label>
                        <input type="range" id="filter-grade" min="0" max="100" value="50" step="10" 
                            class="w-24 h-2 bg-surface rounded-lg appearance-none cursor-pointer accent-accent">
                        <span id="filter-grade-value" class="text-sm font-bold text-accent w-8 text-right">50%</span>
                    </div>

                    <select id="filter-sort" class="w-full sm:w-auto px-4 py-2.5 rounded-xl bg-main border border-white/10 text-pale focus:border-accent focus:outline-none cursor-pointer">
                        <option value="nama">Nama (A-Z)</option>
                        <option value="cocok">Kecocokan Tertinggi</option>
                    </select>
                </div>
            </div>
        </div>
        
        <div class="flex justify-between items-end mb-6 border-b border-white/5 pb-4">
             <h2 class="text-2xl font-bold text-pale">Katalog <span class="text-accent">Produk</span></h2>
             <span id="results-summary" class="text-sm text-muted">Memuat data...</span>
        </div>

        <div id="results-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 min-h-[300px]">
             <div class="col-span-full flex flex-col items-center justify-center py-20 text-muted">
                 <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-accent mb-4"></div>
                 <p>Menyiapkan data produk...</p>
             </div>
        </div>
        
    </main>

    <%- include('../partials/footer.ejs') %>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

    <script> 
        const allProductsData = JSON.parse(decodeURIComponent('<%- encodeURIComponent(JSON.stringify(produkList)) %>')); 
    </script>
    
    <script src="/js/koncoTaniAdmin.js"></script>

    <script>
        /**
         * SCRIPT INTEGRASI UI
         * Menghubungkan logika 'koncoTaniAdmin.js' dengan Tampilan Dark Theme ini
         */
        
        const uiFunctions = {
            // 1. Tampilkan Loading saat ambil data cuaca
            showLoadingState: () => {
                document.getElementById('map-loading').classList.remove('hidden');
                document.getElementById('results-summary').textContent = 'Menganalisis data lahan...';
                document.getElementById('live-weather-cards').classList.add('hidden');
                document.getElementById('live-weather-placeholder').classList.remove('hidden');
            },

            // 2. Sembunyikan Loading
            hideLoadingState: () => {
                document.getElementById('map-loading').classList.add('hidden');
            },

            // 3. Update Kartu Cuaca (Sidebar)
            updateLiveCards: (current, units) => {
                document.getElementById('live-weather-placeholder').classList.add('hidden');
                document.getElementById('live-weather-cards').classList.remove('hidden');
                
                // Format Data
                document.getElementById('live-temp').textContent = Math.round(current.temperature_2m) + (units.temperature_2m || '°C');
                document.getElementById('live-humidity').textContent = (current.relative_humidity_2m || '-') + '%';
                document.getElementById('live-precip').textContent = (current.precipitation || '0') + ' mm';
            },

            // 4. Render Ulang Grid Produk (Fungsi Utama)
            displayResults: (calculatedProducts, passingGrade, totalProducts) => {
                const visibleProducts = calculatedProducts.filter(p => p.isVisible);
                const cocokCount = visibleProducts.filter(p => p.paramCount > 0 && p.scorePercent >= passingGrade).length;
                
                // Update Counter Sidebar
                const liveCocokEl = document.getElementById('live-cocok');
                if(liveCocokEl) liveCocokEl.textContent = cocokCount;

                document.getElementById('results-summary').textContent = `Menampilkan ${visibleProducts.length} produk`;
                
                const container = document.getElementById('results-list');
                container.innerHTML = ''; // Reset isi grid
                
                // Empty State
                if (visibleProducts.length === 0) {
                     container.innerHTML = `
                        <div class="col-span-full text-center py-16 border border-dashed border-white/10 rounded-2xl bg-surface/30">
                            <svg class="w-12 h-12 mx-auto text-muted mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            <p class="text-pale font-semibold text-lg">Tidak ada produk ditemukan</p>
                            <p class="text-muted text-sm">Coba sesuaikan filter atau pilih lokasi lain.</p>
                        </div>`;
                     return;
                }

                // Render Item
                visibleProducts.forEach(product => {
                    container.innerHTML += createDarkCardHTML(product, passingGrade);
                });
            },

            displayInitialState: (msg) => {
                 // Render awal tanpa data peta
                 if(typeof runComparison === 'function') runComparison(null); 
            },
            
            displayError: (msg) => {
                alert("Terjadi kesalahan: " + msg);
            },
            
            updateFilterGradeValue: (val) => { /* Diurus event listener di HTML */ },
            
            getFilterValues: () => {
                return {
                    search: document.getElementById('filter-search').value.toLowerCase(),
                    category: document.getElementById('filter-category').value,
                    sort: document.getElementById('filter-sort').value,
                    grade: parseInt(document.getElementById('filter-grade').value, 10)
                };
            }
        };

        /**
         * GENERATOR KARTU PRODUK (Versi Dark Theme)
         * Fungsi ini membangun string HTML untuk setiap produk
         */
        function createDarkCardHTML(product, passingGrade) {
            let statusBadge = '';
            let scoreText = '';
            
            // Logika Badge Kecocokan
            if (product.paramCount > 0) {
                const isCocok = product.scorePercent >= passingGrade;
                const matches = `${product.score}/${product.paramCount}`;
                
                // Style Badge
                const badgeClass = isCocok 
                    ? 'bg-accent/20 text-accent border border-accent/30' 
                    : 'bg-red-500/20 text-red-400 border border-red-500/30';
                
                const badgeLabel = isCocok ? 'Cocok' : 'Kurang';
                
                statusBadge = `
                    <div class="absolute top-3 right-3 px-2 py-1 rounded text-[10px] font-bold uppercase tracking-wider ${badgeClass} backdrop-blur-md">
                        ${badgeLabel} (${Math.round(product.scorePercent)}%)
                    </div>`;
                
                scoreText = `<span class="text-muted text-xs">Skor:</span> <span class="${isCocok ? 'text-accent' : 'text-red-400'} font-bold">${matches}</span>`;
            } else {
                 scoreText = `<span class="text-muted text-xs">Syarat:</span> <span class="text-pale font-bold">${product.groupparameter?.parameters?.length || 0} Param</span>`;
            }

            // Gambar
            const imgUrl = (product.photos && product.photos.length > 0) 
                 ? `/images/produk/${product.photos[0].Foto}` 
                 : `https://via.placeholder.com/400x300?text=${encodeURIComponent(product.Nama)}`;

            // Harga
            const price = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(product.Harga);

            // Logic Render List Parameter (Detail)
            let paramsHtml = '';
            const rawParams = product.ID_GroupParameter_groupparameter?.parameters || [];
            const details = product.paramDetails || [];
            
            if (details.length > 0) {
                 paramsHtml = '<ul class="space-y-1 mt-2">';
                 details.forEach(p => {
                     const icon = p.isCocok ? '✓' : '✕';
                     const colorClass = p.isCocok ? 'text-accent' : 'text-red-400';
                     const unit = p.Unit || '';
                     
                     paramsHtml += `
                     <li class="flex justify-between items-center text-xs border-b border-white/5 pb-1 last:border-0">
                        <span class="text-muted truncate w-1/2" title="${p.Nama}">${p.Nama}</span>
                        <div class="flex items-center space-x-2">
                             <span class="text-[10px] text-gray-500">${p.Minimal}-${p.Maksimal}</span>
                             <span class="${colorClass} font-bold min-w-[30px] text-right">${p.actualValue}</span>
                        </div>
                     </li>`;
                 });
                 paramsHtml += '</ul>';
            } else if (rawParams.length > 0) {
                 paramsHtml = '<ul class="space-y-1 mt-2">';
                 rawParams.forEach(p => {
                     paramsHtml += `
                     <li class="flex justify-between items-center text-xs border-b border-white/5 pb-1">
                        <span class="text-muted">${p.Nama}</span>
                        <span class="text-gray-600">-</span>
                     </li>`;
                 });
                 paramsHtml += '</ul>';
            }

            // RETURN HTML STRING
            return `
                <div class="bg-surface border border-white/5 rounded-2xl shadow-lg hover:shadow-accent/10 hover:border-accent/30 transition-all duration-300 flex flex-col h-full overflow-hidden group relative" data-product-id="${product.ID_Product}">
                    
                    <div class="relative h-48 bg-black/20 overflow-hidden">
                        <img src="${imgUrl}" alt="${product.Nama}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">
                        ${statusBadge}
                        ${product.Kategori ? `<span class="absolute top-3 left-3 px-2 py-1 rounded text-[10px] font-bold bg-main/80 text-white backdrop-blur-sm border border-white/10">${product.Kategori}</span>` : ''}
                    </div>
                    
                    <div class="p-5 flex flex-col flex-grow">
                        <div class="mb-3">
                            <h3 class="text-lg font-bold text-pale leading-snug group-hover:text-accent transition-colors">${product.Nama}</h3>
                            <div class="mt-1 flex justify-between items-center">
                                <span class="text-lg font-bold text-accent">${price}</span>
                                <div class="text-sm bg-black/20 px-2 py-0.5 rounded border border-white/5">${scoreText}</div>
                            </div>
                        </div>
             
                        <p class="text-sm text-muted line-clamp-2 mb-4"> 
                           ${product.Deskripsi ? product.Deskripsi : 'Tidak ada deskripsi.'}
                        </p>
                        
                        <details class="mt-auto group/details">
                            <summary class="cursor-pointer text-xs font-bold text-accent uppercase tracking-wider hover:text-white flex items-center gap-2 select-none">
                                <span>Cek Parameter</span>
                                <svg class="w-3 h-3 transition-transform group-open/details:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                            </summary>
                            <div class="parameter-list-scroll max-h-32 overflow-y-auto bg-black/20 rounded-lg p-3 mt-2 border border-white/5"> 
                                ${paramsHtml}
                            </div>
                        </details>
                        
                        <div class="mt-5 grid grid-cols-4 gap-2">
                             <a href="/produk/${product.ID_Product}" class="col-span-3 text-center bg-transparent border border-accent text-accent hover:bg-accent hover:text-main font-bold py-2 rounded-lg text-sm transition-all">
                                Lihat Detail
                             </a>
                             <a href="https://wa.me/62812345678?text=Halo, saya tertarik dengan ${encodeURIComponent(product.Nama)}" target="_blank" class="col-span-1 flex items-center justify-center bg-green-600 hover:bg-green-500 text-white rounded-lg transition-colors" title="Beli via WhatsApp">
                                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                             </a>
                        </div>
                    </div>
                </div>`;
        }

        // Listener untuk Range Slider biar angkanya berubah realtime
        document.getElementById('filter-grade').addEventListener('input', function(e) {
            document.getElementById('filter-grade-value').textContent = e.target.value + '%';
        });

        document.addEventListener('DOMContentLoaded', () => {
             // Init External Script (koncoTaniAdmin.js) jika sudah load
             if (window.initKoncoTani) {
                 window.initKoncoTani(uiFunctions);
             } else {
                 console.warn('KoncoTani script not loaded yet, waiting...');
                 // Fallback simple: panggil displayResults sekali untuk show produk tanpa filter cuaca
                 uiFunctions.displayResults(allProductsData.map(p => ({...p, isVisible: true})), 50, allProductsData.length);
             }
        });
    </script>

</body>
</html>