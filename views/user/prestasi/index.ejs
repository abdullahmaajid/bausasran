<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daftar Prestasi - Bausasran</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        main: '#003024',    // Background Gelap
                        surface: '#004030', // Warna Kartu
                        accent: '#83C540',  // Hijau Neon
                        pale: '#F5FEF9',    // Teks Putih
                        muted: '#A3C2B8',   // Teks Pudar
                        gold: '#FFD700',    // Khusus Icon Prestasi
                    },
                    fontFamily: { sans: ['Inter', 'sans-serif'] }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer base { 
            body { @apply bg-main text-pale font-sans antialiased; } 
            .custom-scroll::-webkit-scrollbar { width: 8px; }
            .custom-scroll::-webkit-scrollbar-track { @apply bg-main; }
            .custom-scroll::-webkit-scrollbar-thumb { @apply bg-surface border border-white/10 rounded-full; }
        }
    </style>
</head>
<body class="flex h-screen overflow-hidden">

    <%- include('../../partials/user_sidebar.ejs') %>

    <main class="flex-1 overflow-y-auto custom-scroll p-6 md:p-10 relative">
        
        <div class="fixed top-0 right-0 w-[500px] h-[500px] bg-accent/5 rounded-full blur-[100px] pointer-events-none -z-10"></div>

        <%- include('../../partials/flash.ejs') %>

        <div class="mb-10 border-b border-white/10 pb-6">
            <h1 class="text-3xl md:text-4xl font-bold text-pale mb-2">
                Prestasi & <span class="text-accent">Penghargaan</span>
            </h1>
            <p class="text-muted text-lg">Rekam jejak pencapaian membanggakan dari Kelompok Tani.</p>
        </div>

        <div class="pb-10">
            <% if (prestasiList && prestasiList.length > 0) { %>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-3 gap-8">
                    <% for(let prestasi of prestasiList) { %>
                        <div class="group bg-surface border border-white/5 rounded-2xl overflow-hidden hover:border-accent/50 hover:shadow-[0_0_20px_rgba(131,197,64,0.15)] transition-all duration-300 flex flex-col h-full relative">
                            
                            <div class="h-56 relative overflow-hidden bg-black/20">
                                <% if (prestasi.dataValues.thumbnailFile) { %>
                                    <img src="/images/prestasi/<%= prestasi.dataValues.thumbnailFile %>" 
                                         alt="<%= prestasi.Judul %>"
                                         class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700">
                                    <div class="absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent opacity-80"></div>
                                <% } else { %>
                                    <div class="w-full h-full flex flex-col items-center justify-center bg-surface border-b border-white/5">
                                        <svg class="w-20 h-20 text-gold/20 group-hover:text-gold/50 transition-colors duration-500" fill="currentColor" viewBox="0 0 20 20">
                                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                                        </svg>
                                    </div>
                                <% } %>
                                
                                <div class="absolute -bottom-6 right-6 w-12 h-12 bg-surface border border-white/10 rounded-full flex items-center justify-center shadow-xl z-10 group-hover:scale-110 transition-transform duration-300">
                                    <svg class="w-6 h-6 text-gold" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 2a4 4 0 00-4 4v1H5a1 1 0 00-.994.89l-1 9A1 1 0 004 18h12a1 1 0 00.994-1.11l-1-9A1 1 0 0015 7h-1V6a4 4 0 00-4-4zm2 5V6a2 2 0 10-4 0v1h4zm-6 3a1 1 0 112 0 1 1 0 01-2 0zm7-1a1 1 0 100 2 1 1 0 000-2z" clip-rule="evenodd"></path>
                                    </svg>
                                </div>

                                <% if (prestasi.dataValues.fotoCount > 0) { %>
                                    <div class="absolute top-3 right-3">
                                        <div class="flex items-center space-x-1 bg-black/60 backdrop-blur-md px-2 py-1 rounded-md border border-white/10">
                                            <span class="text-xs font-bold text-white"><%= prestasi.dataValues.fotoCount %></span>
                                            <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                        </div>
                                    </div>
                                <% } %>
                            </div>

                            <div class="p-6 flex-1 flex flex-col mt-2">
                                <h3 class="text-xl font-bold text-pale mb-3 pr-8 group-hover:text-accent transition-colors leading-tight">
                                    <%= prestasi.Judul %>
                                </h3>
                                
                                <div class="space-y-3 mb-6">
                                    <% if (prestasi.Tanggal) { %>
                                        <div class="flex items-center text-sm text-muted">
                                            <svg class="w-4 h-4 mr-3 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                            <%= new Date(prestasi.Tanggal).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                                        </div>
                                    <% } %>

                                    <% if (prestasi.Penyelenggara) { %>
                                        <div class="flex items-start text-sm text-muted">
                                            <svg class="w-4 h-4 mr-3 mt-0.5 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                                            <span class="line-clamp-1"><%= prestasi.Penyelenggara %></span>
                                        </div>
                                    <% } %>
                                </div>

                                <% if (prestasi.Deskripsi) { %>
                                    <p class="text-sm text-muted/70 mb-6 line-clamp-3 leading-relaxed flex-grow">
                                        <%= prestasi.Deskripsi %>
                                    </p>
                                <% } %>

                                <a href="/user/prestasi/<%= prestasi.ID_Prestasi %>" 
                                   class="block w-full text-center bg-white/5 hover:bg-accent border border-white/10 hover:border-transparent text-pale hover:text-main font-semibold py-3 px-4 rounded-xl transition-all duration-300 mt-auto group-hover:shadow-lg">
                                    Lihat Detail Prestasi
                                </a>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } else { %>
                <div class="flex flex-col items-center justify-center py-20 border-2 border-dashed border-white/5 rounded-3xl bg-surface/30">
                    <div class="w-20 h-20 bg-white/5 rounded-full flex items-center justify-center mb-4">
                        <svg class="w-10 h-10 text-gold/50" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-pale mb-2">Belum Ada Prestasi</h3>
                    <p class="text-muted text-sm text-center max-w-md">Data prestasi dan penghargaan belum ditambahkan.</p>
                </div>
            <% } %>
        </div>

        <div class="mt-4 border-t border-white/5 pt-6 text-center text-xs text-muted/30">
            &copy; <%= new Date().getFullYear() %> Kampung Wisata Bausasran.
        </div>
    </main>

</body>
</html>