<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detail Album: <%= groupFoto.Nama %> - Bausasran Heritage</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        paper: '#F9F7F2',       
                        deep: '#0F1F18',        
                        gold: '#C5B388',        
                        charcoal: '#4A4A4A',    
                        linen: '#EBE9E4', 
                        white: '#FFFFFF',
                        danger: '#9B1C1C',      
                    },
                    fontFamily: {
                        sans: ['Lato', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                        crest: ['Cinzel', 'serif'], 
                    },
                    boxShadow: {
                        'elegant': '0 10px 40px -10px rgba(15, 31, 24, 0.05)',
                        'gold-glow': '0 0 15px rgba(197, 179, 136, 0.2)',
                        'photo': '0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06)',
                    }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer base {
            body { @apply bg-paper text-deep font-sans antialiased selection:bg-deep selection:text-paper; }
        }
        /* TEXTURE */
        .noise-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none; z-index: 50; mix-blend-mode: multiply;
        }
        /* Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #C5B388; border-radius: 3px; }

        .btn-heritage {
            @apply px-6 py-3 border border-deep/10 bg-white text-deep text-[10px] font-bold uppercase tracking-widest hover:bg-linen transition-colors flex items-center justify-center gap-2;
        }
    </style>
</head>

<body class="flex h-screen overflow-hidden relative w-full">

    <div class="noise-overlay"></div>

    <%- include('../../partials/admin_sidebar.ejs') %>

    <main class="flex-1 h-full overflow-y-auto overflow-x-hidden p-8 md:p-12 relative z-10">
        <%- include('../../partials/flash.ejs') %>

        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 border-b border-deep/10 pb-8">
            <div class="max-w-3xl">
                <div class="flex items-center gap-3 mb-3">
                    <span class="font-sans text-[10px] uppercase tracking-widest text-gold block">
                        Koleksi Album Foto
                    </span>
                    <span class="h-px w-8 bg-deep/10"></span>
                    <span class="text-[10px] font-bold text-deep/40 font-mono tracking-wider">ID: #<%= groupFoto.ID_GroupFoto %></span>
                </div>
                
                <h1 class="font-crest text-3xl md:text-4xl text-deep leading-tight flex items-end gap-4">
                    <%= groupFoto.Nama %>
                    <span class="font-sans text-xs font-bold text-deep/50 mb-1.5 bg-linen px-2 py-1 rounded-sm tracking-widest uppercase">
                        <%= fotoList ? fotoList.length : 0 %> Item
                    </span>
                </h1>
                <p class="font-serif italic text-deep/60 mt-2 text-lg">
                    Arsip dokumentasi visual dalam album ini.
                </p>
            </div>
            
            <div class="mt-6 md:mt-0 flex gap-3">
                <a href="/admin/galeri" class="btn-heritage">
                    Kembali
                </a>
                <a href="/admin/galeri/<%= groupFoto.ID_GroupFoto %>/edit" class="btn-heritage !bg-deep !text-white !border-deep hover:!bg-gold hover:!text-deep hover:!border-gold hover:shadow-gold-glow">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                    <span>Edit / Tambah</span>
                </a>
            </div>
        </div>

        <% if(fotoList && fotoList.length > 0) { %>
            <div class="bg-white p-8 border border-deep/5 shadow-elegant min-h-[500px]">
                <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-6">
                    <% for(let foto of fotoList) { %>
                        <div class="group relative bg-white p-2.5 shadow-sm border border-deep/5 hover:shadow-xl hover:-translate-y-1 transition-all duration-500 ease-out">
                            
                            <div class="aspect-square relative overflow-hidden bg-linen">
                                <img src="/images/<%= folder || 'galeri' %>/<%= foto.Foto %>" 
                                     alt="Foto ID <%= foto.ID_Foto %>" 
                                     class="w-full h-full object-cover  group-hover:-0 transition-all duration-700 ease-in-out">
                                
                                <div class="absolute inset-0 bg-deep/80 opacity-0 group-hover:opacity-100 transition-all duration-300 flex flex-col items-center justify-center gap-3 backdrop-blur-[1px]">
                                    
                                    <button onclick="openLightbox('<%= foto.Foto %>')" 
                                            class="transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300 delay-75 flex items-center gap-2 px-4 py-2 bg-white text-deep text-[9px] font-bold uppercase tracking-widest hover:bg-gold hover:text-deep">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                                        Lihat
                                    </button>
                                    
                                    <button onclick="deleteFoto('<%= groupFoto.ID_GroupFoto %>', '<%= foto.ID_Foto %>')"
                                            class="transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300 delay-100 flex items-center gap-2 px-4 py-2 bg-danger text-white text-[9px] font-bold uppercase tracking-widest hover:bg-danger/80">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                        Hapus
                                    </button>

                                </div>
                            </div>
                            
                            <div class="mt-2 flex justify-between items-center opacity-30 group-hover:opacity-100 transition-opacity">
                                <div class="h-px w-full bg-deep/10"></div>
                                <span class="text-[8px] font-mono text-deep pl-2 shrink-0">#<%= foto.ID_Foto %></span>
                            </div>

                        </div>
                    <% } %>
                </div>
            </div>
        <% } else { %>
            <div class="flex flex-col items-center justify-center py-24 px-4 bg-white border border-dashed border-deep/10 text-center shadow-sm">
                <div class="bg-linen p-6 rounded-full mb-6 border border-deep/5">
                    <svg class="h-12 w-12 text-deep/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                </div>
                <h3 class="font-crest text-xl text-deep mb-2">Album Kosong</h3>
                <p class="font-serif text-deep/60 italic mb-8 max-w-sm">
                    Belum ada foto yang disematkan dalam album ini.
                </p>
                <a href="/admin/galeri/<%= groupFoto.ID_GroupFoto %>/edit" class="btn-heritage !bg-deep !text-white !border-deep hover:!bg-gold hover:!text-deep">
                    Unggah Foto Sekarang
                </a>
            </div>
        <% } %>
    </main>

    <div id="lightbox" class="hidden fixed inset-0 z-[100] flex items-center justify-center p-4 transition-opacity duration-500" aria-modal="true">
        <div class="absolute inset-0 bg-deep/95 backdrop-blur-sm" onclick="closeLightbox()"></div>
        
        <div class="relative z-10 w-full max-w-6xl h-full flex flex-col items-center justify-center p-4">
            
            <button onclick="closeLightbox()" class="absolute top-6 right-6 text-white/50 hover:text-gold transition-colors">
                <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
            
            <div class="relative p-2 bg-white/5 border border-white/10 shadow-2xl">
                <img id="lightbox-img" src="" class="max-w-full max-h-[85vh] object-contain shadow-2xl">
            </div>
            
            <p class="mt-6 text-white/40 text-xs font-serif italic tracking-wider">
                Tekan ESC untuk menutup
            </p>
        </div>
    </div>

    <form id="delete-form" method="POST" style="display: none;"></form>

    <script>
        const lightbox = document.getElementById('lightbox');
        const lightboxImg = document.getElementById('lightbox-img');

        function openLightbox(filename) {
            lightboxImg.src = '/images/<%= folder || "galeri" %>/' + filename;
            lightbox.classList.remove('hidden');
            
            // Fade in animation
            setTimeout(() => {
                lightbox.querySelector('.absolute.inset-0').classList.add('opacity-100');
            }, 10);
            
            document.body.style.overflow = 'hidden'; 
        }

        function closeLightbox() {
            lightbox.classList.add('hidden');
            lightboxImg.src = '';
            document.body.style.overflow = '';
        }

        function deleteFoto(groupId, fotoId) {
            // Prevent event bubbling to lightbox trigger
            event.stopPropagation();
            
            if (confirm('Konfirmasi: Apakah Anda yakin ingin menghapus foto arsip ini secara permanen?')) {
                const form = document.getElementById('delete-form');
                form.action = `/admin/galeri/${groupId}/foto/${fotoId}/delete`;
                form.submit();
            }
        }

        // Keyboard navigation
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeLightbox();
            }
        });
    </script>
</body>
</html>