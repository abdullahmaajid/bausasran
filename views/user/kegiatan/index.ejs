<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daftar Kegiatan - Bausasran</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        main: '#003024',    // Background Gelap
                        surface: '#004030', // Warna Kartu
                        accent: '#83C540',  // Hijau Neon
                        pale: '#F5FEF9',    // Teks Putih
                        muted: '#A3C2B8',   // Teks Pudar
                    },
                    fontFamily: { sans: ['Inter', 'sans-serif'] }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer base { 
            body { @apply bg-main text-pale font-sans antialiased; } 
            .custom-scroll::-webkit-scrollbar { width: 8px; }
            .custom-scroll::-webkit-scrollbar-track { @apply bg-main; }
            .custom-scroll::-webkit-scrollbar-thumb { @apply bg-surface border border-white/10 rounded-full; }
        }
    </style>
</head>
<body class="flex h-screen overflow-hidden">

    <%- include('../../partials/user_sidebar.ejs') %>

    <main class="flex-1 overflow-y-auto custom-scroll p-6 md:p-10 relative">
        
        <div class="fixed top-0 right-0 w-[500px] h-[500px] bg-accent/5 rounded-full blur-[100px] pointer-events-none -z-10"></div>

        <%- include('../../partials/flash.ejs') %>

        <div class="mb-10 border-b border-white/10 pb-6">
            <h1 class="text-3xl md:text-4xl font-bold text-pale mb-2">
                Agenda & <span class="text-accent">Kegiatan</span>
            </h1>
            <p class="text-muted text-lg">Ikuti berbagai aktivitas, pelatihan, dan program Kelompok Tani.</p>
        </div>

        <div class="pb-10">
            <% if (kegiatanList && kegiatanList.length > 0) { %>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-3 gap-8">
                    <% for(let kegiatan of kegiatanList) { %>
                        <div class="group bg-surface border border-white/5 rounded-2xl overflow-hidden hover:border-accent/50 hover:shadow-[0_0_20px_rgba(131,197,64,0.1)] transition-all duration-300 flex flex-col h-full">
                            
                            <div class="h-52 relative overflow-hidden bg-black/20">
                                <% if (kegiatan.dataValues.thumbnailFile) { %>
                                    <img src="/images/kegiatan/<%= kegiatan.dataValues.thumbnailFile %>" 
                                         alt="<%= kegiatan.Judul %>"
                                         class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700">
                                    <div class="absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent opacity-60"></div>
                                <% } else { %>
                                    <div class="w-full h-full flex items-center justify-center bg-surface border-b border-white/5">
                                        <svg class="w-16 h-16 text-white/5 group-hover:text-accent/20 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                        </svg>
                                    </div>
                                <% } %>
                                
                                <div class="absolute top-3 left-3">
                                    <% if (kegiatan.Status === 'Ongoing') { %>
                                        <span class="px-3 py-1 text-[10px] font-bold uppercase tracking-wider rounded-md bg-accent text-main shadow-lg animate-pulse">
                                            ● Berlangsung
                                        </span>
                                    <% } else if (kegiatan.Status === 'Upcoming') { %>
                                        <span class="px-3 py-1 text-[10px] font-bold uppercase tracking-wider rounded-md bg-amber-500 text-white shadow-lg">
                                            📅 Akan Datang
                                        </span>
                                    <% } else { %>
                                        <span class="px-3 py-1 text-[10px] font-bold uppercase tracking-wider rounded-md bg-gray-600 text-gray-200 border border-white/10 shadow-lg">
                                            ✓ Selesai
                                        </span>
                                    <% } %>
                                </div>

                                <% if (kegiatan.dataValues.fotoCount > 0) { %>
                                    <div class="absolute top-3 right-3">
                                        <div class="flex items-center space-x-1 bg-black/60 backdrop-blur-md px-2 py-1 rounded-md border border-white/10">
                                            <span class="text-xs font-bold text-white"><%= kegiatan.dataValues.fotoCount %></span>
                                            <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                        </div>
                                    </div>
                                <% } %>
                            </div>

                            <div class="p-6 flex-1 flex flex-col relative">
                                <% if (kegiatan.Tanggal) { %>
                                    <div class="absolute -top-6 right-6 bg-surface border border-white/10 p-2 rounded-lg shadow-xl text-center min-w-[60px]">
                                        <div class="text-xs text-accent font-bold uppercase">
                                            <%= new Date(kegiatan.Tanggal).toLocaleDateString('id-ID', { month: 'short' }) %>
                                        </div>
                                        <div class="text-xl font-bold text-pale">
                                            <%= new Date(kegiatan.Tanggal).getDate() %>
                                        </div>
                                    </div>
                                <% } %>

                                <h3 class="text-xl font-bold text-pale mb-3 pr-16 group-hover:text-accent transition-colors leading-tight">
                                    <%= kegiatan.Judul %>
                                </h3>
                                
                                <div class="space-y-3 mb-6">
                                    <% if (kegiatan.Tanggal) { %>
                                        <div class="flex items-center text-sm text-muted">
                                            <svg class="w-4 h-4 mr-2 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                            <%= new Date(kegiatan.Tanggal).toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
                                        </div>
                                    <% } %>

                                    <% if (kegiatan.Lokasi) { %>
                                        <div class="flex items-start text-sm text-muted">
                                            <svg class="w-4 h-4 mr-2 mt-0.5 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                            <span class="line-clamp-1"><%= kegiatan.Lokasi %></span>
                                        </div>
                                    <% } %>
                                </div>

                                <% if (kegiatan.Deskripsi) { %>
                                    <p class="text-sm text-muted/70 mb-6 line-clamp-3 leading-relaxed flex-grow">
                                        <%= kegiatan.Deskripsi %>
                                    </p>
                                <% } %>

                                <a href="/user/kegiatan/<%= kegiatan.ID_Kegiatan %>" 
                                   class="block w-full text-center bg-white/5 hover:bg-accent border border-white/10 hover:border-transparent text-pale hover:text-main font-semibold py-3 px-4 rounded-xl transition-all duration-300 mt-auto group-hover:shadow-lg">
                                    Lihat Detail Kegiatan
                                </a>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } else { %>
                <div class="flex flex-col items-center justify-center py-20 border-2 border-dashed border-white/5 rounded-3xl bg-surface/30">
                    <div class="w-20 h-20 bg-white/5 rounded-full flex items-center justify-center mb-4">
                        <svg class="w-10 h-10 text-muted/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-pale mb-2">Belum Ada Kegiatan</h3>
                    <p class="text-muted text-sm text-center max-w-md">Saat ini belum ada agenda atau kegiatan yang terdaftar.</p>
                </div>
            <% } %>
        </div>

        <div class="mt-4 border-t border-white/5 pt-6 text-center text-xs text-muted/30">
            &copy; <%= new Date().getFullYear() %> Kampung Wisata Bausasran.
        </div>
    </main>

</body>
</html>