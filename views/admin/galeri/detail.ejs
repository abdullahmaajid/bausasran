<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detail Galeri - <%= groupFoto.Nama %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="flex bg-gray-100">

    <%- include('../../partials/admin_sidebar.ejs') %>

    <main class="flex-1 p-10">
        <%- include('../../partials/flash.ejs') %>

        <div class="flex justify-between items-center mb-6">
            <div>
                <h1 class="text-3xl font-bold text-gray-800"><%= groupFoto.Nama %></h1>
                <p class="text-gray-600 mt-1"><%= fotoList.length %> foto</p>
            </div>
            <div class="space-x-2">
                <a href="/admin/galeri/<%= groupFoto.ID_GroupFoto %>/edit" class="bg-yellow-500 hover:bg-yellow-600 text-white font-bold py-2 px-4 rounded-lg">
                    Edit Galeri
                </a>
                <a href="/admin/galeri" class="bg-gray-500 hover:bg-gray-600 text-white font-bold py-2 px-4 rounded-lg">
                    Kembali
                </a>
            </div>
        </div>
        
        <% if(fotoList && fotoList.length > 0) { %>
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                <% for(let foto of fotoList) { %>
                    <div class="relative group">
                        <img src="/images/galeri/<%= foto.Foto %>" 
                             alt="Foto #<%= foto.ID_Foto %>" 
                             class="w-full h-48 object-cover rounded-lg shadow-md cursor-pointer hover:shadow-xl transition-shadow duration-300"
                             onclick="openLightbox('<%= foto.Foto %>')">
                        
                        <!-- Overlay on hover -->
                        <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-50 transition-opacity duration-300 rounded-lg flex items-center justify-center">
                            <button 
                                type="button"
                                onclick="deleteFoto('<%= groupFoto.ID_GroupFoto %>', '<%= foto.ID_Foto %>')"
                                class="opacity-0 group-hover:opacity-100 bg-red-500 hover:bg-red-600 text-white font-semibold py-2 px-4 rounded-lg transition-opacity duration-300">
                                Hapus
                            </button>
                        </div>
                        
                        <p class="text-xs text-gray-600 mt-2 text-center">ID: <%= foto.ID_Foto %></p>
                    </div>
                <% } %>
            </div>
        <% } else { %>
            <div class="bg-white p-12 rounded-lg shadow-lg text-center">
                <svg class="mx-auto h-16 w-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                <p class="mt-4 text-gray-500 text-lg">Belum ada foto di galeri ini.</p>
                <a href="/admin/galeri/<%= groupFoto.ID_GroupFoto %>/edit" class="mt-4 inline-block bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-6 rounded-lg">
                    Tambah Foto
                </a>
            </div>
        <% } %>
    </main>

    <!-- Lightbox Modal -->
    <div id="lightbox" class="hidden fixed inset-0 bg-black bg-opacity-90 z-50 flex items-center justify-center p-4" onclick="closeLightbox()">
        <div class="relative max-w-5xl max-h-full">
            <button onclick="closeLightbox()" class="absolute top-4 right-4 text-white text-4xl font-bold hover:text-gray-300">
                &times;
            </button>
            <img id="lightbox-img" src="" class="max-w-full max-h-screen object-contain">
        </div>
    </div>

    <script>
        function openLightbox(filename) {
            document.getElementById('lightbox').classList.remove('hidden');
            document.getElementById('lightbox-img').src = '/images/galeri/' + filename;
        }

        function closeLightbox() {
            document.getElementById('lightbox').classList.add('hidden');
        }

        function deleteFoto(groupId, fotoId) {
            if (confirm('Apakah Anda yakin ingin menghapus foto ini?')) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = `/admin/galeri/${groupId}/foto/${fotoId}/delete`;
                form.style.display = 'none';
                document.body.appendChild(form);
                form.submit();
            }
        }

        // Close lightbox with ESC key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeLightbox();
            }
        });
    </script>
</body>
</html>
