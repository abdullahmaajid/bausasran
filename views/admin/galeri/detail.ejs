<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detail Galeri: <%= groupFoto.Nama %></title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        main: '#003024',    // Background Gelap
                        surface: '#004030', // Warna Kartu
                        accent: '#83C540',  // Hijau Neon
                        pale: '#F5FEF9',    // Teks Putih
                        muted: '#A3C2B8',   // Teks Pudar
                        darker: '#00251a',  // Background Input
                        danger: '#ff4d4d',  // Merah
                        warning: '#FFC107', // Kuning
                    },
                    fontFamily: { sans: ['Inter', 'sans-serif'] }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer base { body { @apply bg-main text-pale font-sans antialiased; } }
        
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #004030; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #83C540; }
    </style>
</head>

<body class="flex h-screen overflow-hidden w-full">

    <%- include('../../partials/admin_sidebar.ejs') %>

    <main class="flex-1 h-full overflow-y-auto overflow-x-hidden p-6 md:p-8 relative">
        <%- include('../../partials/flash.ejs') %>

        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8 border-b border-white/5 pb-6">
            <div class="flex-1">
                <div class="flex items-center gap-3 mb-1">
                    <span class="px-3 py-1 rounded-full text-xs font-bold bg-accent/10 text-accent border border-accent/20 uppercase tracking-wider">
                        Album Foto
                    </span>
                    <span class="text-muted text-xs font-mono">ID: #<%= groupFoto.ID_GroupFoto %></span>
                </div>
                <h1 class="text-3xl font-bold text-pale tracking-tight leading-tight flex items-center gap-3">
                    <%= groupFoto.Nama %>
                    <span class="text-base font-normal text-muted bg-surface px-3 py-1 rounded-full border border-white/10">
                        <%= fotoList ? fotoList.length : 0 %> Item
                    </span>
                </h1>
                <p class="text-muted text-sm mt-2">Kelola koleksi foto dalam album ini.</p>
            </div>
            
            <div class="flex items-center gap-3 shrink-0">
                <a href="/admin/galeri" class="bg-surface hover:bg-white/10 text-pale font-bold py-2.5 px-6 rounded-xl border border-white/10 transition-all text-sm shadow-lg flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                    Kembali
                </a>
                <a href="/admin/galeri/<%= groupFoto.ID_GroupFoto %>/edit" class="bg-warning hover:bg-warning/90 text-main font-bold py-2.5 px-6 rounded-xl shadow-lg shadow-warning/20 transition-all flex items-center gap-2 text-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                    Edit / Tambah Foto
                </a>
            </div>
        </div>

        <% if(fotoList && fotoList.length > 0) { %>
            <div class="bg-surface rounded-2xl p-6 shadow-xl border border-white/5">
                <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
                    <% for(let foto of fotoList) { %>
                        <div class="group relative aspect-square rounded-xl overflow-hidden bg-darker border border-white/10 shadow-lg">
                            <img src="/images/<%= folder || 'galeri' %>/<%= foto.Foto %>" 
                                 alt="Foto ID <%= foto.ID_Foto %>" 
                                 class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110">
                            
                            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-4">
                                
                                <div class="absolute inset-0 flex items-center justify-center gap-3 opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-4 group-hover:translate-y-0">
                                    <button onclick="openLightbox('<%= foto.Foto %>')" 
                                            class="bg-white/20 hover:bg-accent hover:text-main text-white backdrop-blur-sm p-2.5 rounded-full transition-all border border-white/20 shadow-lg"
                                            title="Lihat Foto">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                                    </button>
                                    
                                    <button onclick="deleteFoto('<%= groupFoto.ID_GroupFoto %>', '<%= foto.ID_Foto %>')"
                                            class="bg-danger/80 hover:bg-danger text-white backdrop-blur-sm p-2.5 rounded-full transition-all border border-white/20 shadow-lg"
                                            title="Hapus Foto">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                    </button>
                                </div>

                                <div class="text-[10px] text-muted font-mono bg-black/50 backdrop-blur-md px-2 py-1 rounded self-start mt-auto border border-white/10">
                                    ID: <%= foto.ID_Foto %>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
        <% } else { %>
            <div class="flex flex-col items-center justify-center py-20 px-4 bg-surface rounded-2xl border border-dashed border-white/10 text-center shadow-xl">
                <div class="bg-darker p-4 rounded-full mb-4 border border-white/5">
                    <svg class="h-12 w-12 text-muted opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                </div>
                <h3 class="text-xl font-bold text-pale mb-2">Album Masih Kosong</h3>
                <p class="text-muted text-sm mb-6 max-w-sm">Belum ada foto yang diunggah ke dalam album ini. Silakan tambahkan foto dokumentasi.</p>
                <a href="/admin/galeri/<%= groupFoto.ID_GroupFoto %>/edit" class="bg-accent hover:bg-accent/90 text-main font-bold py-2.5 px-6 rounded-xl transition-all shadow-lg flex items-center gap-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
                    Unggah Foto Sekarang
                </a>
            </div>
        <% } %>
    </main>

    <div id="lightbox" class="hidden fixed inset-0 z-[100] flex items-center justify-center p-4 transition-opacity duration-300" aria-modal="true">
        <div class="absolute inset-0 bg-black/90 backdrop-blur-sm" onclick="closeLightbox()"></div>
        
        <div class="relative z-10 w-full max-w-5xl h-full flex flex-col items-center justify-center p-4">
            <button onclick="closeLightbox()" class="absolute top-4 right-4 text-white/70 hover:text-white bg-black/50 hover:bg-white/20 rounded-full p-2 transition-all">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
            
            <img id="lightbox-img" src="" class="max-w-full max-h-[85vh] object-contain rounded-lg shadow-2xl border border-white/10">
            
            <p class="mt-4 text-muted text-sm font-mono bg-black/60 px-4 py-2 rounded-full border border-white/10">
                Klik area gelap atau tekan ESC untuk keluar
            </p>
        </div>
    </div>

    <form id="delete-form" method="POST" style="display: none;"></form>

    <script>
        const lightbox = document.getElementById('lightbox');
        const lightboxImg = document.getElementById('lightbox-img');

        function openLightbox(filename) {
            lightboxImg.src = '/images/<%= folder || "galeri" %>/' + filename;
            lightbox.classList.remove('hidden');
            // Sedikit animasi fade in
            setTimeout(() => {
                lightbox.querySelector('.absolute.inset-0').classList.add('opacity-100');
            }, 10);
            document.body.style.overflow = 'hidden'; // Prevent scrolling background
        }

        function closeLightbox() {
            lightbox.classList.add('hidden');
            lightboxImg.src = '';
            document.body.style.overflow = '';
        }

        function deleteFoto(groupId, fotoId) {
            // Stop propagation handled by direct button click usually, but good to be safe
            event.stopPropagation();
            
            if (confirm('Apakah Anda yakin ingin menghapus foto ini secara permanen?')) {
                const form = document.getElementById('delete-form');
                form.action = `/admin/galeri/${groupId}/foto/${fotoId}/delete`;
                form.submit();
            }
        }

        // Keyboard navigation
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeLightbox();
            }
        });
    </script>
</body>
</html>