<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Daftar Akun - Bausasran</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        main: '#003024',    // Background Gelap
                        surface: '#004030', // Warna Kartu
                        accent: '#83C540',  // Hijau Neon
                        pale: '#F5FEF9',    // Teks Putih
                        muted: '#A3C2B8',   // Teks Pudar
                    },
                    fontFamily: { sans: ['Inter', 'sans-serif'] }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer base { body { @apply bg-main text-pale font-sans antialiased; } }
    </style>
</head>

<body class="flex flex-col min-h-screen">

  

    <main class="container mx-auto p-4 md:p-12 flex-grow flex items-center justify-center">
        
        <div class="w-full max-w-2xl">
            <div class="mb-6">
                <%- include('../partials/flash.ejs') %>
            </div>

            <div class="bg-surface p-8 md:p-10 rounded-2xl border border-white/5 shadow-2xl relative overflow-hidden">
                
                <div class="absolute -top-10 -right-10 w-32 h-32 bg-accent/5 rounded-full blur-3xl pointer-events-none"></div>

                <div class="text-center mb-8">
                    <h1 class="text-3xl font-bold text-pale mb-2">Daftar Akun Baru</h1>
                    <p class="text-muted">Bergabunglah dengan komunitas Kampung Wisata Bausasran</p>
                </div>
                
                <form action="/register" method="POST" id="registerForm">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                        <div>
                            <label for="Nama" class="block text-muted text-xs font-bold uppercase tracking-wider mb-2">
                                Nama Lengkap <span class="text-accent">*</span>
                            </label>
                            <input 
                                type="text" 
                                id="Nama" 
                                name="Nama" 
                                class="w-full bg-main border border-white/10 rounded-xl px-4 py-3 text-pale focus:border-accent focus:ring-1 focus:ring-accent outline-none transition-all placeholder-white/20" 
                                required
                                placeholder="Cth: Budi Santoso">
                        </div>
                        
                        <div>
                            <label for="Username" class="block text-muted text-xs font-bold uppercase tracking-wider mb-2">
                                Username <span class="text-accent">*</span>
                            </label>
                            <input 
                                type="text" 
                                id="Username" 
                                name="Username" 
                                class="w-full bg-main border border-white/10 rounded-xl px-4 py-3 text-pale focus:border-accent focus:ring-1 focus:ring-accent outline-none transition-all placeholder-white/20" 
                                required
                                placeholder="Cth: budi_san"
                                pattern="[a-zA-Z0-9_]+"
                                title="Hanya huruf, angka, dan underscore">
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                        <div>
                            <label for="Password" class="block text-muted text-xs font-bold uppercase tracking-wider mb-2">
                                Password <span class="text-accent">*</span>
                            </label>
                            <div class="relative">
                                <input 
                                    type="password" 
                                    id="Password" 
                                    name="Password" 
                                    class="w-full bg-main border border-white/10 rounded-xl px-4 py-3 text-pale focus:border-accent focus:ring-1 focus:ring-accent outline-none transition-all placeholder-white/20 pr-10" 
                                    required
                                    minlength="6"
                                    placeholder="••••••••">
                                <button 
                                    type="button" 
                                    onclick="togglePassword('Password')"
                                    class="absolute right-3 top-3 text-muted hover:text-pale transition-colors">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                                </button>
                            </div>
                        </div>
                        
                        <div>
                            <label for="ConfirmPassword" class="block text-muted text-xs font-bold uppercase tracking-wider mb-2">
                                Konfirmasi Password <span class="text-accent">*</span>
                            </label>
                            <div class="relative">
                                <input 
                                    type="password" 
                                    id="ConfirmPassword" 
                                    name="ConfirmPassword" 
                                    class="w-full bg-main border border-white/10 rounded-xl px-4 py-3 text-pale focus:border-accent focus:ring-1 focus:ring-accent outline-none transition-all placeholder-white/20 pr-10" 
                                    required
                                    minlength="6"
                                    placeholder="••••••••">
                                <button 
                                    type="button" 
                                    onclick="togglePassword('ConfirmPassword')"
                                    class="absolute right-3 top-3 text-muted hover:text-pale transition-colors">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                                </button>
                            </div>
                            <p class="text-xs text-red-400 mt-2 hidden" id="passwordError">
                                <span class="inline-block mr-1">⚠</span> Password tidak cocok!
                            </p>
                        </div>
                    </div>

                    <div class="mb-8 bg-main/50 p-4 rounded-xl border border-white/5">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs text-muted">Kekuatan Password</span>
                            <span id="strengthText" class="text-xs font-bold text-muted">Belum diisi</span>
                        </div>
                        <div class="w-full bg-black/30 rounded-full h-1.5 overflow-hidden">
                            <div id="passwordStrength" class="h-full transition-all duration-500 ease-out bg-red-500 w-0"></div>
                        </div>
                        <div class="mt-2 text-[10px] text-muted opacity-60">
                            Gunakan kombinasi huruf besar, kecil, angka, dan simbol.
                        </div>
                    </div>

                    <button 
                        type="submit" 
                        class="w-full bg-accent hover:bg-white text-main hover:text-main font-bold py-3.5 px-4 rounded-xl shadow-lg shadow-green-900/20 hover:shadow-green-500/20 transition-all duration-300 transform hover:-translate-y-0.5">
                        Buat Akun Sekarang
                    </button>
                </form>
                
                <div class="mt-8 text-center pt-6 border-t border-white/10">
                    <p class="text-muted text-sm">
                        Sudah punya akun? 
                        <a href="/login" class="text-accent hover:text-white font-bold ml-1 transition-colors relative group">
                            Login di sini
                            <span class="absolute left-0 bottom-0 w-0 h-0.5 bg-white transition-all group-hover:w-full"></span>
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </main>

    <script>
        // Toggle password visibility
        function togglePassword(fieldId) {
            const field = document.getElementById(fieldId);
            field.type = field.type === 'password' ? 'text' : 'password';
        }

        // Password strength checker
        const passwordInput = document.getElementById('Password');
        const strengthBar = document.getElementById('passwordStrength');
        const strengthText = document.getElementById('strengthText');

        passwordInput.addEventListener('input', function() {
            const password = this.value;
            let strength = 0;
            
            if (password.length > 0) strength += 10;
            if (password.length >= 6) strength += 20;
            if (password.length >= 10) strength += 20;
            if (/[a-z]/.test(password) && /[A-Z]/.test(password)) strength += 20;
            if (/[0-9]/.test(password)) strength += 15;
            if (/[^a-zA-Z0-9]/.test(password)) strength += 15;
            
            // Cap at 100
            if(strength > 100) strength = 100;

            strengthBar.style.width = strength + '%';
            
            if (strength === 0) {
                strengthBar.className = 'h-full transition-all duration-500 bg-red-500';
                strengthText.textContent = 'Belum diisi';
                strengthText.className = 'text-xs font-bold text-muted';
            } else if (strength < 40) {
                strengthBar.className = 'h-full transition-all duration-500 bg-red-500 shadow-[0_0_10px_rgba(239,68,68,0.5)]';
                strengthText.textContent = 'Lemah';
                strengthText.className = 'text-xs font-bold text-red-400';
            } else if (strength < 70) {
                strengthBar.className = 'h-full transition-all duration-500 bg-yellow-400 shadow-[0_0_10px_rgba(250,204,21,0.5)]';
                strengthText.textContent = 'Sedang';
                strengthText.className = 'text-xs font-bold text-yellow-400';
            } else {
                strengthBar.className = 'h-full transition-all duration-500 bg-accent shadow-[0_0_10px_rgba(131,197,64,0.5)]';
                strengthText.textContent = 'Kuat';
                strengthText.className = 'text-xs font-bold text-accent';
            }
        });

        // Validate password match
        const confirmPassword = document.getElementById('ConfirmPassword');
        const passwordError = document.getElementById('passwordError');
        const form = document.getElementById('registerForm');

        function checkMatch() {
            if (confirmPassword.value && confirmPassword.value !== passwordInput.value) {
                passwordError.classList.remove('hidden');
                confirmPassword.classList.add('border-red-500', 'focus:border-red-500', 'focus:ring-red-500');
                confirmPassword.classList.remove('border-white/10', 'focus:border-accent', 'focus:ring-accent');
            } else {
                passwordError.classList.add('hidden');
                confirmPassword.classList.remove('border-red-500', 'focus:border-red-500', 'focus:ring-red-500');
                confirmPassword.classList.add('border-white/10', 'focus:border-accent', 'focus:ring-accent');
            }
        }

        confirmPassword.addEventListener('input', checkMatch);
        passwordInput.addEventListener('input', checkMatch); // Cek juga saat password utama berubah

        form.addEventListener('submit', function(e) {
            if (passwordInput.value !== confirmPassword.value) {
                e.preventDefault();
                alert('Password dan Konfirmasi Password tidak cocok!');
                confirmPassword.focus();
            }
        });
    </script>
</body>
</html>