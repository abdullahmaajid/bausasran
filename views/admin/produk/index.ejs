<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Analisis Lahan - Executive Console</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        paper: '#F9F7F2',       /* Cream Background */
                        deep: '#0F1F18',        /* Dark Emerald Green */
                        gold: '#C5B388',        /* Antique Gold */
                        charcoal: '#4A4A4A',    /* Soft Black */
                        linen: '#EBE9E4',       /* Light Gray/Beige */
                        white: '#FFFFFF',
                        danger: '#8B3A3A',      /* Elegant Red */
                    },
                    fontFamily: {
                        sans: ['Lato', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                        crest: ['Cinzel', 'serif'], 
                    },
                    boxShadow: {
                        'elegant': '0 20px 50px -12px rgba(15, 31, 24, 0.08)',
                        'gold-glow': '0 0 15px rgba(197, 179, 136, 0.2)',
                    }
                }
            }
        }
    </script>

    <style type="text/tailwindcss">
        @layer base {
            body { @apply bg-paper text-deep font-sans antialiased; }
        }
        
        /* TEXTURE: Film Grain Overlay */
        .noise-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.03'/%3E%3C/svg%3E");
            pointer-events: none; z-index: 50; mix-blend-mode: multiply;
        }

        /* Map Styles */
        #map { height: 100%; width: 100%; z-index: 1; }
        
        /* Range Slider Styling - Heritage Style */
        input[type=range] { @apply h-1 bg-deep/10 rounded-lg appearance-none cursor-pointer; }
        input[type=range]::-webkit-slider-thumb { @apply appearance-none w-4 h-4 bg-deep border-2 border-gold rounded-full shadow hover:scale-125 transition-transform; }

        /* Scrollbar */
        .custom-scroll::-webkit-scrollbar { width: 6px; }
        .custom-scroll::-webkit-scrollbar-track { background: transparent; }
        .custom-scroll::-webkit-scrollbar-thumb { background: #C5B388; border-radius: 3px; }
        .custom-scroll::-webkit-scrollbar-thumb:hover { background: #0F1F18; }

        /* Inputs */
        .input-luxury {
            @apply w-full bg-white border border-deep/10 px-4 py-2 text-sm text-deep placeholder-charcoal/30 focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold/50 transition-all duration-300 font-sans shadow-sm rounded-none;
        }
        
        /* Buttons */
        .btn-luxury {
            @apply px-4 py-2 bg-deep text-gold text-[10px] font-bold uppercase tracking-[0.2em] border border-deep hover:bg-gold hover:text-deep hover:border-gold transition-all duration-500 shadow-lg hover:shadow-gold-glow;
        }
    </style>
</head>

<body class="flex h-screen overflow-hidden relative">

    <div class="noise-overlay"></div>

    <%- include('../../partials/admin_sidebar.ejs') %>

    <main class="flex-1 flex flex-col h-screen overflow-hidden relative z-10">
        <%- include('../../partials/flash.ejs') %>

        <div class="flex-1 overflow-y-auto custom-scroll p-6 md:p-12">
            
            <form id="bulkForm" action="/admin/produk/bulk-action" method="POST">
                
                <div class="flex flex-col md:flex-row justify-between items-end md:items-end mb-10 border-b border-deep/10 pb-6 gap-6">
                    <div>
                        <span class="font-sans text-[10px] uppercase tracking-widest text-gold mb-2 block">Sistem Cerdas</span>
                        <h1 class="font-crest text-3xl md:text-4xl text-deep leading-tight">Analisis Lahan & Produk</h1>
                        <p class="font-serif italic text-charcoal/60 text-sm mt-2">Pilih lokasi pada peta untuk sinkronisasi data satelit.</p>
                    </div>
                    <div class="flex items-center gap-3">
                        <button type="button" id="btn-delete-bulk" class="hidden items-center gap-2 px-6 py-3 bg-danger text-white border border-danger hover:bg-white hover:text-danger text-[10px] font-bold uppercase tracking-widest transition-all shadow-lg">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                            <span>Hapus Terpilih</span>
                        </button>
                        
                        <a href="/admin/produk/new" class="hidden md:inline-flex btn-luxury group items-center gap-2">
                            <span>Tambah Produk</span>
                            <svg class="w-3 h-3 group-hover:rotate-90 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                        </a>
                    </div>
                </div>

                <input type="hidden" name="action" value="delete">

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-10 h-[500px] lg:h-[480px]">
                    
                    <div class="lg:col-span-2 relative bg-white p-1 shadow-elegant border border-deep/5 group">
                        <div id="map" class="h-full w-full -[20%] hover:-0 transition-all duration-700"></div>
                        
                        <div id="map-loading" class="absolute inset-0 bg-paper/90 backdrop-blur-sm z-[400] flex flex-col items-center justify-center hidden">
                            <div class="w-12 h-12 border-2 border-deep/10 border-t-gold rounded-full animate-spin mb-4"></div>
                            <span class="font-crest text-deep text-sm tracking-widest animate-pulse">Sinkronisasi Satelit...</span>
                        </div>

                        <div class="absolute top-4 left-4 bg-white/95 backdrop-blur px-4 py-2 border border-deep/10 shadow-lg z-[400]">
                            <span class="w-2 h-2 bg-danger rounded-full inline-block mr-2 animate-pulse"></span>
                            <span class="text-[10px] uppercase tracking-widest font-bold text-deep">Mode Interaktif</span>
                        </div>
                    </div>

                    <div class="flex flex-col gap-6 h-full">
                        <div class="bg-white p-6 border border-deep/5 shadow-elegant flex-shrink-0 relative overflow-hidden">
                            <div class="absolute top-0 right-0 w-20 h-20 bg-gold/10 rounded-bl-full -mr-10 -mt-10"></div>
                            <h3 class="font-crest text-xs font-bold text-gold uppercase tracking-widest mb-2">Status Area</h3>
                            <p class="font-serif italic text-deep/60 text-sm" id="location-status">Menunggu pemilihan titik koordinat...</p>
                        </div>

                        <div id="live-weather-placeholder" class="flex-1 bg-white border border-dashed border-deep/10 p-6 flex flex-col items-center justify-center text-center space-y-4">
                            <div class="w-16 h-16 rounded-full bg-linen/50 flex items-center justify-center">
                                <svg class="w-8 h-8 text-deep/30" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                            </div>
                            <p class="font-sans text-xs text-charcoal/50 uppercase tracking-wide">Pilih lokasi pada peta untuk memuat data.</p>
                        </div>

                        <div id="live-weather-cards" class="flex-1 grid grid-cols-2 gap-4 hidden">
                            <div class="bg-white p-4 border border-deep/5 shadow-sm flex flex-col justify-center items-center relative group hover:border-gold/30 transition-colors">
                                <span class="text-[9px] text-charcoal/50 uppercase tracking-widest mb-1">Temperatur</span>
                                <span id="live-temp" class="font-serif text-2xl font-bold text-deep">-</span>
                            </div>
                            <div class="bg-white p-4 border border-deep/5 shadow-sm flex flex-col justify-center items-center relative group hover:border-gold/30 transition-colors">
                                <span class="text-[9px] text-charcoal/50 uppercase tracking-widest mb-1">Kelembapan</span>
                                <span id="live-humidity" class="font-serif text-2xl font-bold text-deep">-</span>
                            </div>
                            <div class="bg-white p-4 border border-deep/5 shadow-sm flex flex-col justify-center items-center relative group hover:border-gold/30 transition-colors">
                                <span class="text-[9px] text-charcoal/50 uppercase tracking-widest mb-1">Curah Hujan</span>
                                <span id="live-precip" class="font-serif text-2xl font-bold text-deep">-</span>
                            </div>
                            <div class="bg-deep p-4 border border-deep flex flex-col justify-center items-center shadow-gold-glow">
                                <span class="text-[9px] text-gold uppercase tracking-widest mb-1">Produk Cocok</span>
                                <span id="live-cocok" class="font-serif text-3xl font-bold text-white">-</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="sticky top-0 z-30 bg-paper/95 backdrop-blur-md py-4 border-b border-deep/10 mb-8">
                    <div class="flex flex-col md:flex-row gap-4 items-center justify-between">
                        
                        <div class="relative w-full md:w-80 group">
                            <input type="text" id="filter-search" placeholder="    Cari Produk..." 
                                class="input-luxury pl-10 bg-transparent border-b border-deep/20 border-t-0 border-x-0 focus:ring-0 px-0">
                            <svg class="w-4 h-4 text-deep/40 absolute left-2 top-3 group-focus-within:text-gold transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                        </div>

                        <div class="flex flex-wrap items-center gap-4 w-full md:w-auto">
                            
                            <div class="flex items-center gap-4 px-4 py-2 bg-white border border-deep/5 shadow-sm">
                                <label class="text-[9px] text-charcoal/60 uppercase font-bold tracking-widest whitespace-nowrap">Threshold:</label>
                                <input type="range" id="filter-grade" min="0" max="100" value="0" step="5" class="w-24">
                                <span id="filter-grade-value" class="text-xs font-bold text-deep w-8 text-right font-serif">0%</span>
                            </div>

                            <select id="filter-category" class="bg-transparent border-b border-deep/20 py-2 text-xs text-deep font-bold uppercase tracking-wide focus:outline-none focus:border-gold cursor-pointer">
                                <option value="Semua">Semua Kategori</option>
                                <% categories.forEach(cat => { %>
                                    <option value="<%= cat %>"><%= cat %></option>
                                <% }) %>
                            </select>

                            <select id="filter-sort" class="bg-transparent border-b border-deep/20 py-2 text-xs text-deep font-bold uppercase tracking-wide focus:outline-none focus:border-gold cursor-pointer">
                                <option value="cocok">Kecocokan Tertinggi</option>
                                <option value="nama">Nama (A-Z)</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div id="results-list" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4 gap-6 pb-12">
                    <div id="initial-message" class="col-span-full py-24 flex flex-col items-center justify-center text-deep/20">
                        <svg class="w-16 h-16 mb-4 stroke-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        <h3 class="font-crest text-xl text-deep/40">Menunggu Input Geografis</h3>
                        <p class="font-serif italic text-sm mt-2">Pilih lokasi pada peta untuk memulai analisis.</p>
                    </div>
                </div>
            </form>

        </div>
    </main>

    <script>
        const allProductsData = JSON.parse(decodeURIComponent('<%- encodeURIComponent(JSON.stringify(productsWithParams)) %>'));
    </script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="/js/koncoTaniAdmin.js"></script>

    <script>
        // DOM Cache
        const els = {
            loading: document.getElementById('map-loading'),
            resultsList: document.getElementById('results-list'),
            locStatus: document.getElementById('location-status'),
            liveCards: document.getElementById('live-weather-cards'),
            livePlaceholder: document.getElementById('live-weather-placeholder'),
            liveTemp: document.getElementById('live-temp'),
            liveHumidity: document.getElementById('live-humidity'),
            livePrecip: document.getElementById('live-precip'),
            liveCocok: document.getElementById('live-cocok'),
            search: document.getElementById('filter-search'),
            grade: document.getElementById('filter-grade'),
            gradeVal: document.getElementById('filter-grade-value'),
            category: document.getElementById('filter-category'),
            sort: document.getElementById('filter-sort')
        };

        // UI Builder: Create Product Card (STYLE: HERITAGE)
        function createCardHTML_UI(product) {
            const passingGrade = parseInt(els.grade.value, 10);
            let isCocok = false;
            let scoreColor = 'bg-danger';
            
            if (product.paramCount > 0 && currentApiData) {
                isCocok = product.scorePercent >= passingGrade;
                // Colors: Gold for High, Charcoal/Deep for Mid, Red for Low
                scoreColor = product.scorePercent >= 80 ? 'bg-deep' : (product.scorePercent >= 50 ? 'bg-gold' : 'bg-danger');
            }

            // Status Badge (Heritage Style)
            const statusBadge = isCocok 
                ? `<span class="absolute top-4 right-4 bg-deep text-gold px-3 py-1 text-[9px] font-bold uppercase tracking-widest shadow-lg z-10 border border-gold/50">Cocok</span>` 
                : (currentApiData ? `<span class="absolute top-4 right-4 bg-white/90 text-charcoal px-3 py-1 text-[9px] font-bold uppercase tracking-widest backdrop-blur border border-deep/10 z-10">Tidak Cocok</span>` : '');

            // Image
            const imgUrl = (product.photos && product.photos.length > 0) 
                ? `/images/produk/${product.photos[0].Foto}` 
                : null;
            
            const imgHTML = imgUrl 
                ? `<img src="${imgUrl}" class="w-full h-full object-cover  group-hover:-0 transition-all duration-700">`
                : `<div class="w-full h-full bg-linen flex items-center justify-center text-deep/20 font-serif italic text-xs">Foto Tidak Tersedia</div>`;

            // Parameters List
            let paramsHTML = '';
            if (product.paramDetails && currentApiData) {
                paramsHTML = product.paramDetails.filter(p => parameterApiMapping && parameterApiMapping[p.Nama]).map(p => {
                    const icon = p.isCocok ? `<span class="text-deep font-bold">✓</span>` : `<span class="text-danger font-bold">✕</span>`;
                    return `
                        <div class="flex justify-between items-center py-2 border-b border-deep/5 last:border-0 text-xs">
                            <span class="text-charcoal/70 font-sans">${p.Nama}</span>
                            <div class="flex items-center gap-2">
                                <span class="text-deep font-bold font-mono">${p.actualValue}</span>
                                ${icon}
                            </div>
                        </div>
                    `;
                }).join('');
            }

            // Price
            const price = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(product.Harga || 0);

            return `
                <div class="bg-white rounded-none border border-deep/5 shadow-elegant hover:shadow-gold-glow transition-all duration-500 group flex flex-col overflow-hidden h-full relative">
                    
                    <div class="absolute inset-0 border border-deep/0 group-hover:border-gold/30 pointer-events-none transition-all duration-500 z-20"></div>

                    <div class="relative h-48 overflow-hidden border-b border-deep/5">
                        <div class="absolute top-3 left-3 z-20">
                            <input type="checkbox" name="itemIds" value="${product.ID_Product}" class="w-5 h-5 border border-deep/20 bg-white text-deep focus:ring-gold item-checkbox cursor-pointer rounded-none">
                        </div>
                        ${statusBadge}
                        ${imgHTML}
                    </div>

                    <div class="p-6 flex flex-col flex-grow">
                        <div class="mb-4">
                            <h3 class="font-serif font-bold text-deep text-xl leading-tight group-hover:text-gold transition-colors duration-300 line-clamp-1" title="${product.Nama}">${product.Nama}</h3>
                            <span class="text-[9px] text-charcoal/40 uppercase tracking-[0.2em] mt-1 block">${product.Kategori || 'Katalog Umum'}</span>
                        </div>

                        <div class="mb-6">
                            <div class="flex justify-between text-[10px] mb-2 uppercase tracking-wide">
                                <span class="text-charcoal/50">Tingkat Kecocokan</span>
                                <span class="font-bold text-deep">${product.scorePercent ? product.scorePercent.toFixed(0) : 0}%</span>
                            </div>
                            <div class="w-full bg-linen h-1 overflow-hidden">
                                <div class="h-full ${scoreColor} transition-all duration-1000" style="width: ${product.scorePercent || 0}%"></div>
                            </div>
                        </div>

                        <div class="flex-grow"></div>

                        <details class="group/details mt-2">
                            <summary class="list-none cursor-pointer flex items-center justify-between text-[10px] uppercase tracking-widest font-bold text-deep/60 hover:text-deep bg-paper border border-deep/5 px-3 py-2 transition-colors">
                                <span>Analisis Parameter</span>
                                <svg class="w-3 h-3 transition-transform group-open/details:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7"></path></svg>
                            </summary>
                            <div class="mt-0 bg-white border-x border-b border-deep/5 p-3 max-h-32 overflow-y-auto custom-scroll">
                                ${paramsHTML || '<div class="text-[10px] text-center italic text-charcoal/30 font-serif">Menunggu data satelit...</div>'}
                            </div>
                        </details>
                    </div>
                    
                    <div class="px-6 py-4 bg-paper border-t border-deep/5 flex justify-between items-center">
                        <span class="text-sm font-bold text-deep font-sans">${price}</span>
                        <div class="flex items-center gap-3">
                            <a href="/admin/produk/${product.ID_Product}/edit" class="text-[9px] uppercase tracking-widest text-deep/50 hover:text-gold transition-colors">Edit</a>
                            <a href="/admin/produk/${product.ID_Product}" class="text-[9px] uppercase tracking-widest text-gold hover:text-deep transition-colors">Lihat Detail →</a>
                        </div>
                    </div>
                </div>
            `;
        }

        // --- Controller Interface ---
        const uiFunctions = {
            showLoadingState: () => {
                els.loading.classList.remove('hidden'); els.loading.classList.add('flex');
                els.liveCards.classList.add('hidden'); els.livePlaceholder.classList.remove('hidden');
                els.locStatus.textContent = "Mengambil data satelit...";
            },
            hideLoadingState: () => {
                els.loading.classList.add('hidden'); els.loading.classList.remove('flex');
            },
            updateLiveCards: (current, units) => {
                els.livePlaceholder.classList.add('hidden');
                els.liveCards.classList.remove('hidden'); els.liveCards.classList.add('grid');
                els.liveTemp.textContent = `${current.temperature_2m ?? '-'}${units?.temperature_2m || '°C'}`;
                els.liveHumidity.textContent = `${current.relative_humidity_2m ?? '-'}${units?.relative_humidity_2m || '%'}`;
                els.livePrecip.textContent = `${current.precipitation ?? '-'}${units?.precipitation || 'mm'}`;
                els.locStatus.textContent = "Data cuaca berhasil disinkronisasi";
            },
            displayResults: (calculatedProducts, passingGrade, totalProducts) => {
                const visible = calculatedProducts.filter(p => p.isVisible);
                const cocokCount = visible.filter(p => p.paramCount > 0 && p.scorePercent >= passingGrade).length;
                els.liveCocok.textContent = cocokCount;
                
                els.resultsList.innerHTML = '';
                if(visible.length === 0) {
                    els.resultsList.innerHTML = `<div class="col-span-full py-12 text-center text-charcoal/50 border border-dashed border-deep/10 bg-paper/50 font-serif italic">Tidak ada produk ditemukan yang memenuhi kriteria.</div>`;
                } else {
                    visible.forEach(p => els.resultsList.innerHTML += createCardHTML_UI(p));
                }
            },
            displayInitialState: (msg) => {
                els.resultsList.innerHTML = '';
                const div = document.createElement('div');
                div.className = 'col-span-full py-24 flex flex-col items-center justify-center text-deep/20';
                div.innerHTML = `<svg class="w-16 h-16 mb-4 stroke-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg><h3 class="font-crest text-xl text-deep/40">Menunggu Input Geografis</h3><p class="font-serif italic text-sm mt-2">${msg || 'Klik peta untuk memulai.'}</p>`;
                els.resultsList.appendChild(div);
            },
            displayError: (msg) => {
                els.resultsList.innerHTML = `<div class="col-span-full text-danger text-center py-4 bg-paper border border-danger/20 font-serif italic">${msg}</div>`;
            },
            updateFilterGradeValue: (val) => { els.gradeVal.textContent = `${val}%`; },
            getFilterValues: () => ({
                search: els.search.value.toLowerCase(),
                category: els.category.value,
                sort: els.sort.value,
                grade: parseInt(els.grade.value, 10)
            }),
            addMapMarker: () => {}
        };

        document.addEventListener('DOMContentLoaded', () => {
                if (typeof initKoncoTani === 'function') initKoncoTani(uiFunctions);

                // Bulk Delete Logic
                const btnDeleteBulk = document.getElementById('btn-delete-bulk');
                const resultsList = document.getElementById('results-list');
                const bulkForm = document.getElementById('bulkForm');

                resultsList.addEventListener('change', (e) => {
                    if (e.target.classList.contains('item-checkbox')) {
                        const checkedCount = document.querySelectorAll('.item-checkbox:checked').length;
                        if (checkedCount > 0) {
                            btnDeleteBulk.classList.remove('hidden');
                            btnDeleteBulk.classList.add('flex');
                            btnDeleteBulk.querySelector('span').textContent = `Hapus (${checkedCount})`;
                        } else {
                            btnDeleteBulk.classList.add('hidden');
                            btnDeleteBulk.classList.remove('flex');
                        }
                    }
                });

                btnDeleteBulk.addEventListener('click', () => {
                   if (confirm('Yakin ingin menghapus item yang dipilih? Tindakan ini tidak dapat dibatalkan.')) {
                       bulkForm.submit();
                   }
                });
            });
    </script>
</body>
</html>