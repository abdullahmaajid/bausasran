<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detail Produk: <%= product.Nama %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <style>
        .photo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 0.75rem; }
        .photo-item img { height: 100px; width: 100%; object-fit: cover; border-radius: 0.375rem; border: 1px solid #e5e7eb; }
        .parameter-table th, .parameter-table td { padding: 0.5rem 0.75rem; text-align: left; font-size: 0.875rem; border-bottom: 1px solid #f3f4f6; }
        .parameter-table th { background-color: #f9fafb; color: #6b7280; font-weight: 500; }
    </style>
</head>
<body class="flex bg-gray-100">

    <%- include('../../partials/admin_sidebar.ejs') %>

    <main class="flex-1 p-10">
        <%- include('../../partials/flash.ejs') %>

        <div class="flex justify-between items-center mb-6">
            <h1 class="text-3xl font-bold text-gray-800">Detail Produk</h1>
            <div>
                 <a href="/admin/produk/<%= product.ID_Product %>/edit" class="bg-yellow-500 hover:bg-yellow-600 text-white font-semibold py-2 px-4 rounded-md text-sm shadow-sm mr-2">Edit Produk</a>
                 <a href="/admin/produk" class="bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-2 px-4 rounded-md text-sm">Kembali ke Daftar</a>
            </div>
        </div>

        <div class="bg-white p-8 rounded-lg shadow-lg max-w-4xl mx-auto">

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="md:col-span-1">
                     <h2 class="text-xl font-semibold mb-3 text-gray-700">Foto Produk</h2>
                     <% if (photos && photos.length > 0) { %>
                        <div class="photo-grid">
                            <% photos.forEach(photo => { %>
                                <div class="photo-item">
                                    <a href="/images/produk/<%= photo.Foto %>" target="_blank">
                                        <img src="/images/produk/<%= photo.Foto %>" alt="Foto <%= product.Nama %>">
                                    </a>
                                </div>
                            <% }) %>
                        </div>
                     <% } else { %>
                        <p class="text-sm text-gray-500 italic">Tidak ada foto produk.</p>
                     <% } %>
                </div>

                <div class="md:col-span-2 space-y-4">
                     <h2 class="text-2xl font-bold text-gray-900"><%= product.Nama %></h2>

                     <div class="text-sm">
                        <span class="font-medium text-gray-500">Kategori:</span>
                        <span class="ml-2 bg-gray-100 text-gray-700 px-2 py-0.5 rounded"><%= product.Kategori || 'Tidak ada' %></span>
                     </div>

                     <div>
                        <% const formattedPrice = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(product.Harga || 0); %>
                        <% const discountPercent = product.Diskon ? (product.Diskon * 100).toFixed(1) + '%' : null; %>
                        <% const finalPrice = product.Harga * (1 - (product.Diskon || 0)); %>
                        <% const formattedFinalPrice = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(finalPrice); %>

                        <span class="text-2xl font-bold text-blue-700"><%= formattedFinalPrice %></span>
                         <% if (discountPercent) { %>
                             <span class="ml-3 text-sm bg-red-100 text-red-700 font-medium px-2 py-0.5 rounded"><%= discountPercent %> OFF</span>
                             <span class="ml-2 text-sm text-gray-400 line-through"><%= formattedPrice %></span>
                         <% } else { %>
                              <span class="ml-3 text-gray-500">(Harga Normal: <%= formattedPrice %>)</span>
                         <% } %>
                     </div>

                     <div>
                        <h3 class="text-base font-semibold text-gray-700 mb-1">Deskripsi</h3>
                        <p class="text-sm text-gray-600"><%= product.Deskripsi || 'Tidak ada deskripsi.' %></p>
                     </div>

                     <div>
                         <h3 class="text-base font-semibold text-gray-700 mb-2">Parameter Optimal</h3>
                         <% if (parameters && parameters.length > 0) { %>
                            <div class="overflow-x-auto border rounded">
                                <table class="min-w-full parameter-table">
                                    <thead>
                                        <tr><th>Nama Parameter</th><th>Minimal</th><th>Maksimal</th></tr>
                                    </thead>
                                    <tbody>
                                        <% parameters.forEach(param => { %>
                                            <tr><td><%= param.Nama %></td><td><%= param.Minimal %></td><td><%= param.Maksimal %></td></tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                         <% } else { %>
                             <p class="text-sm text-gray-500 italic">Produk ini tidak memiliki parameter optimal.</p>
                         <% } %>
                     </div>

                </div>
            </div>

            <!-- Simulasi Kecocokan Lahan -->
            <div class="mt-8 pt-8 border-t border-gray-200">
                <h2 class="text-xl font-bold text-gray-800 mb-4">Simulasi Kecocokan Lahan</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Map Container -->
                    <div class="border rounded-lg overflow-hidden shadow-sm relative">
                        <div id="map" class="h-80 w-full z-0" style="min-height: 320px;"></div>
                        <div class="absolute bottom-2 left-2 bg-white px-2 py-1 rounded shadow text-xs text-gray-600 z-10 opacity-90">
                            Klik peta untuk simulasi
                        </div>
                    </div>

                    <!-- Simulation Info -->
                    <div>
                         <div id="simulation-placeholder" class="h-full flex flex-col items-center justify-center text-gray-400 border-2 border-dashed rounded-lg bg-gray-50 p-6">
                             <svg class="w-12 h-12 mb-2 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                             <p class="text-sm">Klik lokasi di peta untuk melihat kecocokan.</p>
                         </div>

                         <div id="simulation-loading" class="hidden h-full flex flex-col items-center justify-center text-gray-500 p-6">
                             <svg class="animate-spin h-8 w-8 text-blue-500 mb-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                               <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                               <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                             </svg>
                             <p class="text-sm">Menganalisis data satelit & tanah...</p>
                         </div>

                         <div id="simulation-status" class="hidden h-full flex flex-col">
                             <div class="flex items-center justify-between mb-4">
                                 <div>
                                     <span class="text-xs text-gray-500 block uppercase tracking-wider font-bold">Skor Kecocokan</span>
                                     <div class="flex items-baseline space-x-2">
                                         <span id="sim-score-badge" class="text-3xl font-extrabold text-gray-800">--%</span>
                                         <span id="sim-status-text" class="px-2 py-0.5 rounded text-xs font-bold bg-gray-200 text-gray-600">--</span>
                                     </div>
                                 </div>
                                 <div class="text-right">
                                     <span class="text-xs text-gray-500 block uppercase tracking-wider font-bold">Kondisi Lahan (Live)</span>
                                     <div class="text-xs text-gray-700 font-mono">
                                         <div>Temp: <span id="sim-temp" class="font-bold">-</span></div>
                                         <div>Hujan: <span id="sim-rain" class="font-bold">-</span></div>
                                     </div>
                                 </div>
                             </div>

                             <div class="flex-grow overflow-hidden flex flex-col">
                                 <h4 class="font-semibold text-gray-700 text-sm mb-2">Detail Parameter</h4>
                                 <div class="overflow-y-auto border rounded bg-white flex-grow" id="sim-param-list" style="max-height: 200px;">
                                     <!-- Parameters injected here -->
                                 </div>
                             </div>
                         </div>
                </div>
            </div>
        </div>
    </main>

    <script src="/js/koncoTaniAdmin.js"></script>
    <script>
        // Prepare Data for KoncoTani Script
        // We construct a single-item array with the structure expected by the script
        const productData = JSON.parse(decodeURIComponent('<%- encodeURIComponent(JSON.stringify(product)) %>'));
        const parametersData = JSON.parse(decodeURIComponent('<%- encodeURIComponent(JSON.stringify(parameters)) %>'));
        
        // Ensure structure matches what koncoTaniAdmin.js expects: product.groupparameter.parameters
        productData.groupparameter = { parameters: parametersData };
        
        // Global variable expected by the script logic we are injecting
        const allProductsData = [productData]; 

        // Initialize with custom UI handlers for the Detail View
        document.addEventListener('DOMContentLoaded', () => {
            if (window.initKoncoTani) {
                window.initKoncoTani({
                    showLoadingState: () => {
                        document.getElementById('simulation-placeholder').classList.add('hidden');
                        document.getElementById('simulation-status').classList.add('hidden');
                        document.getElementById('simulation-loading').classList.remove('hidden');
                    },
                    hideLoadingState: () => {
                        document.getElementById('simulation-loading').classList.add('hidden');
                    },
                    displayError: (msg) => {
                        alert("Error Simulasi: " + msg);
                    },
                    displayInitialState: (msg) => {
                        // Keep placeholder visible
                        document.getElementById('simulation-placeholder').classList.remove('hidden');
                        document.getElementById('simulation-status').classList.add('hidden');
                    },
                    updateLiveCards: (current, units) => {
                        const temp = (current.temperature_2m !== undefined ? current.temperature_2m : '-') + (units.temperature_2m || '');
                        const rain = (current.precipitation !== undefined ? current.precipitation : '-') + (units.precipitation || '');
                        
                        document.getElementById('sim-temp').textContent = temp;
                        document.getElementById('sim-rain').textContent = rain;
                    },
                    displayResults: (calculatedProducts) => {
                        const result = calculatedProducts[0]; // Single product result
                        
                        document.getElementById('simulation-status').classList.remove('hidden');
                        document.getElementById('simulation-loading').classList.add('hidden');
                        document.getElementById('simulation-placeholder').classList.add('hidden');

                        // Update Score Badge
                        const badge = document.getElementById('sim-score-badge');
                        const statusText = document.getElementById('sim-status-text');
                        
                        badge.textContent = `${result.scorePercent.toFixed(0)}%`;
                        
                        // Color Logic
                        if (result.paramCount === 0) {
                            badge.className = "text-3xl font-extrabold text-gray-400";
                            statusText.className = "px-2 py-0.5 rounded text-xs font-bold bg-gray-100 text-gray-500";
                            statusText.textContent = "Tidak Ada Parameter";
                        } else if (result.scorePercent >= 80) {
                            badge.className = "text-3xl font-extrabold text-green-600";
                            statusText.className = "px-2 py-0.5 rounded text-xs font-bold bg-green-100 text-green-700";
                            statusText.textContent = "Sangat Cocok";
                        } else if (result.scorePercent >= 50) {
                            badge.className = "text-3xl font-extrabold text-yellow-600";
                            statusText.className = "px-2 py-0.5 rounded text-xs font-bold bg-yellow-100 text-yellow-700";
                            statusText.textContent = "Cukup Cocok";
                        } else {
                            badge.className = "text-3xl font-extrabold text-red-600";
                            statusText.className = "px-2 py-0.5 rounded text-xs font-bold bg-red-100 text-red-700";
                            statusText.textContent = "Kurang Cocok";
                        }

                        // Update Parameter List
                        const listContainer = document.getElementById('sim-param-list');
                        if (result.paramDetails && result.paramDetails.length > 0) {
                            listContainer.innerHTML = result.paramDetails.map(p => {
                                const isCocok = p.isCocok;
                                const colorClass = isCocok ? 'text-green-700 bg-green-50 border-green-200' : 'text-red-700 bg-red-50 border-red-200';
                                const icon = isCocok ? 
                                    '<svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>' : 
                                    '<svg class="w-4 h-4 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>';
                                
                                return `
                                <div class="p-3 border-b last:border-b-0 hover:bg-gray-50 transition-colors">
                                    <div class="flex justify-between items-start">
                                        <div>
                                            <p class="text-sm font-medium text-gray-700">${p.Nama}</p>
                                            <p class="text-xs text-gray-500">Target: ${p.Minimal} - ${p.Maksimal} ${p.Unit}</p>
                                        </div>
                                        <div class="text-right">
                                            <div class="flex items-center justify-end space-x-1 mb-1">
                                                ${icon}
                                                <span class="text-sm font-bold ${isCocok ? 'text-green-700' : 'text-red-700'}">${p.actualValue}</span>
                                            </div>
                                            <span class="text-[10px] uppercase font-bold tracking-wide ${isCocok ? 'text-green-600' : 'text-red-600'}">${isCocok ? 'Masuk Range' : 'Diluar Range'}</span>
                                        </div>
                                    </div>
                                </div>`;
                            }).join('');
                        } else {
                            listContainer.innerHTML = `
                                <div class="h-full flex flex-col items-center justify-center text-gray-400 p-4">
                                    <p class="text-sm italic text-center">Produk ini belum memiliki parameter optimal yang diatur.</p>
                                </div>`;
                        }
                    },
                    // We don't need getFilterValues as we are not filtering
                    getFilterValues: () => ({ search: '', category: 'Semua', sort: 'nama', grade: 0 }) 
                });
            } else {
                console.error("koncoTaniAdmin.js init function not found!");
            }
        });
    </script>
</body>
</html>