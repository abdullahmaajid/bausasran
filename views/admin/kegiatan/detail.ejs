<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detail Kegiatan: <%= kegiatan.Judul %></title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        main: '#003024',    // Background Gelap
                        surface: '#004030', // Warna Kartu
                        accent: '#83C540',  // Hijau Neon
                        pale: '#F5FEF9',    // Teks Putih
                        muted: '#A3C2B8',   // Teks Pudar
                        darker: '#00251a',  // Background Input
                        danger: '#ff4d4d',  // Merah Error
                        warning: '#FFC107', // Kuning Warning
                    },
                    fontFamily: { sans: ['Inter', 'sans-serif'] }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer base { body { @apply bg-main text-pale font-sans antialiased; } }
        
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #004030; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #83C540; }
    </style>
</head>

<body class="flex h-screen overflow-hidden w-full">

    <%- include('../../partials/admin_sidebar.ejs') %>

    <main class="flex-1 h-full overflow-y-auto overflow-x-hidden p-6 md:p-8 relative">
        <%- include('../../partials/flash.ejs') %>

        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
            <div class="flex-1">
                <div class="flex items-center gap-3 mb-1">
                    <span class="px-3 py-1 rounded-full text-xs font-bold border 
                        <%= kegiatan.Status === 'Upcoming' ? 'bg-accent/10 text-accent border-accent/20' : 'bg-white/10 text-muted border-white/10' %> uppercase tracking-wider">
                        <%= kegiatan.Status %>
                    </span>
                    <span class="text-muted text-xs font-mono">ID: #<%= kegiatan.ID_Kegiatan %></span>
                </div>
                <h1 class="text-3xl font-bold text-pale tracking-tight leading-tight">
                    <%= kegiatan.Judul %>
                </h1>
            </div>
            
            <div class="flex items-center gap-3 shrink-0">
                <a href="/admin/kegiatan" class="bg-surface hover:bg-white/10 text-pale font-bold py-2.5 px-6 rounded-xl border border-white/10 transition-all text-sm shadow-lg flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                    Kembali
                </a>
                <a href="/admin/kegiatan/<%= kegiatan.ID_Kegiatan %>/edit" class="bg-warning hover:bg-warning/90 text-main font-bold py-2.5 px-6 rounded-xl shadow-lg shadow-warning/20 transition-all flex items-center gap-2 text-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                    Edit Data
                </a>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            <div class="lg:col-span-2 space-y-8">
                
                <div class="bg-surface rounded-2xl p-6 md:p-8 shadow-xl border border-white/5">
                    <h2 class="text-lg font-bold text-pale mb-6 flex items-center gap-2 border-b border-white/5 pb-4">
                        <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
                        Detail & Deskripsi Kegiatan
                    </h2>
                    
                    <div class="prose prose-invert prose-p:text-muted prose-headings:text-pale max-w-none leading-relaxed">
                        <% if (sections && sections.length > 0) { %>
                            <% sections.forEach(section => { %>
                                <div class="mb-4">
                                    <p class="whitespace-pre-line"><%- section.Deskripsi %></p>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="flex flex-col items-center justify-center py-8 text-muted opacity-50 border border-dashed border-white/10 rounded-xl">
                                <span class="italic">Belum ada deskripsi konten untuk kegiatan ini.</span>
                            </div>
                        <% } %>
                    </div>
                </div>

                <div class="bg-surface rounded-2xl p-6 md:p-8 shadow-xl border border-white/5">
                    <h2 class="text-lg font-bold text-pale mb-6 flex items-center gap-2 border-b border-white/5 pb-4">
                        <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                        Galeri Dokumentasi
                    </h2>

                    <% if (fotoList && fotoList.length > 0) { %>
                        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                            <% fotoList.forEach((foto, index) => { %>
                                <div class="group relative aspect-square rounded-xl overflow-hidden bg-darker border border-white/10 cursor-pointer">
                                    <img src="/images/kegiatan/<%= foto.Foto %>" 
                                         alt="Dokumentasi Kegiatan" 
                                         class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110">
                                    
                                    <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-colors flex items-center justify-center opacity-0 group-hover:opacity-100">
                                        <a href="/images/kegiatan/<%= foto.Foto %>" target="_blank" class="bg-white/20 hover:bg-white/40 backdrop-blur-sm p-2 rounded-full text-white transition-all">
                                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                                        </a>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="flex flex-col items-center justify-center py-12 text-muted border border-dashed border-white/10 rounded-xl bg-darker/30">
                            <svg class="w-12 h-12 mb-3 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            <p class="text-sm">Belum ada foto yang diunggah.</p>
                        </div>
                    <% } %>
                </div>
            </div>

            <div class="lg:col-span-1 space-y-6">
                
                <div class="bg-surface rounded-2xl p-6 shadow-xl border border-white/5 sticky top-6">
                    <h3 class="text-xs font-bold text-muted uppercase tracking-widest mb-6">Informasi Kegiatan</h3>
                    
                    <div class="space-y-6">
                        <div class="flex items-start gap-4">
                            <div class="bg-darker p-3 rounded-lg border border-white/10 shrink-0">
                                <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            </div>
                            <div>
                                <p class="text-[10px] text-muted uppercase font-bold mb-1">Tanggal Pelaksanaan</p>
                                <p class="text-pale font-medium">
                                    <%= new Date(kegiatan.Tanggal).toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
                                </p>
                            </div>
                        </div>

                        <div class="flex items-start gap-4">
                            <div class="bg-darker p-3 rounded-lg border border-white/10 shrink-0">
                                <svg class="w-5 h-5 text-warning" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path></svg>
                            </div>
                            <div>
                                <p class="text-[10px] text-muted uppercase font-bold mb-1">Kategori</p>
                                <p class="text-pale font-medium"><%= kegiatan.Kategori || 'Umum' %></p>
                            </div>
                        </div>

                        <div class="pt-4 border-t border-white/5">
                            <div class="rounded-xl p-4 border flex items-center justify-between
                                <%= kegiatan.Status === 'Upcoming' ? 'bg-accent/5 border-accent/20' : 'bg-white/5 border-white/10' %>">
                                <div>
                                    <p class="text-[10px] text-muted uppercase font-bold">Status Saat Ini</p>
                                    <p class="text-lg font-bold <%= kegiatan.Status === 'Upcoming' ? 'text-accent' : 'text-pale' %>">
                                        <%= kegiatan.Status %>
                                    </p>
                                </div>
                                <div class="h-8 w-8 rounded-full flex items-center justify-center <%= kegiatan.Status === 'Upcoming' ? 'bg-accent text-main' : 'bg-muted text-main' %>">
                                    <% if(kegiatan.Status === 'Upcoming') { %>
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                    <% } else { %>
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                    <% } %>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </main>
</body>
</html>