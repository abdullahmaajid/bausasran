<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sunting Anggota: <%= anggota.Nama %> - Executive Console</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        paper: '#F9F7F2',       /* Latar Belakang Kertas Tua */
                        deep: '#0F1F18',        /* Tinta Hijau Gelap */
                        gold: '#C5B388',        /* Emas Antik */
                        charcoal: '#4A4A4A',    /* Abu Arang */
                        linen: '#EBE9E4',       /* Abu Linen */
                        white: '#FFFFFF',
                        danger: '#8B3A3A',      /* Merah Bata Elegan */
                    },
                    fontFamily: {
                        sans: ['Lato', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                        crest: ['Cinzel', 'serif'], 
                    },
                    boxShadow: {
                        'elegant': '0 20px 50px -12px rgba(15, 31, 24, 0.08)',
                        'gold-glow': '0 0 15px rgba(197, 179, 136, 0.2)',
                    }
                }
            }
        }
    </script>

    <style type="text/tailwindcss">
        @layer base {
            body { @apply bg-paper text-deep font-sans antialiased; }
        }

        /* TEXTURE: Film Grain Overlay */
        .noise-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.03'/%3E%3C/svg%3E");
            pointer-events: none; z-index: 50; mix-blend-mode: multiply;
        }

        /* COMPONENTS */
        .input-label { 
            @apply block text-[10px] uppercase tracking-[0.15em] font-bold text-deep/60 mb-2 font-sans; 
        }
        
        .required-mark { 
            @apply text-danger ml-0.5 text-xs align-top; 
        }

        .input-luxury {
            @apply w-full bg-white border border-deep/10 px-4 py-3 text-sm text-deep placeholder-deep/20 focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold/50 transition-all duration-300 font-sans shadow-sm rounded-sm appearance-none;
        }

        .input-headline {
            @apply w-full bg-transparent border-b-2 border-deep/10 px-2 py-2 -mx-2 text-3xl md:text-4xl font-serif font-bold text-deep placeholder-deep/15 focus:outline-none focus:border-gold focus:bg-white/40 transition-all duration-300;
        }

        /* Custom Dropdown Arrow */
        .select-wrapper {
            position: relative;
        }
        .select-wrapper::after {
            content: '';
            position: absolute;
            right: 16px;
            top: 50%;
            transform: translateY(-50%) rotate(45deg);
            width: 6px;
            height: 6px;
            border-right: 2px solid #C5B388;
            border-bottom: 2px solid #C5B388;
            pointer-events: none;
        }

        /* Custom Scrollbar */
        .custom-scroll::-webkit-scrollbar { width: 6px; }
        .custom-scroll::-webkit-scrollbar-track { background: transparent; }
        .custom-scroll::-webkit-scrollbar-thumb { background: #C5B388; border-radius: 3px; }
        .custom-scroll::-webkit-scrollbar-thumb:hover { background: #0F1F18; }
    </style>
</head>

<body class="flex h-screen overflow-hidden relative">

    <div class="noise-overlay"></div>

    <%- include('../../partials/admin_sidebar.ejs') %>

    <main class="flex-1 h-full overflow-y-auto overflow-x-hidden custom-scroll relative z-10 p-6 md:p-12">
        <%- include('../../partials/flash.ejs') %>

        <form action="/admin/anggota/<%= anggota.ID_Pengguna %>/edit" method="POST" enctype="multipart/form-data" id="edit-member-form" class="max-w-6xl mx-auto flex flex-col min-h-full">
            
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 border-b border-deep/10 pb-6 animate-enter">
                <div>
                    <span class="font-sans text-[10px] uppercase tracking-widest text-gold mb-2 block">Pembaruan Data</span>
                    <h1 class="font-crest text-3xl md:text-4xl text-deep leading-tight">Sunting Berkas Anggota</h1>
                    <p class="font-serif italic text-charcoal/60 text-sm mt-2">Memperbarui profil, peran, dan kredensial keamanan.</p>
                </div>
                <div class="flex gap-4">
                    <a href="/admin/anggota" class="px-6 py-3 border border-deep/10 text-deep/60 text-[10px] uppercase tracking-widest font-bold hover:bg-white hover:text-deep transition-all flex items-center justify-center">
                        Batal
                    </a>
                    <button type="submit" id="btn-submit" class="px-8 py-3 bg-deep text-gold text-[10px] uppercase tracking-[0.2em] font-bold border border-deep hover:bg-gold hover:text-deep hover:border-gold transition-all shadow-lg hover:shadow-gold-glow flex items-center gap-2 group">
                        <span>Simpan Perubahan</span>
                        <svg class="w-3 h-3 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                    </button>
                </div>
            </div>

            <div class="flex flex-col lg:flex-row gap-8 lg:gap-12 items-start">
                
                <div class="w-full lg:flex-1 space-y-8">
                    
                    <div class="bg-white p-8 border border-deep/5 shadow-elegant relative group h-full">
                        <div class="absolute top-0 left-0 w-1 h-full bg-gold/50 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                        
                        <div class="mb-8 relative">
                            <label for="nama" class="input-label text-gold">Nama Lengkap <span class="required-mark">*</span></label>
                            <input type="text" id="nama" name="nama" value="<%= anggota.Nama %>" class="input-headline" required autocomplete="off">
                        </div>

                        <div class="flex flex-col h-full">
                            <label for="deskripsi" class="input-label">Biografi / Latar Belakang</label>
                            <textarea id="deskripsi" name="deskripsi" rows="8"
                                class="w-full bg-paper/50 border border-deep/10 p-6 text-sm text-deep/80 leading-loose font-serif italic focus:outline-none focus:border-gold resize-none placeholder-deep/20 focus:bg-white transition-all rounded-sm shadow-inner" 
                                placeholder="Ceritakan latar belakang anggota ini secara singkat..."><%= anggota.Deskripsi || '' %></textarea>
                        </div>
                    </div>

                    <div class="bg-deep/5 p-8 border border-deep/5 rounded-sm">
                        <h3 class="font-crest text-sm text-deep mb-5 flex items-center gap-2 border-b border-deep/10 pb-3">
                            <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                            Kredensial & Keamanan
                        </h3>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label for="username" class="input-label">Username</label>
                                <input type="text" id="username" name="username" value="<%= anggota.username %>" class="input-luxury" required autocomplete="off">
                            </div>
                            
                            <div>
                                <label for="password" class="input-label text-danger/80">Reset Password</label>
                                <input type="password" id="password" name="password" class="input-luxury bg-white" placeholder="••••••••" autocomplete="new-password">
                                <p class="text-[9px] text-charcoal/50 mt-1.5 font-serif italic tracking-wide">
                                    * Kosongkan jika tidak ingin mengubah kata sandi.
                                </p>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="w-full lg:w-[350px] shrink-0 flex flex-col gap-6">
                    
                    <div class="bg-white p-6 border border-deep/5 shadow-elegant rounded-sm relative overflow-hidden">
                        <h3 class="font-crest text-sm text-deep mb-5 flex items-center gap-2 relative z-10 border-b border-deep/10 pb-3">
                            <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2"></path></svg>
                            Atribut Anggota
                        </h3>

                        <div class="space-y-5 relative z-10">
                            <div>
                                <label for="jabatan" class="input-label">Jabatan / Posisi</label>
                                <input type="text" id="jabatan" name="jabatan" value="<%= anggota.Jabatan || '' %>" class="input-luxury" placeholder="Cth: Ketua Pokdarwis">
                            </div>

                            <div>
                                <label for="role" class="input-label">Hak Akses Sistem</label>
                                <div class="select-wrapper">
                                    <select id="role" name="role" class="input-luxury cursor-pointer">
                                        <option value="User" <%= anggota.Role === 'User' ? 'selected' : '' %>>User (Anggota Biasa)</option>
                                        <option value="Admin" <%= anggota.Role === 'Admin' ? 'selected' : '' %>>Admin (Full Akses)</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="bg-white p-6 border border-deep/5 shadow-elegant">
                        <div class="mb-4 flex items-center justify-between">
                            <span class="input-label mb-0 text-deep">Potret Profil</span>
                            <div class="h-[1px] flex-1 bg-deep/10 ml-4"></div>
                        </div>

                        <% 
                            let currentPhotoUrl = '';
                            if (anggota.fotoFile) {
                                currentPhotoUrl = '/images/anggota/' + anggota.fotoFile;
                            } else if (anggota.dataValues && anggota.dataValues.fotoFile) {
                                currentPhotoUrl = '/images/anggota/' + anggota.dataValues.fotoFile;
                            }
                        %>

                        <label for="fotoAnggota" class="relative flex flex-col items-center justify-center w-full aspect-[3/4] bg-linen/20 border-2 border-dashed border-deep/20 cursor-pointer group hover:border-gold transition-all duration-300 overflow-hidden mb-2 rounded-sm p-1">
                            
                            <div id="placeholder-container" class="absolute inset-0 flex flex-col items-center justify-center pt-5 pb-6 text-deep/30 group-hover:text-gold transition-colors z-10 <%= currentPhotoUrl ? 'hidden' : '' %>">
                                <div class="w-12 h-12 rounded-full border border-current flex items-center justify-center mb-3">
                                    <svg class="w-6 h-6 stroke-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                                </div>
                                <p class="text-[9px] uppercase tracking-widest font-bold">Ganti Foto</p>
                            </div>

                            <div class="w-full h-full bg-paper relative overflow-hidden border border-deep/5">
                                <img id="preview-img" src="<%= currentPhotoUrl %>" class="w-full h-full object-cover filter sepia-[0.15] <%= currentPhotoUrl ? '' : 'hidden' %>">
                            </div>

                            <input type="file" id="fotoAnggota" name="fotoAnggota" accept="image/png, image/jpeg, image/jpg" class="hidden" onchange="previewProfile(this)">
                        </label>
                        <p class="text-[9px] text-center text-deep/40 italic font-serif">Klik bingkai di atas untuk mengubah foto.</p>
                    </div>

                </div>
            </div>
        </form>
    </main>

    <script>
        // --- 1. Profile Image Preview Logic ---
        function previewProfile(input) {
            const preview = document.getElementById('preview-img');
            const placeholder = document.getElementById('placeholder-container');
            
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                    preview.classList.remove('hidden');
                    placeholder.classList.add('hidden');
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        // --- 2. Submit Loading State ---
        document.getElementById('edit-member-form').addEventListener('submit', function(e) {
            const btn = document.getElementById('btn-submit');
            btn.style.width = `${btn.offsetWidth}px`;
            btn.disabled = true;
            btn.innerHTML = `<svg class="animate-spin h-4 w-4 text-deep mx-auto" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>`;
            btn.classList.add('opacity-75', 'cursor-not-allowed', 'bg-gold', 'text-deep', 'border-gold');
            btn.classList.remove('bg-deep', 'text-gold');
        });
    </script>
</body>
</html>