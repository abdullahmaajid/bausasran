<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Agenda & Kegiatan - Bausasran Heritage</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
    
    <script src="https://cdn.jsdelivr.net/gh/studio-freight/lenis@1.0.29/bundled/lenis.min.js"></script>

    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        paper: '#F9F7F2',       // Cream Background (Dominan)
                        deep: '#0F1F18',        // Dark Green (Teks Utama)
                        gold: '#C5B388',        // Gold (Aksen Mewah)
                        charcoal: '#4A4A4A',    // Teks Sekunder
                        linen: '#EBE9E4',       // Background Kartu/Placeholder
                    },
                    fontFamily: {
                        sans: ['Lato', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                        crest: ['Cinzel', 'serif'], 
                    },
                    letterSpacing: {
                        'luxury': '0.2em',
                        'widest': '0.3em',
                    },
                    transitionDuration: {
                        '1500': '1500ms',       // Untuk efek hover lambat
                    }
                }
            }
        }
    </script>

    <style type="text/tailwindcss">
        @layer base {
            body {
                @apply bg-paper text-deep font-sans antialiased selection:bg-deep selection:text-paper;
                overscroll-behavior: none; 
            }
        }

        /* TEXTURE OVERLAY: Memberikan kesan kertas tua/film grain */
        .noise-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none; z-index: 9999; mix-blend-mode: multiply;
        }

        /* FILTER BUTTON STYLE */
        .filter-btn {
            @apply transition-all duration-500 ease-out;
        }
        .filter-btn.active {
            @apply bg-deep text-paper border-deep;
        }
        
        /* CARD HOVER ANIMATION */
        .card-hover-effect .card-img {
            @apply grayscale transition-all duration-1500 ease-out;
        }
        .card-hover-effect:hover .card-img {
            @apply scale-105 grayscale-0;
        }
    </style>
</head>

<body class="flex flex-col min-h-screen relative">

    <div class="noise-overlay"></div>

    <%- include('../partials/navbar.ejs') %>

    <main class="flex-grow pt-40 pb-24 px-6 relative z-10">
        
        <%- include('../partials/flash.ejs') %>

        <div class="max-w-7xl mx-auto text-center mb-20 animate-[fadeIn_1.5s]">
            <span class="font-sans text-[10px] uppercase tracking-widest text-gold mb-4 block">Archive & Future</span>
            <h1 class="font-crest text-4xl md:text-6xl text-deep mb-6 leading-none">Agenda Desa</h1>
            <p class="font-serif italic text-lg md:text-xl text-charcoal/70 max-w-2xl mx-auto leading-relaxed">
                "Menelusuri jejak kegiatan lampau dan menyambut agenda mendatang di Kampung Wisata Bausasran."
            </p>
            <div class="w-[1px] h-16 bg-deep/10 mx-auto mt-10"></div>
        </div>

        <div class="max-w-7xl mx-auto mb-16 text-center">
            <div class="inline-flex gap-4 flex-wrap justify-center p-2 border-b border-deep/5 pb-8">
                <button onclick="filterKegiatan('all')" id="btnAll" 
                    class="filter-btn active px-8 py-3 text-[10px] uppercase tracking-widest border border-deep/10 text-deep hover:border-gold rounded-sm">
                    Semua
                </button>
                <button onclick="filterKegiatan('upcoming')" id="btnUpcoming" 
                    class="filter-btn px-8 py-3 text-[10px] uppercase tracking-widest border border-deep/10 text-deep hover:border-gold rounded-sm">
                    Akan Datang
                </button>
                <button onclick="filterKegiatan('past')" id="btnPast" 
                    class="filter-btn px-8 py-3 text-[10px] uppercase tracking-widest border border-deep/10 text-deep hover:border-gold rounded-sm">
                    Selesai
                </button>
            </div>
        </div>

        <div class="max-w-7xl mx-auto">
            <% if(kegiatanList && kegiatanList.length > 0) { %>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-20">
                    <% kegiatanList.forEach(kegiatan => { 
                        // 1. Status Logic
                        let isUpcoming = new Date(kegiatan.Tanggal) >= new Date();
                        let statusFilter = isUpcoming ? 'upcoming' : 'past';
                        // Override if specific status exists
                        if(kegiatan.Status && kegiatan.Status.toLowerCase() === 'upcoming') {
                             statusFilter = 'upcoming'; 
                             isUpcoming = true;
                        }

                        // 2. Image Logic (Priority: thumbnailFile -> photos array -> placeholder)
                        let namaFile = null;
                        if (kegiatan.dataValues && kegiatan.dataValues.thumbnailFile) {
                            namaFile = kegiatan.dataValues.thumbnailFile;
                        } else if (kegiatan.thumbnailFile) {
                            namaFile = kegiatan.thumbnailFile;
                        } else if (kegiatan.photos && kegiatan.photos.length > 0) {
                            namaFile = kegiatan.photos[0].Foto;
                        }
                    %>
                        <article class="kegiatan-card group flex flex-col" data-status="<%= statusFilter %>">
                            
                            <a href="/kegiatan/<%= kegiatan.ID_Kegiatan %>" class="card-hover-effect relative aspect-[4/3] overflow-hidden bg-linen mb-8 border border-deep/5 shadow-sm">
                                <img 
                                    src="<%= namaFile ? '/images/kegiatan/' + namaFile : 'https://via.placeholder.com/600x400?text=' + encodeURIComponent(kegiatan.Judul) %>"  
                                    alt="<%= kegiatan.Judul %>" 
                                    class="card-img w-full h-full object-cover transform"
                                    onerror="this.onerror=null; this.src='https://via.placeholder.com/600x400?text=No+Image';"
                                >
                                
                                <div class="absolute top-4 left-4 z-20">
                                    <span class="px-4 py-1.5 text-[9px] uppercase tracking-widest font-bold border backdrop-blur-md
                                        <%= isUpcoming ? 'bg-deep/90 text-gold border-gold' : 'bg-paper/90 text-deep border-deep/20' %>">
                                        <%= isUpcoming ? 'Upcoming' : 'Finished' %>
                                    </span>
                                </div>
                            </a>

                            <div class="flex flex-col flex-grow text-center px-2">
                                <div class="mb-4">
                                    <span class="font-sans text-[10px] uppercase tracking-widest text-gold border-b border-gold/30 pb-1">
                                        <%= new Date(kegiatan.Tanggal).toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %>
                                    </span>
                                </div>

                                <h3 class="font-serif text-2xl md:text-3xl text-deep mb-4 leading-tight group-hover:text-gold transition-colors duration-300">
                                    <a href="/kegiatan/<%= kegiatan.ID_Kegiatan %>">
                                        <%= kegiatan.Judul %>
                                    </a>
                                </h3>

                                <% if (kegiatan.Lokasi) { %>
                                    <p class="text-[10px] uppercase tracking-widest text-charcoal/50 mb-6 flex justify-center items-center gap-3">
                                        <span class="w-1 h-1 bg-gold rounded-full"></span>
                                        <%= kegiatan.Lokasi %>
                                        <span class="w-1 h-1 bg-gold rounded-full"></span>
                                    </p>
                                <% } %>

                                <div class="mt-auto w-full pt-6 border-t border-deep/5">
                                    <a href="/kegiatan/<%= kegiatan.ID_Kegiatan %>" class="inline-flex items-center text-[9px] uppercase tracking-luxury text-deep hover:text-gold transition-colors font-bold">
                                        Baca Selengkapnya <span class="ml-2 font-serif italic text-lg">&rarr;</span>
                                    </a>
                                </div>
                            </div>
                        </article>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="max-w-2xl mx-auto text-center py-32 border border-dashed border-deep/10 bg-linen/20 rounded-sm">
                    <span class="font-crest text-4xl text-deep/20 mb-4 block">∅</span>
                    <p class="font-crest text-xl text-deep mb-2">Arsip Kosong</p>
                    <p class="font-serif italic text-charcoal/50 text-sm">Belum ada agenda kegiatan yang tercatat saat ini.</p>
                </div>
            <% } %>
        </div>
    </main>

    <%- include('../partials/footer.ejs') %>

    <script>
        // 1. Initialize Smooth Scroll (Lenis)
        const lenis = new Lenis({
            duration: 1.2,
            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), 
            direction: 'vertical',
            smooth: true,
        });
        function raf(time) {
            lenis.raf(time);
            requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);

        // 2. Filter Logic
        function filterKegiatan(status) {
            const cards = document.querySelectorAll('.kegiatan-card');
            const btns = document.querySelectorAll('.filter-btn');
            
            // Reset Button Styles
            btns.forEach(btn => btn.classList.remove('active'));

            // Activate Clicked Button
            const activeBtnId = status === 'all' ? 'btnAll' : (status === 'upcoming' ? 'btnUpcoming' : 'btnPast');
            const activeBtn = document.getElementById(activeBtnId);
            if(activeBtn) activeBtn.classList.add('active');

            // Filter Cards with Animation
            cards.forEach(card => {
                const cardStatus = card.getAttribute('data-status');
                
                if (status === 'all' || cardStatus === status) {
                    card.style.display = 'flex';
                    // Trigger reflow/animation
                    card.style.opacity = '0';
                    card.style.transform = 'translateY(20px)';
                    
                    requestAnimationFrame(() => {
                        card.style.transition = 'all 0.6s ease-out';
                        card.style.opacity = '1';
                        card.style.transform = 'translateY(0)';
                    });
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // Run filter 'all' on load
        document.addEventListener("DOMContentLoaded", () => {
            filterKegiatan('all');
        });
    </script>

</body>
</html>