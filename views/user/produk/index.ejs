<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Katalog Produk - Bausasran Heritage</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        paper: '#F9F7F2',       // Background Utama
                        deep: '#0F1F18',        // Teks Utama / Aksen Gelap
                        gold: '#C5B388',        // Aksen Emas
                        charcoal: '#4A4A4A',    // Teks Sekunder
                        linen: '#EBE9E4',       // Background Kartu
                    },
                    fontFamily: {
                        sans: ['Lato', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                        crest: ['Cinzel', 'serif'],
                    },
                    letterSpacing: {
                        'luxury': '0.2em',
                    }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer base { 
            body { 
                @apply bg-paper text-deep font-sans antialiased; 
            } 
            .custom-scroll::-webkit-scrollbar { width: 6px; }
            .custom-scroll::-webkit-scrollbar-track { @apply bg-paper; }
            .custom-scroll::-webkit-scrollbar-thumb { @apply bg-deep/20 hover:bg-gold rounded-full transition-colors; }
        }

        /* Texture Grain Overlay */
        .noise-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none;
            z-index: 0;
            mix-blend-mode: multiply;
        }
    </style>
</head>
<body class="flex h-screen overflow-hidden relative">

    <div class="noise-overlay"></div>

    <%- include('../../partials/user_sidebar.ejs') %>

    <main class="flex-1 overflow-y-auto custom-scroll p-8 md:p-12 relative z-10">
        
        <%- include('../../partials/flash.ejs') %>

        <div class="max-w-7xl mx-auto">

            <div class="mb-12 flex flex-col md:flex-row justify-between items-start md:items-end gap-6 border-b border-deep/10 pb-8">
                <div>
                    <span class="text-[10px] uppercase tracking-luxury text-gold font-bold mb-2 block">Panen & Karya</span>
                    <h1 class="text-3xl md:text-5xl font-crest text-deep mb-3">
                        Katalog <span class="font-serif italic text-gold">Produk</span>
                    </h1>
                    <p class="text-charcoal font-serif italic text-lg max-w-2xl">
                        Kurasi hasil panen segar dan kerajinan tangan terbaik dari warga.
                    </p>
                </div>
                
                <a href="/user/produk/pencocokan" class="group relative px-8 py-3 bg-deep text-paper font-bold uppercase tracking-widest text-[10px] hover:bg-gold hover:text-deep transition-all duration-300 border border-deep shadow-lg">
                    <span class="flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                        Pencocokan Produk
                    </span>
                </a>
            </div>

            <div class="pb-10">
                <% if (produkList && produkList.length > 0) { %>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
                        <% for(let produk of produkList) { %>
                            <div class="group bg-white border border-deep/5 hover:border-gold/50 transition-all duration-500 relative flex flex-col shadow-sm hover:shadow-xl hover:-translate-y-1">
                                
                                <div class="aspect-square relative overflow-hidden bg-linen group-hover:bg-linen/30 transition-colors">
                                    <% if (produk.dataValues.thumbnailFile) { %>
                                        <img src="/images/produk/<%= produk.dataValues.thumbnailFile %>" 
                                             alt="<%= produk.Nama %>"
                                             class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700">
                                    <% } else { %>
                                        <div class="w-full h-full flex items-center justify-center text-deep/10">
                                            <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                            </svg>
                                        </div>
                                    <% } %>
                                    
                                    <% if (produk.Kategori) { %>
                                        <div class="absolute top-0 left-0">
                                            <span class="inline-block px-4 py-1.5 bg-paper/95 text-deep text-[9px] font-bold uppercase tracking-widest border-r border-b border-deep/5">
                                                <%= produk.Kategori %>
                                            </span>
                                        </div>
                                    <% } %>
                                </div>

                                <div class="p-6 flex-1 flex flex-col">
                                    <div class="flex-1 mb-4">
                                        <h3 class="text-xl font-serif text-deep mb-2 group-hover:text-gold transition-colors line-clamp-1" title="<%= produk.Nama %>">
                                            <%= produk.Nama %>
                                        </h3>
                                        
                                        <% if (produk.Deskripsi) { %>
                                            <p class="text-sm text-charcoal/70 line-clamp-2 leading-relaxed font-light">
                                                <%= produk.Deskripsi %>
                                            </p>
                                        <% } else { %>
                                            <p class="text-sm text-charcoal/40 italic">Deskripsi tidak tersedia.</p>
                                        <% } %>
                                    </div>

                                    <div class="pt-4 border-t border-deep/5 flex items-end justify-between">
                                        <div class="flex flex-col">
                                            <span class="text-[9px] uppercase tracking-luxury text-charcoal/50 mb-1">Harga</span>
                                            <span class="text-lg font-bold text-deep font-serif">
                                                <span class="text-gold text-sm mr-1">IDR</span><%= Number(produk.Harga).toLocaleString('id-ID') %>
                                            </span>
                                        </div>
                                        <a href="/user/produk/<%= produk.ID_Product %>" 
                                           class="w-8 h-8 flex items-center justify-center border border-deep/10 text-deep hover:bg-deep hover:text-gold hover:border-deep transition-all rounded-full group-hover:scale-110">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                <% } else { %>
                    <div class="flex flex-col items-center justify-center py-24 border border-dashed border-deep/10 bg-linen/20">
                        <div class="w-16 h-16 rounded-full bg-paper border border-deep/10 flex items-center justify-center mb-6 shadow-sm">
                            <svg class="w-8 h-8 text-deep/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                            </svg>
                        </div>
                        <h3 class="text-xl font-crest text-deep mb-2">Katalog Kosong</h3>
                        <p class="font-serif italic text-charcoal/60 max-w-md text-center">
                            Belum ada produk yang tersedia. Silakan cek kembali nanti atau gunakan fitur pencocokan produk.
                        </p>
                    </div>
                <% } %>
            </div>

            <div class="mt-8 pt-6 border-t border-deep/5 text-center">
                <p class="text-[9px] uppercase tracking-luxury text-charcoal/40">
                    &copy; <%= new Date().getFullYear() %> Bausasran Heritage Estate.
                </p>
            </div>
            
        </div> </main>

</body>
</html>