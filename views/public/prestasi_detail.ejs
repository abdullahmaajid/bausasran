<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= prestasi.Judul %> - Prestasi Bausasran</title>
    
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        main: '#003024',    // Background Gelap
                        surface: '#004030', // Warna Kartu
                        accent: '#83C540',  // Hijau Neon
                        pale: '#F5FEF9',    // Teks Putih
                        muted: '#A3C2B8',   // Teks Pudar
                        gold: '#FACC15',    // Warna Piala
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    boxShadow: {
                        'neon': '0 0 15px rgba(131, 197, 64, 0.3)',
                        'gold': '0 0 20px rgba(250, 204, 21, 0.3)',
                    }
                }
            }
        }
    </script>

    <style type="text/tailwindcss">
        @layer base {
            body {
                @apply bg-main text-pale font-sans antialiased;
            }
        }
    </style>
</head>

<body class="flex flex-col min-h-screen">

    <%- include('../partials/navbar.ejs') %>

    <main class="container mx-auto px-4 py-8 md:py-12 flex-grow">
        <%- include('../partials/flash.ejs') %>

        <nav class="flex mb-8 text-sm font-medium" aria-label="Breadcrumb">
            <ol class="inline-flex items-center space-x-1 md:space-x-3">
                <li class="inline-flex items-center">
                    <a href="/" class="text-muted hover:text-accent transition-colors">Home</a>
                </li>
                <li>
                    <div class="flex items-center">
                        <svg class="w-3 h-3 text-muted mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
                        </svg>
                        <a href="/prestasi" class="text-muted hover:text-accent transition-colors">Prestasi</a>
                    </div>
                </li>
                <li aria-current="page">
                    <div class="flex items-center">
                        <svg class="w-3 h-3 text-muted mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
                        </svg>
                        <span class="text-accent truncate max-w-[150px] md:max-w-xs"><%= prestasi.Judul %></span>
                    </div>
                </li>
            </ol>
        </nav>

        <div class="max-w-5xl mx-auto">
            
            <div class="bg-surface rounded-3xl overflow-hidden shadow-lg border border-white/10 relative mb-8">
                <div class="absolute top-0 left-1/2 transform -translate-x-1/2 w-full h-32 bg-accent/10 blur-3xl pointer-events-none"></div>

                <div class="p-8 md:p-12 text-center relative z-10">
                    <div class="inline-flex items-center justify-center w-24 h-24 mb-6 rounded-full bg-main/50 border border-gold/30 shadow-gold relative group">
                        <div class="absolute inset-0 bg-gold/20 rounded-full blur-xl opacity-50 group-hover:opacity-80 transition-opacity"></div>
                        <svg class="w-12 h-12 text-gold relative z-10" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                        </svg>
                    </div>

                    <h1 class="text-3xl md:text-5xl font-bold text-pale mb-4 leading-tight">
                        <%= prestasi.Judul %>
                    </h1>

                    <div class="flex flex-wrap justify-center items-center gap-4 text-sm md:text-base">
                        <span class="flex items-center text-accent bg-accent/10 px-4 py-1.5 rounded-full border border-accent/20">
                            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            <%= new Date(prestasi.Tanggal).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                        </span>
                        
                        <% if (prestasi.Kategori) { %>
                            <span class="flex items-center text-gold bg-gold/10 px-4 py-1.5 rounded-full border border-gold/20">
                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path></svg>
                                <%= prestasi.Kategori %>
                            </span>
                        <% } %>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                
                <div class="lg:col-span-2">
                    <div class="bg-surface rounded-2xl p-6 border border-white/10 h-full">
                        <h2 class="text-xl font-bold text-pale mb-6 flex items-center">
                            <svg class="w-6 h-6 mr-2 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            Dokumentasi
                        </h2>

                        <% if (fotoFiles && fotoFiles.length > 0) { %>
                            <div class="grid grid-cols-2 gap-4">
                                <% fotoFiles.forEach((foto, idx) => { %>
                                    <div class="group relative aspect-[4/3] rounded-xl overflow-hidden bg-main border border-white/5 cursor-pointer">
                                        <img src="/images/galeri/<%= foto %>" 
                                             alt="Foto Prestasi <%= idx + 1 %>" 
                                             class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                                             loading="lazy"
                                             onerror="this.src='https://via.placeholder.com/400x300?text=No+Image'">
                                        
                                        <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
                                            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path></svg>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="flex flex-col items-center justify-center py-12 border-2 border-dashed border-white/10 rounded-xl bg-white/5">
                                <svg class="w-12 h-12 text-muted mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                <p class="text-muted text-sm">Belum ada dokumentasi foto.</p>
                            </div>
                        <% } %>
                    </div>
                </div>

                <div class="lg:col-span-1">
                    <div class="bg-surface rounded-2xl p-6 border border-white/10 sticky top-24">
                        <h3 class="text-lg font-bold text-pale mb-6 pb-4 border-b border-white/10">
                            Detail Informasi
                        </h3>
                        
                        <div class="space-y-6">
                            <div class="flex items-start">
                                <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-main flex items-center justify-center text-accent mr-4 border border-white/5">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                </div>
                                <div>
                                    <p class="text-xs text-muted uppercase tracking-wider mb-1">Tanggal Raihan</p>
                                    <p class="text-pale font-medium">
                                        <%= new Date(prestasi.Tanggal).toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
                                    </p>
                                </div>
                            </div>

                            <% if (prestasi.Kategori) { %>
                                <div class="flex items-start">
                                    <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-main flex items-center justify-center text-accent mr-4 border border-white/5">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                                    </div>
                                    <div>
                                        <p class="text-xs text-muted uppercase tracking-wider mb-1">Tingkat / Kategori</p>
                                        <p class="text-pale font-medium"><%= prestasi.Kategori %></p>
                                    </div>
                                </div>
                            <% } %>

                            <% if (groupFoto) { %>
                                <div class="flex items-start">
                                    <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-main flex items-center justify-center text-accent mr-4 border border-white/5">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"></path></svg>
                                    </div>
                                    <div>
                                        <p class="text-xs text-muted uppercase tracking-wider mb-1">Album Terkait</p>
                                        <a href="/galeri" class="text-accent hover:text-white hover:underline transition-colors font-medium">
                                            <%= groupFoto.Nama %>
                                        </a>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>

            </div>

            <div class="mt-12 text-center">
                <a href="/prestasi" class="inline-flex items-center px-6 py-3 border border-white/10 text-muted hover:text-white hover:bg-white/5 rounded-xl transition-all duration-300">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                    Kembali ke Daftar Prestasi
                </a>
            </div>

        </div>
    </main>

    <%- include('../partials/footer.ejs') %>

</body>
</html>