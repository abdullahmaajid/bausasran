    <div id="mobile-menu" class="hidden lg:hidden bg-[#004030] border-t border-white/10 absolute w-full left-0 top-20 shadow-xl">
        <div class="flex flex-col p-4 space-y-3">
            <a href="/" class="mobile-link">Home</a>
            <a href="/kegiatan" class="mobile-link">Kegiatan</a>
            <a href="/produk" class="mobile-link">Produk</a>
            <a href="/galeri" class="mobile-link">Galeri</a>
            <a href="/anggota" class="mobile-link">Anggota</a>
            <a href="/prestasi" class="mobile-link">Prestasi</a>
            <a href="/testimoni" class="mobile-link">Testimoni</a>
            
            <div class="h-px bg-white/10 my-2"></div>

