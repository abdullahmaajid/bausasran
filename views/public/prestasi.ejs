<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jejak Prestasi - Bausasran Heritage</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
    
    <script src="https://cdn.jsdelivr.net/gh/studio-freight/lenis@1.0.29/bundled/lenis.min.js"></script>

    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        paper: '#F9F7F2',       // Cream Background
                        deep: '#0F1F18',        // Dark Green (Primary)
                        gold: '#C5B388',        // Luxury Accent
                        charcoal: '#4A4A4A',    // Text
                        sand: '#E5E0D8',        // Border/Secondary
                        white: '#FFFFFF',
                    },
                    fontFamily: {
                        sans: ['Lato', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                        crest: ['Cinzel', 'serif'], 
                    },
                    letterSpacing: {
                        'luxury': '0.2em',
                        'widest': '0.3em',
                    },
                    boxShadow: {
                        'elegant': '0 10px 40px -10px rgba(15, 31, 24, 0.10)',
                    }
                }
            }
        }
    </script>

    <style type="text/tailwindcss">
        @layer base {
            body {
                @apply bg-paper text-deep font-sans antialiased selection:bg-deep selection:text-paper;
                overscroll-behavior: none; 
            }
        }
        
        /* TEXTURE OVERLAY */
        .noise-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none; z-index: 9999; mix-blend-mode: multiply;
        }

        /* TIMELINE LINE LOGIC */
        .timeline-container::before {
            content: '';
            position: absolute;
            top: 0; bottom: 0;
            width: 1px;
            background: rgba(15, 31, 24, 0.15);
        }

        /* Desktop: Center Line */
        @media (min-width: 768px) {
            .timeline-container::before { left: 50%; transform: translateX(-50%); }
        }

        /* Mobile: Left Line */
        @media (max-width: 767px) {
            .timeline-container::before { left: 24px; }
        }
    </style>
</head>

<body class="flex flex-col min-h-screen relative">

    <div class="noise-overlay"></div>

    <%- include('../partials/navbar.ejs') %>

    <main class="flex-grow pt-40 pb-24 px-6 relative z-10">
        <%- include('../partials/flash.ejs') %>

        <div class="max-w-6xl mx-auto text-center mb-24 animate-[fadeIn_1.5s]">
            <span class="font-sans text-[10px] uppercase tracking-widest text-gold mb-4 block">Hall of Achievements</span>
            <h1 class="font-crest text-4xl md:text-6xl text-deep mb-6 leading-none">Jejak Prestasi</h1>
            <p class="font-serif italic text-lg md:text-xl text-charcoal/70 max-w-2xl mx-auto leading-relaxed">
                "Sebuah catatan perjalanan atas dedikasi, kerja keras, dan pengakuan yang telah diraih oleh Kampung Wisata Bausasran."
            </p>
            <div class="w-[1px] h-16 bg-deep/10 mx-auto mt-10"></div>
        </div>

        <% if(prestasiList && prestasiList.length > 0) { %>
            <div class="relative max-w-6xl mx-auto timeline-container pb-12">
                
                <% prestasiList.forEach((prestasi, index) => { 
                    // Safe Data Handling
                    const vals = prestasi.dataValues || prestasi;
                    const id = vals.ID_Prestasi;
                    const judul = vals.Judul;
                    const kategori = vals.Kategori || 'Penghargaan';
                    const tanggal = vals.Tanggal;
                    const deskripsi = vals.Deskripsi;
                    const isLeft = index % 2 === 0; // True if Even index (Left on Desktop)
                %>
                    
                    <div class="relative z-10 mb-16 md:mb-24 flex flex-col md:flex-row items-center w-full group">
                        
                        <div class="w-full md:w-1/2 pl-16 md:pl-0 md:pr-16 md:text-right order-1">
                            
                            <% if(isLeft) { %>
                                <a href="/prestasi/<%= id %>" class="block group/card relative transition-transform duration-500 hover:-translate-y-1">
                                    <div class="flex flex-col md:items-end mb-3">
                                        <span class="font-sans text-[10px] uppercase tracking-widest text-gold mb-2 flex items-center gap-2 md:flex-row-reverse">
                                            <%= new Date(tanggal).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                                            <span class="w-8 h-[1px] bg-gold/50"></span>
                                        </span>
                                        <span class="inline-block px-3 py-1 bg-deep/5 text-deep/60 text-[8px] font-bold uppercase tracking-widest border border-deep/5 mb-3">
                                            <%= kategori %>
                                        </span>
                                    </div>
                                    
                                    <h3 class="font-serif text-2xl md:text-4xl text-deep mb-4 leading-tight group-hover/card:text-gold transition-colors duration-300">
                                        <%= judul %>
                                    </h3>
                                    
                                    <p class="text-charcoal/60 text-sm font-sans mb-5 leading-relaxed line-clamp-2 md:ml-auto max-w-md">
                                        <%= deskripsi || 'Klik untuk melihat detail dokumentasi dan deskripsi lengkap penghargaan ini.' %>
                                    </p>
                                    
                                    <div class="inline-flex items-center text-[9px] uppercase tracking-widest text-deep border-b border-deep/20 pb-1 group-hover/card:border-gold group-hover/card:text-gold transition-all gap-2">
                                        Selengkapnya
                                        <span class="md:hidden">&rarr;</span>
                                    </div>
                                </a>
                            <% } else { %>
                                <div class="hidden md:block"></div> 
                            <% } %>

                            <% if(!isLeft) { %>
                                <div class="md:hidden">
                                    <a href="/prestasi/<%= id %>" class="block group/card relative mt-2 transition-transform duration-500 hover:-translate-y-1">
                                        <div class="flex flex-col items-start mb-3">
                                            <span class="font-sans text-[10px] uppercase tracking-widest text-gold mb-2 flex items-center gap-2">
                                                <%= new Date(tanggal).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                                                <span class="w-8 h-[1px] bg-gold/50"></span>
                                            </span>
                                            <span class="inline-block px-3 py-1 bg-deep/5 text-deep/60 text-[8px] font-bold uppercase tracking-widest border border-deep/5 mb-3">
                                                <%= kategori %>
                                            </span>
                                        </div>
                                        <h3 class="font-serif text-2xl text-deep mb-4 leading-tight group-hover/card:text-gold transition-colors duration-300">
                                            <%= judul %>
                                        </h3>
                                        <div class="inline-flex items-center text-[9px] uppercase tracking-widest text-deep border-b border-deep/20 pb-1 group-hover/card:border-gold group-hover/card:text-gold transition-all gap-2">
                                            Selengkapnya <span>&rarr;</span>
                                        </div>
                                    </a>
                                </div>
                            <% } %>
                        </div>

                        <div class="absolute left-[24px] md:left-1/2 transform -translate-x-1/2 flex items-center justify-center order-1 z-20 top-0">
                            <div class="w-4 h-4 rounded-full bg-paper border-2 border-deep transition-all duration-500 group-hover:border-gold group-hover:scale-150 relative">
                                <div class="absolute inset-0 m-auto w-1.5 h-1.5 rounded-full bg-deep group-hover:bg-gold transition-colors"></div>
                            </div>
                        </div>

                        <div class="w-full md:w-1/2 pl-16 order-1 hidden md:block">
                            
                            <% if(!isLeft) { %>
                                <a href="/prestasi/<%= id %>" class="block group/card relative transition-transform duration-500 hover:-translate-y-1">
                                    <div class="flex flex-col items-start mb-3">
                                        <span class="font-sans text-[10px] uppercase tracking-widest text-gold mb-2 flex items-center gap-2">
                                            <span class="w-8 h-[1px] bg-gold/50"></span>
                                            <%= new Date(tanggal).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                                        </span>
                                        <span class="inline-block px-3 py-1 bg-deep/5 text-deep/60 text-[8px] font-bold uppercase tracking-widest border border-deep/5 mb-3">
                                            <%= kategori %>
                                        </span>
                                    </div>
                                    
                                    <h3 class="font-serif text-4xl text-deep mb-4 leading-tight group-hover/card:text-gold transition-colors duration-300">
                                        <%= judul %>
                                    </h3>
                                    
                                    <p class="text-charcoal/60 text-sm font-sans mb-5 leading-relaxed line-clamp-2 max-w-md">
                                        <%= deskripsi || 'Klik untuk melihat detail dokumentasi dan deskripsi lengkap penghargaan ini.' %>
                                    </p>
                                    
                                    <div class="inline-flex items-center text-[9px] uppercase tracking-widest text-deep border-b border-deep/20 pb-1 group-hover/card:border-gold group-hover/card:text-gold transition-all">
                                        Selengkapnya
                                    </div>
                                </a>
                            <% } else { %>
                                <div></div>
                            <% } %>
                        </div>

                    </div>
                <% }) %>
                
                <div class="absolute -bottom-4 left-[24px] md:left-1/2 transform -translate-x-1/2 text-gold/40 bg-paper py-2">
                    <span class="font-crest text-xl">✦</span>
                </div>

            </div>
        <% } else { %>
            <div class="max-w-2xl mx-auto text-center py-32 border border-dashed border-deep/10 bg-sand/10 rounded-sm">
                <span class="font-crest text-4xl text-deep/20 mb-4 block">∅</span>
                <h3 class="font-crest text-xl text-deep mb-2">Arsip Belum Tersedia</h3>
                <p class="font-serif italic text-charcoal/60 text-sm">Halaman prestasi akan segera diperbarui dengan pencapaian terbaru.</p>
            </div>
        <% } %>
    </main>

    <%- include('../partials/footer.ejs') %>

    <script>
        // Initialize Smooth Scroll
        const lenis = new Lenis({ duration: 1.2, easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), direction: 'vertical', smooth: true });
        function raf(time) { lenis.raf(time); requestAnimationFrame(raf); }
        requestAnimationFrame(raf);
    </script>
</body>
</html>