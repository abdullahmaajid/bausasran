<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profil <%= anggota.Nama %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="flex bg-gray-100">

    <%- include('../../partials/user_sidebar.ejs') %>

    <main class="flex-1 p-10">
        <%- include('../../partials/flash.ejs') %>

        <div class="mb-6">
            <a href="/user/anggota" class="text-blue-500 hover:text-blue-700 font-semibold">
                ← Kembali ke Daftar Anggota
            </a>
        </div>

        <div class="bg-white rounded-lg shadow-lg overflow-hidden">
            <div class="md:flex">
                <!-- Foto Profil -->
                <div class="md:w-1/3 bg-gray-200">
                    <% if (anggota.dataValues.fotoFile) { %>
                        <img src="/images/anggota/<%= anggota.dataValues.fotoFile %>" 
                             alt="<%= anggota.Nama %>"
                             class="w-full h-full object-cover">
                    <% } else { %>
                        <div class="w-full h-96 flex items-center justify-center bg-gradient-to-br from-blue-100 to-blue-200">
                            <svg class="w-32 h-32 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"></path>
                            </svg>
                        </div>
                    <% } %>
                </div>

                <!-- Info Profil -->
                <div class="md:w-2/3 p-8">
                    <h1 class="text-3xl font-bold text-gray-800 mb-6"><%= anggota.Nama %></h1>

                    <div class="space-y-4">
                        <div class="border-b pb-4">
                            <p class="text-sm text-gray-600 mb-1">Username</p>
                            <p class="text-lg font-semibold text-gray-800">
                                <%= anggota.username || '-' %>
                            </p>
                        </div>

                        <div class="border-b pb-4">
                            <p class="text-sm text-gray-600 mb-1">Role</p>
                            <span class="inline-block px-3 py-1 rounded-full text-sm font-semibold <%= anggota.role === 'Admin' ? 'bg-red-100 text-red-800' : 'bg-green-100 text-green-800' %>">
                                <%= anggota.Role %>
                            </span>
                        </div>

                        <% if (anggota.Jabatan) { %>
                            <div class="border-b pb-4">
                                <p class="text-sm text-gray-600 mb-1">Jabatan</p>
                                <p class="text-lg text-gray-800">
                                    <%= anggota.Jabatan %>
                                </p>
                            </div>
                        <% } %>

                        <% if (anggota.Deskripsi) { %>
                            <div class="border-b pb-4">
                                <p class="text-sm text-gray-600 mb-1">Deskripsi</p>
                                <p class="text-lg text-gray-800">
                                    <%= anggota.Deskripsi %>
                                </p>
                            </div>
                        <% } %>

                        <!-- <% if (anggota.Usia) { %>
                            <div class="border-b pb-4">
                                <p class="text-sm text-gray-600 mb-1">Usia</p>
                                <p class="text-lg text-gray-800">
                                    <%= anggota.Usia %> tahun
                                </p>
                            </div>
                        <% } %>

                        <% if (anggota.Jenis_Kelamin) { %>
                            <div class="border-b pb-4">
                                <p class="text-sm text-gray-600 mb-1">Jenis Kelamin</p>
                                <p class="text-lg text-gray-800">
                                    <%= anggota.Jenis_Kelamin %>
                                </p>
                            </div>
                        <% } %> -->
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include('../../partials/footer.ejs') %>
</body>
</html>
