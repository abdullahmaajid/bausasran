<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= produk.Nama %> - Bausasran</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <style>
        /* Map Styles */
        #map { height: 400px; width: 100%; border-radius: 0.5rem; z-index: 1; }
        .map-section { background-color: #f8fafc; border-radius: 0.5rem; border: 1px solid #e2e8f0; overflow: hidden; }
        
        /* Parameter Styles */
        .param-item { display: flex; justify-content: space-between; padding: 0.5rem 0; border-bottom: 1px dashed #e2e8f0; font-size: 0.875rem; }
        .param-item:last-child { border-bottom: none; }
        .param-cocok { color: #16a34a; font-weight: 600; }
        .param-tidak-cocok { color: #dc2626; font-weight: 600; }
        
        /* Weather Card Re-use */
        .weather-card { background: white; padding: 1rem; border-radius: 0.5rem; border: 1px solid #e2e8f0; text-align: center; }
        .weather-value { font-size: 1.25rem; font-weight: 700; color: #1f2937; }
        .weather-label { font-size: 0.75rem; color: #6b7280; margin-top: 0.25rem; }
    </style>
</head>
<body class="bg-gray-100">

    <%- include('../partials/navbar.ejs') %>

    <main class="container mx-auto p-6 md:p-12">
        <%- include('../partials/flash.ejs') %>

        <!-- Breadcrumb -->
        <nav class="mb-6 text-sm">
            <ol class="flex items-center space-x-2 text-gray-600">
                <li><a href="/" class="hover:text-blue-600">Home</a></li>
                <li><span class="text-gray-400">/</span></li>
                <li><a href="/produk" class="hover:text-blue-600">Produk</a></li>
                <li><span class="text-gray-400">/</span></li>
                <li class="text-gray-800 font-semibold"><%= produk.Nama %></li>
            </ol>
        </nav>

        <!-- Detail Produk -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
            <!-- Gambar Produk -->
            <div>
                <% if (fotoFiles && fotoFiles.length > 0) { %>
                    <div class="mb-4">
                        <img 
                            id="mainImage"
                            src="/images/produk/<%= fotoFiles[0] %>" 
                            alt="<%= produk.Nama %>" 
                            class="w-full h-96 object-cover rounded-lg shadow-lg"
                            onerror="this.src='https://via.placeholder.com/800x600?text=<%= produk.Nama %>'">
                    </div>
                    <% if (fotoFiles.length > 1) { %>
                        <div class="grid grid-cols-4 gap-2">
                            <% fotoFiles.forEach((foto, index) => { %>
                                <img 
                                    src="/images/produk/<%= foto %>" 
                                    alt="Thumbnail <%= index + 1 %>" 
                                    class="w-full h-24 object-cover rounded-lg cursor-pointer border-2 border-transparent hover:border-blue-500 transition-colors"
                                    onclick="document.getElementById('mainImage').src = this.src"
                                    onerror="this.src='https://via.placeholder.com/200x150?text=<%= index + 1 %>'">
                            <% }) %>
                        </div>
                    <% } %>
                <% } else { %>
                    <div class="w-full h-96 bg-gradient-to-br from-green-400 to-blue-500 rounded-lg shadow-lg flex items-center justify-center">
                        <div class="text-center text-white">
                            <svg class="w-24 h-24 mx-auto mb-4 opacity-70" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"/>
                            </svg>
                            <p class="text-xl font-semibold">Foto produk belum tersedia</p>
                        </div>
                    </div>
                <% } %>
            </div>

            <!-- Info Produk -->
            <div class="bg-white rounded-lg shadow-lg p-8">
                <!-- Kategori & Rating -->
                <div class="flex items-center justify-between mb-4">
                    <% if (produk.Kategori) { %>
                        <span class="inline-block px-3 py-1 rounded-full text-sm font-semibold bg-blue-100 text-blue-800">
                            <%= produk.Kategori %>
                        </span>
                    <% } %>
                    <div class="flex items-center space-x-2">
                        <% const stars = '⭐'.repeat(Math.round(avgRating)); %>
                        <span class="text-lg"><%= stars %></span>
                        <span class="text-sm text-gray-600">(<%= totalReview %> ulasan)</span>
                    </div>
                </div>

                <!-- Nama Produk -->
                <h1 class="text-4xl font-bold text-gray-900 mb-4"><%= produk.Nama %></h1>

                <!-- Harga -->
                <div class="mb-6">
                    <p class="text-4xl font-bold text-green-600 mb-2">
                        Rp <%= new Intl.NumberFormat('id-ID').format(produk.Harga) %>
                    </p>
                    <% if (avgRating >= 4) { %>
                        <span class="inline-block px-3 py-1 bg-yellow-100 text-yellow-800 text-sm font-semibold rounded-full">
                            ⭐ Produk Terlaris
                        </span>
                    <% } %>
                </div>

                <!-- Deskripsi -->
                <div class="mb-6 pb-6 border-b">
                    <h2 class="text-xl font-bold text-gray-800 mb-3">Deskripsi Produk</h2>
                    <% if (produk.Deskripsi) { %>
                        <p class="text-gray-700 leading-relaxed whitespace-pre-line"><%= produk.Deskripsi %></p>
                    <% } else { %>
                        <p class="text-gray-500 italic">Tidak ada deskripsi tersedia.</p>
                    <% } %>
                </div>

                <!-- Kontak / CTA -->
                <div class="space-y-3">
                    <a 
                        href="https://wa.me/62812345678?text=Halo, saya tertarik dengan produk <%= encodeURIComponent(produk.Nama) %>" 
                        target="_blank"
                        class="w-full block text-center bg-green-500 hover:bg-green-600 text-white font-bold py-4 px-6 rounded-lg transition-colors">
                        💬 Hubungi via WhatsApp
                    </a>
                    <% if (currentUser && currentUser.Role === 'User') { %>
                        <a 
                            href="/user/testimoni/tambah" 
                            class="w-full block text-center bg-blue-500 hover:bg-blue-600 text-white font-bold py-4 px-6 rounded-lg transition-colors">
                            ✍️ Tulis Testimoni
                        </a>
                    <% } else if (!currentUser) { %>
                        <a 
                            href="/login?returnTo=/produk/<%= produk.ID_Product %>" 
                            class="w-full block text-center bg-blue-500 hover:bg-blue-600 text-white font-bold py-4 px-6 rounded-lg transition-colors">
                            🔐 Login untuk Memberi Testimoni
                        </a>
                    <% } %>
                    <a 
                        href="/produk" 
                        class="w-full block text-center bg-gray-500 hover:bg-gray-600 text-white font-bold py-4 px-6 rounded-lg transition-colors">
                        ← Kembali ke Produk
                    </a>
                </div>
            </div>
        </div>

        <!-- Section: Simulasi Kecocokan Lahan -->
        <div class="bg-white rounded-lg shadow-lg p-6 md:p-8 mb-8">
            <h2 class="text-2xl font-bold text-gray-800 mb-6 flex items-center">
                <svg class="w-6 h-6 mr-2 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0121 18.382V7.618a1 1 0 01-1.447-.894L15 7m0 13V7m0 0L9 4"></path></svg>
                Simulasi Kecocokan Lahan
            </h2>
            
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Map Column -->
                <div class="lg:col-span-2">
                    <div class="map-section relative">
                        <div id="map"></div>
                        <div id="map-loading" class="absolute inset-0 bg-white/80 z-[1000] flex flex-col items-center justify-center hidden">
                            <svg class="animate-spin h-8 w-8 text-blue-600 mb-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                            <span class="text-sm font-semibold text-gray-600">Menganalisis lokasi...</span>
                        </div>
                    </div>
                    <p class="text-xs text-gray-500 mt-2 italic">* Klik di peta untuk mengecek kecocokan produk ini dengan lahan Anda.</p>
                </div>

                <!-- Analysis Result Column -->
                <div class="lg:col-span-1 flex flex-col">
                     <!-- Live Weather -->
                     <div id="live-weather-container" class="mb-4 hidden">
                         <h4 class="text-sm font-semibold text-gray-700 mb-2">Kondisi Lahan Terpilih:</h4>
                         <div class="grid grid-cols-2 gap-2" id="live-weather-cards">
                             <!-- Will be populated by JS -->
                             <div class="weather-card"><div class="weather-value" id="val-temp">-</div><div class="weather-label">Suhu</div></div>
                             <div class="weather-card"><div class="weather-value" id="val-rain">-</div><div class="weather-label">Hujan</div></div>
                         </div>
                     </div>

                     <!-- Suitability Result -->
                     <div id="analysis-result-container" class="bg-gray-50 rounded-lg p-4 border border-gray-200 flex-grow">
                         <div id="initial-instruction" class="text-center py-6 text-gray-500">
                             <svg class="w-10 h-10 mx-auto text-gray-300 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                             <p class="text-sm">Pilih lokasi pada peta</p>
                         </div>
                         
                         <div id="result-content" class="hidden">
                             <div id="result-badge" class="mb-4 text-center p-2 rounded font-bold text-white bg-gray-400">
                                 Menunggu Analisis...
                             </div>
                             
                             <h4 class="text-xs font-semibold text-gray-600 uppercase tracking-wide mb-2">Detail Parameter</h4>
                             <div id="parameter-detail-list" class="space-y-1">
                                 <!-- List Items Injected Here -->
                             </div>
                         </div>
                     </div>
                </div>
            </div>
        </div>
        
        <!-- Inject Data & Script -->
        <script>
            // Inject single product as array for compatibility or handling
            const productData = JSON.parse(decodeURIComponent('<%- encodeURIComponent(JSON.stringify(produk)) %>'));
            // Override global data expectation for koncoTaniAdmin if needed, or just pass to init
             
             // Define UI Helper for Detail View
             const detailUiFunctions = {
                 showLoadingState: () => {
                     document.getElementById('map-loading').classList.remove('hidden');
                     document.getElementById('result-badge').className = 'mb-4 text-center p-2 rounded font-bold text-white bg-blue-500';
                     document.getElementById('result-badge').textContent = 'Mengambil data...';
                 },
                 hideLoadingState: () => {
                     document.getElementById('map-loading').classList.add('hidden');
                 },
                 updateLiveCards: (current, units) => {
                     document.getElementById('live-weather-container').classList.remove('hidden');
                     document.getElementById('val-temp').innerText = (current.temperature_2m || '-') + (units.temperature_2m || '°C');
                     document.getElementById('val-rain').innerText = (current.precipitation || '0') + (units.precipitation || 'mm');
                 },
                 displayResults: (products, grade, total) => {
                     // In Detail View, 'products' is actually the list passed to runComparison.
                     // Since we only have 1 product, we take index 0.
                     if(!products || products.length === 0) return;
                     const p = products[0];

                     const container = document.getElementById('analysis-result-container');
                     const instruction = document.getElementById('initial-instruction');
                     const content = document.getElementById('result-content');
                     const badge = document.getElementById('result-badge');
                     const paramList = document.getElementById('parameter-detail-list');

                     instruction.classList.add('hidden');
                     content.classList.remove('hidden');

                     // Update Badge
                     // Logic: product.scorePercent vs grade (default 0 or hardcode reasonable threshold?)
                     // Let's assume default passing grade of 50% for visual indication
                     const isCocok = p.scorePercent >= 50; 
                     badge.className = `mb-4 text-center p-2 rounded font-bold text-white ${isCocok ? 'bg-green-500' : 'bg-red-500'}`;
                     badge.innerHTML = `${isCocok ? '✓ Cocok di Lokasi Ini' : '⚠️ Kurang Cocok'} <span class="block text-xs font-normal opacity-90">Kecocokan: ${Math.round(p.scorePercent)}%</span>`;

                     // Update Parameter Table
                     if (p.paramDetails && p.paramDetails.length > 0) {
                         paramList.innerHTML = p.paramDetails.map(param => {
                             const colorClass = param.isCocok ? 'param-cocok' : 'param-tidak-cocok';
                             const icon = param.isCocok ? '✓' : '✕';
                             return `
                                 <div class="param-item">
                                     <span class="flex-1 text-gray-700" title="${param.Nama}">${param.Nama} <span class="text-xs text-gray-400">(${param.Unit||''})</span></span>
                                     <span class="text-xs text-gray-500 mx-2">Opt: ${param.Minimal}-${param.Maksimal}</span>
                                     <span class="${colorClass}">${icon} ${param.actualValue}</span>
                                 </div>`;
                         }).join('');
                     } else {
                         paramList.innerHTML = '<p class="text-sm text-gray-400 italic text-center">Tidak ada parameter spesifik.</p>';
                     }
                 },
                 displayError: (msg) => {
                     alert(msg);
                 }
             };

             // Initialize
             document.addEventListener('DOMContentLoaded', () => {
                 // Hack: koncoTaniAdmin expects 'allProductsData' to exist in global scope to run comparisons
                 window.allProductsData = [productData];
                 
                 // If koncoTaniAdmin is loaded
                 if (typeof window.initKoncoTani === 'function') {
                     window.initKoncoTani(detailUiFunctions);
                 } else {
                     console.error("KoncoTani script not loaded.");
                 }
             });
        </script>
        <script src="/js/koncoTaniAdmin.js"></script>

        <!-- Tab Section (Detail & Testimoni) -->
        <div class="bg-white rounded-lg shadow-lg p-8 mb-8">
            <div class="border-b border-gray-200 mb-6">
                <nav class="flex space-x-8">
                    <button 
                        onclick="switchTab('detail')" 
                        id="tabDetail"
                        class="py-4 px-1 border-b-2 border-blue-500 font-semibold text-blue-600 whitespace-nowrap">
                        Detail Produk
                    </button>
                    <button 
                        onclick="switchTab('testimoni')" 
                        id="tabTestimoni"
                        class="py-4 px-1 border-b-2 border-transparent font-semibold text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap">
                        Testimoni (<%= totalReview %>)
                    </button>
                </nav>
            </div>

            <!-- Tab Content: Detail -->
            <div id="contentDetail" class="tab-content">
                <h3 class="text-2xl font-bold text-gray-800 mb-4">Informasi Produk</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <p class="text-sm text-gray-600 mb-1">Nama Produk</p>
                        <p class="text-lg font-semibold text-gray-900"><%= produk.Nama %></p>
                    </div>
                    <div>
                        <p class="text-sm text-gray-600 mb-1">Harga</p>
                        <p class="text-lg font-semibold text-green-600">Rp <%= new Intl.NumberFormat('id-ID').format(produk.Harga) %></p>
                    </div>
                    <% if (produk.Kategori) { %>
                        <div>
                            <p class="text-sm text-gray-600 mb-1">Kategori</p>
                            <p class="text-lg font-semibold text-gray-900"><%= produk.Kategori %></p>
                        </div>
                    <% } %>
                    <div>
                        <p class="text-sm text-gray-600 mb-1">Rating Rata-rata</p>
                        <p class="text-lg font-semibold text-gray-900"><%= avgRating %>/5 dari <%= totalReview %> ulasan</p>
                    </div>
                </div>
                
                <% if (produk.Deskripsi) { %>
                    <div class="mt-6">
                        <h4 class="text-xl font-bold text-gray-800 mb-3">Deskripsi Lengkap</h4>
                        <div class="prose max-w-none">
                            <p class="text-gray-700 leading-relaxed whitespace-pre-line"><%= produk.Deskripsi %></p>
                        </div>
                    </div>
                <% } %>
            </div>

            <!-- Tab Content: Testimoni -->
            <div id="contentTestimoni" class="tab-content hidden">
                <div class="mb-6">
                    <h3 class="text-2xl font-bold text-gray-800 mb-2">Testimoni Pelanggan</h3>
                    <div class="flex items-center space-x-4">
                        <div class="flex items-center space-x-2">
                            <% const avgStars = '⭐'.repeat(Math.round(avgRating)); %>
                            <span class="text-3xl"><%= avgStars %></span>
                            <span class="text-2xl font-bold text-gray-800"><%= avgRating %></span>
                        </div>
                        <p class="text-gray-600">dari <%= totalReview %> ulasan</p>
                    </div>
                </div>

                <% if (reviewList && reviewList.length > 0) { %>
                    <div class="space-y-4">
                        <% reviewList.forEach(review => { %>
                            <div class="border border-gray-200 rounded-lg p-5 hover:shadow-md transition-shadow">
                                <div class="flex items-start justify-between mb-3">
                                    <div class="flex items-center space-x-3">
                                        <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-purple-600 rounded-full flex items-center justify-center text-white font-bold text-lg">
                                            <%= review.dataValues.pengguna ? review.dataValues.pengguna.Nama.charAt(0).toUpperCase() : '?' %>
                                        </div>
                                        <div>
                                            <p class="font-semibold text-gray-800">
                                                <%= review.dataValues.pengguna ? review.dataValues.pengguna.Nama : 'Anonymous' %>
                                            </p>
                                            <div class="flex items-center mt-1">
                                                <% const reviewStars = '⭐'.repeat(review.Rating); %>
                                                <span class="text-yellow-500"><%= reviewStars %></span>
                                                <span class="text-gray-600 text-sm ml-2"><%= review.Rating %>/5</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <p class="text-gray-700 leading-relaxed"><%= review.Ulasan || 'Tidak ada ulasan tertulis' %></p>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="text-center py-12 bg-gray-50 rounded-lg">
                        <svg class="w-16 h-16 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                        </svg>
                        <p class="text-gray-500 text-lg">Belum ada testimoni untuk produk ini.</p>
                        <% if (currentUser && currentUser.Role === 'User') { %>
                            <a href="/user/testimoni/tambah" class="mt-4 inline-block px-6 py-2 bg-blue-500 hover:bg-blue-600 text-white font-semibold rounded-lg">
                                Jadilah yang Pertama Memberikan Testimoni
                            </a>
                        <% } else if (!currentUser) { %>
                            <a href="/login?returnTo=/produk/<%= produk.ID_Product %>" class="mt-4 inline-block px-6 py-2 bg-green-500 hover:bg-green-600 text-white font-semibold rounded-lg">
                                Login untuk Memberikan Testimoni
                            </a>
                        <% } %>
                    </div>
                <% } %>
            </div>
        </div>
    </main>

    <%- include('../partials/footer.ejs') %>

    <script>
        function switchTab(tabName) {
            // Hide all tab contents
            document.querySelectorAll('.tab-content').forEach(content => {
                content.classList.add('hidden');
            });

            // Remove active classes from all tabs
            document.querySelectorAll('[id^="tab"]').forEach(tab => {
                tab.classList.remove('border-blue-500', 'text-blue-600');
                tab.classList.add('border-transparent', 'text-gray-500');
            });

            // Show selected tab content
            document.getElementById('content' + tabName.charAt(0).toUpperCase() + tabName.slice(1)).classList.remove('hidden');

            // Add active classes to selected tab
            const activeTab = document.getElementById('tab' + tabName.charAt(0).toUpperCase() + tabName.slice(1));
            activeTab.classList.add('border-blue-500', 'text-blue-600');
            activeTab.classList.remove('border-transparent', 'text-gray-500');
        }
    </script>
</body>
</html>
