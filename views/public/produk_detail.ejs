<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= produk.Nama %> - Bausasran</title>
    
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        main: '#003024',    // Background Gelap
                        surface: '#004030', // Warna Kartu
                        accent: '#83C540',  // Hijau Neon
                        pale: '#F5FEF9',    // Teks Putih
                        muted: '#A3C2B8',   // Teks Pudar
                        gold: '#FACC15',    // Warna Bintang
                        danger: '#EF4444',  // Merah Error
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    boxShadow: {
                        'neon': '0 0 15px rgba(131, 197, 64, 0.3)',
                    }
                }
            }
        }
    </script>

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

    <style type="text/tailwindcss">
        @layer base {
            body {
                @apply bg-main text-pale font-sans antialiased;
            }
        }
        /* Custom Map Styles */
        #map { height: 400px; width: 100%; border-radius: 0.75rem; z-index: 1; }
        .map-section { @apply relative rounded-xl overflow-hidden border border-white/10 shadow-lg; }
        
        /* Parameter List Styles */
        .param-item { @apply flex justify-between py-2 border-b border-white/5 text-sm; }
        .param-item:last-child { border-bottom: none; }
        .param-cocok { @apply text-accent font-bold; }
        .param-tidak-cocok { @apply text-danger font-bold; }

        /* Custom Scrollbar for results */
        .custom-scroll::-webkit-scrollbar { width: 6px; }
        .custom-scroll::-webkit-scrollbar-track { background: #003024; }
        .custom-scroll::-webkit-scrollbar-thumb { background: #83C540; border-radius: 3px; }
    </style>
</head>

<body class="flex flex-col min-h-screen">

    <%- include('../partials/navbar.ejs') %>

    <main class="container mx-auto px-4 py-8 flex-grow">
        <%- include('../partials/flash.ejs') %>

        <nav class="flex mb-8 text-sm font-medium" aria-label="Breadcrumb">
            <ol class="inline-flex items-center space-x-1 md:space-x-3">
                <li class="inline-flex items-center">
                    <a href="/" class="text-muted hover:text-accent transition-colors">Home</a>
                </li>
                <li>
                    <div class="flex items-center">
                        <svg class="w-3 h-3 text-muted mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
                        </svg>
                        <a href="/produk" class="text-muted hover:text-accent transition-colors">Produk</a>
                    </div>
                </li>
                <li aria-current="page">
                    <div class="flex items-center">
                        <svg class="w-3 h-3 text-muted mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
                        </svg>
                        <span class="text-accent truncate max-w-[150px] md:max-w-xs"><%= produk.Nama %></span>
                    </div>
                </li>
            </ol>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 mb-12">
            
            <div class="space-y-4">
                <div class="relative bg-surface rounded-2xl overflow-hidden border border-white/5 shadow-neon group">
                    <% if (fotoFiles && fotoFiles.length > 0) { %>
                        <img 
                            id="mainImage"
                            src="/images/produk/<%= fotoFiles[0] %>" 
                            alt="<%= produk.Nama %>" 
                            class="w-full h-[400px] object-cover transition-transform duration-500 group-hover:scale-105"
                            onerror="this.onerror=null;this.src='https://via.placeholder.com/800x600?text=Produk'">
                    <% } else { %>
                        <div class="w-full h-[400px] flex flex-col items-center justify-center bg-surface border border-white/5">
                            <svg class="w-20 h-20 text-muted/30 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                            </svg>
                            <span class="text-muted">Foto belum tersedia</span>
                        </div>
                    <% } %>
                    
                    <% if (produk.Kategori) { %>
                        <div class="absolute top-4 left-4">
                            <span class="px-4 py-1.5 rounded-full bg-main/80 backdrop-blur text-accent text-xs font-bold border border-accent/30">
                                <%= produk.Kategori %>
                            </span>
                        </div>
                    <% } %>
                </div>

                <% if (fotoFiles && fotoFiles.length > 1) { %>
                    <div class="grid grid-cols-4 gap-3">
                        <% fotoFiles.forEach((foto, index) => { %>
                            <div class="aspect-square rounded-lg overflow-hidden border border-white/10 cursor-pointer hover:border-accent transition-all"
                                 onclick="document.getElementById('mainImage').src = '/images/produk/<%= foto %>'">
                                <img src="/images/produk/<%= foto %>" class="w-full h-full object-cover hover:opacity-80 transition-opacity"
                                     onerror="this.onerror=null;this.src='https://via.placeholder.com/150?text=Thumb'">
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </div>

            <div class="flex flex-col justify-center">
                <div class="mb-2 flex items-center space-x-2">
                    <div class="flex text-gold text-lg">
                        <% const stars = '★'.repeat(Math.round(avgRating)); %>
                        <% const emptyStars = '☆'.repeat(5 - Math.round(avgRating)); %>
                        <span><%= stars %></span><span class="text-gray-600"><%= emptyStars %></span>
                    </div>
                    <span class="text-muted text-sm">(<%= totalReview %> ulasan)</span>
                </div>

                <h1 class="text-4xl md:text-5xl font-bold text-pale mb-4 leading-tight"><%= produk.Nama %></h1>

                <div class="flex items-end gap-3 mb-6">
                    <span class="text-3xl font-bold text-accent">Rp <%= new Intl.NumberFormat('id-ID').format(produk.Harga) %></span>
                    <% if (avgRating >= 4.5) { %>
                        <span class="mb-1 px-3 py-0.5 bg-gold/20 text-gold border border-gold/30 rounded text-xs font-bold">
                            BEST SELLER
                        </span>
                    <% } %>
                </div>

                <div class="prose prose-invert max-w-none text-muted mb-8 line-clamp-4">
                    <%= produk.Deskripsi ? produk.Deskripsi : 'Deskripsi belum tersedia.' %>
                </div>

                <div class="space-y-3">
                    <a href="https://wa.me/62812345678?text=Halo, saya tertarik dengan produk <%= encodeURIComponent(produk.Nama) %>" 
                       target="_blank"
                       class="w-full flex items-center justify-center gap-2 py-4 bg-accent hover:bg-white text-main font-bold rounded-xl transition-all duration-300 shadow-neon group">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
                        Hubungi Penjual
                    </a>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <% if (currentUser && currentUser.Role === 'User') { %>
                            <a href="/user/testimoni/tambah" class="py-3 px-4 bg-surface border border-accent/30 hover:border-accent text-accent font-semibold rounded-xl text-center transition-colors">
                                ✍️ Tulis Testimoni
                            </a>
                        <% } else if (!currentUser) { %>
                            <a href="/login?returnTo=/produk/<%= produk.ID_Product %>" class="py-3 px-4 bg-surface border border-white/10 hover:border-white/30 text-muted hover:text-white font-semibold rounded-xl text-center transition-colors">
                                🔐 Login untuk Review
                            </a>
                        <% } %>
                        <a href="/produk" class="py-3 px-4 bg-transparent border border-white/10 hover:bg-white/5 text-muted hover:text-white font-semibold rounded-xl text-center transition-colors">
                            Kembali ke Daftar
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="bg-surface border border-white/10 rounded-2xl p-6 md:p-8 mb-12 shadow-lg">
            <div class="flex items-center mb-6">
                <div class="w-10 h-10 rounded-full bg-accent/20 flex items-center justify-center mr-3">
                    <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0121 18.382V7.618a1 1 0 01-1.447-.894L15 7m0 13V7m0 0L9 4"></path></svg>
                </div>
                <div>
                    <h2 class="text-2xl font-bold text-pale">Simulasi Kecocokan Lahan</h2>
                    <p class="text-sm text-muted">Klik pada peta untuk melihat apakah <%= produk.Nama %> cocok ditanam di lokasi Anda.</p>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <div class="lg:col-span-2">
                    <div class="map-section relative group">
                        <div id="map"></div>
                        <div id="map-loading" class="absolute inset-0 bg-main/80 backdrop-blur-sm z-[1000] flex flex-col items-center justify-center hidden">
                            <svg class="animate-spin h-10 w-10 text-accent mb-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                            <span class="text-sm font-semibold text-accent animate-pulse">Menganalisis Agro-klimat...</span>
                        </div>
                    </div>
                </div>

                <div class="lg:col-span-1 flex flex-col h-full">
                    <div id="live-weather-container" class="mb-4 hidden">
                        <h4 class="text-xs font-bold text-muted uppercase tracking-wider mb-2">Kondisi Saat Ini</h4>
                        <div class="grid grid-cols-2 gap-3" id="live-weather-cards">
                            <div class="bg-main/50 p-3 rounded-lg border border-white/5 text-center">
                                <div class="text-xl font-bold text-pale" id="val-temp">-</div>
                                <div class="text-xs text-muted">Suhu</div>
                            </div>
                            <div class="bg-main/50 p-3 rounded-lg border border-white/5 text-center">
                                <div class="text-xl font-bold text-pale" id="val-rain">-</div>
                                <div class="text-xs text-muted">Curah Hujan</div>
                            </div>
                        </div>
                    </div>

                    <div id="analysis-result-container" class="bg-main/30 border border-white/5 rounded-xl p-5 flex-grow flex flex-col">
                        <div id="initial-instruction" class="flex flex-col items-center justify-center h-full text-center py-8 opacity-50">
                            <svg class="w-12 h-12 text-muted mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                            <p class="text-sm text-muted">Tentukan titik lokasi pada peta</p>
                        </div>
                        
                        <div id="result-content" class="hidden h-full flex flex-col">
                            <div id="result-badge" class="mb-5 text-center p-3 rounded-lg font-bold text-white shadow-lg transition-all">
                                Menunggu...
                            </div>
                            
                            <h4 class="text-xs font-bold text-muted uppercase tracking-wider mb-2 border-b border-white/10 pb-2">Detail Parameter</h4>
                            <div id="parameter-detail-list" class="space-y-1 overflow-y-auto custom-scroll flex-grow pr-1">
                                </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="bg-surface border border-white/10 rounded-2xl overflow-hidden shadow-lg">
            <div class="flex border-b border-white/10">
                <button onclick="switchTab('detail')" id="tabDetail" class="flex-1 py-4 text-center font-bold text-accent border-b-2 border-accent bg-white/5 transition-colors">
                    Detail Produk
                </button>
                <button onclick="switchTab('testimoni')" id="tabTestimoni" class="flex-1 py-4 text-center font-bold text-muted border-b-2 border-transparent hover:text-pale hover:bg-white/5 transition-colors">
                    Testimoni (<%= totalReview %>)
                </button>
            </div>

            <div id="contentDetail" class="p-6 md:p-8 tab-content animate-fade-in">
                <h3 class="text-xl font-bold text-pale mb-6">Spesifikasi Lengkap</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-y-6 gap-x-12 mb-8">
                    <div class="border-b border-white/5 pb-2">
                        <span class="block text-xs text-muted uppercase tracking-wider mb-1">Nama Produk</span>
                        <span class="text-lg text-pale font-medium"><%= produk.Nama %></span>
                    </div>
                    <div class="border-b border-white/5 pb-2">
                        <span class="block text-xs text-muted uppercase tracking-wider mb-1">Harga</span>
                        <span class="text-lg text-accent font-medium">Rp <%= new Intl.NumberFormat('id-ID').format(produk.Harga) %></span>
                    </div>
                    <div class="border-b border-white/5 pb-2">
                        <span class="block text-xs text-muted uppercase tracking-wider mb-1">Kategori</span>
                        <span class="text-lg text-pale font-medium"><%= produk.Kategori || '-' %></span>
                    </div>
                    <div class="border-b border-white/5 pb-2">
                        <span class="block text-xs text-muted uppercase tracking-wider mb-1">Rating</span>
                        <span class="text-lg text-gold font-medium flex items-center">
                            <%= avgRating %> <span class="text-sm text-muted ml-2 font-normal">/ 5.0</span>
                        </span>
                    </div>
                </div>

                <h3 class="text-xl font-bold text-pale mb-4">Deskripsi</h3>
                <div class="prose prose-invert max-w-none text-muted leading-relaxed whitespace-pre-line">
                    <%= produk.Deskripsi || 'Tidak ada deskripsi tambahan.' %>
                </div>
            </div>

            <div id="contentTestimoni" class="p-6 md:p-8 tab-content hidden animate-fade-in">
                <div class="flex items-center justify-between mb-8">
                    <h3 class="text-xl font-bold text-pale">Ulasan Pembeli</h3>
                    <div class="flex items-center bg-main/50 px-4 py-2 rounded-lg border border-white/5">
                        <span class="text-2xl font-bold text-gold mr-2"><%= avgRating %></span>
                        <div class="flex flex-col">
                            <span class="text-xs text-gold">★★★★★</span>
                            <span class="text-xs text-muted"><%= totalReview %> Reviews</span>
                        </div>
                    </div>
                </div>

                <% if (reviewList && reviewList.length > 0) { %>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <% reviewList.forEach(review => { %>
                            <div class="bg-main/40 p-5 rounded-xl border border-white/5 hover:border-accent/30 transition-colors">
                                <div class="flex items-start justify-between mb-3">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-accent to-green-600 flex items-center justify-center text-main font-bold shadow-neon">
                                            <%= review.dataValues.pengguna ? review.dataValues.pengguna.Nama.charAt(0).toUpperCase() : '?' %>
                                        </div>
                                        <div>
                                            <h4 class="text-sm font-bold text-pale">
                                                <%= review.dataValues.pengguna ? review.dataValues.pengguna.Nama : 'Anonymous' %>
                                            </h4>
                                            <div class="flex text-gold text-xs mt-0.5">
                                                <% for(let i=1; i<=5; i++) { %>
                                                    <%= i <= review.Rating ? '★' : '☆' %>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                    <span class="text-xs text-muted"><%= review.createdAt ? new Date(review.createdAt).toLocaleDateString() : '' %></span>
                                </div>
                                <p class="text-muted text-sm leading-relaxed italic">"<%= review.Ulasan || 'Tidak ada komentar.' %>"</p>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="text-center py-12 border-2 border-dashed border-white/10 rounded-xl">
                        <svg class="w-16 h-16 mx-auto text-muted/30 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
                        <p class="text-muted mb-4">Belum ada ulasan untuk produk ini.</p>
                        <% if (currentUser && currentUser.Role === 'User') { %>
                            <a href="/user/testimoni/tambah" class="text-accent hover:underline text-sm font-semibold">Jadilah yang pertama mereview!</a>
                        <% } %>
                    </div>
                <% } %>
            </div>
        </div>

    </main>

    <%- include('../partials/footer.ejs') %>

    <script>
        // Tab Switching Logic
        function switchTab(tabName) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('[id^="tab"]').forEach(el => {
                el.classList.remove('text-accent', 'border-accent', 'bg-white/5');
                el.classList.add('text-muted', 'border-transparent');
            });

            const contentId = 'content' + tabName.charAt(0).toUpperCase() + tabName.slice(1);
            document.getElementById(contentId).classList.remove('hidden');

            const tabId = 'tab' + tabName.charAt(0).toUpperCase() + tabName.slice(1);
            const activeTab = document.getElementById(tabId);
            activeTab.classList.remove('text-muted', 'border-transparent');
            activeTab.classList.add('text-accent', 'border-accent', 'bg-white/5');
        }

        // KoncoTani / Map Integration
        const productData = JSON.parse(decodeURIComponent('<%- encodeURIComponent(JSON.stringify(produk)) %>'));

        // UI Helpers Object matching KoncoTani Admin requirement
        const detailUiFunctions = {
            showLoadingState: () => {
                document.getElementById('map-loading').classList.remove('hidden');
                const badge = document.getElementById('result-badge');
                badge.className = 'mb-5 text-center p-3 rounded-lg font-bold text-white bg-blue-500/80 animate-pulse';
                badge.textContent = 'Mengambil data satelit...';
            },
            hideLoadingState: () => {
                document.getElementById('map-loading').classList.add('hidden');
            },
            updateLiveCards: (current, units) => {
                document.getElementById('live-weather-container').classList.remove('hidden');
                document.getElementById('val-temp').innerText = (current.temperature_2m || '-') + (units.temperature_2m || '°C');
                document.getElementById('val-rain').innerText = (current.precipitation || '0') + (units.precipitation || 'mm');
            },
            displayResults: (products, grade, total) => {
                if(!products || products.length === 0) return;
                const p = products[0]; // Only 1 product in detail view

                const container = document.getElementById('analysis-result-container');
                const instruction = document.getElementById('initial-instruction');
                const content = document.getElementById('result-content');
                const badge = document.getElementById('result-badge');
                const paramList = document.getElementById('parameter-detail-list');

                instruction.classList.add('hidden');
                content.classList.remove('hidden');

                // Logic Badge Style
                const isCocok = p.scorePercent >= 50; 
                badge.className = `mb-5 text-center p-3 rounded-lg font-bold text-main border ${isCocok ? 'bg-accent border-accent shadow-neon' : 'bg-danger border-danger shadow-lg'}`;
                badge.innerHTML = `
                    <div class="text-lg">${isCocok ? '✓ Lahan Cocok' : '⚠️ Kurang Cocok'}</div>
                    <div class="text-xs font-normal opacity-90 mt-1">Kecocokan: ${Math.round(p.scorePercent)}%</div>
                `;

                // Render List
                if (p.paramDetails && p.paramDetails.length > 0) {
                    paramList.innerHTML = p.paramDetails.map(param => {
                        const icon = param.isCocok ? 
                            '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>' : 
                            '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>';
                        
                        const colorClass = param.isCocok ? 'text-accent' : 'text-danger';
                        
                        return `
                            <div class="param-item">
                                <div class="flex flex-col">
                                    <span class="text-pale font-medium">${param.Nama}</span>
                                    <span class="text-xs text-muted">Range: ${param.Minimal} - ${param.Maksimal} ${param.Unit||''}</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="text-white font-mono bg-white/10 px-2 py-0.5 rounded text-xs">${param.actualValue}</span>
                                    <span class="${colorClass}">${icon}</span>
                                </div>
                            </div>`;
                    }).join('');
                } else {
                    paramList.innerHTML = '<p class="text-sm text-muted italic text-center py-4">Tidak ada parameter spesifik untuk produk ini.</p>';
                }
            },
            displayError: (msg) => {
                alert("Error: " + msg);
            }
        };

        document.addEventListener('DOMContentLoaded', () => {
            // Setup global data for external script logic
            window.allProductsData = [productData];
            
            // Check logic availability
            if (typeof window.initKoncoTani === 'function') {
                window.initKoncoTani(detailUiFunctions);
            } else {
                console.warn("Script KoncoTani belum termuat atau error.");
            }
        });
    </script>
    
    <script src="/js/koncoTaniAdmin.js"></script>

</body>
</html>