<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard User - Bausasran</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        main: '#003024',    // Background Gelap
                        surface: '#004030', // Warna Kartu
                        accent: '#83C540',  // Hijau Neon
                        pale: '#F5FEF9',    // Teks Putih
                        muted: '#A3C2B8',   // Teks Pudar
                    },
                    fontFamily: { sans: ['Inter', 'sans-serif'] }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer base { 
            body { @apply bg-main text-pale font-sans antialiased; } 
            /* Custom Scrollbar untuk area konten */
            .custom-scroll::-webkit-scrollbar { width: 8px; }
            .custom-scroll::-webkit-scrollbar-track { @apply bg-main; }
            .custom-scroll::-webkit-scrollbar-thumb { @apply bg-surface border border-white/10 rounded-full; }
        }
    </style>
</head>

<body class="flex h-screen overflow-hidden">

    <%- include('../partials/user_sidebar.ejs') %>

    <main class="flex-1 overflow-y-auto custom-scroll p-6 md:p-10 relative">
        
        <div class="fixed top-0 right-0 w-[500px] h-[500px] bg-accent/5 rounded-full blur-[100px] pointer-events-none -z-10"></div>

        <%- include('../partials/flash.ejs') %>

        <div class="mb-10 flex flex-col md:flex-row md:items-end justify-between gap-4">
            <div>
                <h1 class="text-3xl md:text-4xl font-bold text-pale mb-2">
                    Dashboard <span class="text-accent">Overview</span>
                </h1>
                <p class="text-muted text-lg">
                    Selamat datang kembali, <span class="font-bold text-white"><%= currentUser.Nama %></span>!
                </p>
            </div>
            <div class="text-sm text-muted bg-surface/50 px-4 py-2 rounded-lg border border-white/5">
                <%= new Date().toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
            
            <div class="bg-surface border border-white/5 rounded-2xl p-6 shadow-lg hover:border-accent/30 transition-all duration-300 group">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <p class="text-sm font-medium text-muted uppercase tracking-wider">Total Anggota</p>
                        <p class="text-3xl font-bold text-white mt-1 group-hover:text-accent transition-colors"><%= stats.totalAnggota %></p>
                    </div>
                    <div class="p-3 bg-blue-500/10 rounded-xl border border-blue-500/20">
                        <svg class="w-8 h-8 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                    </div>
                </div>
                <a href="/user/anggota" class="text-sm text-muted hover:text-white flex items-center transition-colors">
                    Lihat Direktori <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                </a>
            </div>

            <div class="bg-surface border border-white/5 rounded-2xl p-6 shadow-lg hover:border-accent/30 transition-all duration-300 group">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <p class="text-sm font-medium text-muted uppercase tracking-wider">Produk UMKM</p>
                        <p class="text-3xl font-bold text-white mt-1 group-hover:text-accent transition-colors"><%= stats.totalProduk %></p>
                    </div>
                    <div class="p-3 bg-accent/10 rounded-xl border border-accent/20">
                        <svg class="w-8 h-8 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
                    </div>
                </div>
                <a href="/user/produk" class="text-sm text-muted hover:text-white flex items-center transition-colors">
                    Lihat Katalog <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                </a>
            </div>

            <div class="bg-surface border border-white/5 rounded-2xl p-6 shadow-lg hover:border-accent/30 transition-all duration-300 group">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <p class="text-sm font-medium text-muted uppercase tracking-wider">Kegiatan</p>
                        <p class="text-3xl font-bold text-white mt-1 group-hover:text-accent transition-colors"><%= stats.totalKegiatan %></p>
                    </div>
                    <div class="p-3 bg-yellow-500/10 rounded-xl border border-yellow-500/20">
                        <svg class="w-8 h-8 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    </div>
                </div>
                <a href="/user/kegiatan" class="text-sm text-muted hover:text-white flex items-center transition-colors">
                    Lihat Agenda <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                </a>
            </div>

            <div class="bg-surface border border-white/5 rounded-2xl p-6 shadow-lg hover:border-accent/30 transition-all duration-300 group">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <p class="text-sm font-medium text-muted uppercase tracking-wider">Prestasi</p>
                        <p class="text-3xl font-bold text-white mt-1 group-hover:text-accent transition-colors"><%= stats.totalPrestasi %></p>
                    </div>
                    <div class="p-3 bg-purple-500/10 rounded-xl border border-purple-500/20">
                        <svg class="w-8 h-8 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path></svg>
                    </div>
                </div>
                <a href="/user/prestasi" class="text-sm text-muted hover:text-white flex items-center transition-colors">
                    Lihat Pencapaian <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                </a>
            </div>

            <div class="bg-surface border border-white/5 rounded-2xl p-6 shadow-lg hover:border-accent/30 transition-all duration-300 group">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <p class="text-sm font-medium text-muted uppercase tracking-wider">Album Galeri</p>
                        <p class="text-3xl font-bold text-white mt-1 group-hover:text-accent transition-colors"><%= stats.totalGaleri %></p>
                    </div>
                    <div class="p-3 bg-pink-500/10 rounded-xl border border-pink-500/20">
                        <svg class="w-8 h-8 text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    </div>
                </div>
                <a href="/user/galeri" class="text-sm text-muted hover:text-white flex items-center transition-colors">
                    Lihat Foto <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                </a>
            </div>

            <div class="bg-surface border border-white/5 rounded-2xl p-6 shadow-lg hover:border-accent/30 transition-all duration-300 group">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <p class="text-sm font-medium text-muted uppercase tracking-wider">Testimoni Saya</p>
                        <p class="text-3xl font-bold text-white mt-1 group-hover:text-accent transition-colors"><%= stats.totalTestimoniSaya %></p>
                    </div>
                    <div class="p-3 bg-red-500/10 rounded-xl border border-red-500/20">
                        <svg class="w-8 h-8 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
                    </div>
                </div>
                <a href="/user/testimoni" class="text-sm text-muted hover:text-white flex items-center transition-colors">
                    Kelola Ulasan <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                </a>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-10">
            
            <div class="bg-surface border border-white/5 rounded-2xl p-6 shadow-lg flex flex-col h-full">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-xl font-bold text-pale flex items-center">
                        <span class="w-2 h-6 bg-accent rounded-full mr-3"></span>
                        Kegiatan Terbaru
                    </h2>
                    <a href="/user/kegiatan" class="text-xs font-bold text-accent hover:text-white transition-colors uppercase tracking-wider">Lihat Semua</a>
                </div>
                
                <% if (kegiatanTerbaru && kegiatanTerbaru.length > 0) { %>
                    <div class="space-y-3 flex-grow">
                        <% kegiatanTerbaru.forEach(kegiatan => { %>
                            <div class="flex items-center justify-between p-4 bg-black/20 rounded-xl border border-white/5 hover:border-accent/30 transition-all">
                                <div class="flex-1">
                                    <a href="/user/kegiatan/<%= kegiatan.ID_Kegiatan %>" class="font-bold text-pale hover:text-accent transition-colors block mb-1">
                                        <%= kegiatan.Judul %>
                                    </a>
                                    <div class="flex items-center text-xs text-muted">
                                        <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                        <%= new Date(kegiatan.Tanggal).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                                    </div>
                                </div>
                                <span class="ml-4 px-3 py-1 text-[10px] font-bold uppercase rounded-full border 
                                    <%= kegiatan.Status === 'Upcoming' ? 'bg-accent/10 text-accent border-accent/20' : 'bg-white/5 text-muted border-white/10' %>">
                                    <%= kegiatan.Status === 'Upcoming' ? 'Akan Datang' : 'Selesai' %>
                                </span>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="flex flex-col items-center justify-center h-48 border-2 border-dashed border-white/5 rounded-xl text-muted">
                        <p>Belum ada kegiatan terbaru.</p>
                    </div>
                <% } %>
            </div>

            <div class="bg-surface border border-white/5 rounded-2xl p-6 shadow-lg flex flex-col h-full">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-xl font-bold text-pale flex items-center">
                        <span class="w-2 h-6 bg-blue-500 rounded-full mr-3"></span>
                        Produk Terbaru
                    </h2>
                    <a href="/user/produk" class="text-xs font-bold text-blue-400 hover:text-white transition-colors uppercase tracking-wider">Lihat Semua</a>
                </div>
                
                <% if (produkTerbaru && produkTerbaru.length > 0) { %>
                    <div class="space-y-3 flex-grow">
                        <% produkTerbaru.forEach(produk => { %>
                            <div class="flex items-center justify-between p-4 bg-black/20 rounded-xl border border-white/5 hover:border-blue-500/30 transition-all">
                                <div class="flex-1">
                                    <a href="/user/produk/<%= produk.ID_Product %>" class="font-bold text-pale hover:text-blue-400 transition-colors block mb-1">
                                        <%= produk.Nama %>
                                    </a>
                                    <p class="text-sm font-bold text-accent">
                                        Rp <%= produk.Harga.toLocaleString('id-ID') %>
                                    </p>
                                </div>
                                <div class="w-8 h-8 bg-blue-500/10 rounded-full flex items-center justify-center text-blue-400">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <div class="flex flex-col items-center justify-center h-48 border-2 border-dashed border-white/5 rounded-xl text-muted">
                        <p>Belum ada produk terbaru.</p>
                    </div>
                <% } %>
            </div>
        </div>

        <div class="bg-surface border border-white/5 rounded-2xl p-6 shadow-lg mb-8">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-xl font-bold text-pale flex items-center">
                    <span class="w-2 h-6 bg-red-500 rounded-full mr-3"></span>
                    Testimoni Saya
                </h2>
                <a href="/user/testimoni/tambah" class="px-4 py-2 bg-accent text-main font-bold text-sm rounded-lg hover:bg-white transition-all shadow-lg hover:shadow-accent/20">
                    + Tambah Testimoni
                </a>
            </div>
            
            <% if (testimoniSaya && testimoniSaya.length > 0) { %>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <% testimoniSaya.forEach(testimoni => { %>
                        <div class="p-5 bg-black/20 rounded-xl border border-white/5 hover:border-white/20 transition-all group">
                            <div class="flex items-center justify-between mb-3">
                                <div class="flex gap-2">
                                    <% if (testimoni.Rating) { %>
                                        <span class="px-2 py-1 text-[10px] font-bold uppercase rounded-md bg-green-500/10 text-green-400 border border-green-500/20">
                                            ✓ Positif
                                        </span>
                                    <% } else { %>
                                        <span class="px-2 py-1 text-[10px] font-bold uppercase rounded-md bg-red-500/10 text-red-400 border border-red-500/20">
                                            ✗ Negatif
                                        </span>
                                    <% } %>
                                    
                                    <span class="px-2 py-1 text-[10px] font-bold uppercase rounded-md border border-white/10 text-muted bg-white/5">
                                        <%= testimoni.Kategori %>
                                    </span>
                                </div>
                                <div class="flex space-x-3 opacity-50 group-hover:opacity-100 transition-opacity">
                                    <a href="/user/testimoni/edit/<%= testimoni.ID_Review %>" class="text-xs text-blue-400 hover:text-white">Edit</a>
                                    <span class="text-white/10">|</span>
                                    <a href="/user/testimoni" class="text-xs text-muted hover:text-white">Detail</a>
                                </div>
                            </div>
                            
                            <p class="text-muted text-sm italic leading-relaxed border-l-2 border-white/10 pl-3">
                                "<%= testimoni.Ulasan && testimoni.Ulasan.length > 100 ? testimoni.Ulasan.substring(0, 100) + '...' : (testimoni.Ulasan || 'Tidak ada ulasan') %>"
                            </p>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="text-center py-10 border-2 border-dashed border-white/5 rounded-xl bg-white/5">
                    <svg class="w-12 h-12 text-muted/30 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
                    <p class="text-muted mb-4">Anda belum membagikan pengalaman Anda.</p>
                    <a href="/user/testimoni/tambah" class="inline-block px-5 py-2.5 bg-white/10 border border-white/10 text-pale text-sm font-bold rounded-lg hover:bg-accent hover:text-main transition-all">
                        Buat Testimoni Pertama
                    </a>
                </div>
            <% } %>
        </div>

        <div class="text-center pt-8 pb-4 text-xs text-muted/40 border-t border-white/5">
            &copy; <%= new Date().getFullYear() %> Kampung Wisata Bausasran. All rights reserved.
        </div>

    </main>
</body>
</html>