<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Galeri - Bausasran</title>
    
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        main: '#003024',    // Background Gelap
                        surface: '#004030', // Warna Kartu
                        accent: '#83C540',  // Hijau Neon
                        pale: '#F5FEF9',    // Teks Putih
                        muted: '#A3C2B8',   // Teks Pudar
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style type="text/tailwindcss">
        @layer base {
            body {
                @apply bg-main text-pale font-sans antialiased;
            }
        }
        .no-scroll {
            overflow: hidden;
        }
    </style>
</head>

<body class="flex flex-col min-h-screen">

    <%- include('../partials/navbar.ejs') %>

    <main class="container mx-auto px-4 py-12 flex-grow">
        <%- include('../partials/flash.ejs') %>

        <div class="text-center mb-12">
            <h1 class="text-4xl md:text-5xl font-bold text-pale mb-4">
                Galeri <span class="text-accent">Foto</span>
            </h1>
            <p class="text-lg text-muted max-w-2xl mx-auto">
                Dokumentasi kegiatan, produk, dan momen berharga di Kampung Wisata Bausasran.
            </p>
        </div>

        <% if(groupFotoList && groupFotoList.length > 0) { %>
            <div class="flex flex-wrap justify-center mb-10 gap-3">
                <button onclick="filterGaleri('all')" id="btn-all" 
                    class="filter-btn active px-6 py-2.5 rounded-full text-sm font-bold border border-accent bg-accent text-main transition-all duration-300 shadow-[0_0_15px_rgba(131,197,64,0.3)]">
                    Semua
                </button>
                <% groupFotoList.forEach(group => { %>
                    <button onclick="filterGaleri('<%= group.ID_GroupFoto %>')" id="btn-<%= group.ID_GroupFoto %>"
                        class="filter-btn px-6 py-2.5 rounded-full text-sm font-bold border border-white/10 text-muted hover:border-accent hover:text-pale bg-surface transition-all duration-300">
                        <%= group.Nama %>
                    </button>
                <% }) %>
            </div>
        <% } %>

        <% if(fotoList && fotoList.length > 0) { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
                <% fotoList.forEach((foto, index) => { %>
                    <% 
                    // Logika Server Side (EJS)
                    let folder = 'anggota'; // Default fallback
                    // Cek apakah ada di dataValues (Sequelize instance) atau properti langsung
                    const kName = (foto.dataValues && foto.dataValues.kategoriName) ? foto.dataValues.kategoriName : (foto.kategoriName || '');
                    
                    if (kName) {
                        const kategori = kName.toLowerCase();
                        if (kategori.includes('kegiatan')) folder = 'kegiatan';
                        else if (kategori.includes('produk')) folder = 'produk';
                        else if (kategori.includes('galeri')) folder = 'galeri';
                        else if (kategori.includes('prestasi')) folder = 'prestasi';
                    }
                    
                    // Ambil nama file
                    const fileName = (foto.dataValues && foto.dataValues.Foto) ? foto.dataValues.Foto : foto.Foto;
                    const deskripsi = (foto.dataValues && foto.dataValues.Deskripsi) ? foto.dataValues.Deskripsi : foto.Deskripsi;
                    const tanggal = (foto.dataValues && foto.dataValues.Tanggal) ? foto.dataValues.Tanggal : foto.Tanggal;
                    %>
                    
                    <div class="galeri-item group relative aspect-[4/3] bg-surface rounded-2xl overflow-hidden shadow-lg border border-white/5 cursor-pointer hover:shadow-accent/20 transition-all duration-500" 
                         data-category="<%= foto.ID_GroupFoto || (foto.dataValues && foto.dataValues.ID_GroupFoto) %>"
                         data-index="<%= index %>"
                         onclick="openLightbox(this.dataset.index)">
                        
                        <img src="/images/<%= folder %>/<%= fileName %>" 
                             alt="<%= kName || 'Foto' %>" 
                             loading="lazy"
                             class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                             onerror="this.onerror=null;this.src='https://via.placeholder.com/400x300?text=Gambar+Rusak'">
                        
                        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-6">
                            
                            <% if (kName) { %>
                                <span class="absolute top-4 left-4 px-3 py-1 bg-accent/90 text-main text-xs font-bold rounded-lg backdrop-blur-sm transform -translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500 delay-100">
                                    <%= kName %>
                                </span>
                            <% } %>

                            <div class="transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                                <h3 class="text-white font-bold text-lg leading-tight mb-1">
                                    <%= deskripsi ? (deskripsi.length > 30 ? deskripsi.substring(0, 30) + '...' : deskripsi) : 'Dokumentasi' %>
                                </h3>
                                <% if (tanggal) { %>
                                    <p class="text-accent text-xs font-medium">
                                        <%= new Date(tanggal).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                                    </p>
                                <% } %>
                            </div>
                        </div>

                        <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none">
                            <div class="bg-white/10 backdrop-blur-md p-3 rounded-full border border-white/20">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
                                </svg>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="text-center py-20 border-2 border-dashed border-white/10 rounded-2xl bg-surface/30">
                <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-white/5 mb-6 text-muted">
                    <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                </div>
                <h3 class="text-xl font-semibold text-pale mb-2">Belum Ada Foto</h3>
                <p class="text-muted">Galeri foto akan segera diperbarui.</p>
            </div>
        <% } %>
    </main>

    <%- include('../partials/footer.ejs') %>

    <div id="lightbox" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/95 backdrop-blur-xl opacity-0 transition-opacity duration-300" onclick="closeLightbox()">
        
        <div class="absolute top-0 left-0 w-full p-4 flex justify-between items-center z-20 bg-gradient-to-b from-black/80 to-transparent">
            <span id="lightbox-counter" class="text-muted text-sm font-mono ml-2">1 / 10</span>
            <button onclick="closeLightbox()" class="text-white hover:text-accent p-2 rounded-full hover:bg-white/10 transition-colors cursor-pointer">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <div class="relative max-w-6xl w-full mx-4 h-full max-h-[85vh] flex flex-col items-center justify-center" onclick="event.stopPropagation()">
            
            <img id="lightbox-img" src="" alt="" 
                 class="max-w-full max-h-[70vh] md:max-h-[80vh] object-contain shadow-2xl rounded-lg border border-white/10"
                 onerror="this.onerror=null;this.src='https://via.placeholder.com/800x600?text=Foto+Tidak+Ditemukan'">
            
            <div class="mt-4 text-center max-w-2xl px-4">
                <h3 id="lightbox-desc" class="text-xl font-bold text-pale mb-1"></h3>
                <p id="lightbox-date" class="text-accent text-sm"></p>
            </div>

            <button onclick="navigateLightbox(-1); event.stopPropagation()" class="absolute left-2 md:-left-12 top-1/2 transform -translate-y-1/2 text-white hover:text-accent p-3 rounded-full bg-black/50 hover:bg-white/10 transition-all border border-white/10 cursor-pointer">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            </button>
            <button onclick="navigateLightbox(1); event.stopPropagation()" class="absolute right-2 md:-right-12 top-1/2 transform -translate-y-1/2 text-white hover:text-accent p-3 rounded-full bg-black/50 hover:bg-white/10 transition-all border border-white/10 cursor-pointer">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </button>
        </div>
    </div>

    <script type="application/json" id="foto-data">
        <%- JSON.stringify(fotoList || []) %>
    </script>

    <script>
        let currentImageIndex = 0;
        let fotoData = [];
        
        // Parse data from JSON safely
        try {
            const dataElement = document.getElementById('foto-data');
            if (dataElement && dataElement.textContent) {
                fotoData = JSON.parse(dataElement.textContent);
            }
        } catch (e) {
            console.error('Error parsing foto data:', e);
        }

        // --- FILTER FUNCTION ---
        function filterGaleri(category) {
            const items = document.querySelectorAll('.galeri-item');
            const buttons = document.querySelectorAll('.filter-btn');
            
            // Update Button Styles
            buttons.forEach(btn => {
                btn.classList.remove('bg-accent', 'text-main', 'border-accent', 'shadow-[0_0_15px_rgba(131,197,64,0.3)]');
                btn.classList.add('bg-surface', 'text-muted', 'border-white/10');
            });

            // Set Active Style
            const activeBtnID = category === 'all' ? 'btn-all' : `btn-${category}`;
            const activeBtn = document.getElementById(activeBtnID);
            if(activeBtn) {
                activeBtn.classList.remove('bg-surface', 'text-muted', 'border-white/10');
                activeBtn.classList.add('bg-accent', 'text-main', 'border-accent', 'shadow-[0_0_15px_rgba(131,197,64,0.3)]');
            }
            
            // Filter Items
            items.forEach(item => {
                if (category === 'all' || item.dataset.category === category) {
                    item.classList.remove('hidden');
                    // Reset animation
                    item.style.animation = 'none';
                    item.offsetHeight; /* trigger reflow */
                    item.style.animation = null; 
                    
                    item.animate([
                        { opacity: 0, transform: 'scale(0.95)' },
                        { opacity: 1, transform: 'scale(1)' }
                    ], { duration: 300, fill: 'forwards' });
                } else {
                    item.classList.add('hidden');
                }
            });
        }

        // --- LIGHTBOX FUNCTIONS ---
        const lightbox = document.getElementById('lightbox');
        const img = document.getElementById('lightbox-img');

        function openLightbox(index) {
            currentImageIndex = parseInt(index);
            updateLightboxContent();
            
            lightbox.classList.remove('hidden', 'opacity-0');
            lightbox.classList.add('flex', 'opacity-100');
            document.body.classList.add('no-scroll');
        }

        function closeLightbox() {
            lightbox.classList.add('opacity-0');
            setTimeout(() => {
                lightbox.classList.add('hidden');
                lightbox.classList.remove('flex');
                img.src = ""; // Clear src to stop loading
            }, 300);
            document.body.classList.remove('no-scroll');
        }

        function navigateLightbox(direction) {
            currentImageIndex = (currentImageIndex + direction + fotoData.length) % fotoData.length;
            updateLightboxContent();
        }

        function updateLightboxContent() {
            if (!fotoData || fotoData.length === 0) return;
            
            const foto = fotoData[currentImageIndex];
            
            // --- PERBAIKAN LOGIKA DISINI ---
            // Cek properti langsung (setelah JSON.stringify) ATAU dataValues (jika ada)
            let rawKategori = foto.kategoriName || (foto.dataValues ? foto.dataValues.kategoriName : '');
            let rawFoto = foto.Foto || (foto.dataValues ? foto.dataValues.Foto : '');
            let rawDeskripsi = foto.Deskripsi || (foto.dataValues ? foto.dataValues.Deskripsi : 'Dokumentasi');
            let rawTanggal = foto.Tanggal || (foto.dataValues ? foto.dataValues.Tanggal : null);

            // Tentukan folder
            let folder = 'anggota'; // Default
            if (rawKategori) {
                const k = rawKategori.toLowerCase();
                if (k.includes('kegiatan')) folder = 'kegiatan';
                else if (k.includes('produk')) folder = 'produk';
                else if (k.includes('galeri')) folder = 'galeri';
            }
            
            // Update Image
            img.style.opacity = '0.5';
            
            // Pastikan path image benar
            const finalSrc = `/images/${folder}/${rawFoto}`;
            img.src = finalSrc;
            
            // Efek smooth saat gambar load
            img.onload = () => { img.style.opacity = '1'; };
            
            // Fallback jika error (handled juga di HTML tag onerror)
            img.onerror = () => { 
                console.log("Gagal memuat:", finalSrc);
                img.style.opacity = '1'; 
            };

            // Update Texts
            document.getElementById('lightbox-desc').textContent = rawDeskripsi;
            
            if (rawTanggal) {
                const date = new Date(rawTanggal).toLocaleDateString('id-ID', { 
                    year: 'numeric', month: 'long', day: 'numeric' 
                });
                document.getElementById('lightbox-date').textContent = date;
            } else {
                document.getElementById('lightbox-date').textContent = '';
            }

            // Update Counter
            document.getElementById('lightbox-counter').textContent = `${currentImageIndex + 1} / ${fotoData.length}`;
        }

        // Keyboard Listener
        document.addEventListener('keydown', function(e) {
            if (!lightbox.classList.contains('hidden')) {
                if (e.key === 'ArrowLeft') navigateLightbox(-1);
                if (e.key === 'ArrowRight') navigateLightbox(1);
                if (e.key === 'Escape') closeLightbox();
            }
        });
    </script>

</body>
</html>