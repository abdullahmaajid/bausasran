<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kampung Wisata Bausasran</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        // Background Utama (Deep Forest)
                        'main': '#003024',
                        
                        // Warna Card/Container (Dark Moss)
                        'card': '#004030',
                        
                        // Warna Heading/Aksen/Tombol (Lime Shoot)
                        'accent': '#83C540',
                        'accent-hover': '#6DA830', // Versi agak gelap buat hover
                        
                        // Warna Teks (Ice White)
                        'text': '#F5FEF9',
                        
                        // Warna Teks Sekunder (Untuk deskripsi pudar)
                        'text-muted': '#A3C2B8',
                    },
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    },
                    boxShadow: {
                        'glow': '0 0 15px rgba(131, 197, 64, 0.3)', // Efek glow hijau
                    }
                }
            }
        }
    </script>

    <style type="text/tailwindcss">
        @layer base {
            body {
                @apply bg-main text-text font-sans antialiased;
            }
            /* Styling Scrollbar biar senada */
            ::-webkit-scrollbar {
                width: 8px;
            }
            ::-webkit-scrollbar-track {
                @apply bg-main;
            }
            ::-webkit-scrollbar-thumb {
                @apply bg-card rounded-full border border-main;
            }
            ::-webkit-scrollbar-thumb:hover {
                @apply bg-accent;
            }
        }

        @layer components {
            /* Gunakan class 'btn-primary' di tombol mana aja 
               biar gak ngetik panjang-panjang 
            */
            .btn-primary {
                @apply bg-accent text-main font-bold py-2 px-6 rounded-lg transition-all duration-300 hover:bg-accent-hover hover:shadow-glow hover:-translate-y-0.5;
            }

            /* Gunakan class 'card-style' untuk kotak konten 
            */
            .card-style {
                @apply bg-card border border-white/5 rounded-xl p-6 shadow-lg hover:border-accent/30 transition-colors duration-300;
            }
        }
    </style>
</head>

<body class="flex flex-col min-h-screen">
    
    <nav class="sticky top-0 z-50 bg-main/90 backdrop-blur-md border-b border-white/10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <div class="flex-shrink-0">
                    <span class="text-xl font-bold text-accent tracking-wide">BAUSASRAN</span>
                </div>
                <div class="hidden md:block">
                    <div class="ml-10 flex items-baseline space-x-4">
                        <a href="/" class="text-text hover:text-accent px-3 py-2 rounded-md text-sm font-medium transition-colors">Beranda</a>
                        <a href="/produk" class="text-text hover:text-accent px-3 py-2 rounded-md text-sm font-medium transition-colors">Tanaman</a>
                        <a href="/kegiatan" class="text-text hover:text-accent px-3 py-2 rounded-md text-sm font-medium transition-colors">Kegiatan</a>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <main class="flex-grow container mx-auto px-4 py-8">
        <%- body %>
    </main>

    <footer class="bg-card border-t border-white/5 mt-auto">
        <div class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
            <p class="text-center text-text-muted text-sm">
                &copy; 2024 Kampung Wisata Gemah Ripah Bausasran.
            </p>
        </div>
    </footer>

</body>
</html>