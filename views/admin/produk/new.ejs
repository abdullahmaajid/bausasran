<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tambah Produk Baru - Admin Bausasran</title>
    
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        main: '#003024',    // Background Gelap
                        surface: '#004030', // Warna Kartu
                        accent: '#83C540',  // Hijau Neon
                        pale: '#F5FEF9',    // Teks Putih
                        muted: '#A3C2B8',   // Teks Pudar
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style type="text/tailwindcss">
        @layer base {
            body { @apply bg-main text-pale font-sans antialiased; }
        }
        
        /* Custom Scrollbar */
        .custom-scroll::-webkit-scrollbar { width: 6px; }
        .custom-scroll::-webkit-scrollbar-track { background: transparent; }
        .custom-scroll::-webkit-scrollbar-thumb { background: #004030; border-radius: 10px; border: 1px solid rgba(255,255,255,0.1); }
        .custom-scroll::-webkit-scrollbar-thumb:hover { background: #83C540; }

        /* Input Styles */
        .form-input {
            @apply w-full bg-main border border-white/10 rounded-xl px-4 py-3 text-sm text-pale focus:border-accent focus:ring-1 focus:ring-accent outline-none transition-all placeholder-white/20;
        }
        .form-label {
            @apply block text-sm font-medium text-muted mb-2;
        }
    </style>
</head>

<body class="flex h-screen overflow-hidden">

    <%- include('../../partials/admin_sidebar.ejs') %>

    <main class="flex-1 overflow-y-auto relative p-6 md:p-10 custom-scroll">
        <%- include('../../partials/flash.ejs') %>

        <div class="mb-8">
            <h1 class="text-3xl font-bold text-pale">Tambah Produk Baru</h1>
            <p class="text-muted text-sm mt-1">Masukkan informasi detail produk dan parameter agrikultur.</p>
        </div>

        <div class="bg-surface p-6 md:p-8 rounded-3xl border border-white/5 shadow-2xl w-full">
            <form action="/admin/produk" method="POST" enctype="multipart/form-data" id="new-product-form">

                <div class="flex flex-col xl:flex-row gap-8">
                    
                    <div class="flex-1 space-y-8">
                        
                        <div class="border-b border-white/10 pb-8">
                            <h2 class="text-xl font-bold text-accent mb-6 flex items-center gap-2">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                Informasi Produk
                            </h2>
                            
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                                <div>
                                    <label for="Nama" class="form-label">Nama Produk <span class="text-red-400">*</span></label>
                                    <input type="text" id="Nama" name="Nama" class="form-input" placeholder="Contoh: Bibit Cabai Rawit" required>
                                </div>
                                <div>
                                    <label for="Kategori" class="form-label">Kategori</label>
                                    <input type="text" id="Kategori" name="Kategori" class="form-input" placeholder="Contoh: Sayuran / Bibit">
                                </div>
                            </div>

                            <div class="mb-6">
                                <label for="Deskripsi" class="form-label">Deskripsi</label>
                                <textarea id="Deskripsi" name="Deskripsi" rows="4" class="form-input resize-y" placeholder="Jelaskan detail produk, manfaat, dan cara perawatan singkat..."></textarea>
                            </div>

                            <div class="bg-main/50 p-6 rounded-2xl border border-white/5">
                                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-start">
                                    <div>
                                        <label for="Harga" class="form-label">Harga Jual (Rp) <span class="text-red-400">*</span></label>
                                        <div class="relative">
                                            <span class="absolute left-4 top-3 text-muted text-sm">Rp</span>
                                            <input type="number" id="Harga" name="Harga" step="1" min="0" value="0" class="form-input pl-10" required>
                                        </div>
                                    </div>
                                    <div>
                                        <label for="Diskon" class="form-label">Diskon (%)</label>
                                        <input type="number" id="Diskon" name="Diskon" step="1" min="0" max="100" value="0" class="form-input text-center" placeholder="0">
                                    </div>
                                    <div>
                                        <label class="form-label">Harga Akhir</label>
                                        <div class="h-[46px] bg-accent/10 border border-accent/20 rounded-xl flex items-center px-4 text-accent font-bold text-lg w-full" id="final-price-preview">
                                            Rp 0
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div>
                            <h2 class="text-xl font-bold text-accent mb-6 flex items-center gap-2">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                Foto Produk
                            </h2>
                            
                            <div class="w-full bg-main/30 border-2 border-dashed border-white/10 rounded-2xl p-8 text-center hover:border-accent/50 transition-colors">
                                <label for="productImages" class="cursor-pointer flex flex-col items-center justify-center w-full h-full">
                                    <div class="w-12 h-12 rounded-full bg-white/5 flex items-center justify-center mb-3">
                                        <svg class="w-6 h-6 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg>
                                    </div>
                                    <span class="text-sm font-medium text-pale">Klik untuk upload foto</span>
                                    <span class="text-xs text-muted mt-1">Maksimal 10 file (PNG, JPG, JPEG)</span>
                                    <input type="file" id="productImages" name="productImages" multiple accept="image/png, image/jpeg, image/jpg" class="hidden">
                                </label>
                            </div>
                        </div>

                    </div>

                    <div class="flex-1 xl:max-w-xl xl:border-l border-white/10 xl:pl-8">
                        
                        <div class="sticky top-6">
                            <div class="flex justify-between items-center mb-6">
                                <h2 class="text-xl font-bold text-accent flex items-center gap-2">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
                                    Parameter Agrikultur
                                </h2>
                                <button type="button" id="add-parameter-btn" class="text-xs bg-accent hover:bg-white text-main font-bold py-2 px-3 rounded-lg transition-colors flex items-center gap-1 shadow-lg shadow-green-500/20">
                                    <span>+</span> Tambah
                                </button>
                            </div>

                            <div class="bg-main/30 rounded-2xl p-1 border border-white/5 min-h-[200px]">
                                <div id="parameter-container" class="space-y-3 p-3">
                                    <div class="placeholder-message text-center py-12 flex flex-col items-center justify-center opacity-60">
                                        <svg class="w-10 h-10 text-muted mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
                                        <p class="text-muted text-sm font-medium">Belum ada parameter.</p>
                                        <p class="text-muted text-xs mt-1">Tambahkan spesifikasi tumbuh optimal.</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="flex items-center justify-end gap-4 mt-10 pt-6 border-t border-white/10">
                    <a href="/admin/produk" class="py-3 px-8 rounded-xl border border-white/10 text-muted hover:text-white hover:bg-white/5 transition-all font-semibold">
                        Batal
                    </a>
                    <button type="submit" class="bg-accent hover:bg-white text-main font-bold py-3 px-10 rounded-xl transition-all shadow-lg hover:shadow-accent/20 flex items-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        Simpan Produk
                    </button>
                </div>

            </form>
        </div>
    </main>

    <template id="parameter-row-template">
        <div class="parameter-row bg-surface border border-white/10 rounded-xl p-4 relative group hover:border-accent/30 transition-colors animate-fade-in-down">
            
            <div class="flex justify-between items-start mb-3">
                <div class="w-full mr-2">
                    <select name="paramNama[]" class="param-select w-full bg-main border border-white/10 rounded-lg px-3 py-2 text-sm text-pale focus:border-accent outline-none font-medium">
                        <option value="">-- Pilih Parameter --</option>
                    </select>
                </div>
                <button type="button" class="remove-parameter-btn text-red-400 hover:text-red-300 p-1.5 hover:bg-red-500/10 rounded-lg transition-colors" title="Hapus">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>

            <div class="grid grid-cols-2 gap-3 mb-2">
                <div>
                    <label class="block text-[10px] uppercase font-bold text-muted mb-1">Min</label>
                    <input type="number" step="any" name="paramMin[]" placeholder="Min" class="w-full bg-main border border-white/10 rounded-lg px-3 py-1.5 text-sm text-pale focus:border-accent outline-none">
                </div>
                <div>
                    <label class="block text-[10px] uppercase font-bold text-muted mb-1">Max</label>
                    <input type="number" step="any" name="paramMax[]" placeholder="Max" class="w-full bg-main border border-white/10 rounded-lg px-3 py-1.5 text-sm text-pale focus:border-accent outline-none">
                </div>
            </div>

            <div class="flex justify-between items-center pt-2 border-t border-white/5 mt-2">
                <span class="param-unit text-xs font-mono text-accent bg-accent/10 px-2 py-0.5 rounded">Unit: -</span>
                <span class="param-desc text-[10px] text-muted italic truncate max-w-[150px]"></span>
            </div>
        </div>
    </template>

    <script>
        // --- 1. Price Calculator Logic ---
        (function () {
            const hargaInput = document.getElementById('Harga');
            const diskonInput = document.getElementById('Diskon');
            const pricePreview = document.getElementById('final-price-preview');
            const formatter = new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 });

            function updatePricePreview() {
                const harga = parseFloat(hargaInput.value) || 0;
                let diskonPersen = parseFloat(diskonInput.value);
                
                if (isNaN(diskonPersen)) diskonPersen = 0;
                if (diskonPersen < 0) diskonPersen = 0;
                if (diskonPersen > 100) diskonPersen = 100;

                const diskonNilai = harga * (diskonPersen / 100);
                const hargaAkhir = Math.max(0, harga - diskonNilai);
                
                pricePreview.textContent = formatter.format(hargaAkhir);
            }

            hargaInput.addEventListener('input', updatePricePreview);
            diskonInput.addEventListener('input', updatePricePreview);
            updatePricePreview();
        })();

        // --- 2. Dynamic Parameters Logic ---
        (function() {
            const parameterDetails = {
                'Suhu Rata-rata': { unit: '°C', desc: 'Temperatur udara rata-rata.' },
                'Kelembaban Relatif': { unit: '%', desc: 'Persentase uap air di udara.' },
                'Curah Hujan': { unit: 'mm', desc: 'Jumlah hujan harian.' },
                'Kecepatan Angin': { unit: 'm/s', desc: 'Kecepatan angin permukaan.' },
                'Radiasi Matahari': { unit: 'MJ/m²/day', desc: 'Energi radiasi harian.' },
                'Evapotranspirasi': { unit: 'mm/day', desc: 'Penguapan tanah & tanaman.' },
                'Suhu Tanah (0-7cm)': { unit: '°C', desc: 'Temperatur tanah atas.' },
                'Kelembaban Tanah': { unit: 'm³/m³', desc: 'Air tanah lapisan atas.' },
                'pH Tanah': { unit: 'pH', desc: 'Tingkat keasaman tanah.' },
                'Kandungan Organik': { unit: '%', desc: 'Bahan organik tanah.' }
            };
            const predefinedParameters = Object.keys(parameterDetails);
            const container = document.getElementById('parameter-container');
            const addButton = document.getElementById('add-parameter-btn');
            const template = document.getElementById('parameter-row-template');
            const placeholder = container.querySelector('.placeholder-message');

            function getSelectedValues() {
                const selects = container.querySelectorAll('.param-select');
                const values = new Set();
                selects.forEach(s => { if (s.value) values.add(s.value); });
                return values;
            }

            function populateDropdown(selectElement, selectedValue = '') {
                selectElement.innerHTML = '<option value="">-- Pilih --</option>';
                const selectedValues = getSelectedValues();
                
                predefinedParameters.forEach(paramName => {
                    const option = document.createElement('option');
                    option.value = paramName;
                    option.textContent = paramName;
                    if (paramName === selectedValue) option.selected = true;
                    if (selectedValues.has(paramName) && paramName !== selectedValue) {
                        option.disabled = true;
                        option.innerText += ' (Dipilih)';
                    }
                    selectElement.appendChild(option);
                });
            }

            function updateAllDropdowns() {
                const selectedValues = getSelectedValues();
                const allSelects = container.querySelectorAll('.param-select');
                allSelects.forEach(select => {
                    const currentValue = select.value;
                    Array.from(select.options).forEach(option => {
                        if (!option.value) return;
                        if (option.value !== currentValue && selectedValues.has(option.value)) {
                            option.disabled = true;
                            if(!option.innerText.includes('(Dipilih)')) option.innerText += ' (Dipilih)';
                        } else {
                            option.disabled = false;
                            option.innerText = option.value;
                        }
                    });
                });
                
                if(getSelectedValues().size >= predefinedParameters.length) {
                    addButton.classList.add('opacity-50', 'cursor-not-allowed');
                    addButton.disabled = true;
                } else {
                    addButton.classList.remove('opacity-50', 'cursor-not-allowed');
                    addButton.disabled = false;
                }
            }

            function updateParameterInfo(rowElement, selectedValue) {
                const unitElement = rowElement.querySelector('.param-unit');
                const descElement = rowElement.querySelector('.param-desc');
                const details = parameterDetails[selectedValue];

                if (details) {
                    if (unitElement) unitElement.textContent = `Unit: ${details.unit}`;
                    if (descElement) descElement.textContent = details.desc;
                } else {
                    if (unitElement) unitElement.textContent = 'Unit: -';
                    if (descElement) descElement.textContent = '';
                }
            }

            function addParamRow(selectedValue = '') {
                if (placeholder) placeholder.style.display = 'none';
                
                const clone = template.content.cloneNode(true);
                const newRow = clone.querySelector('.parameter-row');
                const selectElement = newRow.querySelector('.param-select');
                const removeButton = newRow.querySelector('.remove-parameter-btn');

                populateDropdown(selectElement, selectedValue);
                updateParameterInfo(newRow, selectedValue);

                selectElement.addEventListener('change', (e) => {
                    updateAllDropdowns();
                    updateParameterInfo(newRow, e.target.value);
                });

                removeButton.addEventListener('click', (e) => {
                    newRow.remove();
                    updateAllDropdowns();
                    if (container.querySelectorAll('.parameter-row').length === 0 && placeholder) {
                        placeholder.style.display = 'flex';
                    }
                });

                container.appendChild(clone);
                updateAllDropdowns();
            }

            addButton.addEventListener('click', () => { addParamRow(); });
        })();
    </script>
</body>
</html>