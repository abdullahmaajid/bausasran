<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detail Prestasi: <%= prestasi.Judul %></title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        main: '#003024',    // Background Gelap
                        surface: '#004030', // Warna Kartu
                        accent: '#83C540',  // Hijau Neon
                        pale: '#F5FEF9',    // Teks Putih
                        muted: '#A3C2B8',   // Teks Pudar
                        darker: '#00251a',  // Background Input
                        warning: '#FFC107', // Kuning Warning
                        gold: '#FFD700',    // Emas untuk Trophy
                    },
                    fontFamily: { sans: ['Inter', 'sans-serif'] }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer base { body { @apply bg-main text-pale font-sans antialiased; } }
        
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #004030; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #83C540; }
    </style>
</head>

<body class="flex h-screen overflow-hidden w-full">

    <%- include('../../partials/admin_sidebar.ejs') %>

    <main class="flex-1 h-full overflow-y-auto overflow-x-hidden p-6 md:p-8 relative">
        <%- include('../../partials/flash.ejs') %>

        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
            <div class="flex-1">
                <div class="flex items-center gap-3 mb-1">
                    <span class="px-3 py-1 rounded-full text-xs font-bold bg-accent/10 text-accent border border-accent/20 uppercase tracking-wider">
                        Prestasi
                    </span>
                    <span class="text-muted text-xs font-mono">ID: #<%= prestasi.ID_Prestasi %></span>
                </div>
                <h1 class="text-3xl font-bold text-pale tracking-tight leading-tight flex items-center gap-2">
                    <svg class="w-8 h-8 text-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1.323l3.954 1.582 1.699-3.181a1 1 0 011.827 1.035L17.474 8l1.202 5.86a1 1 0 01-1.353 1.15L10 13l-7.323 2.01a1 1 0 01-1.353-1.15L2.526 8l-1.006-2.141a1 1 0 011.827-1.035l1.699 3.181L9 4.323V3a1 1 0 011-1zm-5 8.274l-.818 3.987 4.818-1.323 4.818 1.323-.818-3.987L10 9.776l-2.906.498z" clip-rule="evenodd"></path></svg>
                    <%= prestasi.Judul %>
                </h1>
            </div>
            
            <div class="flex items-center gap-3 shrink-0">
                <a href="/admin/prestasi" class="bg-surface hover:bg-white/10 text-pale font-bold py-2.5 px-6 rounded-xl border border-white/10 transition-all text-sm shadow-lg flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                    Kembali
                </a>
                <a href="/admin/prestasi/<%= prestasi.ID_Prestasi %>/edit" class="bg-warning hover:bg-warning/90 text-main font-bold py-2.5 px-6 rounded-xl shadow-lg shadow-warning/20 transition-all flex items-center gap-2 text-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                    Edit Data
                </a>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
            <div class="bg-surface p-6 rounded-2xl border border-white/5 flex items-start gap-4 shadow-lg">
                <div class="p-3 bg-darker rounded-xl border border-white/10">
                    <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                </div>
                <div>
                    <h3 class="text-xs font-bold text-muted uppercase tracking-widest mb-1">Tanggal Diraih</h3>
                    <p class="text-lg font-medium text-pale">
                        <%= new Date(prestasi.Tanggal).toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
                    </p>
                </div>
            </div>

            <div class="bg-surface p-6 rounded-2xl border border-white/5 flex items-start gap-4 shadow-lg">
                <div class="p-3 bg-darker rounded-xl border border-white/10">
                    <svg class="w-6 h-6 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path></svg>
                </div>
                <div>
                    <h3 class="text-xs font-bold text-muted uppercase tracking-widest mb-1">Kategori / Tingkat</h3>
                    <p class="text-lg font-medium text-pale"><%= prestasi.Kategori || '-' %></p>
                </div>
            </div>

            <div class="bg-surface p-6 rounded-2xl border border-white/5 flex items-start gap-4 shadow-lg">
                <div class="p-3 bg-darker rounded-xl border border-white/10">
                    <svg class="w-6 h-6 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                </div>
                <div>
                    <h3 class="text-xs font-bold text-muted uppercase tracking-widest mb-1">System ID</h3>
                    <p class="text-lg font-mono font-medium text-pale"><%= prestasi.ID_Prestasi %></p>
                </div>
            </div>
        </div>

        <div class="bg-surface rounded-2xl p-6 md:p-8 shadow-xl border border-white/5">
            <h2 class="text-xl font-bold text-pale mb-6 flex items-center gap-2 border-b border-white/5 pb-4">
                <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                Dokumentasi & Sertifikat
            </h2>

            <% if (fotoList && fotoList.length > 0) { %>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                    <% fotoList.forEach((foto, index) => { %>
                        <div class="group relative aspect-[4/3] rounded-xl overflow-hidden bg-darker border border-white/10 shadow-lg cursor-pointer">
                            <img src="/images/prestasi/<%= foto.Foto %>" 
                                 alt="Dokumentasi Prestasi" 
                                 class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110">
                            
                            <% if (index === 0) { %>
                                <div class="absolute top-2 left-2 z-10">
                                    <span class="bg-accent text-main text-[10px] font-bold px-2 py-1 rounded-md shadow-sm border border-black/10 flex items-center gap-1">
                                        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                                        Cover Utama
                                    </span>
                                </div>
                            <% } %>

                            <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center backdrop-blur-[2px]">
                                <a href="/images/prestasi/<%= foto.Foto %>" target="_blank" class="bg-white/20 hover:bg-white/40 text-white p-3 rounded-full transition-all transform scale-75 group-hover:scale-100">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                                </a>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="flex flex-col items-center justify-center py-12 text-muted border border-dashed border-white/10 rounded-xl bg-darker/30">
                    <svg class="w-16 h-16 mb-4 opacity-20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    <p class="text-sm font-medium">Belum ada dokumentasi foto yang diunggah.</p>
                </div>
            <% } %>
        </div>

    </main>
</body>
</html>