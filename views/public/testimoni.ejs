<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Testimoni - Bausasran</title>
    
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        main: '#003024',    // Background Gelap
                        surface: '#004030', // Warna Kartu
                        accent: '#83C540',  // Hijau Neon
                        pale: '#F5FEF9',    // Teks Putih
                        muted: '#A3C2B8',   // Teks Pudar
                        gold: '#FACC15',    // Warna Bintang
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    boxShadow: {
                        'neon': '0 0 15px rgba(131, 197, 64, 0.3)',
                    }
                }
            }
        }
    </script>

    <style type="text/tailwindcss">
        @layer base {
            body {
                @apply bg-main text-pale font-sans antialiased;
            }
        }
    </style>
</head>

<body class="flex flex-col min-h-screen">

    <%- include('../partials/navbar.ejs') %>

    <main class="container mx-auto px-4 py-12 flex-grow">
        <%- include('../partials/flash.ejs') %>

        <div class="text-center mb-12">
            <h1 class="text-4xl md:text-5xl font-bold text-pale mb-4">
                Apa Kata <span class="text-accent">Mereka?</span>
            </h1>
            <p class="text-lg text-muted max-w-2xl mx-auto">
                Pengalaman nyata dari pengunjung dan pelanggan tentang produk serta kegiatan di Bausasran.
            </p>
        </div>

        <div class="max-w-3xl mx-auto mb-12">
            <% if (!currentUser) { %>
                <div class="bg-surface/50 border border-accent/20 rounded-2xl p-8 text-center backdrop-blur-sm relative overflow-hidden group">
                    <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-accent to-transparent opacity-50"></div>
                    <p class="text-pale text-lg mb-4 font-medium">Pernah berkunjung atau membeli produk kami? Bagikan ceritamu!</p>
                    <a href="/login" class="inline-flex items-center px-6 py-3 bg-white/5 border border-white/10 hover:border-accent text-accent font-bold rounded-full transition-all duration-300 hover:bg-accent hover:text-main shadow-lg">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path></svg>
                        Login untuk Memberi Testimoni
                    </a>
                </div>
            <% } else if (currentUser.Role === 'User') { %>
                <div class="bg-gradient-to-br from-surface to-surface/50 border border-accent/30 rounded-2xl p-8 text-center relative overflow-hidden shadow-[0_0_20px_rgba(131,197,64,0.1)]">
                    <div class="absolute -top-10 -right-10 w-32 h-32 bg-accent/10 rounded-full blur-2xl"></div>
                    <h3 class="text-xl font-bold text-pale mb-2">Halo, <%= currentUser.Nama %>!</h3>
                    <p class="text-muted mb-6">Suara Anda sangat berarti bagi kemajuan Bausasran.</p>
                    <a href="/user/testimoni/tambah" class="inline-flex items-center px-8 py-3 bg-accent text-main font-bold rounded-full hover:bg-white hover:text-main transition-all duration-300 shadow-neon transform hover:-translate-y-1">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                        Tulis Testimoni Baru
                    </a>
                </div>
            <% } %>
        </div>

        <div class="flex flex-wrap justify-center mb-10 gap-3">
            <button onclick="filterTestimoni('all')" id="btn-all" 
                class="filter-btn active px-6 py-2.5 rounded-full text-sm font-bold border border-accent bg-accent text-main transition-all duration-300 shadow-neon">
                Semua
            </button>
            <button onclick="filterTestimoni('Product')" id="btn-Product" 
                class="filter-btn px-6 py-2.5 rounded-full text-sm font-bold border border-white/10 text-muted hover:border-accent hover:text-white bg-surface transition-all duration-300">
                Produk
            </button>
            <button onclick="filterTestimoni('Kegiatan')" id="btn-Kegiatan" 
                class="filter-btn px-6 py-2.5 rounded-full text-sm font-bold border border-white/10 text-muted hover:border-accent hover:text-white bg-surface transition-all duration-300">
                Kegiatan
            </button>
        </div>

        <% if(testimoniList && testimoniList.length > 0) { %>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <% testimoniList.forEach(testimoni => { %>
                    <div class="testimoni-card flex flex-col h-full bg-surface border border-white/5 rounded-2xl p-6 shadow-lg hover:shadow-neon hover:border-accent/40 transition-all duration-300 transform hover:-translate-y-1" 
                         data-kategori="<%= testimoni.Kategori %>">
                        
                        <div class="flex items-center mb-4">
                            <div class="flex-shrink-0">
                                <% if (testimoni.dataValues.penggunaFoto) { %>
                                    <img src="/images/anggota/<%= testimoni.dataValues.penggunaFoto %>" 
                                         alt="<%= testimoni.dataValues.penggunaName %>" 
                                         class="w-12 h-12 rounded-full object-cover border-2 border-accent">
                                <% } else { %>
                                    <div class="w-12 h-12 rounded-full bg-white/10 flex items-center justify-center border border-white/20">
                                        <svg class="w-6 h-6 text-muted" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
                                        </svg>
                                    </div>
                                <% } %>
                            </div>
                            
                            <div class="ml-4">
                                <h3 class="font-bold text-pale text-sm md:text-base"><%= testimoni.dataValues.penggunaName || 'Pengguna' %></h3>
                                <p class="text-xs text-muted">Reviewer</p>
                            </div>
                            
                            <div class="ml-auto text-accent/20">
                                <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21L14.017 18C14.017 16.8954 14.9124 16 16.017 16H19.017C19.5693 16 20.017 15.5523 20.017 15V9C20.017 8.44772 19.5693 8 19.017 8H15.017C14.4647 8 14.017 8.44772 14.017 9V11C14.017 11.5523 13.5693 12 13.017 12H12.017V5H22.017V15C22.017 18.3137 19.3307 21 16.017 21H14.017ZM5.0166 21L5.0166 18C5.0166 16.8954 5.91203 16 7.0166 16H10.0166C10.5689 16 11.0166 15.5523 11.0166 15V9C11.0166 8.44772 10.5689 8 10.0166 8H6.0166C5.46432 8 5.0166 8.44772 5.0166 9V11C5.0166 11.5523 4.56889 12 4.0166 12H3.0166V5H13.0166V15C13.0166 18.3137 10.3303 21 7.0166 21H5.0166Z"></path></svg>
                            </div>
                        </div>

                        <div class="flex items-center justify-between mb-4 pb-4 border-b border-white/5">
                            <div class="flex space-x-1">
                                <% for(let i = 1; i <= 5; i++) { %>
                                    <svg class="w-4 h-4 <%= i <= testimoni.Rating ? 'text-gold fill-current' : 'text-gray-600' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                                    </svg>
                                <% } %>
                            </div>
                            
                            <span class="px-3 py-1 text-xs font-bold rounded-full border <%= testimoni.Kategori === 'Product' ? 'bg-blue-500/10 text-blue-400 border-blue-500/20' : 'bg-accent/10 text-accent border-accent/20' %>">
                                <%= testimoni.Kategori === 'Product' ? 'Produk' : 'Kegiatan' %>
                            </span>
                        </div>

                        <div class="flex-grow">
                            <h4 class="text-white font-semibold text-sm mb-2 opacity-90">
                                "<%= testimoni.dataValues.entityName || 'Umum' %>"
                            </h4>
                            <p class="text-muted text-sm italic leading-relaxed">
                                "<%= testimoni.Testimoni %>"
                            </p>
                        </div>

                        <div class="mt-6 pt-4 border-t border-white/5">
                            <% if (testimoni.ID_Product && testimoni.Kategori === 'Product') { %>
                                <a href="/produk/<%= testimoni.ID_Product %>" class="flex items-center justify-center w-full py-2 text-sm font-medium text-muted hover:text-accent bg-white/5 hover:bg-white/10 rounded-lg transition-colors">
                                    Lihat Produk
                                    <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                                </a>
                            <% } else if (testimoni.ID_Kegiatan && testimoni.Kategori === 'Kegiatan') { %>
                                <a href="/kegiatan/<%= testimoni.ID_Kegiatan %>" class="flex items-center justify-center w-full py-2 text-sm font-medium text-muted hover:text-accent bg-white/5 hover:bg-white/10 rounded-lg transition-colors">
                                    Lihat Kegiatan
                                    <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                                </a>
                            <% } else { %>
                                <span class="block py-2"></span>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="text-center py-20 border-2 border-dashed border-white/10 rounded-2xl bg-surface/30">
                <svg class="w-20 h-20 mx-auto text-muted mb-4 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
                </svg>
                <h3 class="text-xl font-bold text-pale mb-2">Belum Ada Testimoni</h3>
                <p class="text-muted">Jadilah yang pertama berbagi pengalaman!</p>
            </div>
        <% } %>

        <% if(testimoniList && testimoniList.length > 12) { %>
            <div class="mt-12 flex justify-center">
                <nav class="inline-flex rounded-lg shadow-sm bg-surface p-1 border border-white/10">
                    <a href="#" class="px-4 py-2 rounded-md text-muted hover:text-pale hover:bg-white/5 transition-colors text-sm font-medium">Previous</a>
                    <a href="#" class="px-4 py-2 rounded-md bg-accent text-main font-bold text-sm mx-1">1</a>
                    <a href="#" class="px-4 py-2 rounded-md text-muted hover:text-pale hover:bg-white/5 transition-colors text-sm font-medium">2</a>
                    <a href="#" class="px-4 py-2 rounded-md text-muted hover:text-pale hover:bg-white/5 transition-colors text-sm font-medium">Next</a>
                </nav>
            </div>
        <% } %>
    </main>

    <%- include('../partials/footer.ejs') %>

    <script>
        function filterTestimoni(kategori) {
            const cards = document.querySelectorAll('.testimoni-card');
            const buttons = document.querySelectorAll('.filter-btn');
            
            // 1. Reset & Set Button Styles
            buttons.forEach(btn => {
                btn.classList.remove('bg-accent', 'text-main', 'border-accent', 'shadow-neon');
                btn.classList.add('bg-surface', 'text-muted', 'border-white/10');
            });
            
            const activeBtn = document.getElementById(`btn-${kategori}`);
            if(activeBtn) {
                activeBtn.classList.remove('bg-surface', 'text-muted', 'border-white/10');
                activeBtn.classList.add('bg-accent', 'text-main', 'border-accent', 'shadow-neon');
            }
            
            // 2. Filter Cards with Animation
            cards.forEach(card => {
                if (kategori === 'all' || card.dataset.kategori === kategori) {
                    card.classList.remove('hidden');
                    // Reset animation
                    card.animate([
                        { opacity: 0, transform: 'translateY(10px)' },
                        { opacity: 1, transform: 'translateY(0)' }
                    ], { duration: 300, fill: 'forwards' });
                } else {
                    card.classList.add('hidden');
                }
            });
        }
    </script>

</body>
</html>