<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Direktori Anggota - Bausasran Heritage</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        paper: '#F9F7F2',       // Background Utama
                        deep: '#0F1F18',        // Teks Utama / Aksen Gelap
                        gold: '#C5B388',        // Aksen Emas
                        charcoal: '#4A4A4A',    // Teks Sekunder
                        linen: '#EBE9E4',       // Background Kartu
                    },
                    fontFamily: {
                        sans: ['Lato', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                        crest: ['Cinzel', 'serif'],
                    },
                    letterSpacing: {
                        'luxury': '0.2em',
                    }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer base { 
            body { 
                @apply bg-paper text-deep font-sans antialiased; 
            } 
            .custom-scroll::-webkit-scrollbar { width: 6px; }
            .custom-scroll::-webkit-scrollbar-track { @apply bg-paper; }
            .custom-scroll::-webkit-scrollbar-thumb { @apply bg-deep/20 hover:bg-gold rounded-full transition-colors; }
        }

        /* Texture Grain Overlay */
        .noise-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none;
            z-index: 0;
            mix-blend-mode: multiply;
        }
    </style>
</head>
<body class="flex h-screen overflow-hidden relative">

    <div class="noise-overlay"></div>

    <%- include('../../partials/user_sidebar.ejs') %>

    <main class="flex-1 overflow-y-auto custom-scroll p-8 md:p-12 relative z-10">
        
        <%- include('../../partials/flash.ejs') %>

        <div class="mb-12 border-b border-deep/10 pb-8 flex flex-col md:flex-row justify-between items-end gap-6">
            <div>
                <span class="text-[10px] uppercase tracking-luxury text-gold font-bold mb-2 block">Komunitas Kami</span>
                <h1 class="text-3xl md:text-5xl font-crest text-deep mb-3">
                    Direktori <span class="font-serif italic text-gold">Anggota</span>
                </h1>
                <p class="text-charcoal font-serif italic text-lg max-w-2xl">
                    Mengenal lebih dekat para penggerak dan warga Kampung Wisata Bausasran.
                </p>
            </div>
            
            <div class="hidden md:block">
                <div class="w-16 h-16 border border-deep/10 rounded-full flex items-center justify-center opacity-50">
                    <svg class="w-6 h-6 text-deep" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                </div>
            </div>
        </div>

        <% if (anggotaList && anggotaList.length > 0) { %>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8 pb-10">
                <% for(let anggota of anggotaList) { %>
                    <div class="group bg-white border border-deep/5 hover:border-gold/50 transition-all duration-500 relative flex flex-col shadow-sm hover:shadow-xl hover:-translate-y-1">
                        
                        <div class="aspect-[4/5] overflow-hidden bg-linen relative">
                            <% if (anggota.dataValues && anggota.dataValues.fotoFile) { %>
                                <img src="/images/anggota/<%= anggota.dataValues.fotoFile %>" 
                                     alt="<%= anggota.Nama %>"
                                     class="w-full h-full object-cover filter grayscale group-hover:grayscale-0 transition-all duration-700 transform group-hover:scale-105">
                            <% } else { %>
                                <div class="w-full h-full flex flex-col items-center justify-center bg-linen/50 text-deep/10">
                                    <svg class="w-24 h-24" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                                    </svg>
                                </div>
                            <% } %>
                            
                            <div class="absolute inset-2 border border-white/20 pointer-events-none z-10"></div>
                        </div>

                        <div class="p-6 text-center flex-1 flex flex-col items-center">
                            
                            <h3 class="text-xl font-crest text-deep mb-1 group-hover:text-gold transition-colors duration-300">
                                <%= anggota.Nama %>
                            </h3>
                            
                            <div class="w-8 h-[1px] bg-gold/50 my-3"></div>
                            
                            <div class="space-y-2 mb-6 flex-grow flex flex-col justify-center">
                                <% if (anggota.Username) { %>
                                    <p class="text-[10px] uppercase tracking-luxury text-charcoal/60 font-bold">
                                        @<%= anggota.Username %>
                                    </p>
                                <% } %>
                                
                                <% if (anggota.Alamat) { %>
                                    <p class="text-sm font-serif italic text-charcoal line-clamp-2 px-2">
                                        "<%= anggota.Alamat %>"
                                    </p>
                                <% } %>
                            </div>

                            <a href="/user/anggota/<%= anggota.ID_Pengguna %>" 
                               class="inline-block w-full py-3 text-[10px] font-bold uppercase tracking-luxury border border-deep/10 hover:bg-deep hover:text-gold hover:border-deep transition-all duration-300">
                                Lihat Profil
                            </a>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } else { %>
            <div class="flex flex-col items-center justify-center py-24 border border-dashed border-deep/10 bg-linen/20">
                <div class="w-16 h-16 rounded-full bg-paper border border-deep/10 flex items-center justify-center mb-6 shadow-sm">
                    <span class="text-2xl text-deep/40 font-serif italic">!</span>
                </div>
                <h3 class="text-xl font-crest text-deep mb-2">Data Belum Tersedia</h3>
                <p class="font-serif italic text-charcoal/60">Belum ada anggota yang terdaftar dalam direktori.</p>
            </div>
        <% } %>

        <div class="mt-8 pt-6 border-t border-deep/5 text-center">
            <p class="text-[9px] uppercase tracking-luxury text-charcoal/40">
                &copy; <%= new Date().getFullYear() %> Bausasran Heritage Estate. All Rights Reserved.
            </p>
        </div>
    </main>

</body>
</html>