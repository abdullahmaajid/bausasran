<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= anggota.Nama %> - Bausasran Heritage</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
    
    <script src="https://cdn.jsdelivr.net/gh/studio-freight/lenis@1.0.29/bundled/lenis.min.js"></script>

    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        paper: '#F9F7F2',       // Cream Background
                        deep: '#0F1F18',        // Dark Green (Primary)
                        gold: '#C5B388',        // Luxury Accent
                        charcoal: '#4A4A4A',    // Text
                        sand: '#E5E0D8',        // Border/Secondary
                        white: '#FFFFFF',
                    },
                    fontFamily: {
                        sans: ['Lato', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                        crest: ['Cinzel', 'serif'], 
                    },
                    letterSpacing: {
                        'luxury': '0.2em',
                        'widest': '0.3em',
                    },
                    boxShadow: {
                        'elegant': '0 10px 40px -10px rgba(15, 31, 24, 0.05)',
                        'sharp': '5px 5px 0px 0px rgba(197, 179, 136, 0.3)',
                    }
                }
            }
        }
    </script>

    <style type="text/tailwindcss">
        @layer base {
            body {
                @apply bg-paper text-deep font-sans antialiased selection:bg-deep selection:text-paper;
                overscroll-behavior: none; 
            }
            h1, h2, h3, h4 {
                @apply font-crest text-deep;
            }
            p {
                @apply font-serif text-charcoal/80 leading-relaxed;
            }
        }
        
        /* TEXTURE OVERLAY */
        .noise-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none; z-index: 9999; mix-blend-mode: multiply;
        }
    </style>
</head>

<body class="flex flex-col min-h-screen relative">

    <div class="noise-overlay"></div>

    <%- include('../partials/navbar.ejs') %>

    <main class="flex-grow pt-40 pb-24 px-4 md:px-8 relative z-10">
        <%- include('../partials/flash.ejs') %>

        <div class="max-w-7xl mx-auto">
            
            <nav class="flex mb-8 animate-[fadeIn_1s]" aria-label="Breadcrumb">
                <ol class="inline-flex items-center space-x-2 md:space-x-3 font-sans text-[10px] uppercase tracking-widest">
                    <li class="inline-flex items-center">
                        <a href="/" class="text-deep/40 hover:text-gold transition-colors">Home</a>
                    </li>
                    <li><span class="text-deep/20">/</span></li>
                    <li>
                        <a href="/anggota" class="text-deep/40 hover:text-gold transition-colors">Anggota</a>
                    </li>
                    <li><span class="text-deep/20">/</span></li>
                    <li aria-current="page">
                        <span class="text-deep font-bold truncate max-w-[200px]"><%= anggota.Nama %></span>
                    </li>
                </ol>
            </nav>

            <header class="mb-12 animate-[fadeIn_1.2s]">
                <div class="flex flex-wrap items-center gap-4 mb-4">
                    <% if (anggota.Role === 'Admin') { %>
                        <span class="inline-block px-3 py-1 text-[9px] font-bold uppercase tracking-widest border bg-gold text-paper border-gold">
                            Pengurus Inti
                        </span>
                    <% } else { %>
                        <span class="inline-block px-3 py-1 text-[9px] font-bold uppercase tracking-widest border bg-deep/5 text-deep/40 border-deep/10">
                            Anggota
                        </span>
                    <% } %>
                    
                    <% if (anggota.Jabatan) { %>
                        <span class="inline-block px-3 py-1 text-[9px] font-bold uppercase tracking-widest border border-deep/20 text-deep/60">
                            <%= anggota.Jabatan %>
                        </span>
                    <% } %>
                </div>
                <h1 class="text-4xl md:text-6xl text-deep leading-tight mb-2"><%= anggota.Nama %></h1>
            </header>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
                
                <div class="lg:col-span-8 space-y-12 animate-[fadeIn_1.5s]">
                    
                    <div class="relative w-full aspect-[4/5] md:aspect-video bg-sand/20 p-2 border border-deep/5">
                        <div class="w-full h-full relative overflow-hidden group">
                            <% 
                               const fotoFile = (anggota.dataValues && anggota.dataValues.fotoFile) ? anggota.dataValues.fotoFile : (anggota.fotoFile || anggota.Foto);
                            %>
                            <% if (fotoFile) { %>
                                <img src="/images/anggota/<%= fotoFile %>" 
                                     alt="<%= anggota.Nama %>" 
                                     class="w-full h-full object-cover object-top transition-transform duration-1000 group-hover:scale-105 filter  contrast-[1.1] group-hover:-0 transition-all"
                                     onerror="this.onerror=null;this.parentElement.innerHTML='<div class=\'w-full h-full flex items-center justify-center bg-sand/10\'><span class=\'font-crest text-4xl text-deep/20\'>No Image</span></div>'">
                            <% } else { %>
                                <div class="w-full h-full flex items-center justify-center bg-sand/10 text-deep/20">
                                    <span class="font-crest text-6xl"><%= anggota.Nama.charAt(0) %></span>
                                </div>
                            <% } %>
                            <div class="absolute inset-0 bg-gradient-to-t from-deep/30 to-transparent opacity-60"></div>
                        </div>
                    </div>

                    <div class="prose prose-lg max-w-none text-charcoal/80">
                        <h3 class="text-2xl mb-4 pb-4 border-b border-deep/10 relative inline-block">
                            Biografi Singkat
                            <span class="absolute bottom-0 left-0 w-1/3 h-[2px] bg-gold"></span>
                        </h3>
                        <div class="font-serif leading-loose whitespace-pre-line text-lg italic text-charcoal/70">
                            "<%= anggota.Bio || anggota.Keterangan || 'Tidak ada biografi yang tersedia untuk anggota ini.' %>"
                        </div>
                    </div>

                </div>

                <div class="lg:col-span-4 animate-[fadeIn_1.8s]">
                    <div class="sticky top-32 space-y-6">
                        
                        <div class="bg-white border border-deep/10 p-8 shadow-elegant relative overflow-hidden">
                            <div class="absolute top-0 left-0 w-full h-1 bg-gold"></div>
                            
                            <h3 class="text-xl mb-6">Detail Profil</h3>
                            
                            <ul class="space-y-6">
                                
                                <% if (anggota.username) { %>
                                <li class="flex items-start gap-4">
                                    <div class="w-8 h-8 flex items-center justify-center text-deep/40 border border-deep/10 rounded-full shrink-0">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                                    </div>
                                    <div>
                                        <span class="block text-[9px] uppercase tracking-widest text-deep/40 mb-1">Username</span>
                                        <span class="font-serif text-deep text-lg leading-tight block">
                                            @<%= anggota.username %>
                                        </span>
                                    </div>
                                </li>
                                <% } %>

                                <% if (anggota.TanggalBergabung) { %>
                                <li class="flex items-start gap-4">
                                    <div class="w-8 h-8 flex items-center justify-center text-deep/40 border border-deep/10 rounded-full shrink-0">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                    </div>
                                    <div>
                                        <span class="block text-[9px] uppercase tracking-widest text-deep/40 mb-1">Bergabung Sejak</span>
                                        <span class="font-serif text-deep text-lg leading-tight block">
                                            <%= new Date(anggota.TanggalBergabung).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                                        </span>
                                    </div>
                                </li>
                                <% } %>

                                <% if (anggota.Alamat) { %>
                                <li class="flex items-start gap-4">
                                    <div class="w-8 h-8 flex items-center justify-center text-deep/40 border border-deep/10 rounded-full shrink-0">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                    </div>
                                    <div>
                                        <span class="block text-[9px] uppercase tracking-widest text-deep/40 mb-1">Alamat</span>
                                        <span class="font-serif text-deep text-lg leading-tight block">
                                            <%= anggota.Alamat %>
                                        </span>
                                    </div>
                                </li>
                                <% } %>

                            </ul>
                        </div>

                        <div class="space-y-3">
                            <% if (anggota.No_Telepon) { %>
                                <a href="https://wa.me/<%= anggota.No_Telepon.replace(/[^0-9]/g, '') %>?text=Halo%20<%= encodeURIComponent(anggota.Nama) %>" 
                                   target="_blank"
                                   class="block w-full py-4 bg-deep text-paper text-[10px] uppercase tracking-widest font-bold text-center border border-deep hover:bg-gold hover:border-gold hover:text-deep transition-all duration-300 shadow-sharp">
                                    Hubungi WhatsApp
                                </a>
                            <% } %>
                            
                            <a href="/anggota" class="block w-full py-3 text-center text-[10px] uppercase tracking-widest text-deep/40 hover:text-deep transition-colors">
                                ← Kembali ke Direktori
                            </a>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </main>

    <%- include('../partials/footer.ejs') %>

    <script>
        // Init Smooth Scroll (Sama dgn Kegiatan)
        const lenis = new Lenis({ duration: 1.2, easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), direction: 'vertical', smooth: true });
        function raf(time) { lenis.raf(time); requestAnimationFrame(raf); }
        requestAnimationFrame(raf);
    </script>
</body>
</html>