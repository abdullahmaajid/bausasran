<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Review #<%= review.ID_Review %> - Bausasran Heritage</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        paper: '#F9F7F2',       
                        deep: '#0F1F18',        
                        gold: '#C5B388',        
                        charcoal: '#4A4A4A',    
                        linen: '#EBE9E4', 
                        white: '#FFFFFF',
                        danger: '#9B1C1C',      
                    },
                    fontFamily: {
                        sans: ['Lato', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                        crest: ['Cinzel', 'serif'], 
                    },
                    boxShadow: {
                        'elegant': '0 10px 40px -10px rgba(15, 31, 24, 0.05)',
                    }
                }
            }
        }
    </script>

    <style type="text/tailwindcss">
        @layer base {
            body {
                @apply bg-paper text-deep font-sans antialiased selection:bg-deep selection:text-paper;
            }
        }
        /* TEXTURE: FILM GRAIN */
        .noise-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none; z-index: 50; mix-blend-mode: multiply;
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #C5B388; border-radius: 3px; }

        /* Form Styling */
        .heritage-input {
            @apply w-full bg-white border border-deep/10 px-4 py-3 text-deep text-sm focus:border-gold focus:outline-none focus:ring-1 focus:ring-gold transition-all placeholder:text-charcoal/30;
        }
        .heritage-select {
            @apply w-full bg-white border border-deep/10 px-4 py-3 text-deep text-sm focus:border-gold focus:outline-none focus:ring-1 focus:ring-gold transition-all appearance-none cursor-pointer;
        }
        .heritage-label {
            @apply block text-[10px] font-bold text-gold uppercase tracking-widest mb-2;
        }
        .heritage-card {
            @apply bg-white p-8 border border-deep/5 shadow-elegant relative overflow-hidden;
        }
    </style>
</head>

<body class="flex h-screen overflow-hidden relative">

    <div class="noise-overlay"></div>

    <%- include('../../partials/admin_sidebar.ejs') %>

    <main class="flex-1 h-full overflow-y-auto relative z-10 p-8 md:p-12">
        <%- include('../../partials/flash.ejs') %>

        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 border-b border-deep/10 pb-8">
            <div>
                <span class="font-sans text-[10px] uppercase tracking-widest text-gold mb-2 block">
                    Manajemen Ulasan
                </span>
                <h1 class="font-crest text-3xl md:text-4xl text-deep leading-none">
                    Edit Review #<%= review.ID_Review %>
                </h1>
                <p class="font-serif italic text-charcoal/60 mt-2 text-sm">
                    Kelola detail ulasan dan feedback dari warga.
                </p>
            </div>
            <div class="mt-6 md:mt-0 flex gap-3">
                <a href="/admin/testimoni" class="px-6 py-3 border border-deep/10 bg-white text-deep text-[10px] font-bold uppercase tracking-widest hover:bg-linen transition-colors">
                    Kembali
                </a>
            </div>
        </div>

        <form action="/admin/testimoni/<%= review.ID_Review %>/edit" method="POST" class="h-full">
            
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch pb-12">
                
                <div class="lg:col-span-2 h-full">
                    <div class="heritage-card h-full flex flex-col">
                        <h3 class="font-crest text-xl text-deep mb-6 border-b border-deep/5 pb-4 shrink-0">Isi Ulasan</h3>
                        
                        <div class="flex-1 flex flex-col">
                            <label for="Ulasan" class="heritage-label">Komentar Pengguna</label>
                            <div class="relative flex-1">
                                <span class="absolute top-4 left-4 text-4xl text-gold/20 font-serif leading-none z-10">“</span>
                                <textarea id="Ulasan" name="Ulasan" class="heritage-input h-full min-h-[400px] resize-none font-serif text-lg leading-relaxed pl-12 py-6 italic text-deep/80" placeholder="Tuliskan pendapat pengguna di sini..."><%= review.Ulasan || '' %></textarea>
                            </div>
                            <p class="text-[10px] text-charcoal/40 mt-2 italic text-right shrink-0">Ulasan ini akan ditampilkan di halaman publik.</p>
                        </div>
                    </div>
                </div>

                <div class="lg:col-span-1 h-full">
                    <div class="heritage-card h-full flex flex-col justify-between">
                        <div>
                            <h3 class="font-crest text-xl text-deep mb-6 border-b border-deep/5 pb-4">Detail & Konteks</h3>
                            
                            <div class="space-y-6">
                                <div>
                                    <label for="ID_Pengguna" class="heritage-label">Pengguna (Reviewer)</label>
                                    <div class="relative">
                                        <select id="ID_Pengguna" name="ID_Pengguna" class="heritage-select" required>
                                            <option value="">-- Pilih Pengguna --</option>
                                            <% if(penggunaList && penggunaList.length > 0) { %>
                                                <% for(let pengguna of penggunaList) { %>
                                                    <option value="<%= pengguna.ID_Pengguna %>" <%= review.ID_Pengguna === pengguna.ID_Pengguna ? 'selected' : '' %>>
                                                        <%= pengguna.Nama %> (<%= pengguna.Role %>)
                                                    </option>
                                                <% } %>
                                            <% } %>
                                        </select>
                                        <div class="absolute inset-y-0 right-0 flex items-center px-4 pointer-events-none text-charcoal/40">
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                                        </div>
                                    </div>
                                </div>

                                <div>
                                    <label for="Kategori" class="heritage-label">Kategori Konteks</label>
                                    <div class="relative">
                                        <select id="Kategori" name="Kategori" class="heritage-select" required onchange="toggleKategori(this.value)">
                                            <option value="">-- Pilih Kategori --</option>
                                            <option value="Product" <%= review.Kategori === 'Product' ? 'selected' : '' %>>Product (Produk UMKM)</option>
                                            <option value="Kegiatan" <%= review.Kategori === 'Kegiatan' ? 'selected' : '' %>>Kegiatan Desa</option>
                                        </select>
                                        <div class="absolute inset-y-0 right-0 flex items-center px-4 pointer-events-none text-charcoal/40">
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                                        </div>
                                    </div>
                                </div>

                                <div id="dynamic-selection-area" class="bg-linen/30 p-4 border border-deep/5 transition-all">
                                    
                                    <div id="produk-section" style="display: <%= review.Kategori === 'Product' ? 'block' : 'none' %>;">
                                        <label for="ID_Product" class="heritage-label">Produk Terkait</label>
                                        <div class="relative">
                                            <select id="ID_Product" name="ID_Product" class="heritage-select bg-white">
                                                <option value="">-- Pilih Produk --</option>
                                                <% if(produkList && produkList.length > 0) { %>
                                                    <% for(let produk of produkList) { %>
                                                        <option value="<%= produk.ID_Product %>" <%= review.ID_Product === produk.ID_Product ? 'selected' : '' %>>
                                                            <%= produk.Nama %>
                                                        </option>
                                                    <% } %>
                                                <% } %>
                                            </select>
                                        </div>
                                    </div>

                                    <div id="kegiatan-section" style="display: <%= review.Kategori === 'Kegiatan' ? 'block' : 'none' %>;">
                                        <label for="ID_Kegiatan" class="heritage-label">Kegiatan Terkait</label>
                                        <div class="relative">
                                            <select id="ID_Kegiatan" name="ID_Kegiatan" class="heritage-select bg-white">
                                                <option value="">-- Pilih Kegiatan --</option>
                                                <% if(kegiatanList && kegiatanList.length > 0) { %>
                                                    <% for(let kegiatan of kegiatanList) { %>
                                                        <option value="<%= kegiatan.ID_Kegiatan %>" <%= review.ID_Kegiatan === kegiatan.ID_Kegiatan ? 'selected' : '' %>>
                                                            <%= kegiatan.Judul %>
                                                        </option>
                                                    <% } %>
                                                <% } %>
                                            </select>
                                        </div>
                                    </div>

                                    <div id="no-kategori-msg" class="text-center text-charcoal/40 text-xs italic py-2" style="display: <%= !review.Kategori ? 'block' : 'none' %>;">
                                        Pilih kategori di atas.
                                    </div>
                                </div>

                                <div>
                                    <label for="Rating" class="heritage-label">Rating Penilaian</label>
                                    <div class="relative">
                                        <select id="Rating" name="Rating" class="heritage-select font-serif italic text-deep" required>
                                            <option value="">-- Berikan Bintang --</option>
                                            <option value="1" <%= review.Rating === 1 ? 'selected' : '' %>>★☆☆☆☆ (1 - Buruk)</option>
                                            <option value="2" <%= review.Rating === 2 ? 'selected' : '' %>>★★☆☆☆ (2 - Kurang)</option>
                                            <option value="3" <%= review.Rating === 3 ? 'selected' : '' %>>★★★☆☆ (3 - Cukup)</option>
                                            <option value="4" <%= review.Rating === 4 ? 'selected' : '' %>>★★★★☆ (4 - Baik)</option>
                                            <option value="5" <%= review.Rating === 5 ? 'selected' : '' %>>★★★★★ (5 - Sempurna)</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="w-full mt-8 py-4 bg-deep text-white font-sans text-[10px] font-bold uppercase tracking-widest hover:bg-gold hover:text-deep transition-all border border-deep shadow-lg">
                            Simpan Perubahan
                        </button>
                    </div>
                </div>

            </div>
        </form>
    </main>

    <script>
        function toggleKategori(kategori) {
            const produkSection = document.getElementById('produk-section');
            const kegiatanSection = document.getElementById('kegiatan-section');
            const noKategoriMsg = document.getElementById('no-kategori-msg');
            
            const produkSelect = document.getElementById('ID_Product');
            const kegiatanSelect = document.getElementById('ID_Kegiatan');

            // Reset tampilan
            produkSection.style.display = 'none';
            kegiatanSection.style.display = 'none';
            noKategoriMsg.style.display = 'none';

            // Reset required
            produkSelect.required = false;
            kegiatanSelect.required = false;

            if (kategori === 'Product') {
                produkSection.style.display = 'block';
                produkSelect.required = true;
                kegiatanSelect.value = ''; 
            } else if (kategori === 'Kegiatan') {
                kegiatanSection.style.display = 'block';
                kegiatanSelect.required = true;
                produkSelect.value = '';
            } else {
                noKategoriMsg.style.display = 'block';
            }
        }
    </script>
</body>
</html>