<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Bausasran</title>
    
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        main: '#003024',    // Background Gelap
                        surface: '#004030', // Warna Kartu
                        accent: '#83C540',  // Hijau Neon
                        pale: '#F5FEF9',    // Teks Putih
                        muted: '#A3C2B8',   // Teks Pudar
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    boxShadow: {
                        'neon': '0 0 15px rgba(131, 197, 64, 0.3)',
                    }
                }
            }
        }
    </script>

    <style type="text/tailwindcss">
        @layer base {
            body {
                @apply bg-main text-pale font-sans antialiased;
            }
        }
        /* Custom autofill style for dark mode */
        input:-webkit-autofill,
        input:-webkit-autofill:hover, 
        input:-webkit-autofill:focus, 
        input:-webkit-autofill:active{
            -webkit-box-shadow: 0 0 0 30px #003024 inset !important;
            -webkit-text-fill-color: #F5FEF9 !important;
            transition: background-color 5000s ease-in-out 0s;
        }
    </style>
</head>

<body class="flex flex-col min-h-screen relative overflow-x-hidden">

    <div class="fixed top-0 left-0 w-full h-full overflow-hidden -z-10 pointer-events-none">
        <div class="absolute -top-[20%] -left-[10%] w-[50%] h-[50%] bg-accent/10 rounded-full blur-[100px]"></div>
        <div class="absolute top-[40%] right-[10%] w-[30%] h-[30%] bg-surface rounded-full blur-[80px]"></div>
    </div>



    <main class="container mx-auto px-4 flex-grow flex items-center justify-center py-12">
        
        <div class="w-full max-w-md">
            
            <%- include('../partials/flash.ejs') %>

            <div class="bg-surface p-8 md:p-10 rounded-3xl shadow-2xl border border-white/10 relative overflow-hidden backdrop-blur-sm">
                
                <div class="text-center mb-8">
                    <h1 class="text-3xl font-bold text-pale mb-2">Selamat Datang</h1>
                    <p class="text-muted text-sm">Masuk untuk mengakses dasbor Bausasran.</p>
                </div>

                <form action="/login" method="POST" class="space-y-6">
                    
                    <div>
                        <label for="username" class="block text-sm font-medium text-muted mb-2 ml-1">Username</label>
                        <div class="relative group">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <svg class="h-5 w-5 text-muted group-focus-within:text-accent transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                            </div>
                            <input type="text" id="username" name="username" 
                                class="block w-full pl-10 pr-3 py-3 bg-main border border-white/10 rounded-xl text-pale placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-all duration-300 sm:text-sm" 
                                placeholder="Masukkan username" required>
                        </div>
                    </div>
                    
                    <div>
                        <label for="password" class="block text-sm font-medium text-muted mb-2 ml-1">Password</label>
                        <div class="relative group">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <svg class="h-5 w-5 text-muted group-focus-within:text-accent transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                                </svg>
                            </div>
                            <input type="password" id="password" name="password" 
                                class="block w-full pl-10 pr-10 py-3 bg-main border border-white/10 rounded-xl text-pale placeholder-gray-500 focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent transition-all duration-300 sm:text-sm" 
                                placeholder="••••••••" required>
                            
                            <button type="button" onclick="togglePassword()" class="absolute inset-y-0 right-0 pr-3 flex items-center text-muted hover:text-white transition-colors focus:outline-none">
                                <svg id="eye-icon" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                </svg>
                                <svg id="eye-slash-icon" class="h-5 w-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                                </svg>
                            </button>
                        </div>
                    </div>
                    
                    <div class="flex items-center justify-between text-sm">
                        <div class="flex items-center">
                            <input id="rememberMe" name="rememberMe" type="checkbox" class="h-4 w-4 text-accent focus:ring-accent border-white/20 rounded bg-main cursor-pointer">
                            <label for="rememberMe" class="ml-2 block text-muted cursor-pointer hover:text-pale transition-colors">
                                Ingat saya
                            </label>
                        </div>
                        <div class="text-sm">
                            <a href="/lupa-password" class="font-medium text-accent hover:text-white transition-colors">
                                Lupa password?
                            </a>
                        </div>
                    </div>
                    
                    <div>
                        <button type="submit" class="group w-full flex justify-center py-3 px-4 border border-transparent text-sm font-bold rounded-xl text-main bg-accent hover:bg-white focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent focus:ring-offset-main transition-all duration-300 shadow-neon transform active:scale-95">
                            MASUK
                            <svg class="w-5 h-5 ml-2 -mr-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                            </svg>
                        </button>
                    </div>
                </form>
                
                <div class="mt-8 pt-6 border-t border-white/10 text-center">
                    <p class="text-sm text-muted">
                        Belum punya akun? 
                        <a href="/register" class="font-bold text-accent hover:text-white hover:underline transition-colors">
                            Daftar di sini
                        </a>
                    </p>
                </div>
            </div>
            
            <div class="mt-8 text-center">
                <a href="/" class="text-muted text-sm hover:text-pale transition-colors flex items-center justify-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                    Kembali ke Beranda
                </a>
            </div>

        </div>
    </main>

    <script>
        function togglePassword() {
            const passwordInput = document.getElementById('password');
            const eyeIcon = document.getElementById('eye-icon');
            const eyeSlashIcon = document.getElementById('eye-slash-icon');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                eyeIcon.classList.add('hidden');
                eyeSlashIcon.classList.remove('hidden');
            } else {
                passwordInput.type = 'password';
                eyeIcon.classList.remove('hidden');
                eyeSlashIcon.classList.add('hidden');
            }
        }
    </script>

</body>
</html>