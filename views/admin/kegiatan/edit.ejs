<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Kegiatan</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        dialog {
            border: none; padding: 2rem; border-radius: 0.5rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }
        dialog::backdrop { background: rgba(0, 0, 0, 0.5); }
    </style>
</head>
<body class="flex bg-gray-100">
    <%- include('../../partials/admin_sidebar.ejs') %>
    <main class="flex-1 p-10">
        <%- include('../../partials/flash.ejs') %>
        <h1 class="text-3xl font-bold text-gray-800 mb-6">Edit Kegiatan: <%= kegiatan.Judul %></h1>
        
        <div class="bg-white p-8 rounded-lg shadow-lg max-w-2xl mx-auto mb-10">
            <form action="/admin/kegiatan/<%= kegiatan.ID_Kegiatan %>/edit" method="POST" enctype="multipart/form-data">
                
                <div class="mb-4">
                    <label for="Judul" class="block text-gray-700 text-sm font-semibold mb-2">Judul Kegiatan*</label>
                    <input type="text" id="Judul" name="Judul" value="<%= kegiatan.Judul %>" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700" required>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                    <div>
                        <label for="Tanggal" class="block text-gray-700 text-sm font-semibold mb-2">Tanggal Pelaksanaan*</label>
                        <input type="date" id="Tanggal" name="Tanggal" value="<%= kegiatan.Tanggal %>" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700" required>
                    </div>
                    <div>
                        <label for="Kategori" class="block text-gray-700 text-sm font-semibold mb-2">Kategori</label>
                        <input type="text" id="Kategori" name="Kategori" value="<%= kegiatan.Kategori || '' %>" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700">
                    </div>
                </div>
                <div class="mb-4">
                    <label for="Status" class="block text-gray-700 text-sm font-semibold mb-2">Status*</label>
                    <select id="Status" name="Status" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700" required>
                        <option value="Upcoming" <%= kegiatan.Status === 'Upcoming' ? 'selected' : '' %>>Upcoming (Akan Datang)</option>
                        <option value="Past" <%= kegiatan.Status === 'Past' ? 'selected' : '' %>>Past (Selesai)</option>
                    </select>
                </div>
                <div class="mb-4">
                    <label for="Deskripsi" class="block text-gray-700 text-sm font-semibold mb-2">Deskripsi (Konten)</label>
                    <textarea id="Deskripsi" name="Deskripsi" rows="5" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700"><%= kegiatan.dataValues.Deskripsi || '' %></textarea>
                </div>
                <hr class="my-6">
                <div class="mb-6">
                    <label for="fotoKegiatan" class="block text-gray-700 text-sm font-semibold mb-2">Tambah Foto ke Galeri</label>
                    <input type="file" id="fotoKegiatan" name="fotoKegiatan" accept="image/png, image/jpeg, image/jpg" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700" multiple>
                    <p class="text-xs text-gray-500 mt-1">Kosongkan jika tidak ingin menambah foto.</p>
                </div>
                <div class="flex items-center space-x-4">
                    <button type="submit" class="w-full bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded">
                        Simpan Perubahan
                    </button>
                    <a href="/admin/kegiatan" class="w-full text-center bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold py-2 px-4 rounded">
                        Batal
                    </a>
                </div>
            </form>
        </div>


        <div class="bg-white p-8 rounded-lg shadow-lg max-w-2xl mx-auto">
            <h2 class="text-xl font-bold text-gray-800 mb-4">Kelola Galeri Foto Saat Ini</h2>
            
            <% if (fotoList && fotoList.length > 0) { %>
                <form action="/admin/kegiatan/<%= kegiatan.ID_Kegiatan %>/bulk-delete-fotos" method="POST" id="bulk-foto-form">
                    
                    <div class="mb-4 flex justify-between items-center">
                        <button type="submit" class="bg-red-500 hover:bg-red-600 text-white font-bold py-2 px-4 rounded-lg">
                            Hapus Foto yang Dipilih
                        </button>
                        <div class="flex items-center space-x-2">
                            <input type="checkbox" id="select-all-fotos">
                            <label for="select-all-fotos">Pilih Semua</label>
                        </div>
                    </div>
                    
                    <div id="gallery-container" class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-4">
                        <% fotoList.forEach(foto => { %>
                            <div class="relative group" id="foto-wrapper-<%= foto.ID_Foto %>">
                                
                                <label for="foto-<%= foto.ID_Foto %>" class="cursor-pointer">
                                    <img src="/images/kegiatan/<%= foto.Foto %>" alt="Foto Kegiatan" class="h-24 w-full object-cover rounded-md border-2 border-transparent peer-checked:border-blue-500">
                                    <input type="checkbox" name="fotoIds" value="<%= foto.ID_Foto %>" id="foto-<%= foto.ID_Foto %>" class="absolute top-2 left-2 peer row-foto-checkbox">
                                </label>
                                
                                <% if (foto.ID_Foto === thumbnailId) { %>
                                    <span class="absolute top-1 right-1 bg-green-600 text-white text-xs px-2 py-0.5 rounded-full font-semibold">
                                        Thumbnail
                                    </span>
                                <% } else { %>
                                    <button 
                                        type="button" 
                                        class="absolute top-1 right-1 bg-blue-500 hover:bg-blue-600 text-white text-xs px-2 py-0.5 rounded-full opacity-0 group-hover:opacity-100 transition-opacity" 
                                        title="Jadikan Thumbnail"
                                        onclick="setThumbnail('<%= kegiatan.ID_Kegiatan %>', '<%= foto.ID_Foto %>')">
                                        Set Cover
                                    </button>
                                <% } %>
                                <button type="button" 
                                        class="absolute bottom-1 right-1 bg-yellow-500 hover:bg-yellow-600 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity"
                                        onclick="openReplaceModal('<%= kegiatan.ID_Kegiatan %>', '<%= foto.ID_Foto %>')">
                                    Ganti
                                </button>
                            </div>
                        <% }) %>
                    </div>
                </form>
            <% } else { %>
                <p class="text-sm text-gray-500 italic">Belum ada foto di galeri.</p>
            <% } %>
        </div>

        <dialog id="replace-foto-modal" class="p-6 rounded-lg shadow-xl w-full max-w-md">
            <h3 class="text-xl font-bold mb-4">Ganti Foto</h3>
            <form id="replace-foto-form" method="POST" enctype="multipart/form-data">
                <input type="hidden" name="_method" value="POST"> 
                <div class="mb-4">
                    <label for="newFoto" class="block text-gray-700 text-sm font-semibold mb-2">Pilih Foto Baru</label>
                    <input type="file" id="newFoto" name="newFoto" accept="image/png, image/jpeg, image/jpg" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700" required>
                </div>
                <div class="flex justify-end space-x-3">
                    <button type="button" onclick="closeReplaceModal()" class="bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold py-2 px-4 rounded">
                        Batal
                    </button>
                    <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded">
                        Ganti Foto
                    </button>
                </div>
            </form>
        </dialog>
    </main>

    <script>
        // Script untuk Bulk Delete Foto (Tidak berubah)
        document.getElementById('select-all-fotos').addEventListener('change', function(e) {
            const checkboxes = document.querySelectorAll('.row-foto-checkbox');
            checkboxes.forEach(cb => { cb.checked = e.target.checked; });
        });
        document.getElementById('bulk-foto-form').addEventListener('submit', function(e) {
            const checkedBoxes = document.querySelectorAll('.row-foto-checkbox:checked').length;
            if (checkedBoxes === 0) {
                e.preventDefault();
                alert('Tidak ada foto yang dipilih untuk dihapus.');
            } else if (!confirm(`Apakah Anda yakin ingin menghapus ${checkedBoxes} foto yang dipilih?`)) {
                e.preventDefault();
            }
        });

        // Script untuk Ganti Foto Modal (Tidak berubah)
        const replaceModal = document.getElementById('replace-foto-modal');
        const replaceForm = document.getElementById('replace-foto-form');
        function openReplaceModal(kegiatanId, fotoId) {
            replaceForm.action = `/admin/kegiatan/${kegiatanId}/foto/${fotoId}/replace`;
            replaceModal.showModal();
        }
        function closeReplaceModal() {
            replaceModal.close();
            replaceForm.reset();
        }

        // === SCRIPT BARU UNTUK "SET THUMBNAIL" ===
        function setThumbnail(kegiatanId, fotoId) {
            if (confirm('Jadikan foto ini sebagai thumbnail?')) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = `/admin/kegiatan/${kegiatanId}/foto/${fotoId}/set-thumbnail`;
                
                form.style.display = 'none';
                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
</body>
</html>