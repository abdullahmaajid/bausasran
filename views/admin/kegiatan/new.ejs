<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tambah Kegiatan Baru - Admin Bausasran</title>
    
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        main: '#003024',    // Background Gelap
                        surface: '#004030', // Warna Kartu
                        accent: '#83C540',  // Hijau Neon
                        pale: '#F5FEF9',    // Teks Putih
                        muted: '#A3C2B8',   // Teks Pudar
                        darker: '#00251a',  // Background Input
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style type="text/tailwindcss">
        @layer base {
            body { @apply bg-main text-pale font-sans antialiased; }
        }
        
        /* Custom Scrollbar */
        .custom-scroll::-webkit-scrollbar { width: 6px; }
        .custom-scroll::-webkit-scrollbar-track { background: transparent; }
        .custom-scroll::-webkit-scrollbar-thumb { background: #004030; border-radius: 10px; border: 1px solid rgba(255,255,255,0.1); }
        .custom-scroll::-webkit-scrollbar-thumb:hover { background: #83C540; }

        /* Input Styles */
        .form-input {
            @apply w-full bg-darker border border-white/10 rounded-xl px-4 py-3 text-sm text-pale focus:border-accent focus:ring-1 focus:ring-accent outline-none transition-all placeholder-white/20;
        }
        .form-label {
            @apply block text-sm font-bold text-muted mb-2 uppercase tracking-wider;
        }
        
        /* Fix Date Input Icon */
        input[type="date"]::-webkit-calendar-picker-indicator {
            filter: invert(1);
            cursor: pointer;
            opacity: 0.6;
        }
        input[type="date"]::-webkit-calendar-picker-indicator:hover { opacity: 1; }
    </style>
</head>

<body class="flex h-screen overflow-hidden w-full">

    <%- include('../../partials/admin_sidebar.ejs') %>

    <main class="flex-1 h-full overflow-y-auto overflow-x-hidden custom-scroll relative">
        <%- include('../../partials/flash.ejs') %>

        <form action="/admin/kegiatan" method="POST" enctype="multipart/form-data" class="min-h-full p-6 md:p-8 flex flex-col">
            
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6 shrink-0">
                <div>
                    <h1 class="text-3xl font-bold text-pale tracking-tight">Tambah Kegiatan</h1>
                    <p class="text-muted text-sm mt-1">Dokumentasi acara dan agenda kegiatan.</p>
                </div>
                <div class="md:hidden flex gap-2">
                    <button type="submit" class="flex-1 bg-accent text-main font-bold py-2 px-4 rounded-lg text-sm">Simpan</button>
                    <a href="/admin/kegiatan" class="bg-surface text-pale py-2 px-4 rounded-lg text-sm border border-white/10">Batal</a>
                </div>
            </div>

            <div class="flex flex-col lg:flex-row gap-6 items-stretch flex-1">
                
                <div class="w-full lg:flex-1 min-w-0 flex flex-col">
                    
                    <div class="bg-surface rounded-2xl p-6 md:p-8 shadow-xl border border-white/5 flex-1 flex flex-col h-full">
                        
                        <div class="mb-6 shrink-0">
                            <input type="text" id="Judul" name="Judul" 
                                class="w-full bg-transparent border-b border-white/10 px-0 py-2 text-2xl md:text-3xl font-bold text-pale focus:border-accent outline-none transition-colors placeholder-white/20" 
                                placeholder="Tulis Judul Kegiatan di Sini..." required>
                        </div>

                        <div class="flex-1 flex flex-col min-h-[300px]">
                            <label for="Deskripsi" class="form-label text-xs mb-3 shrink-0">Konten & Deskripsi</label>
                            <textarea id="Deskripsi" name="Deskripsi" 
                                class="w-full h-full bg-darker/50 border border-white/10 rounded-xl p-5 text-base text-pale leading-relaxed focus:border-accent outline-none transition-all resize-none placeholder-white/20" 
                                placeholder="Ceritakan detail kegiatan, latar belakang, serta hasil yang dicapai..."></textarea>
                        </div>
                    </div>

                </div>

                <div class="w-full lg:w-[350px] shrink-0 flex flex-col gap-6">
                    
                    <div class="bg-surface rounded-2xl p-6 shadow-xl border border-white/5">
                        <h3 class="text-lg font-bold text-pale mb-4 flex items-center gap-2">
                            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            Waktu & Status
                        </h3>
                        
                        <div class="space-y-4">
                            <div>
                                <label class="text-xs text-muted font-semibold block mb-1.5">Tanggal Pelaksanaan</label>
                                <input type="date" id="Tanggal" name="Tanggal" class="form-input" required>
                            </div>
                            <div>
                                <label class="text-xs text-muted font-semibold block mb-1.5">Status Kegiatan</label>
                                <div class="relative">
                                    <select id="Status" name="Status" class="form-input appearance-none cursor-pointer">
                                        <option value="Upcoming">🗓️ Upcoming (Akan Datang)</option>
                                        <option value="Past">✅ Past (Selesai)</option>
                                    </select>
                                    <div class="absolute right-4 top-3.5 pointer-events-none text-muted">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="hidden md:flex flex-col gap-3 mt-6 pt-6 border-t border-white/10">
                            <button type="submit" class="w-full bg-accent hover:bg-white text-main font-bold py-3 px-6 rounded-xl transition-all shadow-lg hover:shadow-accent/20 flex justify-center items-center gap-2">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                Simpan & Publikasikan
                            </button>
                            <a href="/admin/kegiatan" class="w-full text-center py-2 text-sm text-muted hover:text-white transition-colors">
                                Batalkan
                            </a>
                        </div>
                    </div>

                    <div class="bg-surface rounded-2xl p-6 shadow-xl border border-white/5">
                        <h3 class="text-lg font-bold text-pale mb-4 flex items-center gap-2">
                            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path></svg>
                            Kategori
                        </h3>
                        <div>
                            <input type="text" id="Kategori" name="Kategori" list="kategoriList" class="form-input" placeholder="Cari atau buat baru...">
                            <datalist id="kategoriList">
                                <option value="Panen Raya">
                                <option value="Penyuluhan">
                                <option value="Rapat Warga">
                                <option value="Kerja Bakti">
                            </datalist>
                        </div>
                    </div>

                    <div class="bg-surface rounded-2xl p-6 shadow-xl border border-white/5 flex-1 flex flex-col justify-center">
                        <h3 class="text-lg font-bold text-pale mb-4 flex items-center gap-2">
                            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            Galeri Foto
                        </h3>
                        
                        <div class="w-full bg-darker/50 border-2 border-dashed border-white/10 rounded-xl p-4 text-center hover:border-accent/50 transition-colors group relative overflow-hidden flex-1 flex flex-col justify-center min-h-[120px]">
                            <input type="file" id="fotoKegiatan" name="fotoKegiatan" multiple accept="image/png, image/jpeg, image/jpg" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" onchange="previewFiles()">
                            
                            <div class="flex flex-col items-center justify-center py-2">
                                <div class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center mb-2 group-hover:scale-110 transition-transform">
                                    <svg class="w-5 h-5 text-muted group-hover:text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                                </div>
                                <span class="text-xs font-bold text-pale group-hover:text-accent transition-colors">Klik untuk Upload</span>
                            </div>
                        </div>

                        <div id="filePreview" class="mt-4 hidden">
                            <ul id="fileList" class="space-y-2"></ul>
                        </div>
                    </div>

                </div> </div> </form>
    </main>

    <script>
        // 1. Auto Status Logic
        const dateInput = document.getElementById('Tanggal');
        const statusSelect = document.getElementById('Status');

        dateInput.addEventListener('change', function() {
            if(!this.value) return;
            const selectedDate = new Date(this.value);
            const today = new Date();
            today.setHours(0,0,0,0); 

            if (selectedDate < today) {
                statusSelect.value = 'Past';
            } else {
                statusSelect.value = 'Upcoming';
            }
        });

        // 2. File Preview Logic
        function previewFiles() {
            const input = document.getElementById('fotoKegiatan');
            const container = document.getElementById('filePreview');
            const list = document.getElementById('fileList');
            
            list.innerHTML = ''; 
            
            if (input.files.length > 0) {
                container.classList.remove('hidden');
                Array.from(input.files).forEach(file => {
                    const li = document.createElement('li');
                    li.className = "text-xs text-pale bg-white/5 px-2 py-1.5 rounded border border-white/5 flex items-center gap-2 truncate";
                    li.innerHTML = `
                        <svg class="w-3 h-3 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                        <span class="truncate">${file.name}</span>
                    `;
                    list.appendChild(li);
                });
            } else {
                container.classList.add('hidden');
            }
        }
    </script>
</body>
</html>