<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kata Mereka - Bausasran Heritage</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
    
    <script src="https://cdn.jsdelivr.net/gh/studio-freight/lenis@1.0.29/bundled/lenis.min.js"></script>

    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        paper: '#F9F7F2',       // Cream Background
                        deep: '#0F1F18',        // Dark Green (Primary)
                        gold: '#C5B388',        // Luxury Accent
                        charcoal: '#4A4A4A',    // Text
                        sand: '#E5E0D8',        // Border/Secondary
                        white: '#FFFFFF',
                    },
                    fontFamily: {
                        sans: ['Lato', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                        crest: ['Cinzel', 'serif'], 
                    },
                    letterSpacing: {
                        'luxury': '0.2em',
                        'widest': '0.3em',
                    },
                    boxShadow: {
                        'elegant': '0 10px 40px -10px rgba(15, 31, 24, 0.10)',
                    }
                }
            }
        }
    </script>

    <style type="text/tailwindcss">
        @layer base {
            body {
                @apply bg-paper text-deep font-sans antialiased selection:bg-deep selection:text-paper;
                overscroll-behavior: none; 
            }
        }
        
        /* TEXTURE OVERLAY */
        .noise-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none; z-index: 9999; mix-blend-mode: multiply;
        }

        /* QUOTE DECORATION */
        .quote-mark {
            font-family: 'Playfair Display', serif;
            font-size: 6rem;
            line-height: 0.5;
            position: absolute;
            top: 1rem;
            right: 1.5rem;
            opacity: 0.07;
            pointer-events: none;
            color: #0F1F18;
        }
    </style>
</head>

<body class="flex flex-col min-h-screen relative">

    <div class="noise-overlay"></div>

    <%- include('../partials/navbar.ejs') %>

    <main class="flex-grow pt-40 pb-24 px-6 relative z-10">
        <%- include('../partials/flash.ejs') %>

        <div class="max-w-6xl mx-auto text-center mb-16 animate-[fadeIn_1.5s]">
            <span class="font-sans text-[10px] uppercase tracking-widest text-gold mb-4 block">Voices of Visitors</span>
            <h1 class="font-crest text-4xl md:text-6xl text-deep mb-6 leading-none">Kata Mereka</h1>
            <p class="font-serif italic text-lg md:text-xl text-charcoal/70 max-w-2xl mx-auto leading-relaxed">
                "Kumpulan cerita dan pengalaman autentik dari para penikmat warisan budaya dan produk Bausasran."
            </p>
            <div class="w-[1px] h-16 bg-deep/10 mx-auto mt-10"></div>
        </div>

        <div class="max-w-4xl mx-auto mb-20 animate-[fadeIn_2s]">
            <% if (!currentUser) { %>
                <div class="bg-white border border-deep/5 p-10 text-center relative overflow-hidden shadow-sm group">
                    <div class="absolute top-0 left-0 w-full h-0.5 bg-gradient-to-r from-transparent via-gold/50 to-transparent"></div>
                    <h3 class="font-crest text-xl text-deep mb-3">Bagikan Pengalaman Anda</h3>
                    <p class="text-charcoal/60 text-sm font-serif italic mb-8 max-w-lg mx-auto">
                        Jejak Anda sangat berarti bagi kami. Bergabunglah untuk menulis ulasan tentang produk dan kegiatan kami.
                    </p>
                    <a href="/login" class="inline-block px-8 py-3 bg-deep text-paper text-[10px] uppercase tracking-widest font-bold border border-deep hover:bg-transparent hover:text-deep transition-all duration-500">
                        Login untuk Menulis
                    </a>
                </div>
            <% } else if (currentUser.Role === 'User') { %>
                <div class="bg-sand/10 border border-deep/10 p-8 md:p-10 flex flex-col md:flex-row items-center justify-between gap-6 relative overflow-hidden rounded-sm">
                    <div class="text-center md:text-left z-10">
                        <h3 class="font-crest text-xl text-deep mb-2">Halo, <%= currentUser.Nama %></h3>
                        <p class="text-charcoal/60 text-sm font-serif italic">Pendapat Anda membantu kami melestarikan kualitas warisan.</p>
                    </div>
                    <div class="z-10">
                        <a href="/user/testimoni/tambah" class="inline-flex items-center px-8 py-3 bg-white border border-deep/10 text-deep text-[10px] uppercase tracking-widest font-bold hover:border-gold hover:text-gold transition-all duration-300 shadow-sm hover:shadow-md">
                            <span class="mr-2 text-lg leading-none">+</span> Tulis Ulasan
                        </a>
                    </div>
                    <div class="absolute -right-8 -bottom-12 text-deep/5 font-serif italic text-9xl select-none pointer-events-none">✎</div>
                </div>
            <% } %>
        </div>

        <div class="flex justify-center mb-16">
            <div class="inline-flex flex-wrap justify-center gap-4">
                <button onclick="filterTestimoni('all')" id="btn-all" 
                    class="filter-btn px-8 py-2 text-[10px] uppercase tracking-widest border border-deep bg-deep text-paper transition-all duration-300 hover:shadow-lg">
                    Semua
                </button>
                <button onclick="filterTestimoni('Product')" id="btn-Product" 
                    class="filter-btn px-8 py-2 text-[10px] uppercase tracking-widest border border-deep/10 text-deep/60 hover:border-gold hover:text-deep bg-transparent transition-all duration-300">
                    Produk
                </button>
                <button onclick="filterTestimoni('Kegiatan')" id="btn-Kegiatan" 
                    class="filter-btn px-8 py-2 text-[10px] uppercase tracking-widest border border-deep/10 text-deep/60 hover:border-gold hover:text-deep bg-transparent transition-all duration-300">
                    Kegiatan
                </button>
            </div>
        </div>

        <% if(testimoniList && testimoniList.length > 0) { %>
            <div class="max-w-[1400px] mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                
                <% testimoniList.forEach(testimoni => { 
                    // Safe Data Handling
                    const t = testimoni.dataValues || testimoni;
                    // Access nested relations safely (Assuming controller includes Pengguna, Produk, Kegiatan)
                    const user = t.Pengguna || {}; 
                    const userName = user.Nama || t.penggunaName || 'Pengunjung';
                    const userFoto = user.Foto || t.penggunaFoto;
                    
                    // Determine Entity Name (Product/Activity Name)
                    let entityName = 'Umum';
                    let entityLink = '#';
                    if(t.Kategori === 'Product' && t.Produk) {
                        entityName = t.Produk.Nama_Produk || t.entityName;
                        entityLink = `/produk/${t.ID_Product}`;
                    } else if (t.Kategori === 'Kegiatan' && t.Kegiatan) {
                        entityName = t.Kegiatan.Nama_Kegiatan || t.entityName;
                        entityLink = `/kegiatan/${t.ID_Kegiatan}`;
                    } else if (t.entityName) {
                        // Fallback if relation not included but flat name provided
                        entityName = t.entityName;
                    }
                %>

                    <article class="testimoni-card group relative flex flex-col bg-white border border-deep/5 p-8 shadow-sm hover:shadow-elegant transition-all duration-500 hover:-translate-y-1" 
                             data-kategori="<%= t.Kategori %>">
                        
                        <div class="quote-mark">“</div>

                        <div class="flex items-center gap-4 mb-6 pb-6 border-b border-deep/5 relative z-10">
                            <div class="flex-shrink-0">
                                <% if (userFoto) { %>
                                    <img src="/images/anggota/<%= userFoto %>" 
                                         alt="<%= userName %>" 
                                         class="w-14 h-14 rounded-full object-cover border border-deep/10 p-1"
                                         onerror="this.onerror=null; this.src='https://ui-avatars.com/api/?name=<%= userName %>&background=E5E0D8&color=0F1F18';">
                                <% } else { %>
                                    <div class="w-14 h-14 rounded-full bg-sand/30 flex items-center justify-center border border-deep/10 text-deep font-serif italic text-xl">
                                        <%= userName.charAt(0) %>
                                    </div>
                                <% } %>
                            </div>
                            
                            <div>
                                <h3 class="font-crest text-sm text-deep tracking-wide mb-1"><%= userName %></h3>
                                <div class="flex items-center gap-0.5">
                                    <% for(let i = 1; i <= 5; i++) { %>
                                        <svg class="w-3 h-3 <%= i <= t.Rating ? 'text-gold fill-current' : 'text-sand fill-current' %>" viewBox="0 0 24 24">
                                            <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                                        </svg>
                                    <% } %>
                                </div>
                            </div>
                        </div>

                        <div class="flex-grow relative z-10">
                            <div class="mb-4 flex items-center gap-2">
                                <span class="px-2 py-0.5 text-[8px] uppercase tracking-widest font-bold border <%= t.Kategori === 'Product' ? 'border-gold text-gold' : 'border-deep/20 text-deep/60' %>">
                                    <%= t.Kategori === 'Product' ? 'Produk' : 'Kegiatan' %>
                                </span>
                            </div>

                            <p class="text-charcoal/80 text-lg font-serif italic leading-relaxed mb-6">
                                "<%= t.Ulasan %>"
                            </p>
                        </div>

                        <div class="mt-auto pt-4 border-t border-deep/5 relative z-10 flex justify-between items-center group-hover:border-gold/30 transition-colors">
                            <span class="text-[10px] uppercase tracking-widest text-deep/40 group-hover:text-deep/60 truncate max-w-[60%]">
                                <%= entityName %>
                            </span>
                            
                            <% if(entityLink !== '#') { %>
                                <a href="<%= entityLink %>" class="flex items-center text-[9px] uppercase tracking-widest text-deep hover:text-gold transition-colors font-bold">
                                    Lihat Detail
                                    <svg class="w-3 h-3 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"></path></svg>
                                </a>
                            <% } %>
                        </div>
                    </article>
                <% }) %>
            </div>

            <% if(testimoniList.length > 12) { %>
                <div class="mt-20 flex justify-center">
                    <nav class="flex items-center space-x-8 font-serif text-sm">
                        <a href="#" class="text-deep/40 hover:text-deep transition-colors">&larr; Previous</a>
                        <span class="text-gold font-bold border-b border-gold pb-1">1</span>
                        <a href="#" class="text-deep/40 hover:text-deep transition-colors">2</a>
                        <a href="#" class="text-deep hover:text-gold transition-colors">Next &rarr;</a>
                    </nav>
                </div>
            <% } %>

        <% } else { %>
            <div class="max-w-2xl mx-auto text-center py-32 border border-dashed border-deep/10 bg-sand/10 rounded-sm">
                <span class="font-crest text-4xl text-deep/20 mb-4 block">?</span>
                <h3 class="font-crest text-xl text-deep mb-2">Belum Ada Ulasan</h3>
                <p class="font-serif italic text-charcoal/60 text-sm">Jadilah yang pertama menuliskan cerita Anda di sini.</p>
            </div>
        <% } %>
    </main>

    <%- include('../partials/footer.ejs') %>

    <script>
        // 1. Initialize Smooth Scroll
        const lenis = new Lenis({ duration: 1.2, easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), direction: 'vertical', smooth: true });
        function raf(time) { lenis.raf(time); requestAnimationFrame(raf); }
        requestAnimationFrame(raf);

        // 2. Filter Logic with Fade Animation
        function filterTestimoni(kategori) {
            const cards = document.querySelectorAll('.testimoni-card');
            const buttons = document.querySelectorAll('.filter-btn');
            
            // Reset Button Styles
            buttons.forEach(btn => {
                btn.classList.remove('bg-deep', 'text-paper', 'border-deep');
                btn.classList.add('bg-transparent', 'text-deep/60', 'border-deep/10');
            });

            // Set Active Button
            const activeBtn = document.getElementById(`btn-${kategori}`);
            if(activeBtn) {
                activeBtn.classList.remove('bg-transparent', 'text-deep/60', 'border-deep/10');
                activeBtn.classList.add('bg-deep', 'text-paper', 'border-deep');
            }
            
            // Animate Cards
            cards.forEach(card => {
                if (kategori === 'all' || card.dataset.kategori === kategori) {
                    card.style.display = 'flex';
                    requestAnimationFrame(() => {
                        card.style.transition = 'all 0.5s ease-out';
                        card.style.opacity = '1';
                        card.style.transform = 'translateY(0)';
                    });
                } else {
                    card.style.opacity = '0';
                    card.style.transform = 'translateY(10px)';
                    setTimeout(() => {
                        card.style.display = 'none';
                    }, 300); // Wait for fade out
                }
            });
        }
    </script>

</body>
</html>