<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= produk.Nama %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="flex bg-gray-100">

    <%- include('../../partials/user_sidebar.ejs') %>

    <main class="flex-1 p-10">
        <%- include('../../partials/flash.ejs') %>

        <div class="mb-6">
            <a href="/user/produk" class="text-blue-500 hover:text-blue-700 font-semibold">
                ← Kembali ke Daftar Produk
            </a>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Main Content -->
            <div class="lg:col-span-2">
                <div class="bg-white rounded-lg shadow-lg p-8 mb-6">
                    <!-- Header -->
                    <h1 class="text-4xl font-bold text-gray-800 mb-4"><%= produk.Nama %></h1>
                    
                    <% if (produk.Harga) { %>
                        <p class="text-3xl font-bold text-green-600 mb-6">
                            Rp <%= Number(produk.Harga).toLocaleString('id-ID') %>
                        </p>
                    <% } %>

                    <!-- Info -->
                    <div class="grid grid-cols-2 gap-4 mb-6 text-sm">
                        <% if (produk.Kategori) { %>
                            <div class="bg-gray-50 p-3 rounded">
                                <p class="text-gray-600 mb-1">Kategori</p>
                                <p class="font-semibold text-gray-800"><%= produk.Kategori %></p>
                            </div>
                        <% } %>
                        <% if (produk.Stok !== null && produk.Stok !== undefined) { %>
                            <div class="bg-gray-50 p-3 rounded">
                                <p class="text-gray-600 mb-1">Stok</p>
                                <p class="font-semibold text-gray-800"><%= produk.Stok %> unit</p>
                            </div>
                        <% } %>
                    </div>

                    <!-- Deskripsi -->
                    <% if (produk.Deskripsi) { %>
                        <div class="mb-6">
                            <h2 class="text-2xl font-bold text-gray-800 mb-3">Deskripsi Produk</h2>
                            <div class="bg-gray-50 p-6 rounded-lg">
                                <p class="text-gray-700 leading-relaxed whitespace-pre-line"><%= produk.Deskripsi %></p>
                            </div>
                        </div>
                    <% } %>

                    <!-- Galeri Foto -->
                    <% if (produk.dataValues.fotoFiles && produk.dataValues.fotoFiles.length > 0) { %>
                        <div>
                            <h2 class="text-2xl font-bold text-gray-800 mb-3">Galeri Foto (<%= produk.dataValues.fotoFiles.length %>)</h2>
                            <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                                <% for(let foto of produk.dataValues.fotoFiles) { %>
                                    <div class="relative group cursor-pointer" onclick="openLightbox('<%= foto %>')">
                                        <img src="/images/produk/<%= foto %>" 
                                             alt="Foto Produk"
                                             class="w-full h-40 object-cover rounded-lg border-2 border-gray-200 hover:border-indigo-400 transition-all">
                                        <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-30 transition-all rounded-lg flex items-center justify-center">
                                            <svg class="w-8 h-8 text-white opacity-0 group-hover:opacity-100 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path>
                                            </svg>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Sidebar - Testimoni -->
            <div class="lg:col-span-1">
                <div class="bg-white rounded-lg shadow-lg p-6 sticky top-6">
                    <h2 class="text-2xl font-bold text-gray-800 mb-4">Testimoni</h2>
                    
                    <% if (reviewList && reviewList.length > 0) { %>
                        <div class="space-y-4 max-h-96 overflow-y-auto">
                            <% for(let review of reviewList) { %>
                                <div class="border-2 border-gray-200 rounded-lg p-4">
                                    <div class="flex justify-between items-start mb-2">
                                        <p class="font-semibold text-gray-800"><%= review.dataValues.namaPengguna %></p>
                                        <div class="flex items-center">
                                            <% for(let i = 1; i <= 5; i++) { %>
                                                <% if (i <= review.Rating) { %>
                                                    <span class="text-yellow-400 text-sm">★</span>
                                                <% } else { %>
                                                    <span class="text-gray-300 text-sm">★</span>
                                                <% } %>
                                            <% } %>
                                        </div>
                                    </div>
                                    <% if (review.Ulasan) { %>
                                        <p class="text-sm text-gray-600 italic">"<%= review.Ulasan %>"</p>
                                    <% } %>
                                </div>
                            <% } %>
                        </div>
                    <% } else { %>
                        <p class="text-gray-500 text-center py-8">Belum ada testimoni untuk produk ini.</p>
                    <% } %>

                    <a href="/user/testimoni/tambah" class="block w-full text-center bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 px-4 rounded-lg mt-4 transition-colors">
                        + Tulis Testimoni
                    </a>
                </div>
            </div>
        </div>
    </main>

    <%- include('../../partials/footer.ejs') %>

    <!-- Lightbox Modal -->
    <div id="lightbox" class="fixed inset-0 bg-black bg-opacity-90 z-50 hidden flex items-center justify-center p-4" onclick="closeLightbox()">
        <div class="relative max-w-5xl max-h-full">
            <button onclick="closeLightbox()" class="absolute -top-10 right-0 text-white text-3xl font-bold hover:text-gray-300">
                ×
            </button>
            <img id="lightbox-img" src="" alt="Preview" class="max-w-full max-h-screen rounded-lg">
        </div>
    </div>

    <script>
        function openLightbox(foto) {
            const lightbox = document.getElementById('lightbox');
            const img = document.getElementById('lightbox-img');
            img.src = '/images/produk/' + foto;
            lightbox.classList.remove('hidden');
            lightbox.classList.add('flex');
        }

        function closeLightbox() {
            const lightbox = document.getElementById('lightbox');
            lightbox.classList.add('hidden');
            lightbox.classList.remove('flex');
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeLightbox();
            }
        });
    </script>
</body>
</html>
