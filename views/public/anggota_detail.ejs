<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= anggota.Nama %> - Profil Anggota</title>
    
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        main: '#003024',    // Background Gelap
                        surface: '#004030', // Warna Kartu
                        accent: '#83C540',  // Hijau Neon
                        pale: '#F5FEF9',    // Teks Putih
                        muted: '#A3C2B8',   // Teks Pudar
                        gold: '#FACC15',    // Aksen Emas
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    boxShadow: {
                        'neon': '0 0 15px rgba(131, 197, 64, 0.3)',
                    }
                }
            }
        }
    </script>

    <style type="text/tailwindcss">
        @layer base {
            body {
                @apply bg-main text-pale font-sans antialiased;
            }
        }
    </style>
</head>

<body class="flex flex-col min-h-screen">

    <%- include('../partials/navbar.ejs') %>

    <main class="container mx-auto px-4 py-8 md:py-12 flex-grow">
        <%- include('../partials/flash.ejs') %>

        <nav class="flex mb-8 text-sm font-medium" aria-label="Breadcrumb">
            <ol class="inline-flex items-center space-x-1 md:space-x-3">
                <li class="inline-flex items-center">
                    <a href="/" class="text-muted hover:text-accent transition-colors">Home</a>
                </li>
                <li>
                    <div class="flex items-center">
                        <svg class="w-3 h-3 text-muted mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
                        </svg>
                        <a href="/anggota" class="text-muted hover:text-accent transition-colors">Anggota</a>
                    </div>
                </li>
                <li aria-current="page">
                    <div class="flex items-center">
                        <svg class="w-3 h-3 text-muted mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
                        </svg>
                        <span class="text-accent truncate max-w-[150px] md:max-w-xs"><%= anggota.Nama %></span>
                    </div>
                </li>
            </ol>
        </nav>

        <div class="max-w-5xl mx-auto">
            <div class="bg-surface rounded-2xl overflow-hidden shadow-lg border border-white/10 relative">
                
                <div class="absolute top-0 right-0 p-10 opacity-5 pointer-events-none">
                    <svg class="w-64 h-64 text-accent" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M12.316 3.051a1 1 0 01.633 1.265l-4 12a1 1 0 11-1.898-.632l4-12a1 1 0 011.265-.633zM5.707 6.293a1 1 0 010 1.414L3.414 10l2.293 2.293a1 1 0 11-1.414 1.414l-3-3a1 1 0 010-1.414l3-3a1 1 0 011.414 0zm8.586 0a1 1 0 011.414 0l3 3a1 1 0 010 1.414l-3 3a1 1 0 01-1.414-1.414L16.586 10l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
                </div>

                <div class="md:flex">
                    <div class="md:w-1/3 relative group">
                        <% 
                           // Handle data logic safely
                           const fotoFile = (anggota.dataValues && anggota.dataValues.fotoFile) ? anggota.dataValues.fotoFile : anggota.fotoFile;
                        %>
                        <% if (fotoFile) { %>
                            <img src="/images/anggota/<%= fotoFile %>" 
                                 alt="<%= anggota.Nama %>" 
                                 class="w-full h-full min-h-[300px] md:min-h-full object-cover transition-transform duration-700 group-hover:scale-105"
                                 onerror="this.src='https://via.placeholder.com/400x500?text=Foto+Anggota'">
                            <div class="absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent md:bg-gradient-to-r md:from-transparent md:to-surface opacity-80"></div>
                        <% } else { %>
                            <div class="w-full h-full min-h-[300px] flex flex-col items-center justify-center bg-main border-r border-white/5">
                                <svg class="w-32 h-32 text-muted/30 mb-4" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"/>
                                </svg>
                                <span class="text-muted text-sm">Foto belum tersedia</span>
                            </div>
                        <% } %>
                    </div>

                    <div class="md:w-2/3 p-8 relative z-10">
                        <div class="flex flex-col-reverse md:flex-row md:items-start md:justify-between mb-8 gap-4">
                            <div>
                                <h1 class="text-4xl font-bold text-pale mb-2"><%= anggota.Nama %></h1>
                                <% if (anggota.Jabatan) { %>
                                    <p class="text-xl text-accent font-semibold tracking-wide"><%= anggota.Jabatan %></p>
                                <% } else { %>
                                    <p class="text-xl text-muted font-medium">Anggota</p>
                                <% } %>
                            </div>
                            
                            <div>
                                <% if (anggota.Role === 'Admin') { %>
                                    <span class="inline-flex items-center px-4 py-1.5 rounded-full text-xs font-bold bg-purple-500/20 text-purple-300 border border-purple-500/30 shadow-neon">
                                        🛡️ ADMIN
                                    </span>
                                <% } else { %>
                                    <span class="inline-flex items-center px-4 py-1.5 rounded-full text-xs font-bold bg-accent/20 text-accent border border-accent/30">
                                        🌱 ANGGOTA
                                    </span>
                                <% } %>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 gap-y-4 mb-8">
                            <% if (anggota.username) { %>
                                <div class="flex items-center p-3 rounded-lg bg-main/50 border border-white/5 hover:border-accent/30 transition-colors">
                                    <div class="w-10 h-10 rounded-full bg-surface flex items-center justify-center mr-4 text-accent">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                                    </div>
                                    <div>
                                        <p class="text-xs text-muted uppercase tracking-wider">Username</p>
                                        <p class="text-pale font-medium">@<%= anggota.username %></p>
                                    </div>
                                </div>
                            <% } %>

                            <% if (anggota.No_Telepon) { %>
                                <div class="flex items-center p-3 rounded-lg bg-main/50 border border-white/5 hover:border-accent/30 transition-colors">
                                    <div class="w-10 h-10 rounded-full bg-surface flex items-center justify-center mr-4 text-accent">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                                    </div>
                                    <div>
                                        <p class="text-xs text-muted uppercase tracking-wider">Telepon</p>
                                        <p class="text-pale font-medium"><%= anggota.No_Telepon %></p>
                                    </div>
                                </div>
                            <% } %>

                            <% if (anggota.Alamat) { %>
                                <div class="flex items-center p-3 rounded-lg bg-main/50 border border-white/5 hover:border-accent/30 transition-colors">
                                    <div class="w-10 h-10 rounded-full bg-surface flex items-center justify-center mr-4 text-accent">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                    </div>
                                    <div>
                                        <p class="text-xs text-muted uppercase tracking-wider">Alamat</p>
                                        <p class="text-pale font-medium"><%= anggota.Alamat %></p>
                                    </div>
                                </div>
                            <% } %>

                            <% if (anggota.TanggalBergabung) { %>
                                <div class="flex items-center p-3 rounded-lg bg-main/50 border border-white/5 hover:border-accent/30 transition-colors">
                                    <div class="w-10 h-10 rounded-full bg-surface flex items-center justify-center mr-4 text-accent">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                    </div>
                                    <div>
                                        <p class="text-xs text-muted uppercase tracking-wider">Bergabung Sejak</p>
                                        <p class="text-pale font-medium">
                                            <%= new Date(anggota.TanggalBergabung).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                                        </p>
                                    </div>
                                </div>
                            <% } %>
                        </div>

                        <% if (anggota.No_Telepon) { %>
                            <a href="https://wa.me/<%= anggota.No_Telepon.replace(/[^0-9]/g, '') %>?text=Halo%20<%= encodeURIComponent(anggota.Nama) %>" 
                               target="_blank"
                               class="inline-flex items-center justify-center w-full md:w-auto px-8 py-4 bg-accent hover:bg-white text-main font-bold rounded-xl transition-all duration-300 shadow-neon group">
                                <svg class="w-5 h-5 mr-2 transition-transform group-hover:scale-110" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                                </svg>
                                Hubungi via WhatsApp
                            </a>
                        <% } %>
                    </div>
                </div>
            </div>

            <% if (anggota.Bio || anggota.Keterangan) { %>
                <div class="mt-8 bg-surface rounded-2xl p-8 shadow-lg border border-white/10">
                    <h2 class="text-xl font-bold text-pale mb-4 flex items-center">
                        <svg class="w-6 h-6 mr-2 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        Tentang <%= anggota.Nama %>
                    </h2>
                    <div class="prose prose-invert max-w-none text-muted leading-relaxed whitespace-pre-line">
                        <%= anggota.Bio || anggota.Keterangan %>
                    </div>
                </div>
            <% } %>

            <div class="mt-12 text-center">
                <a href="/anggota" class="inline-flex items-center px-6 py-3 border border-white/10 text-muted hover:text-white hover:bg-white/5 rounded-xl transition-all duration-300">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                    Kembali ke Daftar Anggota
                </a>
            </div>
        </div>
    </main>

    <%- include('../partials/footer.ejs') %>

</body>
</html>