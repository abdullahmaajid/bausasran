<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Produk - Bausasran</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-gray-100">

    <%- include('../partials/navbar.ejs') %>

    <main class="container mx-auto p-6 md:p-12">
        <%- include('../partials/flash.ejs') %>

        <!-- Header -->
        <div class="text-center mb-12">
            <h1 class="text-4xl font-bold text-gray-800 mb-4">Produk Unggulan</h1>
            <p class="text-lg text-gray-600">Berbagai produk berkualitas dari Bausasran</p>
        </div>

        <!-- Produk Grid -->
        <% if(produkList && produkList.length > 0) { %>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                <% produkList.forEach(produk => { %>
                    <div class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                        <div class="relative h-56 bg-gray-200">
                            <img 
                                src="https://via.placeholder.com/400x300?text=<%= encodeURIComponent(produk.Nama) %>" 
                                alt="<%= produk.Nama %>" 
                                class="w-full h-full object-cover">
                            <% if (produk.Kategori) { %>
                                <span class="absolute top-3 left-3 px-3 py-1 rounded-full text-xs font-semibold bg-blue-500 text-white">
                                    <%= produk.Kategori %>
                                </span>
                            <% } %>
                        </div>
                        <div class="p-5">
                            <h3 class="text-xl font-bold text-gray-900 mb-2 line-clamp-2"><%= produk.Nama %></h3>
                            <% if (produk.Deskripsi) { %>
                                <p class="text-gray-600 text-sm mb-3 line-clamp-2"><%= produk.Deskripsi %></p>
                            <% } %>
                            <div class="flex items-baseline justify-between mb-4">
                                <span class="text-2xl font-bold text-green-600">
                                    Rp <%= new Intl.NumberFormat('id-ID').format(produk.Harga) %>
                                </span>
                            </div>
                            <div class="flex space-x-2">
                                <a href="/produk/<%= produk.ID_Product %>" class="flex-1 text-center bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 px-4 rounded-lg transition-colors">
                                    Detail
                                </a>
                                <a 
                                    href="https://wa.me/62812345678?text=Halo, saya tertarik dengan <%= encodeURIComponent(produk.Nama) %>" 
                                    target="_blank"
                                    class="flex-1 text-center bg-green-500 hover:bg-green-600 text-white font-semibold py-2 px-4 rounded-lg transition-colors">
                                    <svg class="w-5 h-5 inline-block" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="text-center py-16">
                <svg class="w-24 h-24 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                </svg>
                <h3 class="text-xl font-semibold text-gray-700 mb-2">Belum Ada Produk</h3>
                <p class="text-gray-500">Produk akan segera hadir. Pantau terus halaman ini!</p>
            </div>
        <% } %>
    </main>

    <%- include('../partials/footer.ejs') %>

</body>
</html>
