<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kelola Galeri - Executive Console</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        paper: '#F9F7F2',       /* Cream Background */
                        deep: '#0F1F18',        /* Dark Emerald Green */
                        gold: '#C5B388',        /* Antique Gold */
                        charcoal: '#4A4A4A',    /* Soft Black */
                        linen: '#EBE9E4',       /* Light Gray/Beige */
                        white: '#FFFFFF',
                        danger: '#8B3A3A',      /* Elegant Red */
                    },
                    fontFamily: {
                        sans: ['Lato', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                        crest: ['Cinzel', 'serif'], 
                    },
                    boxShadow: {
                        'elegant': '0 20px 50px -12px rgba(15, 31, 24, 0.08)',
                        'gold-glow': '0 0 15px rgba(197, 179, 136, 0.2)',
                    }
                }
            }
        }
    </script>

    <style type="text/tailwindcss">
        @layer base {
            body { @apply bg-paper text-deep font-sans antialiased; }
        }

        /* TEXTURE: Film Grain Overlay */
        .noise-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.03'/%3E%3C/svg%3E");
            pointer-events: none; z-index: 50; mix-blend-mode: multiply;
        }

        /* Custom Checkbox Heritage Style */
        .custom-checkbox {
            @apply appearance-none h-5 w-5 border border-deep/20 bg-white checked:bg-deep checked:border-deep cursor-pointer transition-all relative shadow-sm;
        }
        .custom-checkbox:checked::after {
            content: '✓';
            @apply absolute inset-0 flex items-center justify-center text-gold font-bold text-[10px];
        }

        /* Input Luxury */
        .input-luxury {
            @apply bg-white border border-deep/10 px-4 py-2 text-sm text-deep placeholder-charcoal/30 focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold/50 transition-all duration-300 font-sans shadow-sm rounded-none;
        }

        /* Scrollbar */
        .custom-scroll::-webkit-scrollbar { width: 6px; }
        .custom-scroll::-webkit-scrollbar-track { background: transparent; }
        .custom-scroll::-webkit-scrollbar-thumb { background: #C5B388; border-radius: 3px; }
        .custom-scroll::-webkit-scrollbar-thumb:hover { background: #0F1F18; }
    </style>
</head>

<body class="flex h-screen overflow-hidden relative">

    <div class="noise-overlay"></div>

    <%- include('../../partials/admin_sidebar.ejs') %>

    <main class="flex-1 overflow-y-auto relative z-10 custom-scroll p-6 md:p-12">
        <%- include('../../partials/flash.ejs') %>

        <div class="flex flex-col md:flex-row justify-between items-end md:items-end mb-10 border-b border-deep/10 pb-6 gap-6">
            <div>
                <span class="font-sans text-[10px] uppercase tracking-widest text-gold mb-2 block">Dokumentasi Visual</span>
                <h1 class="font-crest text-3xl md:text-4xl text-deep leading-tight">Arsip Galeri</h1>
                <p class="font-serif italic text-charcoal/60 text-sm mt-2">Koleksi album kegiatan, landscape desa, dan momen bersejarah.</p>
            </div>
            
            <a href="/admin/galeri/new" class="group flex items-center gap-3 px-6 py-3 bg-deep text-gold text-[10px] font-bold uppercase tracking-[0.2em] border border-deep hover:bg-gold hover:text-deep hover:border-gold transition-all duration-500 shadow-lg hover:shadow-gold-glow">
                <span class="text-lg leading-none mb-0.5">+</span>
                <span>Buat Album</span>
            </a>
        </div>

        <div class="bg-white p-6 border border-deep/5 shadow-elegant mb-8 relative overflow-hidden group">
            <div class="absolute top-0 right-0 w-16 h-16 bg-gold/5 rounded-bl-full -mr-8 -mt-8"></div>
            
            <div class="flex flex-col md:flex-row gap-6 justify-between items-end md:items-center">
                
                <div class="w-full md:w-1/3 relative group/search">
                    <input type="text" id="searchInput" placeholder="Cari nama album..." 
                        class="w-full bg-transparent border-b border-deep/20 py-3 pl-8 pr-4 text-deep font-serif italic placeholder-deep/30 focus:border-gold focus:outline-none transition-all">
                    <svg class="w-4 h-4 text-deep/30 absolute left-0 top-3.5 group-focus-within/search:text-gold transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                </div>

                <div class="flex items-center gap-4 w-full md:w-auto">
                    <div class="flex items-center gap-3">
                         <span class="text-[9px] uppercase tracking-widest text-deep/40 font-bold hidden sm:block">Urutkan:</span>
                         <select id="sortFilter" class="input-luxury cursor-pointer min-w-[140px]">
                            <option value="newest">Terbaru</option>
                            <option value="name_asc">Nama (A-Z)</option>
                            <option value="count_desc">Foto Terbanyak</option>
                        </select>
                    </div>
                    
                    <button type="button" id="toggleSelectAll" class="px-4 py-2 bg-linen/50 hover:bg-linen border border-deep/10 text-[10px] font-bold uppercase tracking-widest text-deep/60 hover:text-deep transition-all">
                        Pilih Semua
                    </button>
                </div>
            </div>
        </div>

        <form action="/admin/galeri/bulk-action" method="POST" id="bulk-form">
            <input type="hidden" name="action" value="delete">

            <div id="bulk-action-bar" class="hidden mb-6 bg-danger text-white p-4 flex justify-between items-center shadow-lg border border-danger/80 animate-fade-in-down relative z-20">
                <span class="font-crest text-xs tracking-widest"><span id="selected-count" class="font-bold text-white">0</span> ALBUM DIPILIH</span>
                <button type="submit" class="text-[10px] bg-white text-danger font-bold uppercase tracking-widest py-2 px-5 hover:bg-paper transition-colors shadow-sm flex items-center gap-2">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                    Hapus Permanen
                </button>
            </div>
            
            <div id="galleryGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8 pb-20">
                <% if(groupFotoList && groupFotoList.length > 0) { %>
                    <% for(let group of groupFotoList) { %>
                        <div class="group relative bg-white p-3 shadow-sm hover:shadow-elegant border border-deep/5 transition-all duration-500 gallery-card"
                             data-name="<%= group.Nama.toLowerCase() %>"
                             data-count="<%= group.dataValues.photoCount %>"
                             data-id="<%= group.ID_GroupFoto %>">
                            
                            <div class="absolute top-5 left-5 z-20">
                                <input type="checkbox" name="selectedIds" value="<%= group.ID_GroupFoto %>" class="row-checkbox custom-checkbox shadow-md">
                            </div>

                            <div class="aspect-[4/3] w-full overflow-hidden bg-linen relative border border-deep/5">
                                <% if (group.dataValues.thumbnail) { %>
                                    <img src="/images/<%= group.dataValues.folder || 'galeri' %>/<%= group.dataValues.thumbnail %>" 
                                         alt="<%= group.Nama %>" 
                                         class="w-full h-full object-cover  group-hover:-0 transform group-hover:scale-105 transition-all duration-1000">
                                <% } else { %>
                                    <div class="w-full h-full flex flex-col items-center justify-center text-deep/20 bg-paper">
                                        <span class="text-2xl opacity-50 mb-1">📷</span>
                                        <span class="text-[9px] uppercase tracking-widest">Kosong</span>
                                    </div>
                                <% } %>

                                <div class="absolute bottom-0 right-0 bg-deep text-gold px-3 py-1 text-[9px] font-bold tracking-widest border-t border-l border-white/10 z-10">
                                    <%= group.dataValues.photoCount %> ITEM
                                </div>
                            </div>

                            <div class="pt-4 px-1 pb-1">
                                <h3 class="font-serif font-bold text-deep text-lg leading-tight group-hover:text-gold transition-colors truncate mb-1" title="<%= group.Nama %>">
                                    <%= group.Nama %>
                                </h3>
                                <p class="text-[9px] text-charcoal/40 font-mono tracking-wider uppercase mb-4">ID: <%= group.ID_GroupFoto %></p>

                                <div class="grid grid-cols-3 gap-0 border-t border-deep/5 pt-3">
                                    <a href="/admin/galeri/<%= group.ID_GroupFoto %>" class="flex items-center justify-center text-deep/40 hover:text-deep hover:bg-gold/10 transition-colors py-1 text-[10px] font-bold uppercase tracking-widest border-r border-deep/5">
                                        Lihat
                                    </a>
                                    <a href="/admin/galeri/<%= group.ID_GroupFoto %>/edit" class="flex items-center justify-center text-deep/40 hover:text-gold hover:bg-deep transition-colors py-1 text-[10px] font-bold uppercase tracking-widest border-r border-deep/5">
                                        Edit
                                    </a>
                                    <button type="button" onclick="deleteItem('<%= group.ID_GroupFoto %>', '<%= group.Nama.replace(/'/g, "\\'") %>')" class="flex items-center justify-center text-deep/40 hover:text-white hover:bg-danger transition-colors py-1 text-[10px] font-bold uppercase tracking-widest">
                                        Hapus
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% } %>
                <% } else { %>
                    <div class="col-span-full py-24 text-center flex flex-col items-center justify-center opacity-60">
                        <svg class="w-16 h-16 text-deep/20 mb-4 stroke-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                        <h3 class="text-xl font-crest text-deep">Arsip Galeri Kosong</h3>
                        <p class="font-serif italic text-charcoal/60 mt-2">Silakan buat album baru untuk memulai dokumentasi.</p>
                    </div>
                <% } %>
            </div>
            
            <div id="noResultsMsg" class="hidden py-20 text-center text-deep/40 font-serif italic bg-white/50 border border-deep/5">
                <p>Tidak ditemukan album dalam arsip dengan nama tersebut.</p>
            </div>
        </form>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('searchInput');
            const sortFilter = document.getElementById('sortFilter');
            const galleryGrid = document.getElementById('galleryGrid');
            const noResultsMsg = document.getElementById('noResultsMsg');
            let cards = Array.from(document.querySelectorAll('.gallery-card'));

            // --- 1. FILTER & SEARCH LOGIC ---
            function filterAndSort() {
                const searchTerm = searchInput.value.toLowerCase();
                const sortValue = sortFilter.value;

                // Filter Visual
                let visibleCount = 0;
                cards.forEach(card => {
                    const name = card.getAttribute('data-name');
                    if (name.includes(searchTerm)) {
                        card.style.display = '';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                // Show/Hide No Results
                if(visibleCount === 0 && cards.length > 0) {
                    noResultsMsg.classList.remove('hidden');
                } else {
                    noResultsMsg.classList.add('hidden');
                }

                // Sorting Logic
                const visibleCards = cards.filter(c => c.style.display !== 'none');
                
                visibleCards.sort((a, b) => {
                    const nameA = a.getAttribute('data-name');
                    const nameB = b.getAttribute('data-name');
                    const countA = parseInt(a.getAttribute('data-count'));
                    const countB = parseInt(b.getAttribute('data-count'));
                    const idA = parseInt(a.getAttribute('data-id'));
                    const idB = parseInt(b.getAttribute('data-id'));

                    if (sortValue === 'name_asc') return nameA.localeCompare(nameB);
                    if (sortValue === 'count_desc') return countB - countA;
                    if (sortValue === 'newest') return idB - idA;
                    return 0;
                });

                visibleCards.forEach(card => galleryGrid.appendChild(card));
            }

            if(searchInput) searchInput.addEventListener('input', filterAndSort);
            if(sortFilter) sortFilter.addEventListener('change', filterAndSort);


            // --- 2. BULK ACTION LOGIC ---
            const toggleSelectAllBtn = document.getElementById('toggleSelectAll');
            const checkboxes = document.querySelectorAll('.row-checkbox');
            const bulkActionBar = document.getElementById('bulk-action-bar');
            const selectedCountSpan = document.getElementById('selected-count');

            function updateBulkState() {
                // Count visible checkboxes only
                const checked = Array.from(document.querySelectorAll('.row-checkbox:checked')).filter(cb => {
                    return cb.closest('.gallery-card').style.display !== 'none';
                });
                
                selectedCountSpan.innerText = checked.length;
                
                if (checked.length > 0) {
                    bulkActionBar.classList.remove('hidden');
                    bulkActionBar.classList.add('flex');
                } else {
                    bulkActionBar.classList.add('hidden');
                    bulkActionBar.classList.remove('flex');
                }
            }

            if(toggleSelectAllBtn) {
                toggleSelectAllBtn.addEventListener('click', function() {
                    const visibleCheckboxes = Array.from(checkboxes).filter(cb => cb.closest('.gallery-card').style.display !== 'none');
                    if(visibleCheckboxes.length === 0) return;

                    const allChecked = visibleCheckboxes.every(cb => cb.checked);
                    
                    visibleCheckboxes.forEach(cb => {
                        cb.checked = !allChecked;
                    });
                    
                    updateBulkState();
                    this.innerText = !allChecked ? 'BATAL' : 'PILIH SEMUA';
                });
            }

            checkboxes.forEach(cb => {
                cb.addEventListener('change', updateBulkState);
                cb.addEventListener('click', (e) => e.stopPropagation());
            });

            // --- 3. DELETE ACTIONS ---
            const bulkForm = document.getElementById('bulk-form');
            if(bulkForm) {
                bulkForm.addEventListener('submit', function(e) {
                    const count = document.querySelectorAll('.row-checkbox:checked').length;
                    if(count === 0) {
                        e.preventDefault(); 
                        return;
                    }
                    if(!confirm(`PERINGATAN KERAS:\n\nAnda akan menghapus ${count} album beserta SELURUH FOTO di dalamnya secara permanen.\n\nTindakan ini tidak dapat dibatalkan. Lanjutkan?`)) {
                        e.preventDefault();
                    }
                });
            }
        });

        function deleteItem(id, name) {
            if (confirm(`PERINGATAN KERAS:\n\nMenghapus album "${name}" akan menghapus permanen SEMUA FOTO di dalamnya.\n\nApakah Anda yakin ingin melanjutkan?`)) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = `/admin/galeri/${id}/delete`;
                form.style.display = 'none';
                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
</body>
</html>