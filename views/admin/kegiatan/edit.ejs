<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jurnal Kegiatan: <%= kegiatan.Judul %> - Executive Console</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Courier+Prime:wght@400;700&display=swap" rel="stylesheet">
    
    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        paper: '#F9F7F2',       /* Latar Belakang Kertas Tua */
                        deep: '#0F1F18',        /* Tinta Hijau Gelap */
                        gold: '#C5B388',        /* Emas Antik */
                        charcoal: '#4A4A4A',    /* Abu Arang */
                        linen: '#EBE9E4',       /* Abu Linen */
                        white: '#FFFFFF',
                        danger: '#8B3A3A',      /* Merah Bata Elegan */
                        info: '#5B7C99',        /* Biru Pudar */
                    },
                    fontFamily: {
                        sans: ['Lato', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                        crest: ['Cinzel', 'serif'], 
                        mono: ['Courier Prime', 'monospace'],
                    },
                    boxShadow: {
                        'elegant': '0 20px 50px -12px rgba(15, 31, 24, 0.08)',
                        'gold-glow': '0 0 15px rgba(197, 179, 136, 0.2)',
                    }
                }
            }
        }
    </script>

    <style type="text/tailwindcss">
        @layer base {
            body { @apply bg-paper text-deep font-sans antialiased; }
        }

        /* TEXTURE: Film Grain Overlay */
        .noise-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.03'/%3E%3C/svg%3E");
            pointer-events: none; z-index: 50; mix-blend-mode: multiply;
        }

        /* COMPONENTS */
        .input-label { 
            @apply block text-[10px] uppercase tracking-[0.15em] font-bold text-deep/60 mb-2 font-sans; 
        }

        .input-luxury {
            @apply w-full bg-white border border-deep/10 px-4 py-3 text-sm text-deep placeholder-deep/20 focus:outline-none focus:border-gold focus:ring-1 focus:ring-gold/50 transition-all duration-300 font-sans shadow-sm rounded-sm appearance-none;
        }

        .input-headline {
            @apply w-full bg-transparent border-b-2 border-deep/10 px-2 py-2 -mx-2 text-2xl md:text-3xl font-serif font-bold text-deep placeholder-deep/15 focus:outline-none focus:border-gold focus:bg-white/40 transition-all duration-300;
        }

        /* Checkbox Custom */
        .custom-check { @apply appearance-none w-4 h-4 border border-deep/30 rounded-sm checked:bg-deep checked:border-deep cursor-pointer transition-colors relative; }
        .custom-check:checked::after { content: '✓'; @apply absolute inset-0 flex items-center justify-center text-gold text-[10px] font-bold leading-none; }

        /* Modal Backdrop */
        dialog::backdrop { background: rgba(15, 31, 24, 0.6); backdrop-filter: sepia(80%); }
    </style>
</head>

<body class="flex h-screen overflow-hidden relative">

    <div class="noise-overlay"></div>

    <%- include('../../partials/admin_sidebar.ejs') %>

    <main class="flex-1 h-full overflow-y-auto overflow-x-hidden p-6 md:p-12 relative z-10 custom-scroll">
        <%- include('../../partials/flash.ejs') %>

        <div class="max-w-6xl mx-auto flex flex-col min-h-full">
            
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 border-b border-deep/10 pb-6">
                <div>
                    <span class="font-sans text-[10px] uppercase tracking-widest text-gold mb-2 block">Agenda & Dokumentasi</span>
                    <h1 class="font-crest text-3xl md:text-4xl text-deep leading-tight">Sunting Kegiatan</h1>
                    <p class="font-serif italic text-charcoal/60 text-sm mt-2">Pembaruan jurnal kegiatan dan manajemen arsip foto.</p>
                </div>
                <div class="flex gap-4">
                    <a href="/admin/kegiatan" class="px-6 py-3 border border-deep/10 text-deep/60 text-[10px] uppercase tracking-widest font-bold hover:bg-white hover:text-deep transition-all flex items-center justify-center">
                        Tutup Berkas
                    </a>
                </div>
            </div>

            <form action="/admin/kegiatan/<%= kegiatan.ID_Kegiatan %>/edit" method="POST" enctype="multipart/form-data" class="flex flex-col lg:flex-row gap-8 lg:gap-12 items-start mb-12">
                
                <div class="w-full lg:flex-1 space-y-8">
                    <div class="bg-white p-8 border border-deep/5 shadow-elegant relative h-full">
                        <div class="absolute top-0 left-0 w-1 h-full bg-gold/50"></div>
                        
                        <div class="mb-8">
                            <label for="Judul" class="input-label text-gold">Nama Kegiatan / Peristiwa</label>
                            <input type="text" id="Judul" name="Judul" value="<%= kegiatan.Judul %>" class="input-headline" required>
                        </div>

                        <div>
                            <label for="Deskripsi" class="input-label">Narasi Lengkap</label>
                            <textarea id="Deskripsi" name="Deskripsi" rows="8" class="w-full bg-paper/50 border border-deep/10 p-6 text-sm text-deep/80 leading-loose font-serif italic focus:outline-none focus:border-gold resize-y placeholder-deep/20 transition-all shadow-inner" placeholder="Tuliskan detail peristiwa..."><%= kegiatan.Deskripsi || (kegiatan.dataValues ? kegiatan.dataValues.Deskripsi : '') %></textarea>
                        </div>
                    </div>
                </div>

                <div class="w-full lg:w-[350px] shrink-0 flex flex-col gap-6">
                    
                    <div class="bg-deep/5 p-6 border border-deep/5 rounded-sm relative">
                        <h3 class="font-crest text-sm text-deep mb-5 flex items-center gap-2 border-b border-deep/10 pb-3">
                            <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            Detail Pelaksanaan
                        </h3>

                        <div class="space-y-5">
                            <div>
                                <label for="Tanggal" class="input-label">Waktu</label>
                                <input type="date" id="Tanggal" name="Tanggal" value="<%= kegiatan.Tanggal %>" class="input-luxury font-mono text-xs uppercase" required>
                            </div>

                            <div>
                                <label for="Kategori" class="input-label">Kategori</label>
                                <input type="text" id="Kategori" name="Kategori" value="<%= kegiatan.Kategori || '' %>" placeholder="Contoh: Panen Raya" class="input-luxury">
                            </div>

                            <div>
                                <label for="Status" class="input-label">Status Arsip</label>
                                <div class="relative">
                                    <select id="Status" name="Status" class="input-luxury cursor-pointer appearance-none">
                                        <option value="Upcoming" <%= kegiatan.Status === 'Upcoming' ? 'selected' : '' %>>○ Akan Datang (Upcoming)</option>
                                        <option value="Past" <%= kegiatan.Status === 'Past' ? 'selected' : '' %>>● Selesai (Past)</option>
                                    </select>
                                    <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none">
                                        <div class="w-0 h-0 border-l-[4px] border-l-transparent border-r-[4px] border-r-transparent border-t-[6px] border-t-gold"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="bg-white p-6 border border-deep/5 shadow-elegant">
                        <label class="input-label mb-3 block">Tambah Foto Dokumentasi</label>
                        <label for="fotoKegiatan" class="relative flex flex-col items-center justify-center w-full h-32 bg-linen/30 border-2 border-dashed border-deep/20 cursor-pointer group hover:border-gold hover:bg-white transition-all duration-300">
                            <input type="file" id="fotoKegiatan" name="fotoKegiatan" multiple accept="image/png, image/jpeg, image/jpg" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10">
                            
                            <div class="flex flex-col items-center pointer-events-none text-deep/40 group-hover:text-gold transition-colors">
                                <svg class="w-8 h-8 mb-2 stroke-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                <span class="text-[9px] font-bold uppercase tracking-widest">Upload Foto Baru</span>
                            </div>
                        </label>
                        <p class="text-[9px] text-center text-deep/40 italic font-serif mt-2">Mendukung upload banyak file sekaligus.</p>
                    </div>

                    <button type="submit" class="w-full px-8 py-3 bg-deep text-gold text-[10px] uppercase tracking-[0.2em] font-bold border border-deep hover:bg-gold hover:text-deep hover:border-gold transition-all shadow-lg flex items-center justify-center gap-2 group">
                        <span>Simpan Arsip</span>
                    </button>
                </div>
            </form>

            <div class="border-t border-deep/10 pt-8 mt-4">
                <div class="flex items-center justify-between mb-6">
                    <h3 class="font-crest text-xl text-deep flex items-center gap-2">
                        <span class="text-gold text-2xl">❖</span> Lembar Kontak (Galeri)
                    </h3>
                </div>

                <% if (fotoList && fotoList.length > 0) { %>
                    <form action="/admin/kegiatan/<%= kegiatan.ID_Kegiatan %>/bulk-delete-fotos" method="POST" id="bulk-foto-form">
                        
                        <div class="flex items-center gap-4 mb-6 bg-linen/30 p-3 border border-deep/5">
                            <label class="flex items-center gap-2 cursor-pointer select-none text-xs font-bold text-deep/60 hover:text-deep transition-colors uppercase tracking-wider">
                                <input type="checkbox" id="select-all-fotos" class="custom-check">
                                <span>Pilih Semua</span>
                            </label>
                            <div class="h-4 w-px bg-deep/10"></div>
                            <button type="submit" id="btn-delete-bulk" disabled class="text-xs font-bold text-danger disabled:opacity-30 disabled:cursor-not-allowed hover:underline flex items-center gap-1 uppercase tracking-wider">
                                [ Hapus Terpilih ]
                            </button>
                        </div>

                        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-6">
                            <% fotoList.forEach(foto => { %>
                                <div class="relative group bg-white p-2 shadow-sm border border-deep/10 hover:shadow-gold-glow transition-all">
                                    
                                    <div class="aspect-square overflow-hidden bg-charcoal relative">
                                        <img src="/images/kegiatan/<%= foto.Foto %>" alt="Dokumentasi" class="w-full h-full object-cover filter sepia-[0.4] group-hover:sepia-0 transition-all duration-500">
                                        
                                        <div class="absolute top-2 left-2 z-20">
                                            <input type="checkbox" name="fotoIds" value="<%= foto.ID_Foto %>" class="row-foto-checkbox custom-check bg-white/80 border-none shadow-sm">
                                        </div>

                                        <% if (foto.ID_Foto === thumbnailId) { %>
                                            <div class="absolute top-2 right-2 bg-gold text-deep text-[9px] font-bold px-2 py-0.5 border border-deep/20 shadow-md z-20 uppercase tracking-widest">
                                                Sampul
                                            </div>
                                        <% } %>
                                    </div>

                                    <div class="mt-2 flex flex-col gap-1">
                                        <% if (foto.ID_Foto !== thumbnailId) { %>
                                            <button type="button" 
                                                onclick="setThumbnail('<%= kegiatan.ID_Kegiatan %>', '<%= foto.ID_Foto %>')"
                                                class="w-full py-1 text-[9px] font-bold text-deep/60 hover:text-deep hover:bg-linen/50 transition-colors uppercase tracking-wider border border-transparent hover:border-deep/5 text-center">
                                                Jadikan Sampul
                                            </button>
                                        <% } else { %>
                                            <span class="w-full py-1 text-[9px] font-bold text-gold text-center uppercase tracking-wider border-b border-gold/20 block">
                                                Foto Utama
                                            </span>
                                        <% } %>

                                        <button type="button" 
                                            onclick="openReplaceModal('<%= kegiatan.ID_Kegiatan %>', '<%= foto.ID_Foto %>')"
                                            class="w-full py-1 text-[9px] font-bold text-info hover:text-deep hover:bg-linen/50 transition-colors uppercase tracking-wider border border-transparent hover:border-deep/5 text-center">
                                            Ganti File
                                        </button>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </form>
                <% } else { %>
                    <div class="text-center py-12 border border-dashed border-deep/20 bg-linen/10">
                        <p class="font-serif italic text-deep/40 text-sm">Belum ada dokumentasi visual dalam arsip ini.</p>
                    </div>
                <% } %>
            </div>
        </div>
    </main>

    <dialog id="replace-foto-modal" class="bg-paper p-0 shadow-2xl w-full max-w-sm border border-deep/10 outline-none">
        <div class="relative p-6 border-4 border-double border-deep/5">
            <h3 class="font-crest text-lg text-deep mb-4 border-b border-deep/10 pb-2 text-center">Ganti Dokumen Foto</h3>
            
            <form id="replace-foto-form" method="POST" enctype="multipart/form-data">
                <input type="hidden" name="_method" value="POST"> 
                
                <div class="mb-6">
                    <label for="newFoto" class="input-label text-center mb-4">Pilih File Pengganti</label>
                    <input type="file" id="newFoto" name="newFoto" accept="image/png, image/jpeg, image/jpg" class="block w-full text-xs text-deep file:mr-4 file:py-2 file:px-4 file:border-0 file:text-[10px] file:font-bold file:uppercase file:bg-deep file:text-gold hover:file:bg-gold hover:file:text-deep transition-all border border-deep/10 bg-white p-1" required>
                </div>

                <div class="flex justify-between gap-3 pt-4 border-t border-deep/10">
                    <button type="button" onclick="closeReplaceModal()" class="px-4 py-2 text-[10px] uppercase font-bold text-deep/60 hover:text-deep hover:underline transition-colors">
                        Batal
                    </button>
                    <button type="submit" class="px-6 py-2 bg-deep text-gold text-[10px] uppercase font-bold hover:bg-gold hover:text-deep transition-all shadow-md">
                        Simpan
                    </button>
                </div>
            </form>
        </div>
    </dialog>

    <script>
        // --- 1. LOGIKA BULK DELETE ---
        const checkAll = document.getElementById('select-all-fotos');
        const bulkBtn = document.getElementById('btn-delete-bulk');
        const bulkForm = document.getElementById('bulk-foto-form');
        
        if (checkAll && bulkForm) {
            checkAll.addEventListener('change', function(e) {
                const checkboxes = document.querySelectorAll('.row-foto-checkbox');
                checkboxes.forEach(cb => cb.checked = e.target.checked);
                toggleBulkButton();
            });

            document.querySelectorAll('.row-foto-checkbox').forEach(cb => {
                cb.addEventListener('change', toggleBulkButton);
            });

            function toggleBulkButton() {
                const count = document.querySelectorAll('.row-foto-checkbox:checked').length;
                bulkBtn.disabled = count === 0;
                bulkBtn.textContent = count > 0 
                    ? `[ Hapus (${count}) Foto ]` 
                    : `[ Hapus Terpilih ]`;
            }

            bulkForm.addEventListener('submit', function(e) {
                const checkedBoxes = document.querySelectorAll('.row-foto-checkbox:checked').length;
                if (checkedBoxes === 0) {
                    e.preventDefault();
                } else if (!confirm(`PERINGATAN ARSIP:\n\nApakah Anda yakin ingin menghapus ${checkedBoxes} foto ini secara permanen?`)) {
                    e.preventDefault();
                }
            });
        }

        // --- 2. LOGIKA MODAL GANTI FOTO ---
        const replaceModal = document.getElementById('replace-foto-modal');
        const replaceForm = document.getElementById('replace-foto-form');

        function openReplaceModal(kegiatanId, fotoId) {
            if(!replaceModal || !replaceForm) return;
            replaceForm.action = `/admin/kegiatan/${kegiatanId}/foto/${fotoId}/replace`;
            replaceModal.showModal();
        }

        function closeReplaceModal() {
            if(!replaceModal) return;
            replaceModal.close();
            replaceForm.reset();
        }

        replaceModal.addEventListener('click', (e) => {
            if (e.target === replaceModal) closeReplaceModal();
        });

        // --- 3. LOGIKA SET THUMBNAIL ---
        function setThumbnail(kegiatanId, fotoId) {
            if (confirm('Jadikan foto ini sebagai Sampul Utama kegiatan?')) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = `/admin/kegiatan/${kegiatanId}/foto/${fotoId}/set-thumbnail`;
                form.style.display = 'none';
                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
</body>
</html>