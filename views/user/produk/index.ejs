<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Produk Kami - Bausasran</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        main: '#003024',    // Background Gelap
                        surface: '#004030', // Warna Kartu
                        accent: '#83C540',  // Hijau Neon
                        pale: '#F5FEF9',    // Teks Putih
                        muted: '#A3C2B8',   // Teks Pudar
                    },
                    fontFamily: { sans: ['Inter', 'sans-serif'] }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer base { 
            body { @apply bg-main text-pale font-sans antialiased; } 
            .custom-scroll::-webkit-scrollbar { width: 8px; }
            .custom-scroll::-webkit-scrollbar-track { @apply bg-main; }
            .custom-scroll::-webkit-scrollbar-thumb { @apply bg-surface border border-white/10 rounded-full; }
        }
    </style>
</head>
<body class="flex h-screen overflow-hidden">

    <%- include('../../partials/user_sidebar.ejs') %>

    <main class="flex-1 overflow-y-auto custom-scroll p-6 md:p-10 relative">
        
        <div class="fixed top-0 right-0 w-[500px] h-[500px] bg-accent/5 rounded-full blur-[100px] pointer-events-none -z-10"></div>

        <%- include('../../partials/flash.ejs') %>

        <div class="mb-10 flex flex-col md:flex-row justify-between items-start md:items-end gap-6 border-b border-white/10 pb-6">
            <div>
                <h1 class="text-3xl md:text-4xl font-bold text-pale mb-2">
                    Katalog <span class="text-accent">Produk</span>
                </h1>
                <p class="text-muted text-lg">Jelajahi hasil panen dan olahan terbaik dari Kelompok Tani.</p>
            </div>
            
            <a href="/user/produk/pencocokan" class="group relative inline-flex items-center justify-center px-6 py-3 font-bold text-main transition-all duration-200 bg-accent font-pj rounded-xl focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent hover:bg-white hover:shadow-[0_0_20px_rgba(131,197,64,0.4)]">
                <span class="absolute inset-0 w-full h-full -mt-1 rounded-lg opacity-30 bg-gradient-to-b from-transparent via-transparent to-black"></span>
                <span class="relative flex items-center">
                    <svg class="w-5 h-5 mr-2 -ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
                    Pencocokan Produk
                </span>
            </a>
        </div>

        <div class="pb-10">
            <% if (produkList && produkList.length > 0) { %>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                    <% for(let produk of produkList) { %>
                        <div class="group bg-surface border border-white/5 rounded-2xl overflow-hidden hover:border-accent/50 hover:shadow-lg transition-all duration-300 flex flex-col h-full">
                            
                            <div class="h-56 relative overflow-hidden bg-black/20 group-hover:opacity-100">
                                <% if (produk.dataValues.thumbnailFile) { %>
                                    <img src="/images/produk/<%= produk.dataValues.thumbnailFile %>" 
                                         alt="<%= produk.Nama %>"
                                         class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500">
                                <% } else { %>
                                    <div class="w-full h-full flex items-center justify-center bg-surface">
                                        <svg class="w-16 h-16 text-white/5 group-hover:text-accent/20 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                                        </svg>
                                    </div>
                                <% } %>
                                
                                <% if (produk.Kategori) { %>
                                    <div class="absolute top-3 left-3">
                                        <span class="px-3 py-1 text-[10px] font-bold uppercase tracking-wider rounded-md bg-black/60 backdrop-blur-sm text-pale border border-white/10">
                                            <%= produk.Kategori %>
                                        </span>
                                    </div>
                                <% } %>

                                <% if (produk.dataValues.fotoCount > 0) { %>
                                    <div class="absolute top-3 right-3">
                                        <span class="flex items-center px-2 py-1 text-xs font-bold rounded-md bg-accent text-main shadow-lg">
                                            <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                            <%= produk.dataValues.fotoCount %>
                                        </span>
                                    </div>
                                <% } %>
                            </div>

                            <div class="p-5 flex-1 flex flex-col">
                                <div class="flex-1">
                                    <h3 class="text-xl font-bold text-pale mb-2 group-hover:text-accent transition-colors line-clamp-1" title="<%= produk.Nama %>">
                                        <%= produk.Nama %>
                                    </h3>
                                    
                                    <% if (produk.Deskripsi) { %>
                                        <p class="text-sm text-muted line-clamp-2 mb-4 h-10 leading-relaxed">
                                            <%= produk.Deskripsi %>
                                        </p>
                                    <% } else { %>
                                        <p class="text-sm text-muted/50 italic mb-4 h-10">Tidak ada deskripsi.</p>
                                    <% } %>
                                </div>

                                <div class="mt-4 pt-4 border-t border-white/5 flex items-center justify-between">
                                    <div class="flex flex-col">
                                        <span class="text-xs text-muted font-medium uppercase">Harga</span>
                                        <span class="text-lg font-bold text-accent">
                                            Rp <%= Number(produk.Harga).toLocaleString('id-ID') %>
                                        </span>
                                    </div>
                                    <a href="/user/produk/<%= produk.ID_Product %>" 
                                       class="p-2 rounded-lg bg-white/5 hover:bg-accent text-muted hover:text-main transition-all border border-white/10 hover:border-transparent group-hover:shadow-[0_0_15px_rgba(131,197,64,0.3)]">
                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } else { %>
                <div class="flex flex-col items-center justify-center py-20 border-2 border-dashed border-white/5 rounded-3xl bg-surface/30">
                    <div class="w-20 h-20 bg-white/5 rounded-full flex items-center justify-center mb-4">
                        <svg class="w-10 h-10 text-muted/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-pale mb-2">Produk Belum Tersedia</h3>
                    <p class="text-muted text-sm text-center max-w-md">Saat ini belum ada produk yang ditambahkan. Silakan cek kembali nanti atau gunakan fitur pencocokan produk.</p>
                </div>
            <% } %>
        </div>

        <div class="mt-4 border-t border-white/5 pt-6 text-center text-xs text-muted/30">
            &copy; <%= new Date().getFullYear() %> Kampung Wisata Bausasran.
        </div>
    </main>

</body>
</html>