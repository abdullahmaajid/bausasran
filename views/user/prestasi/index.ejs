<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Galeri Prestasi - Bausasran Heritage</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        paper: '#F9F7F2',       // Background Utama
                        deep: '#0F1F18',        // Teks Utama / Aksen Gelap
                        gold: '#C5B388',        // Aksen Emas
                        charcoal: '#4A4A4A',    // Teks Sekunder
                        linen: '#EBE9E4',       // Background Kartu
                    },
                    fontFamily: {
                        sans: ['Lato', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                        crest: ['Cinzel', 'serif'],
                    },
                    letterSpacing: {
                        'luxury': '0.2em',
                    }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer base { 
            body { 
                @apply bg-paper text-deep font-sans antialiased; 
            } 
            .custom-scroll::-webkit-scrollbar { width: 6px; }
            .custom-scroll::-webkit-scrollbar-track { @apply bg-paper; }
            .custom-scroll::-webkit-scrollbar-thumb { @apply bg-deep/20 hover:bg-gold rounded-full transition-colors; }
        }

        /* Texture Grain Overlay */
        .noise-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.04'/%3E%3C/svg%3E");
            pointer-events: none;
            z-index: 0;
            mix-blend-mode: multiply;
        }
    </style>
</head>
<body class="flex h-screen overflow-hidden relative">

    <div class="noise-overlay"></div>

    <%- include('../../partials/user_sidebar.ejs') %>

    <main class="flex-1 overflow-y-auto custom-scroll p-8 md:p-12 relative z-10">
        
        <%- include('../../partials/flash.ejs') %>

        <div class="mb-12 border-b border-deep/10 pb-8 flex flex-col items-center text-center">
            <div class="w-12 h-12 mb-4 text-gold opacity-80">
                <svg fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            </div>
            <span class="text-[10px] uppercase tracking-luxury text-charcoal font-bold mb-2">Dedikasi & Pengakuan</span>
            <h1 class="text-3xl md:text-5xl font-crest text-deep mb-3">
                Galeri <span class="font-serif italic text-gold">Prestasi</span>
            </h1>
            <p class="text-charcoal font-serif italic text-lg max-w-2xl">
                Rekam jejak kebanggaan dan pencapaian warga Kampung Wisata Bausasran.
            </p>
        </div>

        <div class="pb-10">
            <% if (prestasiList && prestasiList.length > 0) { %>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <% for(let prestasi of prestasiList) { %>
                        <div class="group bg-white p-3 border border-deep/5 shadow-sm hover:shadow-xl transition-all duration-500 hover:-translate-y-1 relative">
                            
                            <div class="border border-deep/10 h-full flex flex-col relative bg-paper/30">
                                
                                <div class="h-60 relative overflow-hidden bg-linen border-b border-deep/5">
                                    <% if (prestasi.dataValues.thumbnailFile) { %>
                                        <img src="/images/prestasi/<%= prestasi.dataValues.thumbnailFile %>" 
                                             alt="<%= prestasi.Judul %>"
                                             class="w-full h-full object-cover filter sepia-[0.3] group-hover:sepia-0 transition-all duration-700 transform group-hover:scale-105">
                                    <% } else { %>
                                        <div class="w-full h-full flex flex-col items-center justify-center bg-linen text-gold/40">
                                            <svg class="w-24 h-24" fill="currentColor" viewBox="0 0 24 24">
                                                <path d="M5 21h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v14a2 2 0 002 2zm2-10h4V7h2v4h4v2h-4v4h-2v-4H7v-2z"/> </svg>
                                        </div>
                                    <% } %>
                                    
                                    <% if (prestasi.Tanggal) { %>
                                        <div class="absolute top-4 left-4 bg-white/90 backdrop-blur-sm px-3 py-1 border border-deep/10 shadow-sm">
                                            <span class="text-[9px] font-bold uppercase tracking-luxury text-deep">
                                                <%= new Date(prestasi.Tanggal).getFullYear() %>
                                            </span>
                                        </div>
                                    <% } %>
                                </div>

                                <div class="absolute top-[13.5rem] left-1/2 transform -translate-x-1/2 w-10 h-10 bg-deep rounded-full flex items-center justify-center border-2 border-white shadow-md z-10 group-hover:bg-gold transition-colors duration-300">
                                    <svg class="w-5 h-5 text-gold group-hover:text-deep transition-colors duration-300" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 2a4 4 0 00-4 4v1H5a1 1 0 00-.994.89l-1 9A1 1 0 004 18h12a1 1 0 00.994-1.11l-1-9A1 1 0 0015 7h-1V6a4 4 0 00-4-4zm2 5V6a2 2 0 10-4 0v1h4zm-6 3a1 1 0 112 0 1 1 0 01-2 0zm7-1a1 1 0 100 2 1 1 0 000-2z" clip-rule="evenodd"></path>
                                    </svg>
                                </div>

                                <div class="p-6 pt-10 text-center flex-1 flex flex-col items-center">
                                    
                                    <h3 class="text-xl font-crest text-deep mb-2 group-hover:text-gold transition-colors duration-300 px-2">
                                        <%= prestasi.Judul %>
                                    </h3>

                                    <div class="w-12 h-[1px] bg-deep/20 my-3"></div>
                                    
                                    <div class="space-y-4 mb-6 flex-grow">
                                        <% if (prestasi.Penyelenggara) { %>
                                            <div class="text-xs text-charcoal/80 font-serif italic">
                                                Oleh: <%= prestasi.Penyelenggara %>
                                            </div>
                                        <% } %>

                                        <% if (prestasi.Deskripsi) { %>
                                            <p class="text-sm text-charcoal/60 leading-relaxed line-clamp-3">
                                                <%= prestasi.Deskripsi %>
                                            </p>
                                        <% } %>
                                    </div>

                                    <a href="/user/prestasi/<%= prestasi.ID_Prestasi %>" 
                                       class="inline-block px-6 py-2 border border-deep/20 hover:border-deep text-[10px] font-bold uppercase tracking-luxury text-deep hover:bg-deep hover:text-gold transition-all duration-300">
                                        Detail Penghargaan
                                    </a>
                                </div>

                            </div>
                        </div>
                    <% } %>
                </div>
            <% } else { %>
                <div class="flex flex-col items-center justify-center py-24 border border-dashed border-deep/10 bg-linen/20">
                    <div class="w-16 h-16 rounded-full bg-paper border border-deep/10 flex items-center justify-center mb-6 shadow-sm">
                        <svg class="w-8 h-8 text-gold" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-crest text-deep mb-2">Belum Ada Catatan</h3>
                    <p class="font-serif italic text-charcoal/60 max-w-md text-center">
                        Data prestasi dan penghargaan belum ditambahkan ke dalam galeri.
                    </p>
                </div>
            <% } %>
        </div>

        <div class="mt-8 pt-6 border-t border-deep/5 text-center">
            <p class="text-[9px] uppercase tracking-luxury text-charcoal/40">
                &copy; <%= new Date().getFullYear() %> Bausasran Heritage Estate.
            </p>
        </div>
    </main>

</body>
</html>