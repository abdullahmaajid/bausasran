<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profil Anggota: <%= anggota.Nama %> - Executive Console</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Lato:wght@300;400;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        paper: '#F9F7F2',       /* Cream Kertas Tua */
                        deep: '#0F1F18',        /* Hijau Gelap Mewah */
                        gold: '#C5B388',        /* Emas Antik */
                        charcoal: '#4A4A4A',    /* Teks Abu */
                        linen: '#EBE9E4',       /* Background Secondary */
                        white: '#FFFFFF',
                    },
                    fontFamily: {
                        sans: ['Lato', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                        crest: ['Cinzel', 'serif'], 
                    },
                    boxShadow: {
                        'elegant': '0 20px 50px -12px rgba(15, 31, 24, 0.08)',
                        'gold-glow': '0 0 15px rgba(197, 179, 136, 0.2)',
                    }
                }
            }
        }
    </script>

    <style type="text/tailwindcss">
        @layer base {
            body { @apply bg-paper text-deep font-sans antialiased selection:bg-deep selection:text-paper; }
        }

        /* TEXTURE: Film Grain Overlay */
        .noise-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.03'/%3E%3C/svg%3E");
            pointer-events: none; z-index: 50; mix-blend-mode: multiply;
        }

        /* COMPONENT CLASSES */
        .heritage-card {
            @apply bg-white p-8 border border-deep/5 shadow-elegant relative overflow-hidden;
        }
        
        .heritage-label {
            @apply block text-[10px] uppercase tracking-[0.15em] font-bold text-gold mb-2 font-sans;
        }

        .heritage-value {
            @apply font-serif text-lg text-deep border-b border-deep/10 pb-2 w-full block;
        }

        .btn-action {
            @apply px-6 py-3 text-[10px] uppercase tracking-[0.2em] font-bold transition-all flex items-center justify-center gap-2 shadow-sm;
        }
        
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #C5B388; border-radius: 3px; }
    </style>
</head>

<body class="flex h-screen overflow-hidden relative">

    <div class="noise-overlay"></div>

    <%- include('../../partials/admin_sidebar.ejs') %>

    <main class="flex-1 h-full overflow-y-auto overflow-x-hidden p-6 md:p-12 relative z-10">
        <%- include('../../partials/flash.ejs') %>

        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 border-b border-deep/10 pb-8 animate-fade-in">
            <div>
                <span class="font-sans text-[10px] uppercase tracking-widest text-gold mb-2 block">
                    Direktori Personalia
                </span>
                <h1 class="font-crest text-3xl md:text-4xl text-deep leading-none flex items-center gap-4">
                    <%= anggota.Nama %>
                </h1>
                <div class="flex items-center gap-4 mt-3">
                    <span class="px-3 py-1 text-[10px] font-bold uppercase tracking-widest border 
                        <%= anggota.Role === 'Admin' 
                            ? 'bg-deep text-white border-deep' 
                            : 'bg-linen text-deep border-deep/10' %>">
                        <%= anggota.Role %>
                    </span>
                    <span class="w-px h-4 bg-deep/20"></span>
                    <span class="font-serif italic text-deep/60 text-sm">
                        <%= anggota.Jabatan || 'Anggota Pengurus' %>
                    </span>
                </div>
            </div>

            <div class="flex items-center gap-3 shrink-0">
                <a href="/admin/anggota" class="btn-action border border-deep/10 text-deep/60 bg-white hover:bg-linen hover:text-deep">
                    Kembali
                </a>
                <a href="/admin/anggota/<%= anggota.ID_Pengguna %>/edit" class="btn-action bg-deep text-gold border border-deep hover:bg-gold hover:text-deep hover:border-gold hover:shadow-gold-glow group">
                    <span>Edit Data</span>
                    <svg class="w-3 h-3 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                </a>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12 items-start">
            
            <div class="lg:col-span-1">
                <div class="heritage-card p-4 group">
                    <div class="relative aspect-[3/4] w-full bg-linen/30 border border-deep/10 overflow-hidden shadow-inner">
                        
                        <% if (anggota.dataValues.fotoFile) { %>
                            <img src="/images/anggota/<%= anggota.dataValues.fotoFile %>" 
                                 alt="<%= anggota.Nama %>" 
                                 class="w-full h-full object-cover filter sepia-[0.15] contrast-[0.95] group-hover:sepia-0 group-hover:contrast-100 transition-all duration-700 ease-out">
                        <% } else { %>
                            <div class="w-full h-full flex flex-col items-center justify-center text-deep/30 bg-linen/20">
                                <svg class="w-20 h-20 mb-3 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                                <span class="font-crest text-[10px] uppercase tracking-widest opacity-60">Tanpa Foto</span>
                            </div>
                        <% } %>
                        
                        <div class="absolute inset-0 border-[1px] border-white/20 pointer-events-none"></div>
                        <div class="absolute bottom-0 left-0 w-full h-1/3 bg-gradient-to-t from-deep/40 to-transparent opacity-50"></div>
                    </div>
                    
                    <div class="mt-5 text-center border-t border-deep/5 pt-4">
                        <p class="font-serif italic text-deep/50 text-xs">
                            Status Akun Sistem
                        </p>
                        <p class="font-crest text-deep text-xs mt-1 font-bold tracking-wider uppercase">
                            Terdaftar & Aktif
                        </p>
                    </div>
                </div>
            </div>

            <div class="lg:col-span-2 space-y-8">
                
                <div class="heritage-card">
                    <div class="absolute top-0 left-0 w-1 h-full bg-gold"></div>
                    
                    <h3 class="font-crest text-lg text-deep mb-8 flex items-center gap-3">
                        Informasi Personal
                    </h3>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8">
                        <div>
                            <span class="heritage-label">Nama Lengkap</span>
                            <span class="heritage-value"><%= anggota.Nama %></span>
                        </div>

                        <div>
                            <span class="heritage-label">Username Akun</span>
                            <span class="heritage-value font-mono text-base tracking-tight"><%= anggota.username %></span>
                        </div>

                        <div>
                            <span class="heritage-label">Jabatan Struktural</span>
                            <span class="heritage-value"><%= anggota.Jabatan || '-' %></span>
                        </div>

                        <div>
                            <span class="heritage-label">Hak Akses Sistem</span>
                            <span class="heritage-value"><%= anggota.Role %></span>
                        </div>
                    </div>
                </div>

                <div class="heritage-card">
                    <h3 class="font-crest text-lg text-deep mb-6 flex items-center gap-3">
                        Catatan & Biografi
                    </h3>
                    
                    <div class="relative pl-6 border-l-2 border-gold/30 py-2">
                        <% if (anggota.Deskripsi) { %>
                            <p class="font-serif text-deep/80 leading-loose text-lg italic whitespace-pre-line">
                                <%- anggota.Deskripsi %>
                            </p>
                        <% } else { %>
                            <p class="font-serif text-charcoal/40 italic">
                                Belum ada catatan biografi yang ditambahkan untuk anggota ini.
                            </p>
                        <% } %>
                    </div>
                </div>

            </div>
        </div>

    </main>
</body>
</html>