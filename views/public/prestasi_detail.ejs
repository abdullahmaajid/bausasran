<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= prestasi.Judul %> - Bausasran</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-gray-100">

    <%- include('../partials/navbar.ejs') %>

    <main class="container mx-auto p-6 md:p-12">
        <%- include('../partials/flash.ejs') %>

        <!-- Breadcrumb -->
        <nav class="mb-6 text-sm">
            <ol class="flex items-center space-x-2 text-gray-600">
                <li><a href="/" class="hover:text-blue-600">Home</a></li>
                <li><span class="text-gray-400">/</span></li>
                <li><a href="/prestasi" class="hover:text-blue-600">Prestasi</a></li>
                <li><span class="text-gray-400">/</span></li>
                <li class="text-gray-800 font-semibold"><%= prestasi.Judul %></li>
            </ol>
        </nav>

        <!-- Detail Prestasi -->
        <div class="bg-white rounded-lg shadow-lg overflow-hidden mb-8">
            <!-- Header with Trophy Icon -->
            <div class="bg-gradient-to-r from-yellow-400 to-yellow-600 p-8 text-white">
                <div class="flex items-center justify-center mb-4">
                    <svg class="w-24 h-24" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                </div>
                <h1 class="text-4xl font-bold text-center mb-2"><%= prestasi.Judul %></h1>
                <p class="text-center text-lg">
                    <%= new Date(prestasi.Tanggal).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                </p>
            </div>

            <!-- Content -->
            <div class="p-8">
                <% if (prestasi.Kategori) { %>
                    <div class="mb-6">
                        <span class="px-4 py-2 bg-blue-100 text-blue-800 font-semibold rounded-full">
                            <%= prestasi.Kategori %>
                        </span>
                    </div>
                <% } %>

                <!-- Photo Gallery -->
                <% if (fotoFiles && fotoFiles.length > 0) { %>
                    <div class="mb-8">
                        <h2 class="text-2xl font-bold text-gray-800 mb-4">Galeri Foto</h2>
                        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                            <% fotoFiles.forEach(foto => { %>
                                <div class="relative h-48 bg-gray-200 rounded-lg overflow-hidden group cursor-pointer">
                                    <img src="/images/galeri/<%= foto %>" 
                                         alt="Foto prestasi" 
                                         class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300">
                                    <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-30 transition-all"></div>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                <% } %>

                <!-- Info Card -->
                <div class="bg-gray-50 rounded-lg p-6 mb-6">
                    <h3 class="text-xl font-bold text-gray-800 mb-4">Informasi Prestasi</h3>
                    <div class="space-y-3">
                        <div class="flex items-start">
                            <svg class="w-5 h-5 text-blue-500 mr-3 mt-1" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/>
                            </svg>
                            <div>
                                <p class="font-semibold text-gray-700">Tanggal</p>
                                <p class="text-gray-600"><%= new Date(prestasi.Tanggal).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
                            </div>
                        </div>
                        <% if (prestasi.Kategori) { %>
                            <div class="flex items-start">
                                <svg class="w-5 h-5 text-blue-500 mr-3 mt-1" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M17.707 9.293a1 1 0 010 1.414l-7 7a1 1 0 01-1.414 0l-7-7A.997.997 0 012 10V5a3 3 0 013-3h5c.256 0 .512.098.707.293l7 7zM5 6a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/>
                                </svg>
                                <div>
                                    <p class="font-semibold text-gray-700">Kategori</p>
                                    <p class="text-gray-600"><%= prestasi.Kategori %></p>
                                </div>
                            </div>
                        <% } %>
                        <% if (groupFoto) { %>
                            <div class="flex items-start">
                                <svg class="w-5 h-5 text-blue-500 mr-3 mt-1" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"/>
                                </svg>
                                <div>
                                    <p class="font-semibold text-gray-700">Galeri</p>
                                    <p class="text-gray-600"><%= groupFoto.Nama %></p>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Back Button -->
                <div class="text-center">
                    <a href="/prestasi" class="inline-block px-6 py-3 bg-gray-600 text-white font-semibold rounded-lg hover:bg-gray-700 transition-colors">
                        ← Kembali ke Daftar Prestasi
                    </a>
                </div>
            </div>
        </div>
    </main>

    <%- include('../partials/footer.ejs') %>

</body>
</html>