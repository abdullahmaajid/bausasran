                <a href="/login" class="block text-center w-full bg-[#83C540] text-[#003024] font-bold py-3 rounded-lg">Login</a>
            <% } else { %>
                <div class="flex items-center justify-between px-2">
                    <span class="text-[#F5FEF9]">Hi, <span class="text-[#83C540] font-bold"><%= currentUser.Nama.split(' ')[0] %></span></span>
                    <% if(currentUser.Role === 'Admin') { %>
                        <a href="/admin/dashboard" class="text-xs text-[#83C540] border border-[#83C540] px-2 py-1 rounded">Admin Panel</a>
                    <% } %>
                </div>
                <% if(currentUser && currentUser.Role === 'User') { %>
                    <a href="/user/testimoni" class="mobile-link text-[#83C540]">Testimoni Saya</a>
