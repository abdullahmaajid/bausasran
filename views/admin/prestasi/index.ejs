<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kelola Prestasi</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="flex bg-gray-100">
    <%- include('../../partials/admin_sidebar.ejs') %>
    <main class="flex-1 p-10">
        <%- include('../../partials/flash.ejs') %>
        
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-3xl font-bold text-gray-800">Kelola Prestasi</h1>
            <a href="/admin/prestasi/new" class="bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded-lg">
                + Tambah Prestasi
            </a>
        </div>
        
        <form action="/admin/prestasi/bulk-action" method="POST" id="bulk-form">
            <input type="hidden" name="action" value="delete">
            <div class="mb-4">
                <button type="submit" class="bg-red-500 hover:bg-red-600 text-white font-bold py-2 px-4 rounded-lg">
                    Hapus yang Dipilih
                </button>
            </div>

            <div class="bg-white p-6 rounded-lg shadow-lg overflow-x-auto">
                <table class="min-w-full bg-white">
                    <thead class="bg-gray-200 text-gray-700">
                        <tr>
                            <th class="py-3 px-4 text-center w-12">
                                <input type="checkbox" id="select-all">
                            </th>
                            <th class="py-3 px-4 text-left">Thumbnail</th>
                            <th class="py-3 px-4 text-left">Judul</th>
                            <th class="py-3 px-4 text-left">Tanggal</th>
                            <th class="py-3 px-4 text-left">Kategori</th>
                            <th class="py-3 px-4 text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody class="text-gray-700">
                        <% if(prestasiList && prestasiList.length > 0) { %>
                            <% for(let prestasi of prestasiList) { %>
                                <tr class="border-b border-gray-200 hover:bg-gray-50">
                                    <td class="py-3 px-4 text-center">
                                        <input type="checkbox" name="selectedIds" value="<%= prestasi.ID_Prestasi %>" class="row-checkbox">
                                    </td>
                                    <td class="py-3 px-4">
                                        <% if (prestasi.dataValues.thumbnailFile) { %>
                                            <img src="/images/prestasi/<%= prestasi.dataValues.thumbnailFile %>" alt="<%= prestasi.Judul %>" class="h-12 w-16 rounded object-cover">
                                        <% } else { %>
                                            <div class="h-12 w-16 rounded bg-gray-300 flex items-center justify-center text-xs text-gray-600">
                                                NoImg
                                            </div>
                                        <% } %>
                                    </td>
                                    <td class="py-3 px-4"><%= prestasi.Judul %></td>
                                    <td class="py-3 px-4">
                                        <%= new Date(prestasi.Tanggal).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                                    </td>
                                    <td class="py-3 px-4"><%= prestasi.Kategori || '-' %></td>
                                    <td class="py-3 px-4 text-center flex items-center justify-center space-x-2">
                                        <a href="/admin/prestasi/<%= prestasi.ID_Prestasi %>" class="bg-green-500 hover:bg-green-600 text-white font-semibold py-1 px-3 rounded-lg text-sm">
                                            Detail
                                        </a>
                                        <a href="/admin/prestasi/<%= prestasi.ID_Prestasi %>/edit" class="bg-yellow-500 hover:bg-yellow-600 text-white font-semibold py-1 px-3 rounded-lg text-sm">
                                            Edit
                                        </a>
                                        
                                        <button 
                                            type="button" 
                                            class="bg-red-500 hover:bg-red-600 text-white font-semibold py-1 px-3 rounded-lg text-sm"
                                            onclick="deleteItem('<%= prestasi.ID_Prestasi %>', '<%= prestasi.Judul.replace(/'/g, "\\'") %>')">
                                            Hapus
                                        </button>
                                        </td>
                                </tr>
                            <% } %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="py-4 px-4 text-center text-gray-500">
                                    Belum ada data prestasi.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </form>
    </main>

    <script>
        document.getElementById('select-all').addEventListener('change', function(e) {
            const checkboxes = document.querySelectorAll('.row-checkbox');
            checkboxes.forEach(cb => {
                cb.checked = e.target.checked;
            });
        });
        
        document.getElementById('bulk-form').addEventListener('submit', function(e) {
            const checkedBoxes = document.querySelectorAll('.row-checkbox:checked').length;
            if (checkedBoxes === 0) {
                e.preventDefault();
                alert('Tidak ada item yang dipilih untuk dihapus.');
            } else if (!confirm(`Apakah Anda yakin ingin menghapus ${checkedBoxes} item yang dipilih?`)) {
                e.preventDefault();
            }
        });

        // === SCRIPT BARU UNTUK HAPUS SATUAN ===
        function deleteItem(id, name) {
            if (confirm(`Apakah Anda yakin ingin menghapus "${name}"? Ini akan menghapus semua foto terkait.`)) {
                const form = document.createElement('form');
                form.method = 'POST';
                // Pastikan URL action-nya benar
                form.action = `/admin/prestasi/${id}/delete`; 
                
                form.style.display = 'none';
                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
</body>
</html>